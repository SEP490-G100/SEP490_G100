<section class="py-24 bg-background-light dark:bg-background-dark relative overflow-hidden scroll-section dir-down">
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-72 h-72 bg-blue-100 dark:bg-blue-900/10 rounded-full blur-3xl -ml-36">
    </div>
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-72 h-72 bg-orange-100 dark:bg-orange-900/10 rounded-full blur-3xl -mr-36">
    </div>
    <div class="max-w-3xl mx-auto px-6 relative z-10">
        <div class="text-center mb-16 sec-reveal">
            <span class="section-label">📈 Cách hoạt động</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mt-1"
                style="font-family:'Quicksand',sans-serif">
                Tìm người trông trẻ hoặc công việc
                <span class="gradient-text">nhanh chóng &amp; dễ dàng</span>
            </h2>
            <div class="section-divider"></div>
        </div>
        <div class="mt-16 sec-reveal">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch relative">
                <!-- Connecting dashed line background for desktop -->
                <div class="hidden md:block absolute top-12 left-[16.66%] right-[16.66%] h-1 border-t-2 border-dashed border-gray-300 dark:border-gray-700 z-0">
                </div>

                <!-- Step 1 -->
                <div class="relative z-10 bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 dark:border-gray-700 group text-center flex flex-col items-center">
                    <div class="w-24 h-24 rounded-full bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner">
                        <span class="material-icons-round text-blue-500 text-4xl">search</span>
                    </div>
                    <div class="absolute -top-4 -left-4 w-12 h-12 rounded-full bg-blue-500 text-white flex items-center justify-center font-bold text-xl shadow-lg border-4 border-white dark:border-gray-800">
                        1
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Tìm kiếm & Màng lọc</h3>
                    <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
                        Dễ dàng lọc theo vị trí,
                        kinh nghiệm, và dịch vụ mong muốn. Xem hồ sơ chi tiết và đánh giá từ cộng đồng.
                    </p>
                </div>

                <!-- Step 2 -->
                <div class="relative z-10 bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 dark:border-gray-700 group text-center flex flex-col items-center md:translate-y-8">
                    <div class="w-24 h-24 rounded-full bg-purple-50 dark:bg-purple-900/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner">
                        <span class="material-icons-round text-purple-500 text-4xl">forum</span>
                    </div>
                    <div class="absolute -top-4 -left-4 w-12 h-12 rounded-full bg-purple-500 text-white flex items-center justify-center font-bold text-xl shadow-lg border-4 border-white dark:border-gray-800">
                        2
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Kết nối & Trò chuyện</h3>
                    <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
                        Sử dụng hệ thống nhắn tin
                        bảo mật để trò chuyện, trao đổi yêu cầu và sắp xếp một cuộc gọi ban đầu nếu cần.
                    </p>
                </div>

                <!-- Step 3 -->
                <div class="relative z-10 bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 dark:border-gray-700 group text-center flex flex-col items-center">
                    <div class="w-24 h-24 rounded-full bg-pink-50 dark:bg-pink-900/30 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner">
                        <span class="material-icons-round text-pink-500 text-4xl">handshake</span>
                    </div>
                    <div class="absolute -top-4 -left-4 w-12 h-12 rounded-full bg-pink-500 text-white flex items-center justify-center font-bold text-xl shadow-lg border-4 border-white dark:border-gray-800">
                        3
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Gặp mặt & An tâm</h3>
                    <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
                        Sắp xếp cuộc gặp mặt trực
                        tiếp. Khi đã hài lòng, bạn hoàn toàn có thể yên tâm đặt lịch ngay lập tức.
                    </p>
                </div>
                <!-- Step 4-->
                
            </div>

            <div class="text-center mt-20">
                <button class="bg-gradient-to-r from-primary to-orange-400 hover:from-primaryDark hover:to-primary text-white px-10 py-4 rounded-full font-bold shadow-lg shadow-orange-500/40 transform hover:scale-105 hover:-translate-y-1 transition-all duration-300 text-lg flex items-center gap-2 mx-auto">
                    <span class="material-icons-round">rocket_launch</span>
                    Bắt đầu ngay hôm nay
                </button>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-4 font-medium">
                    ✨ Miễn phí đăng ký và xem hồ sơ
                </p>
            </div>
        </div>
    </div>
</section>