<section class="py-24 bg-white dark:bg-card-dark scroll-section dir-up" style="background-color: #fff">

    <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <!-- Heading -->
        <div class="text-center mb-14 sec-reveal">
            <span class="section-label">🙋 Câu hỏi thường gặp</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mt-2"
                style="font-family:'Quicksand',sans-serif">
                Bạn đang <span class="gradient-text">thắc mắc điều gì?</span>
            </h2>
            <div class="section-divider"></div>
        </div>

        <!-- FAQ accordion -->
        <div class="space-y-3 sec-reveal" id="faqAccordion">

            <!-- Q1 -->
            <div class="faq-item bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                <button onclick="toggleFaq(this)"
                        class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-orange-50/50 dark:hover:bg-gray-700/40 transition-colors duration-200">
                    <span class="font-semibold text-gray-900 dark:text-white text-sm lg:text-base pr-4">
                        NannyMatch
                        hoạt động như thế nào?
                    </span>
                    <span class="material-icons -round text-primary text-xl flex-shrink-0 faq-icon transition-transform duration-300">expand_more</span>
                </button>
                <div class="faq-answer-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out relative">
                    <div class="overflow-hidden">
                        <div class="faq-answer px-6 pb-5">
                            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                                Bạn tạo hồ sơ, tìm
                                kiếm bảo
                                mẫu phù hợp theo khu vực và tiêu chí, xem hồ sơ đã được xác minh, nhắn tin trực
                                tiếp, rồi
                                sắp xếp buổi gặp mặt trước khi đặt lịch chính thức. Toàn bộ quy trình an toàn và
                                minh bạch.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Q2 -->
            <div class="faq-item bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                <button onclick="toggleFaq(this)"
                        class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-orange-50/50 dark:hover:bg-gray-700/40 transition-colors duration-200">
                    <span class="font-semibold text-gray-900 dark:text-white text-sm lg:text-base pr-4">
                        Bảo mẫu có
                        được kiểm tra lý lịch không?
                    </span>
                    <span class="material-icons-round text-primary text-xl flex-shrink-0 faq-icon transition-transform duration-300">expand_more</span>
                </button>
                <div class="faq-answer-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out relative">
                    <div class="overflow-hidden">
                        <div class="faq-answer px-6 pb-5">
                            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                                Có. Mọi bảo mẫu đều
                                trải qua
                                quy trình xác minh danh tính theo nhiều bước, bao gồm kiểm tra CCCD/hộ chiếu và đánh
                                giá từ
                                các gia đình trước. Chúng tôi cam kết tính minh bạch và an toàn.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
                    <!-- Q3 -->
            <div class="faq-item bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                        <button onclick="toggleFaq(this)"
                                class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-orange-50/50 dark:hover:bg-gray-700/40 transition-colors duration-200">
                            <span class="font-semibold text-gray-900 dark:text-white text-sm lg:text-base pr-4">
                                Chi
                                phí sử
                                dụng NannyMatch là bao nhiêu?
                            </span>
                            <span class="material-icons-round text-primary text-xl flex-shrink-0 faq-icon transition-transform duration-300">expand_more</span>
                        </button>
                        <div class="faq-answer-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out relative">
                            <div class="overflow-hidden">
                                <div class="faq-answer px-6 pb-5">
                                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                                        Đăng ký và
                                        xem hồ sơ cơ bản
                                        hoàn toàn miễn phí. Gói trả phí từ <strong class="text-gray-800 dark:text-white">
                                            99.000
                                            đ/tháng
                                        </strong> để mở khóa nhắn tin không giới hạn, bộ lọc nâng cao và
                                        huy hiệu xác
                                        minh ưu tiên.
                                    </p>
                                </div>
                            </div>
                        </div>
            </div>

            <!-- Q4 -->
            <div class="faq-item bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                                <button onclick="toggleFaq(this)"
                                        class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-orange-50/50 dark:hover:bg-gray-700/40 transition-colors duration-200">
                                    <span class="font-semibold text-gray-900 dark:text-white text-sm lg:text-base pr-4">
                                        Tôi
                                        có thể
                                        hủy dịch vụ bất kỳ lúc nào không?
                                    </span>
                                    <span class="material-icons-round text-primary text-xl flex-shrink-0 faq-icon transition-transform duration-300">expand_more</span>
                                </button>
                                <div class="faq-answer-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out relative">
                                    <div class="overflow-hidden">
                                        <div class="faq-answer px-6 pb-5">
                                            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                                                Hoàn
                                                toàn có thể. Không có
                                                hợp đồng dài hạn. Bạn có thể hủy gói trả phí bất cứ lúc nào trong
                                                phần cài đặt tài khoản và
                                                gói sẽ tiếp tục có hiệu lực đến hết chu kỳ đã thanh toán.
                                            </p>
                                        </div>
                                    </div>
                                </div>
            </div>
                                    <!-- Q5 -->
            <div class="faq-item bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                                        <button onclick="toggleFaq(this)"
                                                class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-orange-50/50 dark:hover:bg-gray-700/40 transition-colors duration-200">
                                            <span class="font-semibold text-gray-900 dark:text-white text-sm lg:text-base pr-4">
                                                Làm
                                                sao nếu
                                                tôi không hài lòng với bảo mẫu?
                                            </span>
                                            <span class="material-icons-round text-primary text-xl flex-shrink-0 faq-icon transition-transform duration-300">expand_more</span>
                                        </button>
                                        <div class="faq-answer-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out relative">
                                            <div class="overflow-hidden">
                                                <div class="faq-answer px-6 pb-5">
                                                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                                                        Bạn có thể tìm bảo mẫu khác
                                                        bất kỳ lúc nào. Nếu có vấn đề nghiêm trọng, đội ngũ hỗ trợ
                                                        của chúng tôi sẵn sàng can thiệp
                                                        trong vòng 24 giờ. Phụ huynh luôn được đặt lên hàng đầu.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
            </div>

            <!-- Q6 -->
            <div class="faq-item bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50 overflow-hidden">
                                                <button onclick="toggleFaq(this)"
                                                        class="faq-btn w-full flex items-center justify-between px-6 py-5 text-left hover:bg-orange-50/50 dark:hover:bg-gray-700/40 transition-colors duration-200">
                                                    <span class="font-semibold text-gray-900 dark:text-white text-sm lg:text-base pr-4">
                                                        Bảo
                                                        mẫu đăng
                                                        ký có khó không?
                                                    </span>
                                                    <span class="material-icons-round text-primary text-xl flex-shrink-0 faq-icon transition-transform duration-300">expand_more</span>
                                                </button>
                                                <div class="faq-answer-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out relative">
                                                    <div class="overflow-hidden">
                                                        <div class="faq-answer px-6 pb-5">
                                                            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                                                                Rất đơn giản! Chỉ cần 5 phút
                                                                để tạo hồ sơ, tải ảnh và xác minh danh tính. Sau khi
                                                                được phê duyệt, hồ sơ của bạn sẽ xuất
                                                                hiện trước hàng nghìn gia đình đang tìm kiếm dịch vụ
                                                                chăm sóc.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
            </div>
            <!-- CTA below FAQ -->
            <div class="text-center mt-12 sec-reveal">
                                                    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                                                        Câu hỏi
                                                        của bạn chưa có trong danh sách?
                                                    </p>
                                                    <a asp-controller="Communication"
                                                       asp-action="Index"
                                                       class="inline-flex items-center gap-2 text-primary hover:text-primaryDark font-bold text-sm hover:underline transition-colors">
                                                        <span class="material-icons-round text-base">support_agent</span>
                                                        Liên hệ bộ phận hỗ trợ →
                                                    </a>
            </div>
                                           
</section>
