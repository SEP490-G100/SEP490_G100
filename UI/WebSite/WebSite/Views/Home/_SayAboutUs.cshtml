@model WebSite.Models.Home.HomePageViewModel
@using System.Globalization
@{
    var averageRating = Math.Clamp(Model?.AverageRating ?? 0m, 0m, 5m);
    var totalReviews = Math.Max(Model?.TotalReviews ?? 0, 0);
    var viVn = CultureInfo.GetCultureInfo("vi-VN");
    var fullStars = (int)Math.Floor(averageRating);
    var hasHalfStar = (averageRating - fullStars) >= 0.5m;
    var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
}
<section class="py-28 relative overflow-hidden scroll-section dir-up">
    <!-- decorative blobs -->
    <div class="absolute top-0 right-0 w-80 h-80 bg-orange-200/40 rounded-full -mr-20 -mt-20 blur-3xl pointer-events-none">
    </div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-amber-200/30 rounded-full -ml-16 -mb-16 blur-3xl pointer-events-none">
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-10">
        <!-- Eyebrow + Heading -->
        <div class="text-center mb-6 sec-reveal">
            <span class="section-label">💬 Người dùng nói gì</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-2"
                style="font-family:'Quicksand',sans-serif">
                NannyMatch — nền tảng <span class="gradient-text">được nhiều phụ huynh tin dùng</span>
            </h2>
        </div>
        <!-- Stars + count -->
        <div class="flex flex-col items-center gap-1.5 mb-14 sec-reveal">
            <div class="flex items-center gap-0.5">
                @for (var i = 0; i < fullStars; i++)
                {
                    <span class="material-icons-round text-amber-400 text-2xl">star</span>
                }
                @if (hasHalfStar)
                {
                    <span class="material-icons-round text-amber-400 text-2xl">star_half</span>
                }
                @for (var i = 0; i < emptyStars; i++)
                {
                    <span class="material-icons-round text-amber-400 text-2xl">star_border</span>
                }
                <span class="ml-2 text-2xl font-bold text-gray-800">@averageRating.ToString("0.0", CultureInfo.InvariantCulture) / 5</span>
            </div>
            <p class="text-gray-500 text-sm font-medium">
                Dựa trên <strong class="text-gray-700">@totalReviews.ToString("N0", viVn)</strong> đánh
                giá từ phụ huynh và bảo mẫu
            </p>
        </div>

        <!-- Testimonial cards -->
        <div class="marquee-container overflow-hidden w-full relative sec-reveal py-2"
             style="-webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);">
            <div class="marquee-track">
                <!-- Card 1 -->
                <div class="marquee-item bg-white rounded-2xl p-6 flex flex-col gap-4 shadow-card hover:shadow-soft hover:-translate-y-1.5 transition-all duration-300 border border-orange-100/60 ring-1 ring-black/[0.03]">
                    <div class="flex items-center justify-between">
                        <span class="text-5xl leading-none"
                              style="color:#F97316; font-family:Georgia,serif; line-height:1">"</span>
                        <div class="flex gap-0.5">
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                        </div>
                    </div>
                    <p class="text-gray-600 text-sm leading-relaxed flex-1">
                        Dễ dàng tìm được bảo mẫu đáng tin cậy.
                        Nền
                        tảng an toàn, giao diện thân thiện và hỗ trợ nhanh chóng. Tôi rất hài lòng!
                    </p>
                    <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-orange-400 to-rose-400 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                            H
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">Hương Nguyễn</p>
                            <p class="text-xs text-gray-400">Phụ huynh · TP.HCM</p>
                        </div>
                    </div>
                </div>
                <!-- Card 2 -->
                <div class="marquee-item bg-white rounded-2xl p-6 flex flex-col gap-4 shadow-card hover:shadow-soft hover:-translate-y-1.5 transition-all duration-300 border border-orange-100/60 ring-1 ring-black/[0.03]">
                    <div class="flex items-center justify-between">
                        <span class="text-5xl leading-none"
                              style="color:#F97316; font-family:Georgia,serif; line-height:1">"</span>
                        <div class="flex gap-0.5">
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                        </div>
                    </div>
                    <p class="text-gray-600 text-sm leading-relaxed flex-1">
                        Hồ sơ bảo mẫu rõ ràng, minh bạch. Tìm
                        được
                        người trông con ngay trong ngày đăng ký. Tiện lợi và chuyên nghiệp!
                    </p>
                    <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-teal-400 to-emerald-400 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                            M
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">Minh Trần</p>
                            <p class="text-xs text-gray-400">Phụ huynh · Hà Nội</p>
                        </div>
                    </div>
                </div>
                <!-- Card 3 -->
                <div class="marquee-item bg-white rounded-2xl p-6 flex flex-col gap-4 shadow-card hover:shadow-soft hover:-translate-y-1.5 transition-all duration-300 border border-orange-100/60 ring-1 ring-black/[0.03]">
                    <div class="flex items-center justify-between">
                        <span class="text-5xl leading-none"
                              style="color:#F97316; font-family:Georgia,serif; line-height:1">"</span>
                        <div class="flex gap-0.5">
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star_half</span>
                        </div>
                    </div>
                    <p class="text-gray-600 text-sm leading-relaxed flex-1">
                        Hệ thống xác minh danh tính khiến tôi
                        hoàn
                        toàn yên tâm. Đây là nền tảng đầu tiên tôi tin tưởng để giao phó con mình.
                    </p>
                    <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-violet-400 to-purple-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                            L
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">Lan Phạm</p>
                            <p class="text-xs text-gray-400">Phụ huynh · Đà Nẵng</p>
                        </div>
                    </div>
                </div>
                <!-- Card 4 -->
                <div class="marquee-item bg-white rounded-2xl p-6 flex flex-col gap-4 shadow-card hover:shadow-soft hover:-translate-y-1.5 transition-all duration-300 border border-orange-100/60 ring-1 ring-black/[0.03]">
                    <div class="flex items-center justify-between">
                        <span class="text-5xl leading-none"
                              style="color:#F97316; font-family:Georgia,serif; line-height:1">"</span>
                        <div class="flex gap-0.5">
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                        </div>
                    </div>
                    <p class="text-gray-600 text-sm leading-relaxed flex-1">
                        Là bảo mẫu, tôi tìm được nhiều gia đình
                        tuyệt vời qua NannyMatch. Thu nhập ổn định và lịch trình rất linh hoạt.
                    </p>
                    <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white text-sm font-bold flex-shrink-0">
                            T
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">Thu Lê</p>
                            <p class="text-xs text-gray-400">Bảo mẫu · TP.HCM</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div class="text-center mt-14 sec-reveal">
            <a asp-controller="Auth"
               asp-action="Register"
               class="inline-flex items-center gap-2 bg-primary hover:bg-primaryDark text-white px-9 py-3.5 rounded-xl font-bold shadow-glow hover:scale-105 transition-all duration-200">
                <span class="material-icons-round text-sm">how_to_reg</span>
                Đăng ký miễn phí ngay
            </a>
            <p class="text-xs text-gray-400 mt-3">Không cần thẻ tín dụng · Hoàn toàn miễn phí để bắt đầu</p>
        </div>
    </div>
</section>
