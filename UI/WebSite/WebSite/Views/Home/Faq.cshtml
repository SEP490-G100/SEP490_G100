@section Scripts {
<script>
(function () {
    // ── Accordion aria init ────────────────────────────────────────
    document.querySelectorAll('#faqAccordion .faq-item').forEach((item, i) => {
        const btn   = item.querySelector('.faq-btn');
        const panel = item.querySelector('.faq-answer-wrapper');
        const id    = 'faq-panel-' + i;
        panel.id    = id;
        panel.setAttribute('role', 'region');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-controls', id);
    });

    // ── Accordion ──────────────────────────────────────────────────
    function toggleFaq(btn) {
        const wrapper = btn.nextElementSibling;
        const chevron = btn.querySelector('.faq-chevron');
        const isOpen  = wrapper.style.gridTemplateRows === '1fr';

        // Close all
        document.querySelectorAll('#faqAccordion .faq-answer-wrapper').forEach(w => {
            w.style.gridTemplateRows = '0fr';
        });
        document.querySelectorAll('#faqAccordion .faq-chevron').forEach(c => {
            c.style.transform = 'rotate(0deg)';
        });
        document.querySelectorAll('#faqAccordion .faq-card').forEach(c => {
            c.style.borderLeftColor = 'transparent';
        });
        document.querySelectorAll('#faqAccordion .faq-btn').forEach(b => {
            b.setAttribute('aria-expanded', 'false');
        });

        // Open clicked
        if (!isOpen) {
            wrapper.style.gridTemplateRows = '1fr';
            chevron.style.transform = 'rotate(180deg)';
            btn.closest('.faq-card').style.borderLeftColor = '#f97316';
            btn.setAttribute('aria-expanded', 'true');
        }
    }

    // ── Search ─────────────────────────────────────────────────────
    function searchFaq(q) {
        const kw    = q.trim().toLowerCase();
        const items = document.querySelectorAll('.faq-item');
        const clear = document.getElementById('faqSearchClear');
        let shown   = 0;

        // Close all first
        document.querySelectorAll('.faq-answer-wrapper').forEach(w => w.style.gridTemplateRows = '0fr');
        document.querySelectorAll('.faq-chevron').forEach(c => c.style.transform = 'rotate(0deg)');

        clear.style.display = kw ? 'block' : 'none';

        if (kw) {
            document.querySelectorAll('.faq-cat-btn').forEach(b => b.classList.remove('faq-cat-active'));
            document.querySelectorAll('.faq-cat-btn').forEach(b => applyInactiveStyle(b));
        } else {
            activateTab('tab-all');
        }

        items.forEach(item => {
            const text  = item.dataset.q || '';
            const match = !kw || text.toLowerCase().includes(kw);
            item.style.display = match ? '' : 'none';
            if (match) shown++;
        });

        document.getElementById('faqCount').textContent = shown + ' câu hỏi';
        document.getElementById('faqEmpty').style.display = shown === 0 ? 'block' : 'none';
    }

    function clearSearch() {
        document.getElementById('faqSearch').value = '';
        searchFaq('');
    }

    // ── Category filter ────────────────────────────────────────────
    const catLabels = { all:'Tất cả câu hỏi', general:'Câu hỏi chung', parent:'Câu hỏi phụ huynh', nanny:'Câu hỏi bảo mẫu', payment:'Thanh toán & Gói' };

    function filterFaq(cat) {
        const items = document.querySelectorAll('.faq-item');
        const input = document.getElementById('faqSearch');
        if (input) { input.value = ''; document.getElementById('faqSearchClear').style.display = 'none'; }

        document.querySelectorAll('.faq-answer-wrapper').forEach(w => w.style.gridTemplateRows = '0fr');
        document.querySelectorAll('.faq-chevron').forEach(c => c.style.transform = 'rotate(0deg)');
        document.querySelectorAll('.faq-card').forEach(c => c.style.borderLeftColor = 'transparent');

        let shown = 0;
        items.forEach(item => {
            const match = cat === 'all' || item.dataset.category === cat;
            item.style.display = match ? '' : 'none';
            if (match) shown++;
        });

        document.querySelectorAll('.faq-cat-btn').forEach(b => applyInactiveStyle(b));
        activateTab('tab-' + cat);

        document.getElementById('faqSectionLabel').textContent = catLabels[cat] || 'Câu hỏi';
        document.getElementById('faqCount').textContent = shown + ' câu hỏi';
        document.getElementById('faqEmpty').style.display = shown === 0 ? 'block' : 'none';
    }

    function applyInactiveStyle(btn) {
        btn.style.borderColor = '#e5e7eb';
        btn.style.background  = '#fff';
        const count = btn.querySelector('.faq-cat-count');
        if (count) count.style.background = count.dataset.bg || count.style.background;
        btn.classList.remove('faq-cat-active');
    }

    function activateTab(id) {
        const btn = document.getElementById(id);
        if (!btn) return;
        btn.style.borderColor = '#f97316';
        btn.style.background  = '#fff7ed';
        btn.classList.add('faq-cat-active');
        const count = btn.querySelector('.faq-cat-count');
        if (count) { count.dataset.bg = count.style.background; count.style.background = '#f97316'; count.style.color = '#fff'; }
    }

    // Expose page-level handlers to window (required by inline onclick/oninput)
    window.toggleFaq  = toggleFaq;
    window.searchFaq  = searchFaq;
    window.clearSearch = clearSearch;
    window.filterFaq  = filterFaq;
}());
</script>
<style>
    .faq-card {
        background: #fff;
        border-radius: 16px;
        border: 1.5px solid #f3f4f6;
        border-left: 3px solid transparent;
        overflow: hidden;
        transition: border-color .2s, box-shadow .2s;
        margin-bottom: 8px;
    }
    .faq-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,.06); }
    .faq-btn:hover { background: #fff7ed; }

    .faq-cat-btn:hover { border-color: #fdba74 !important; background: #fff7ed !important; }
    .faq-cat-active { border-color: #f97316 !important; background: #fff7ed !important; }

    .faq-contact-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #fff;
        color: #ea580c;
        font-weight: 700;
        font-size: .82rem;
        padding: 10px;
        border-radius: 12px;
        text-decoration: none;
        transition: opacity .15s;
    }
    .faq-contact-btn:hover { opacity: .9; color: #ea580c; }

    /* Mobile: stack layout */
    @@media (max-width: 767px) {
        #categoryCards { grid-template-columns: repeat(3, 1fr) !important; }
        .max-w-5xl > section > div > div:last-child,
        div[style*="grid-template-columns:1fr 320px"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>
}
