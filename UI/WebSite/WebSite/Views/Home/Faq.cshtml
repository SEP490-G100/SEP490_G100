                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </span>
                <span style="font-size:12px;font-weight:700;color:#374151">Chung</span>
                <span class="faq-cat-count" style="font-size:10px;font-weight:700;background:#eff6ff;color:#3b82f6;padding:2px 8px;border-radius:99px">3</span>
            </button>

            <button onclick="filterFaq('parent')" id="tab-parent"
                    class="faq-cat-btn"
