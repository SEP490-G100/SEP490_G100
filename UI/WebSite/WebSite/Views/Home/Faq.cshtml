                <span style="width:36px;height:36px;border-radius:10px;background:#fdf2f8;display:flex;align-items:center;justify-content:center">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#db2777" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                </span>
                <span style="font-size:12px;font-weight:700;color:#374151">Bảo mẫu</span>
                <span class="faq-cat-count" style="font-size:10px;font-weight:700;background:#fdf2f8;color:#db2777;padding:2px 8px;border-radius:99px">2</span>
            </button>

            <button onclick="filterFaq('payment')" id="tab-payment"
                    class="faq-cat-btn"
                    style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 8px;border-radius:16px;border:2px solid #e5e7eb;background:#fff;cursor:pointer;transition:all .2s">
                <span style="width:36px;height:36px;border-radius:10px;background:#ecfdf5;display:flex;align-items:center;justify-content:center">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                    </svg>
                </span>
                <span style="font-size:12px;font-weight:700;color:#374151">Thanh toán</span>
                <span class="faq-cat-count" style="font-size:10px;font-weight:700;background:#ecfdf5;color:#059669;padding:2px 8px;border-radius:99px">3</span>
            </button>
        </div>

        <!-- ── Two-column layout ── -->
        <div style="display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start">

            <!-- Accordion column -->
            <div>
                <!-- Section label -->
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
