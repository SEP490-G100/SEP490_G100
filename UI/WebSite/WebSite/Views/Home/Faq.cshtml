                <span style="width:36px;height:36px;border-radius:10px;background:#f5f3ff;display:flex;align-items:center;justify-content:center">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                <span style="font-size:12px;font-weight:700;color:#374151">Phụ huynh</span>
                <span class="faq-cat-count" style="font-size:10px;font-weight:700;background:#f5f3ff;color:#7c3aed;padding:2px 8px;border-radius:99px">3</span>
            </button>

            <button onclick="filterFaq('nanny')" id="tab-nanny"
                    class="faq-cat-btn"
