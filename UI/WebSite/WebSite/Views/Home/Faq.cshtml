@{
    ViewData["Title"] = "Câu hỏi thường gặp – NannyMatch";
}

<!-- ══ HERO ═══════════════════════════════════════════════════════════ -->
<section class="relative overflow-hidden"
         style="background: linear-gradient(160deg, #fff7ed 0%, #fef9f0 55%, #f9fafb 100%); padding: 72px 0 64px">
    <!-- Orbs -->
    <div style="position:absolute;top:-80px;right:-80px;width:420px;height:420px;background:radial-gradient(circle,rgba(251,191,36,.18) 0%,transparent 70%);pointer-events:none"></div>
    <div style="position:absolute;bottom:-60px;left:-60px;width:320px;height:320px;background:radial-gradient(circle,rgba(249,115,22,.10) 0%,transparent 70%);pointer-events:none"></div>

    <div class="max-w-2xl mx-auto px-6 text-center" style="position:relative;z-index:1">
        <!-- Badge -->
        <div style="display:inline-flex;align-items:center;gap:6px;background:#ffedd5;color:#ea580c;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:6px 14px;border-radius:99px;margin-bottom:20px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Trung tâm hỗ trợ
        </div>

        <!-- Heading -->
        <h1 style="font-family:'Quicksand',sans-serif;font-size:clamp(2rem,5vw,3rem);font-weight:800;color:#111827;line-height:1.15;margin-bottom:14px">
            Chúng tôi có thể<br>
            <span class="gradient-text">giúp gì cho bạn?</span>
        </h1>
        <p style="color:#6b7280;font-size:.95rem;margin-bottom:32px;line-height:1.7">
            Tổng hợp <strong style="color:#374151">11 câu hỏi</strong> thường gặp nhất từ phụ huynh và bảo mẫu.
        </p>

        <!-- Search -->
        <div style="position:relative;max-width:520px;margin:0 auto">
            <!-- Icon SVG (không phụ thuộc Material Icons) -->
            <svg style="position:absolute;left:18px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:#9ca3af;pointer-events:none;flex-shrink:0"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input id="faqSearch" type="text" placeholder="Nhập từ khóa tìm kiếm..."
                   oninput="searchFaq(this.value)"
                   style="width:100%;padding:14px 46px 14px 48px;border-radius:16px;border:1.5px solid #e5e7eb;background:#fff;font-size:.9rem;color:#111827;box-shadow:0 4px 24px rgba(0,0,0,.07);outline:none;transition:border-color .2s,box-shadow .2s;box-sizing:border-box"
                   onfocus="this.style.borderColor='#f97316';this.style.boxShadow='0 4px 24px rgba(249,115,22,.15)'"
                   onblur="this.style.borderColor='#e5e7eb';this.style.boxShadow='0 4px 24px rgba(0,0,0,.07)'" />
            <button id="faqSearchClear" onclick="clearSearch()"
                    style="display:none;position:absolute;right:16px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;padding:2px;color:#9ca3af;line-height:1">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
    </div>
</section>

<!-- ══ MAIN CONTENT ════════════════════════════════════════════════════ -->
<section style="background:#f9fafb;padding:48px 0 72px">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">

        <!-- ── Category cards ── -->
        <div id="categoryCards" style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:36px">

            <button onclick="filterFaq('all')" id="tab-all"
                    class="faq-cat-btn faq-cat-active"
                    style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 8px;border-radius:16px;border:2px solid #f97316;background:#fff7ed;cursor:pointer;transition:all .2s">
                <span style="width:36px;height:36px;border-radius:10px;background:#ffedd5;display:flex;align-items:center;justify-content:center">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                    </svg>
                </span>
                <span style="font-size:12px;font-weight:700;color:#374151">Tất cả</span>
                <span class="faq-cat-count" style="font-size:10px;font-weight:700;background:#f97316;color:#fff;padding:2px 8px;border-radius:99px">11</span>
            </button>

            <button onclick="filterFaq('general')" id="tab-general"
                    class="faq-cat-btn"
