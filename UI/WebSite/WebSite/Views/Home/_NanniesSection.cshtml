@model WebSite.Models.Home.HomePageViewModel
@using System.Globalization
@{
    var featuredNannies = (Model?.FeaturedNannies ?? new List<WebSite.Models.Nanny.NannyListItemViewModel>())
        .Take(8)
        .ToList();
    var viVn = CultureInfo.GetCultureInfo("vi-VN");

    string FormatMoney(decimal? amount) =>
        amount.HasValue && amount.Value > 0
            ? $"{amount.Value.ToString("N0", viVn)} VND"
            : "Thỏa thuận";

    string FormatSalary(decimal? min, decimal? max)
    {
        if (min.HasValue && max.HasValue) return $"{FormatMoney(min)} - {FormatMoney(max)}";
        if (min.HasValue) return $"Từ {FormatMoney(min)}";
        if (max.HasValue) return $"Đến {FormatMoney(max)}";
        return "Thỏa thuận";
    }
}

<section class="py-24 bg-white dark:bg-card-dark scroll-section dir-up" style="background: linear-gradient(to bottom, #ffffff, #f9fafb)">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="text-center mb-14 sec-reveal">
            <span class="section-label">👶 Bảo mẫu của chúng tôi</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mt-1"
                style="font-family:'Quicksand',sans-serif">
                Tìm người trông trẻ mà
                <span class="gradient-text">các bé sẽ yêu quý</span>
            </h2>
            <div class="section-divider"></div>
        </div>

        @if (featuredNannies.Count > 0)
        {
            <div class="marquee-container overflow-hidden w-full relative sec-reveal py-2"
                 style="-webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);">
                <div class="marquee-track">
                    @foreach (var nanny in featuredNannies)
                    {
                        var ratingValue = Math.Clamp(nanny.AverageRating ?? 0m, 0m, 5m);
                        var fullStars = (int)Math.Floor(ratingValue);
                        var hasHalfStar = (ratingValue - fullStars) >= 0.5m;
                        var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

                        <a class="marquee-item bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-card hover:shadow-soft hover:-translate-y-1.5 transition-all duration-300 border border-gray-100 dark:border-gray-700 cursor-pointer group ring-1 ring-black/[0.04]"
                           asp-controller="Nanny"
                           asp-action="List"
                           asp-route-detailId="@nanny.Id">
                            <div class="relative mb-4">
                                <img alt="Ảnh hồ sơ bảo mẫu" class="w-full aspect-square object-cover rounded-xl"
                                     src="@(string.IsNullOrWhiteSpace(nanny.AvatarUrl) ? "/img/nanny-logo.jpg" : nanny.AvatarUrl)" />
                                @if (nanny.FeaturedBadge || nanny.SearchPriority)
                                {
                                    <div class="absolute top-2 left-2 flex flex-wrap gap-2">
                                        @if (nanny.SearchPriority)
                                        {
                                            <span class="rounded-full bg-slate-900/85 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[0.14em] text-white">Gói Pro</span>
                                        }
                                        else if (nanny.FeaturedBadge)
                                        {
                                            <span class="rounded-full bg-orange-500/90 px-3 py-1 text-[11px] font-extrabold uppercase tracking-[0.14em] text-white">Gói Plus</span>
                                        }
                                    </div>
                                }
                                <div class="absolute top-2 right-2 bg-white dark:bg-gray-900 px-2 py-1 rounded-lg text-xs font-bold text-gray-900 dark:text-gray-200 shadow-sm">
                                    @FormatSalary(nanny.ExpectedSalaryMin, nanny.ExpectedSalaryMax)
                                </div>
                            </div>
                            <div class="text-center">
                                <h3 class="font-bold text-lg text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                                    @nanny.FullName
                                </h3>
                                <p class="text-sm text-gray-500 dark:text-gray-400">
                                    @(string.Join(", ", new[] { nanny.District, nanny.City }.Where(s => !string.IsNullOrWhiteSpace(s))))
                                </p>
                                <div class="flex justify-center items-center mt-2 gap-1 text-yellow-500 text-sm">
                                    @for (var i = 0; i < fullStars; i++)
                                    {
                                        <span class="material-icons-round text-base">star</span>
                                    }
                                    @if (hasHalfStar)
                                    {
                                        <span class="material-icons-round text-base">star_half</span>
                                    }
                                    @for (var i = 0; i < emptyStars; i++)
                                    {
                                        <span class="material-icons-round text-base">star_border</span>
                                    }
                                    <span class="text-gray-400 text-xs">(@nanny.TotalReviews)</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="sec-reveal text-center bg-white rounded-2xl border border-gray-100 p-10 shadow-sm">
                <p class="text-gray-500">Chưa có dữ liệu bảo mẫu để hiển thị.</p>
            </div>
        }

        <div class="text-center mt-14 sec-reveal">
            <a class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl border-2 border-primary text-primary font-bold hover:bg-primary hover:text-white transition-all duration-200 hover:shadow-glow"
               asp-controller="Nanny"
               asp-action="List">
                Xem tất cả bảo mẫu
                <span class="material-icons-round text-sm">arrow_forward</span>
            </a>
        </div>
    </div>
</section>
