@{
    ViewData["Title"] = "Quan ly hop dong";
    var isParent = User.IsInRole("Parent");

}

<section class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="border-b border-orange-100 px-5 py-5 md:px-7">
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">@(isParent ? "Khu vực phụ huynh" : "Khu vực bảo mẫu")</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">@(isParent ? "Quản lý hợp đồng của phụ huynh" : "Quản lý hợp đồng của bảo mẫu")</h1>
            <p class="mt-1 text-sm text-slate-500">Tải lên file PDF hợp đồng để lưu trữ trên hệ thống (chỉ nhận PDF).</p>
        </div>

        <div class="px-5 pb-6 pt-5 md:px-7">
            <div id="contractStorageState" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                Đang tải danh sách hợp đồng...
            </div>
            <div id="contractStorageList" class="hidden grid gap-3"></div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const stateEl = document.getElementById('contractStorageState');
            const listEl = document.getElementById('contractStorageList');

            const esc = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('vi-VN') : 'Chua xac dinh';

            const toFlatList = (payload) => {
                const active = Array.isArray(payload?.active) ? payload.active : [];
                const pending = Array.isArray(payload?.pending) ? payload.pending : [];
                const history = Array.isArray(payload?.history) ? payload.history : [];

                return active.concat(pending).concat(history)
                    .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            };

            const renderItem = (item) => {
                const fileUrl = String(item.pdfUrl || '').trim();
                const hasFile = !!fileUrl;

                return `
                <article class="rounded-2xl border border-orange-100 bg-gradient-to-b from-white to-orange-50/40 p-4 shadow-sm" data-contract-card="${esc(item.contractId)}">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="text-base font-bold text-slate-900">${esc(item.jobTitle || 'Cong viec')}</p>
                            <p class="mt-1 text-xs font-semibold text-slate-500">${fmtDate(item.startDate)} - ${fmtDate(item.endDate)}</p>
                        </div>
                    </div>

                    <div class="mt-3 grid gap-1 text-sm text-slate-700">
                        <p><span class="font-bold text-slate-800">Parent:</span> ${esc(item.parentName || '...')}</p>
                        <p><span class="font-bold text-slate-800">Nanny:</span> ${esc(item.nannyName || '...')}</p>
                    </div>

                    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-3">
                        <div class="mb-2 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Luu tru file PDF hop dong</div>
                        ${hasFile
                            ? `<a href="${esc(fileUrl)}" target="_blank" rel="noopener" class="mb-3 inline-flex items-center justify-center rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-xs font-bold text-orange-600 hover:bg-orange-100">Xem file PDF hop dong da luu</a>`
                            : '<p class="mb-3 text-xs font-semibold text-slate-500">Chua co file PDF hop dong nao duoc luu.</p>'}
                        <div class="flex flex-wrap items-center gap-2">
                            <input type="file" accept="application/pdf,.pdf" data-file-input="${esc(item.contractId)}" class="block text-sm text-slate-700" />
                            <button type="button" data-upload-btn="${esc(item.contractId)}"
                                class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-orange-500 to-orange-400 px-4 py-2 text-xs font-extrabold text-white hover:from-orange-600 hover:to-orange-500">
                                Luu hop dong
                            </button>
                        </div>
                        <p class="mt-2 hidden text-xs font-semibold" data-upload-msg="${esc(item.contractId)}"></p>
                    </div>
                </article>`;
            };

            const setMessage = (contractId, text, isError) => {
                const el = document.querySelector(`[data-upload-msg="${contractId}"]`);
                if (!el) return;
                el.textContent = text;
                el.classList.remove('hidden', 'text-emerald-600', 'text-rose-600');
                el.classList.add(isError ? 'text-rose-600' : 'text-emerald-600');
            };

            const bindUploadHandlers = () => {
                document.querySelectorAll('[data-upload-btn]').forEach((btn) => {
                    btn.addEventListener('click', async () => {
                        const contractId = btn.getAttribute('data-upload-btn');
                        const input = document.querySelector(`[data-file-input="${contractId}"]`);
                        if (!input || !input.files || !input.files.length) {
                            setMessage(contractId, 'Vui long chon file PDF hop dong.', true);
                            return;
                        }

                        const file = input.files[0];
                        const fileName = String(file.name || '').toLowerCase();
                        const isPdfByType = file.type === 'application/pdf';
                        const isPdfByExt = fileName.endsWith('.pdf');
                        if (!isPdfByType && !isPdfByExt) {
                            setMessage(contractId, 'Chi chap nhan file PDF.', true);
                            return;
                        }

                        const formData = new FormData();
                        formData.append('contractFile', file);

                        btn.disabled = true;
                        const original = btn.textContent;
                        btn.textContent = 'Dang luu...';
                        setMessage(contractId, '', false);

                        try {
                            const response = await fetch(`/Contract/Api/${contractId}/UploadStorageFile`, {
                                method: 'POST',
                                body: formData,
                                credentials: 'include'
                            });
                            const json = await response.json();

                            if (!response.ok || !json?.success) {
                                setMessage(contractId, json?.message || 'Khong luu duoc file PDF hop dong.', true);
                                return;
                            }

                            setMessage(contractId, 'Luu hop dong thanh cong.', false);
                            loadData();
                        } catch {
                            setMessage(contractId, 'Loi ket noi. Vui long thu lai.', true);
                        } finally {
                            btn.disabled = false;
                            btn.textContent = original;
                        }
                    });
                });
            };

            const loadData = () => {
                fetch('/Contract/Api/List', { credentials: 'include' })
                    .then(async (res) => {
                        const json = await res.json();
                        if (!res.ok || !json?.success) {
                            throw new Error(json?.message || 'Không thể tải danh sách hợp đồng.');
                        }

                        const items = toFlatList(json.data);
                        if (!items.length) {
                            stateEl.classList.remove('hidden');
                            stateEl.textContent = 'Chưa có hợp đồng nào để quản lý.';
                            listEl.classList.add('hidden');
                            return;
                        }

                        listEl.innerHTML = items.map(renderItem).join('');
                        stateEl.classList.add('hidden');
                        listEl.classList.remove('hidden');
                        bindUploadHandlers();
                    })
                    .catch((err) => {
                        stateEl.classList.remove('hidden');
                        stateEl.textContent = `Không thể tải danh sách hợp đồng: ${String(err?.message || 'Unknown error')}`;
                        listEl.classList.add('hidden');
                    });
            };

            loadData();
        })();
    </script>
}
