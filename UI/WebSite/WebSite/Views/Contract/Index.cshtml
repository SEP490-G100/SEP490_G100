@{
    ViewData["Title"] = "Hợp đồng của tôi";
}

<section class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="border-b border-orange-100 px-5 py-5 md:px-7">
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Hợp đồng</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">Hợp đồng của tôi</h1>
            <p class="mt-1 text-sm text-slate-500">Quản lý hợp đồng đang chờ, đang hoạt động và lịch sử.</p>
        </div>

        <div class="px-5 pt-5 md:px-7">
            <div class="inline-flex rounded-2xl border border-orange-100 bg-orange-50 p-1">
                <button type="button" class="contract-tab active" data-tab="active">Đang hoạt động (<span id="countActive">0</span>)</button>
                <button type="button" class="contract-tab" data-tab="pending">Đang chờ (<span id="countPending">0</span>)</button>
                <button type="button" class="contract-tab" data-tab="history">Lịch sử (<span id="countHistory">0</span>)</button>
            </div>
        </div>

        <div class="px-5 pb-6 pt-5 md:px-7">
            <div id="contractLoadState" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                Đang tải danh sách hợp đồng...
            </div>
            <div id="activePanel" class="contract-panel hidden"></div>
            <div id="pendingPanel" class="contract-panel hidden"></div>
            <div id="historyPanel" class="contract-panel hidden"></div>
        </div>
    </div>
</section>

<style>
    .contract-tab {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 800;
        color: #9a3412;
        transition: all .2s ease;
    }

    .contract-tab.active {
        background: #ffffff;
        color: #c2410c;
        box-shadow: 0 8px 18px rgba(249, 115, 22, .15);
    }

    .contract-panel {
        display: grid;
        gap: 12px;
    }

    .contract-card {
        border: 1px solid #fed7aa;
        background: linear-gradient(180deg, #fff 0%, #fffbf6 100%);
        border-radius: 18px;
        padding: 14px;
        box-shadow: 0 10px 20px rgba(15,23,42,.05);
    }

    .contract-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 800;
    }

    .contract-badge.active { background: #dcfce7; color: #166534; }
    .contract-badge.pending { background: #fef3c7; color: #92400e; }
    .contract-badge.history { background: #e2e8f0; color: #334155; }
</style>

@section Scripts {
    <script>
        (() => {
            const stateEl = document.getElementById('contractLoadState');
            const panels = {
                active: document.getElementById('activePanel'),
                pending: document.getElementById('pendingPanel'),
                history: document.getElementById('historyPanel')
            };
            const tabs = Array.from(document.querySelectorAll('.contract-tab'));
            const countEl = {
                active: document.getElementById('countActive'),
                pending: document.getElementById('countPending'),
                history: document.getElementById('countHistory')
            };

            const fmtDate = (value) => value ? new Date(value + 'T00:00:00').toLocaleDateString('vi-VN') : 'Chưa xác định';
            const esc = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            function badgeHtmlByStatus(status) {
                if (status === 1) return '<span class="contract-badge active">Đang hoạt động</span>';
                if (status === 0) return '<span class="contract-badge pending">Đang chờ bảo mẫu xác nhận</span>';
                return '<span class="contract-badge history">Lịch sử</span>';
            }

            function renderCards(container, list) {
                if (!Array.isArray(list) || !list.length) {
                    container.innerHTML = `
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                            Chưa có hợp đồng trong mục này.
                        </div>`;
                    return;
                }

                container.innerHTML = list.map((item) => {
                    const isDirectContactHire = String(item.jobTitle || '').toLowerCase() === 'thue nanny truc tiep';
                    const titleText = isDirectContactHire ? 'Hợp đồng từ yêu cầu liên hệ' : (item.jobTitle || 'Công việc');
                    const signBadge = item.signedByParent && item.signedByNanny
                        ? '<span class="contract-badge active">Đã ký 2 bên</span>'
                        : '<span class="contract-badge pending">Chờ ký hoàn tất</span>';

                    return `
                        <article class="contract-card">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <p class="text-sm font-extrabold text-slate-800">${esc(titleText)}</p>
                                    <p class="mt-1 text-xs font-semibold text-slate-500">${fmtDate(item.startDate)} - ${fmtDate(item.endDate)}</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    ${badgeHtmlByStatus(Number(item.hiringStatus))}
                                    ${signBadge}
                                </div>
                            </div>
                            <div class="mt-3 flex items-center justify-end">
                                <a href="/Contract/Detail/${item.contractId}" class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 px-4 py-2 text-xs font-extrabold text-white shadow-sm hover:from-orange-600 hover:to-orange-500">
                                    Xem chi tiết
                                </a>
                            </div>
                        </article>`;
                }).join('');
            }

            function switchTab(tab) {
                tabs.forEach((btn) => btn.classList.toggle('active', btn.dataset.tab === tab));
                Object.keys(panels).forEach((name) => {
                    panels[name].classList.toggle('hidden', name !== tab);
                });
            }

            tabs.forEach((btn) => {
                btn.addEventListener('click', () => switchTab(btn.dataset.tab));
            });

            fetch('/Contract/Api/List', { credentials: 'include' })
                .then(async (res) => {
                    const json = await res.json();
                    if (!res.ok || !json?.success) throw new Error(json?.message || 'Không tải được danh sách hợp đồng.');
                    const data = json.data || {};

                    const active = Array.isArray(data.active) ? data.active : [];
                    const pending = Array.isArray(data.pending) ? data.pending : [];
                    const history = Array.isArray(data.history) ? data.history : [];

                    countEl.active.textContent = String(active.length);
                    countEl.pending.textContent = String(pending.length);
                    countEl.history.textContent = String(history.length);

                    renderCards(panels.active, active);
                    renderCards(panels.pending, pending);
                    renderCards(panels.history, history);

                    stateEl.classList.add('hidden');
                    panels.active.classList.remove('hidden');
                    switchTab('active');
                })
                .catch((err) => {
                    stateEl.classList.remove('hidden');
                    const msg = String(err?.message || '').trim();
                    const hasVi = /[àáảãạăằắẳẵặâầấẩẫậèéẻẽẹêềếểễệìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵđ]/i.test(msg);
                    stateEl.textContent = hasVi
                        ? `Không tải được danh sách hợp đồng: ${msg}`
                        : 'Không tải được danh sách hợp đồng. Vui lòng thử lại sau.';
                });
        })();
    </script>
}
