@model WebSite.Models.Contract.ContractDetailPageViewModel
@{
    ViewData["Title"] = "Chi tiet hop dong";
}

<section class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-orange-100 px-5 py-5 md:px-7">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Contract Detail</p>
                <h1 class="mt-1 text-2xl font-bold text-slate-900">Chi tiet hop dong</h1>
            </div>
            <div class="flex items-center gap-2">
                <a href="/Contract" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">Quay lai</a>
                <button type="button" id="printContractBtn" onclick="window.print()" class="hidden inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 px-4 py-2 text-sm font-bold text-white hover:from-orange-600 hover:to-orange-500">In hop dong</button>
            </div>
        </div>

        <div class="px-5 pb-6 pt-5 md:px-7">
            <div id="detailLoadState" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                Dang tai thong tin hop dong...
            </div>

            <div id="detailContent" class="hidden space-y-4">
                <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <p class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Phu huynh</p>
                        <p id="parentName" class="mt-1 text-lg font-bold text-slate-800"></p>
                        <p id="parentPhone" class="mt-1 text-sm text-slate-600"></p>
                        <p id="parentEmail" class="mt-1 text-sm text-slate-600"></p>
                        <p id="parentAddress" class="mt-1 text-sm text-slate-600"></p>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <p class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Bao mau</p>
                        <p id="nannyName" class="mt-1 text-lg font-bold text-slate-800"></p>
                        <p id="nannyPhone" class="mt-1 text-sm text-slate-600"></p>
                        <p id="nannyEmail" class="mt-1 text-sm text-slate-600"></p>
                        <p id="nannyAddress" class="mt-1 text-sm text-slate-600"></p>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span id="hiringStatus" class="detail-badge"></span>
                        <span id="signStatus" class="detail-badge"></span>
                    </div>
                    <p id="signedAt" class="mt-2 text-sm font-semibold text-slate-600"></p>
                    <p id="jobMeta" class="mt-1 text-sm text-slate-600"></p>
                </div>

                <div class="rounded-2xl border border-orange-100 bg-orange-50/30 p-4">
                    <p class="text-xs font-extrabold uppercase tracking-wider text-orange-500">Noi dung hop dong</p>
                    <div id="contractContent" class="mt-3 prose max-w-none text-sm text-slate-700"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .detail-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 800;
        background: #e2e8f0;
        color: #334155;
    }

    @@media print {
        nav,
        footer,
        .sticky,
        button,
        a {
            display: none !important;
        }

        body {
            background: #fff !important;
        }

        #detailContent {
            display: block !important;
        }
    }
</style>

@section Scripts {
    <script>
        (() => {
            const contractId = '@Model.ContractId';
            const loadState = document.getElementById('detailLoadState');
            const detailContent = document.getElementById('detailContent');

            const fmtDate = (value) => value ? new Date(value).toLocaleString('vi-VN') : 'Chua xac dinh';
            const fmtDateOnly = (value) => value ? new Date(value + 'T00:00:00').toLocaleDateString('vi-VN') : 'Chua xac dinh';
            const esc = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const hiringStatusText = (status) => {
                if (status === 1) return 'Dang hoat dong';
                if (status === 0) return 'Dang cho';
                if (status === 2) return 'Da tu choi';
                if (status === 3) return 'Da huy';
                if (status === 4) return 'Da hoan thanh';
                return 'Khong xac dinh';
            };

            fetch(`/Contract/Api/Detail/${contractId}`, { credentials: 'include' })
                .then(async (res) => {
                    const json = await res.json();
                    if (!res.ok || !json?.success) throw new Error(json?.message || 'Khong tai duoc hop dong.');
                    const d = json.data || {};

                    document.getElementById('parentName').textContent = d.parentName || '-';
                    document.getElementById('parentPhone').textContent = `SDT: ${d.parentPhone || '-'}`;
                    document.getElementById('parentEmail').textContent = `Email: ${d.parentEmail || '-'}`;
                    document.getElementById('parentAddress').textContent = `Dia chi: ${d.parentAddress || '-'}`;

                    document.getElementById('nannyName').textContent = d.nannyName || '-';
                    document.getElementById('nannyPhone').textContent = `SDT: ${d.nannyPhone || '-'}`;
                    document.getElementById('nannyEmail').textContent = `Email: ${d.nannyEmail || '-'}`;
                    document.getElementById('nannyAddress').textContent = `Dia chi: ${d.nannyAddress || '-'}`;

                    document.getElementById('hiringStatus').textContent = hiringStatusText(Number(d.hiringStatus));
                    document.getElementById('signStatus').textContent = (d.signedByParent && d.signedByNanny) ? 'Da ky 2 ben' : 'Cho ky hoan tat';
                    document.getElementById('signedAt').textContent = `Ngay ky: ${fmtDate(d.signedAt)}`;
                    const isDirectContactHire = String(d.jobTitle || '').toLowerCase() === 'thue nanny truc tiep';
                    document.getElementById('jobMeta').textContent = isDirectContactHire
                        ? `${fmtDateOnly(d.startDate)} - ${fmtDateOnly(d.endDate)}`
                        : `${d.jobTitle || '-'} | ${fmtDateOnly(d.startDate)} - ${fmtDateOnly(d.endDate)}`;
                    document.getElementById('printContractBtn')?.classList.toggle('hidden', !d.signedByNanny);

                    document.getElementById('contractContent').innerHTML = d.contractContent || '<p>Chua co noi dung hop dong.</p>';

                    loadState.classList.add('hidden');
                    detailContent.classList.remove('hidden');
                })
                .catch((err) => {
                    loadState.classList.remove('hidden');
                    loadState.textContent = `Khong tai duoc hop dong: ${err.message || 'Unknown error'}`;
                    detailContent.classList.add('hidden');
                });
        })();
    </script>
}
