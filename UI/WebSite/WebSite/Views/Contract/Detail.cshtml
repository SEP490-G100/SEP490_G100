@model WebSite.Models.Contract.ContractDetailPageViewModel
@{
    ViewData["Title"] = "Chi tiết hợp đồng";
}

<section class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-orange-100 px-5 py-5 md:px-7">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Chi tiết hợp đồng</p>
                <h1 class="mt-1 text-2xl font-bold text-slate-900">Chi tiết hợp đồng</h1>
            </div>
            <div class="flex items-center gap-2">
                <a href="/Contract" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">Quay lại</a>
                <button type="button" id="printContractBtn" onclick="window.print()" class="hidden inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 px-4 py-2 text-sm font-bold text-white hover:from-orange-600 hover:to-orange-500">In hợp đồng</button>
            </div>
        </div>

        <div class="px-5 pb-6 pt-5 md:px-7">
            <div id="detailLoadState" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                Đang tải thông tin hợp đồng...
            </div>

            <div id="detailContent" class="hidden space-y-4">
                <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <p class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Phụ huynh</p>
                        <p id="parentName" class="mt-1 text-lg font-bold text-slate-800"></p>
                        <p id="parentPhone" class="mt-1 text-sm text-slate-600"></p>
                        <p id="parentEmail" class="mt-1 text-sm text-slate-600"></p>
                        <p id="parentAddress" class="mt-1 text-sm text-slate-600"></p>
                    </div>
                    <div class="rounded-2xl border border-slate-200 bg-white p-4">
                        <p class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Bảo mẫu</p>
                        <p id="nannyName" class="mt-1 text-lg font-bold text-slate-800"></p>
                        <p id="nannyPhone" class="mt-1 text-sm text-slate-600"></p>
                        <p id="nannyEmail" class="mt-1 text-sm text-slate-600"></p>
                        <p id="nannyAddress" class="mt-1 text-sm text-slate-600"></p>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <span id="hiringStatus" class="detail-badge"></span>
                        <span id="signStatus" class="detail-badge"></span>
                    </div>
                    <p id="signedAt" class="mt-2 text-sm font-semibold text-slate-600"></p>
                    <p id="jobMeta" class="mt-1 text-sm text-slate-600"></p>

                    @* Action row: chi hien voi Parent *@
                    <div id="parentActionRow" class="hidden mt-4 flex flex-wrap items-center gap-3">
                        <button type="button" id="completeBtn"
                                class="hidden inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all"
                                style="background: linear-gradient(135deg, #22c55e, #16a34a);">
                            <span class="material-icons-round text-base">check_circle</span>
                            Hoàn thành hợp đồng
                        </button>
                        <p id="pendingNote" class="hidden text-sm font-semibold text-amber-600"></p>
                        <p id="completeError" class="hidden w-full text-sm font-semibold text-rose-600"></p>
                    </div>
                </div>

                <div class="rounded-2xl border border-orange-100 bg-orange-50/30 p-4">
                    <p class="text-xs font-extrabold uppercase tracking-wider text-orange-500">Nội dung hợp đồng</p>
                    <div id="contractContent" class="mt-3 prose max-w-none text-sm text-slate-700"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .detail-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 800;
        background: #e2e8f0;
        color: #334155;
    }

    @@media print {
        nav,
        footer,
        .sticky,
        button,
        a {
            display: none !important;
        }

        body {
            background: #fff !important;
        }

        #detailContent {
            display: block !important;
        }
    }
</style>

@section Scripts {
    <script>
        (() => {
            const contractId = '@Model.ContractId';
            const isParent = @(User.IsInRole("Parent") ? "true" : "false");

            const loadState = document.getElementById('detailLoadState');
            const detailContent = document.getElementById('detailContent');
            const parentActionRow = document.getElementById('parentActionRow');
            const completeBtn = document.getElementById('completeBtn');
            const pendingNote = document.getElementById('pendingNote');
            const completeError = document.getElementById('completeError');

            const fmtDate = (value) => value ? new Date(value).toLocaleString('vi-VN') : 'Chưa xác định';
            const fmtDateOnly = (value) => value ? new Date(value + 'T00:00:00').toLocaleDateString('vi-VN') : 'Chưa xác định';

            const hiringStatusText = (status) => {
                if (status === 1) return 'Đang hoạt động';
                if (status === 0) return 'Đang chờ';
                if (status === 2) return 'Đã từ chối';
                if (status === 3) return 'Đã hủy';
                if (status === 4) return 'Đã hoàn thành';
                return 'Không xác định';
            };

            let currentHiringRecordId = null;

            const renderParentActions = (hiringStatus) => {
                console.log('[Contract Detail] isParent:', isParent, '| hiringRecordId:', currentHiringRecordId, '| hiringStatus:', hiringStatus);

                if (!isParent || !currentHiringRecordId) return;

                parentActionRow.classList.remove('hidden');

                // Reset tất cả trước
                completeBtn.classList.add('hidden');
                pendingNote.classList.add('hidden');
                completeError.classList.add('hidden');

                if (hiringStatus === 1) {
                    // Active: Parent có thể hoàn thành hợp đồng
                    completeBtn.classList.remove('hidden');
                } else if (hiringStatus === 0) {
                    // Pending: nanny chưa xác nhận, hiện ghi chú
                    pendingNote.textContent = '⏳ Đang chờ nanny xác nhận. Nút "Hoàn thành" sẽ hiện sau khi nanny chấp nhận hợp đồng.';
                    pendingNote.classList.remove('hidden');
                } else {
                    // Declined / Cancelled: ẩn toàn bộ row
                    parentActionRow.classList.add('hidden');
                }
            };

            fetch(`/Contract/Api/Detail/${contractId}`, { credentials: 'include' })
                .then(async (res) => {
                    const json = await res.json();
                    if (!res.ok || !json?.success) throw new Error(json?.message || 'Không tải được hợp đồng.');
                    const d = json.data || {};

                    currentHiringRecordId = d.hiringRecordId;

                    document.getElementById('parentName').textContent = d.parentName || '-';
                    document.getElementById('parentPhone').textContent = `SĐT: ${d.parentPhone || '-'}`;
                    document.getElementById('parentEmail').textContent = `Email: ${d.parentEmail || '-'}`;
                    document.getElementById('parentAddress').textContent = `Địa chỉ: ${d.parentAddress || '-'}`;

                    document.getElementById('nannyName').textContent = d.nannyName || '-';
                    document.getElementById('nannyPhone').textContent = `SĐT: ${d.nannyPhone || '-'}`;
                    document.getElementById('nannyEmail').textContent = `Email: ${d.nannyEmail || '-'}`;
                    document.getElementById('nannyAddress').textContent = `Địa chỉ: ${d.nannyAddress || '-'}`;

                    const hs = Number(d.hiringStatus);
                    document.getElementById('hiringStatus').textContent = hiringStatusText(hs);
                    document.getElementById('signStatus').textContent = (d.signedByParent && d.signedByNanny) ? 'Đã ký 2 bên' : 'Chờ ký hoàn tất';
                    document.getElementById('signedAt').textContent = `Ngày ký: ${fmtDate(d.signedAt)}`;
                    const isDirectContactHire = String(d.jobTitle || '').toLowerCase() === 'thue nanny truc tiep';
                    document.getElementById('jobMeta').textContent = isDirectContactHire
                        ? `${fmtDateOnly(d.startDate)} - ${fmtDateOnly(d.endDate)}`
                        : `${d.jobTitle || '-'} | ${fmtDateOnly(d.startDate)} - ${fmtDateOnly(d.endDate)}`;
                    document.getElementById('printContractBtn')?.classList.toggle('hidden', !d.signedByNanny);

                    document.getElementById('contractContent').innerHTML = d.contractContent || '<p>Chưa có nội dung hợp đồng.</p>';

                    renderParentActions(hs);

                    loadState.classList.add('hidden');
                    detailContent.classList.remove('hidden');
                })
                .catch((err) => {
                    loadState.classList.remove('hidden');
                    loadState.textContent = `Không tải được hợp đồng: ${err.message || 'Lỗi không xác định'}`;
                    detailContent.classList.add('hidden');
                });

            // Xử lý nút "Hoàn thành hợp đồng"
            completeBtn?.addEventListener('click', async () => {
                if (!currentHiringRecordId) return;

                completeBtn.disabled = true;
                completeBtn.textContent = 'Đang xử lý...';
                completeError.classList.add('hidden');

                try {
                    const res = await fetch(`/Hiring/Records/${currentHiringRecordId}/Complete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include'
                    });
                    const json = await res.json();

                    if (!json.success) {
                        completeError.textContent = json.message || 'Có lỗi xảy ra.';
                        completeError.classList.remove('hidden');
                        return;
                    }

                    window.location.href = `/Contract/Detail/${contractId}`;
                } catch {
                    completeError.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
                    completeError.classList.remove('hidden');
                } finally {
                    completeBtn.disabled = false;
                    completeBtn.innerHTML = '<span class="material-icons-round text-base">check_circle</span> Hoàn thành hợp đồng';
                }
            });
        })();
    </script>
}
