@model WebSite.Models.Account.AccountDto
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Edit Account";

    var avatarColors = new[] { "#F97316","#3B82F6","#8B5CF6","#10B981","#F59E0B" };
    var avatarBg = avatarColors[Math.Abs(Model.Id.GetHashCode()) % avatarColors.Length];
    var statusLabel = Model.Status == 1 ? "Active" : "Inactive";
    var genderLabel = Model.Gender switch { 1 => "Male", 2 => "Female", _ => "Not specified" };
    var fullAddress = string.Join(", ", new[] { Model.Address, Model.Ward, Model.District, Model.City }
                         .Where(s => !string.IsNullOrWhiteSpace(s)));
}

<!-- ====================================================
     PAGE HEADER
     ==================================================== -->
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">👤 Account Management</span>
        <h1 class="page-title mt-2">
            Edit <span class="gradient-text">Account</span>
        </h1>
        <p class="page-subtitle">View account details and update allowed fields.</p>
    </div>
    <a href="/Moderator/ManageAccount" class="btn-outline flex-shrink-0">
        <span class="material-icons-round text-base">arrow_back</span>
        Back to List
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<form method="post" action="/Moderator/EditAccount/@Model.Id" onsubmit="return validateForm()">
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- =============================================
             LEFT PANEL — Detail fields (2 / 3 width)
             ============================================= -->
        <div class="xl:col-span-2 space-y-5">

            <!-- ── Identity Info (Read-only) ── -->
            <div class="content-card p-0 fade-in-up">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">person</span>
                        <h2>Identity Information <span class="text-xs text-gray-400 font-normal ml-1">(read-only)</span></h2>
                    </div>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">

                    <!-- Email -->
                    <div class="field-group sm:col-span-2">
                        <label class="field-label">Email</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">email</span>
                            @Model.Email
                            @if (!Model.EmailConfirmed)
                            {
                                <span class="ml-2 text-[10px] text-amber-600 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded-full">Unverified</span>
                            }
                        </div>
                    </div>

                    <!-- First Name -->
                    <div class="field-group">
                        <label class="field-label">First Name</label>
                        <div class="field-readonly">@(Model.FirstName.Length > 0 ? Model.FirstName : "—")</div>
                    </div>

                    <!-- Last Name -->
                    <div class="field-group">
                        <label class="field-label">Last Name</label>
                        <div class="field-readonly">@(Model.LastName.Length > 0 ? Model.LastName : "—")</div>
                    </div>

                    <!-- Date of Birth -->
                    <div class="field-group">
                        <label class="field-label">Date of Birth</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">cake</span>
                            @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "—")
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="field-group">
                        <label class="field-label">Gender</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">wc</span>
                            @genderLabel
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="field-group sm:col-span-2">
                        <label class="field-label">Address</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">location_on</span>
                            @(string.IsNullOrWhiteSpace(fullAddress) ? "—" : fullAddress)
                        </div>
                    </div>

                </div>
            </div>

            <!-- ── Role & Account Status (Moderator editable) ── -->
            <div class="content-card p-0 fade-in-up" style="animation-delay:.05s;">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">manage_accounts</span>
                        <h2>Account Settings <span class="text-xs text-green-500 font-semibold ml-1">✏️ editable</span></h2>
                    </div>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">

                    <!-- Role (read-only) -->
                    <div class="field-group">
                        <label class="field-label">Role</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">badge</span>
                            @foreach (var r in Model.Roles)
                            {
                                var rb = r switch { "Parent" => "badge-parent", "Nanny" => "badge-nanny", _ => "badge-mod" };
                                <span class="badge @rb">@r</span>
                            }
                        </div>
                    </div>

                    <!-- Phone Number (editable) -->
                    <div class="field-group">
                        <label class="field-label">
                            Phone Number
                            <span class="text-orange-400 text-[10px] ml-1">✏️</span>
                        </label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-base pointer-events-none">phone</span>
                            <input id="phoneInput" name="PhoneNumber" type="tel"
                                   value="@Model.PhoneNumber"
                                   placeholder="Enter phone number (10–11 digits)"
                                   pattern="^[0-9]{10,11}$"
                                   maxlength="11"
                                   oninput="validatePhone(this)"
                                   class="search-input !pl-9 w-full" />
                        </div>
                        <p id="phone-error" class="text-xs text-red-500 mt-1 hidden">
                            Phone number must be 10–11 digits (numbers only).
                        </p>
                    </div>

                    <!-- Status (editable) -->
                    <div class="field-group sm:col-span-2">
                        <label class="field-label">
                            Account Status
                            <span class="text-orange-400 text-[10px] ml-1">✏️</span>
                        </label>
                        <div class="flex gap-3">
                            <label class="flex items-center gap-2.5 px-4 py-3 rounded-2xl border-2 cursor-pointer transition-all @(Model.Status == 1 ? "border-emerald-400 bg-emerald-50" : "border-gray-200 bg-gray-50 hover:border-gray-300")"
                                   id="label-active">
                                <input type="radio" name="Status" value="1"
                                       @(Model.Status == 1 ? "checked" : "")
                                       class="accent-emerald-500"
                                       onchange="updateStatusLabel(1)" />
                                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
                                <span class="text-sm font-semibold text-gray-700">Active</span>
                            </label>
                            <label class="flex items-center gap-2.5 px-4 py-3 rounded-2xl border-2 cursor-pointer transition-all @(Model.Status == 0 ? "border-red-400 bg-red-50" : "border-gray-200 bg-gray-50 hover:border-gray-300")"
                                   id="label-inactive">
                                <input type="radio" name="Status" value="0"
                                       @(Model.Status == 0 ? "checked" : "")
                                       class="accent-red-500"
                                       onchange="updateStatusLabel(0)" />
                                <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                                <span class="text-sm font-semibold text-gray-700">Inactive</span>
                            </label>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ── Audit Info (Read-only) ── -->
            <div class="content-card p-0 fade-in-up" style="animation-delay:.1s;">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">history</span>
                        <h2>Audit Information <span class="text-xs text-gray-400 font-normal ml-1">(read-only)</span></h2>
                    </div>
                </div>
                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="field-group">
                        <label class="field-label">Last Login</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">login</span>
                            @(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("dd MMM yyyy, HH:mm") : "Never")
                        </div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Created At</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">calendar_today</span>
                            @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Created By</label>
                        <div class="field-readonly font-mono text-xs">
                            @(Model.CreatedBy.HasValue ? Model.CreatedBy.Value.ToString() : "System")
                        </div>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Updated At</label>
                        <div class="field-readonly">
                            <span class="material-icons-round text-gray-300 text-base">update</span>
                            @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                        </div>
                    </div>
                    <div class="field-group sm:col-span-2">
                        <label class="field-label">Updated By</label>
                        <div class="field-readonly font-mono text-xs">
                            @(Model.UpdatedBy.HasValue ? Model.UpdatedBy.Value.ToString() : "—")
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- =============================================
             RIGHT PANEL — Avatar + Summary (1 / 3 width)
             ============================================= -->
        <div class="space-y-5">

            <!-- Avatar card -->
            <div class="content-card p-6 text-center fade-in-up" style="animation-delay:.08s;">
                <div class="relative inline-block mb-4">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@Model.FullName"
                             class="w-24 h-24 rounded-full object-cover ring-4 ring-orange-100 shadow-lg mx-auto" />
                    }
                    else
                    {
                        <div class="w-24 h-24 rounded-full flex items-center justify-center text-white text-4xl font-bold ring-4 ring-orange-100 shadow-lg mx-auto"
                             style="background:@avatarBg;">
                            @Model.Avatar
                        </div>
                    }
                    <!-- Status dot -->
                    <div class="absolute bottom-1 right-1 w-5 h-5 rounded-full border-2 border-white @(Model.Status == 1 ? "bg-emerald-400" : "bg-red-400") shadow"></div>
                </div>

                <h3 class="font-bold text-gray-900 text-lg">@Model.FullName</h3>
                <p class="text-sm text-gray-400 mt-0.5">@Model.Email</p>

                <div class="flex flex-wrap gap-1.5 justify-center mt-3">
                    @foreach (var r in Model.Roles)
                    {
                        var rb = r switch { "Parent" => "badge-parent", "Nanny" => "badge-nanny", _ => "badge-mod" };
                        <span class="badge @rb">@r</span>
                    }
                </div>

                <div class="mt-4 pt-4 border-t border-gray-100">
                    <div id="current-status-display"
                         class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold @(Model.Status == 1 ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-700 border border-red-200")">
                        <div id="status-dot" class="w-2 h-2 rounded-full @(Model.Status == 1 ? "bg-emerald-400" : "bg-red-400")"></div>
                        <span id="status-text">@statusLabel</span>
                    </div>
                </div>
            </div>

            <!-- Account ID info -->
            <div class="content-card p-4 fade-in-up" style="animation-delay:.12s;">
                <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold mb-1">Account ID</p>
                <p class="font-mono text-xs text-gray-600 break-all">@Model.Id</p>
            </div>

            <!-- Save / Cancel buttons -->
            <div class="content-card p-4 space-y-2.5 fade-in-up" style="animation-delay:.15s;">
                <button type="submit" class="btn-primary w-full justify-center">
                    <span class="material-icons-round text-base">save</span>
                    Save Changes
                </button>
                <a href="/Moderator/ManageAccount" class="btn-outline w-full justify-center">
                    <span class="material-icons-round text-base">close</span>
                    Cancel
                </a>
            </div>

        </div>
    </div>
</form>

<!-- Inline styles for field groups -->
<style>
.field-group { display: flex; flex-direction: column; gap: .4rem; }
.field-label {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #9CA3AF;
}
.field-readonly {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: #F9FAFB;
    border: 1px solid #F3F4F6;
    border-radius: .85rem;
    padding: .6rem .9rem;
    font-size: .875rem;
    color: #374151;
    min-height: 2.6rem;
}
</style>

@section Scripts {
<script>
function validatePhone(input) {
    var val = input.value.replace(/\D/g, ''); // strip non-digits
    input.value = val;                         // auto-strip letters as user types
    var err = document.getElementById('phone-error');
    if (val.length > 0 && (val.length < 10 || val.length > 11)) {
        err.classList.remove('hidden');
        input.classList.add('!border-red-400');
    } else {
        err.classList.add('hidden');
        input.classList.remove('!border-red-400');
    }
}

function validateForm() {
    var phone = document.getElementById('phoneInput').value;
    if (phone.length > 0 && !/^[0-9]{10,11}$/.test(phone)) {
        document.getElementById('phone-error').classList.remove('hidden');
        document.getElementById('phoneInput').focus();
        return false;
    }
    return true;
}

function updateStatusLabel(val) {
    var display = document.getElementById('current-status-display');
    var dot     = document.getElementById('status-dot');
    var text    = document.getElementById('status-text');
    var avatarDot = document.querySelector('.absolute.bottom-1.right-1');

    if (val === 1) {
        display.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
        dot.className     = 'w-2 h-2 rounded-full bg-emerald-400';
        text.textContent  = 'Active';
        if (avatarDot) avatarDot.className = avatarDot.className.replace('bg-red-400', 'bg-emerald-400');

        document.getElementById('label-active').className   = document.getElementById('label-active').className.replace('border-gray-200 bg-gray-50 hover:border-gray-300', 'border-emerald-400 bg-emerald-50');
        document.getElementById('label-inactive').className = document.getElementById('label-inactive').className.replace('border-red-400 bg-red-50', 'border-gray-200 bg-gray-50 hover:border-gray-300');
    } else {
        display.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold bg-red-50 text-red-700 border border-red-200';
        dot.className     = 'w-2 h-2 rounded-full bg-red-400';
        text.textContent  = 'Inactive';
        if (avatarDot) avatarDot.className = avatarDot.className.replace('bg-emerald-400', 'bg-red-400');

        document.getElementById('label-inactive').className = document.getElementById('label-inactive').className.replace('border-gray-200 bg-gray-50 hover:border-gray-300', 'border-red-400 bg-red-50');
        document.getElementById('label-active').className   = document.getElementById('label-active').className.replace('border-emerald-400 bg-emerald-50', 'border-gray-200 bg-gray-50 hover:border-gray-300');
    }
}
</script>
}
