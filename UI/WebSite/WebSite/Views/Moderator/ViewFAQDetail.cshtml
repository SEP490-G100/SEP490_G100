@model WebSite.Models.FAQ.FaqDto
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "FAQ Detail";
    var statusLabel = Model.IsActive ? "Active" : "Inactive";
}

<!-- PAGE HEADER -->
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">📋 Content Management</span>
        <h1 class="page-title mt-2">FAQ <span class="gradient-text">Detail &amp; Edit</span></h1>
        <p class="page-subtitle">View and update FAQ question and answer.</p>
    </div>
    <a href="/Moderator/ManageFAQ" class="btn-outline flex-shrink-0">
        <span class="material-icons-round text-base">arrow_back</span>
        Back to FAQs
    </a>
</div>

<!-- Global error banner -->
<div id="globalError" class="hidden mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2">
    <span class="material-icons-round text-base">error_outline</span>
    <span id="globalErrorMsg"></span>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<form method="post" action="/Moderator/ViewFAQDetail/@Model.Id" id="faqEditForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- LEFT — Detail fields -->
        <div class="xl:col-span-2 space-y-5">

            <!-- Read-only Info -->
            <div class="content-card p-0 fade-in-up">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">info</span>
                        <h2>FAQ Info <span class="text-xs text-gray-400 font-normal ml-1">(read-only)</span></h2>
                    </div>
                </div>
                <div class="p-5 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <div class="field-group sm:col-span-2">
                            <label class="field-label">FAQ ID</label>
                            <div class="field-readonly font-mono text-xs break-all">@Model.Id</div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Category</label>
                            <div class="field-readonly">
                                <span class="material-icons-round text-gray-300 text-base">label_outline</span>
                                @(string.IsNullOrEmpty(Model.Category) ? "—" : Model.Category)
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Sort Order</label>
                            <div class="field-readonly">
                                <span class="material-icons-round text-gray-300 text-base">sort</span>
                                <span class="font-semibold text-gray-700">@Model.SortOrder</span>
                                <span class="text-xs text-gray-300 ml-1">(read-only)</span>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="field-group">
                            <label class="field-label">View Count</label>
                            <div class="field-readonly">
                                <span class="material-icons-round text-gray-300 text-base">visibility</span>
                                <span class="font-semibold text-gray-700">@Model.ViewCount</span>
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Created At</label>
                            <div class="field-readonly text-xs">
                                <span class="material-icons-round text-gray-300 text-base">calendar_today</span>
                                @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Last Updated</label>
                            <div class="field-readonly text-xs">
                                <span class="material-icons-round text-gray-300 text-base">update</span>
                                @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm") : "Never")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Editable Content -->
            <div class="content-card p-0 fade-in-up" style="animation-delay:.05s;">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">edit</span>
                        <h2>Edit Content <span class="text-xs text-green-500 font-semibold ml-1">✏️ editable</span></h2>
                    </div>
                </div>
                <div class="p-5 space-y-4">

                    <!-- Question -->
                    <div class="field-group">
                        <label class="field-label">
                            Question <span class="text-red-400">*</span>
                            <span class="text-orange-400 text-[10px] ml-1">✏️ editable</span>
                        </label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-3 text-gray-300 text-base pointer-events-none">help_outline</span>
                            <textarea id="questionInput" name="Question" rows="3"
                                      placeholder="Enter the question..."
                                      class="search-input !pl-9 w-full resize-none">@Model.Question</textarea>
                        </div>
                        <p id="questionError" class="hidden text-xs text-red-500 mt-0.5 flex items-center gap-1">
                            <span class="material-icons-round text-xs">error</span>
                            Question không được để trống.
                        </p>
                    </div>

                    <!-- Answer -->
                    <div class="field-group">
                        <label class="field-label">
                            Answer <span class="text-red-400">*</span>
                            <span class="text-orange-400 text-[10px] ml-1">✏️ editable</span>
                        </label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-3 text-gray-300 text-base pointer-events-none">chat_bubble_outline</span>
                            <textarea id="answerInput" name="Answer" rows="7"
                                      placeholder="Enter the answer..."
                                      class="search-input !pl-9 w-full resize-y">@Model.Answer</textarea>
                        </div>
                        <p id="answerError" class="hidden text-xs text-red-500 mt-0.5 flex items-center gap-1">
                            <span class="material-icons-round text-xs">error</span>
                            Answer không được để trống.
                        </p>
                    </div>

                    <!-- Status -->
                    <div class="field-group">
                        <label class="field-label">
                            Status <span class="text-orange-400 text-[10px] ml-1">✏️ editable</span>
                        </label>
                        <div class="flex gap-3">
                            <label class="flex items-center gap-2.5 px-4 py-3 rounded-2xl border-2 cursor-pointer transition-all @(Model.IsActive ? "border-emerald-400 bg-emerald-50" : "border-gray-200 bg-gray-50 hover:border-gray-300")"
                                   id="label-active">
                                <input type="radio" name="IsActive" value="true"
                                       @(Model.IsActive ? "checked" : "") class="accent-emerald-500"
                                       onchange="updateStatusLabel(true)" />
                                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
                                <span class="text-sm font-semibold text-gray-700">Active</span>
                            </label>
                            <label class="flex items-center gap-2.5 px-4 py-3 rounded-2xl border-2 cursor-pointer transition-all @(!Model.IsActive ? "border-gray-400 bg-gray-100" : "border-gray-200 bg-gray-50 hover:border-gray-300")"
                                   id="label-inactive">
                                <input type="radio" name="IsActive" value="false"
                                       @(!Model.IsActive ? "checked" : "") class="accent-gray-500"
                                       onchange="updateStatusLabel(false)" />
                                <div class="w-2.5 h-2.5 rounded-full bg-gray-400"></div>
                                <span class="text-sm font-semibold text-gray-700">Inactive</span>
                            </label>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- RIGHT — Summary + Actions -->
        <div class="space-y-5">

            <!-- FAQ Summary -->
            <div class="content-card p-6 text-center fade-in-up" style="animation-delay:.08s;">
                <div class="w-20 h-20 rounded-full bg-orange-50 flex items-center justify-center text-orange-300 ring-4 ring-orange-100 mb-4 mx-auto shadow-inner">
                    <span class="material-icons-round text-3xl text-orange-400">help_outline</span>
                </div>
                <h3 class="font-bold text-gray-900 text-sm leading-tight px-2">
                    @(Model.Question.Length > 60 ? Model.Question.Substring(0, 60) + "…" : Model.Question)
                </h3>
                <div class="flex flex-wrap gap-1.5 justify-center mt-3">
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-100">@Model.Category</span>
                    }
                    <span class="badge">FAQ #@Model.SortOrder</span>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100">
                    <div id="current-status-display"
                         class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold @(Model.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-gray-100 text-gray-600 border border-gray-200")">
                        <div id="status-dot" class="w-2 h-2 rounded-full @(Model.IsActive ? "bg-emerald-400" : "bg-gray-400")"></div>
                        <span id="status-text">@statusLabel</span>
                    </div>
                </div>
            </div>

            <!-- Audit Info -->
            <div class="content-card p-4 space-y-3 fade-in-up" style="animation-delay:.1s;">
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold mb-0.5">View Count</p>
                    <p class="text-2xl font-bold text-gray-800">@Model.ViewCount</p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold mb-0.5">Sort Order</p>
                    <p class="text-lg font-bold text-gray-700">@Model.SortOrder <span class="text-xs text-gray-400 font-normal">(not editable)</span></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold mb-0.5">Created</p>
                    <p class="text-sm text-gray-600">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                </div>
            </div>

            <!-- Actions -->
            <div class="content-card p-4 space-y-2.5 fade-in-up" style="animation-delay:.15s;">
                <button type="button" onclick="submitEditForm()" class="btn-primary w-full justify-center">
                    <span class="material-icons-round text-base">save</span>
                    Save Changes
                </button>
                <a href="/Moderator/ManageFAQ" class="btn-outline w-full justify-center">
                    <span class="material-icons-round text-base">close</span>
                    Cancel
                </a>
                <hr class="border-gray-100 my-1" />
                <button type="button" onclick="confirmDelete('@Model.Id')" class="btn-danger w-full justify-center">
                    <span class="material-icons-round text-base">delete_forever</span>
                    Delete FAQ
                </button>
            </div>

        </div>
    </div>
</form>

<!-- DELETE MODAL -->
<div id="deleteModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeModal('deleteModal')">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center" style="background:#FEE2E2;">
                <span class="material-icons-round text-2xl" style="color:#EF4444;">delete_forever</span>
            </div>
            <div>
                <h3 class="text-lg font-bold text-gray-900">Delete FAQ Entry</h3>
                <p class="text-sm text-gray-400">Record will be soft-deleted (not removed from database)</p>
            </div>
        </div>
        <p class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed">
            Are you sure you want to delete this FAQ? The entry will be marked as deleted and hidden from users.
        </p>
        <div id="deleteFormContainer" class="flex gap-2"></div>
    </div>
</div>

<style>
.field-group { display:flex; flex-direction:column; gap:.4rem; }
.field-label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#9CA3AF; }
.field-readonly {
    display:flex; align-items:center; gap:.5rem;
    background:#F9FAFB; border:1px solid #F3F4F6;
    border-radius:.85rem; padding:.6rem .9rem;
    font-size:.875rem; color:#374151; min-height:2.6rem;
}
.btn-danger {
    display:inline-flex; align-items:center; gap:.4rem;
    padding:.55rem 1.1rem; border-radius:.85rem;
    font-size:.85rem; font-weight:700; cursor:pointer; transition:all .15s;
    background:#FEE2E2; color:#EF4444; border:1.5px solid #FECACA;
}
.btn-danger:hover { background:#FCA5A5; border-color:#F87171; }
</style>

@section Scripts {
<script>
function setFieldError(inputId, errorId, hasError) {
    var el  = document.getElementById(inputId);
    var err = document.getElementById(errorId);
    if (hasError) {
        el.classList.add('!border-red-400');
        err.classList.remove('hidden');
    } else {
        el.classList.remove('!border-red-400');
        err.classList.add('hidden');
    }
}

function submitEditForm() {
    var q = (document.getElementById('questionInput').value || '').trim();
    var a = (document.getElementById('answerInput').value  || '').trim();

    setFieldError('questionInput','questionError', !q);
    setFieldError('answerInput',  'answerError',   !a);

    if (!q || !a) {
        var msg = !q && !a ? 'Question và Answer không được để trống.'
                : !q ? 'Question không được để trống.'
                :       'Answer không được để trống.';
        document.getElementById('globalErrorMsg').textContent = msg;
        document.getElementById('globalError').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
    }

    document.getElementById('globalError').classList.add('hidden');
    document.getElementById('faqEditForm').submit();
}

// Clear error on input
['questionInput','answerInput'].forEach(function(id) {
    document.getElementById(id).addEventListener('input', function() {
        var errId = id === 'questionInput' ? 'questionError' : 'answerError';
        if (this.value.trim()) setFieldError(id, errId, false);
    });
});

function updateStatusLabel(isActive) {
    var display = document.getElementById('current-status-display');
    var dot     = document.getElementById('status-dot');
    var text    = document.getElementById('status-text');
    var la = document.getElementById('label-active');
    var li = document.getElementById('label-inactive');

    if (isActive) {
        display.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
        dot.className = 'w-2 h-2 rounded-full bg-emerald-400';
        text.textContent = 'Active';
        la.className = la.className.replace('border-gray-200 bg-gray-50 hover:border-gray-300','border-emerald-400 bg-emerald-50');
        li.className = li.className.replace('border-gray-400 bg-gray-100','border-gray-200 bg-gray-50 hover:border-gray-300');
    } else {
        display.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-bold bg-gray-100 text-gray-600 border border-gray-200';
        dot.className = 'w-2 h-2 rounded-full bg-gray-400';
        text.textContent = 'Inactive';
        li.className = li.className.replace('border-gray-200 bg-gray-50 hover:border-gray-300','border-gray-400 bg-gray-100');
        la.className = la.className.replace('border-emerald-400 bg-emerald-50','border-gray-200 bg-gray-50 hover:border-gray-300');
    }
}

function confirmDelete(id) {
    document.getElementById('deleteFormContainer').innerHTML =
        '<button onclick="closeModal(\'deleteModal\')" class="btn-outline flex-1 justify-center">Cancel</button>' +
        '<form method="post" action="/Moderator/DeleteFAQ" class="flex-1 flex">' +
        '@Html.AntiForgeryToken()'.replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&') +
        '<input type="hidden" name="id" value="' + id + '" />' +
        '<button type="submit" class="btn-danger w-full justify-center">Confirm Delete</button>' +
        '</form>';
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
</script>
}
