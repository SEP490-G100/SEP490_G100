@model WebSite.Models.BlogCategory.BlogCategoryDto
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Chi tiết danh mục Blog";
    var nameError = ViewData.ModelState["Name"]?.Errors.Count > 0
        ? ViewData.ModelState["Name"]?.Errors[0].ErrorMessage
        : null;
    var slugError = ViewData.ModelState["Slug"]?.Errors.Count > 0
        ? ViewData.ModelState["Slug"]?.Errors[0].ErrorMessage
        : null;
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">Quản lý nội dung</span>
        <h1 class="page-title mt-2">Danh mục Blog <span class="gradient-text">Chi tiết & Chỉnh sửa</span></h1>
        <p class="page-subtitle">Cập nhật tên danh mục. Đường dẫn sẽ được tự động tạo từ tên.</p>
    </div>
    <a href="/Moderator/ManageBlogCategory" class="btn-outline flex-shrink-0">
        <span class="material-icons-round text-base">arrow_back</span>
        Quay lại danh sách
    </a>
</div>

<form method="post" action="/Moderator/ViewBlogCategoryDetail/@Model.Id" id="catEditForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 space-y-5">
            <div class="content-card p-0 fade-in-up">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-blue-400">info</span>
                        <h2>Thông tin danh mục <span class="text-xs text-gray-400 font-normal ml-1">(chỉ xem)</span></h2>
                    </div>
                </div>
                <div class="p-5 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="field-group sm:col-span-2">
                            <label class="field-label">Mã danh mục</label>
                            <div class="field-readonly font-mono text-xs break-all">@Model.Id</div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Thứ tự</label>
                            <div class="field-readonly">
                                <span class="material-icons-round text-gray-300 text-base">sort</span>
                                <span class="font-semibold text-gray-700">@Model.SortOrder</span>
                                <span class="text-xs text-gray-300 ml-1">(chỉ xem)</span>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="field-group">
                            <label class="field-label">Tổng số bài</label>
                            <div class="field-readonly">
                                <span class="material-icons-round text-gray-300 text-base">article</span>
                                <span class="font-semibold text-gray-700">@Model.BlogCount</span>
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Ngày tạo</label>
                            <div class="field-readonly text-xs">
                                <span class="material-icons-round text-gray-300 text-base">calendar_today</span>
                                @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Ngày cập nhật</label>
                            <div class="field-readonly text-xs">
                                <span class="material-icons-round text-gray-300 text-base">update</span>
                                @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa từng")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-card p-0 fade-in-up" style="animation-delay:.05s;">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-blue-400">edit</span>
                        <h2>Sửa nội dung <span class="text-xs text-green-500 font-semibold ml-1">có thể sửa</span></h2>
                    </div>
                </div>
                <div class="p-5 space-y-4">
                    <div class="field-group">
                        <label class="field-label">
                            Tên <span class="text-red-400">*</span>
                            <span class="text-blue-400 text-[10px] ml-1">có thể sửa</span>
                        </label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-base pointer-events-none">label</span>
                            <input id="nameInput" name="Name" type="text"
                                   value="@Model.Name"
                                   placeholder="VD: Nuôi dạy con"
                                   class="search-input !pl-9 w-full @(!string.IsNullOrWhiteSpace(nameError) ? "!border-red-400" : "")" />
                        </div>
                        <p id="nameError" class="text-xs text-red-500 mt-0.5 flex items-center gap-1 @((string.IsNullOrWhiteSpace(nameError) ? "hidden" : ""))">
                            <span class="material-icons-round text-xs">error</span>
                            @(nameError ?? "Vui lòng nhập tên danh mục.")
                        </p>
                    </div>

                    <div class="field-group">
                        <label class="field-label">
                            Đường dẫn <span class="text-red-400">*</span>
                            <span class="text-gray-400 text-[10px] ml-1">tự động tạo từ tên</span>
                        </label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-base pointer-events-none">link</span>
                            <input id="slugInput" name="Slug" type="text"
                                   value="@Model.Slug"
                                   placeholder="VD: nuoi-day-con"
                                   class="search-input !pl-9 w-full bg-gray-50 text-gray-500 @(!string.IsNullOrWhiteSpace(slugError) ? "!border-red-400" : "")"
                                   readonly />
                        </div>
                        <p id="slugError" class="text-xs text-red-500 mt-0.5 flex items-center gap-1 @((string.IsNullOrWhiteSpace(slugError) ? "hidden" : ""))">
                            <span class="material-icons-round text-xs">error</span>
                            @(slugError ?? "Vui lòng nhập đường dẫn.")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-5">
            <div class="content-card p-6 text-center fade-in-up" style="animation-delay:.08s;">
                <div class="w-20 h-20 rounded-full bg-blue-50 flex items-center justify-center mx-auto mb-4 ring-4 ring-blue-100">
                    <span class="material-icons-round text-3xl text-blue-400">category</span>
                </div>
                <h3 id="summaryName" class="font-bold text-gray-900 text-sm leading-tight px-2">@Model.Name</h3>
                <p id="summarySlug" class="text-xs text-gray-400 mt-1 font-mono">@Model.Slug</p>
                <div class="mt-3 pt-3 border-t border-gray-100">
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-50 text-orange-500 border border-orange-100">
                        @Model.BlogCount bài viết
                    </span>
                </div>
            </div>

            <div class="content-card p-4 space-y-3 fade-in-up" style="animation-delay:.1s;">
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold mb-0.5">Thứ tự ưu tiên</p>
                    <p class="text-lg font-bold text-gray-700">@Model.SortOrder <span class="text-xs text-gray-400 font-normal">(không thể sửa)</span></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-wide font-semibold mb-0.5">Ngày tạo</p>
                    <p class="text-sm text-gray-600">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <div class="content-card p-4 space-y-2.5 fade-in-up" style="animation-delay:.15s;">
                <button type="button" onclick="submitEditForm()" class="btn-primary w-full justify-center">
                    <span class="material-icons-round text-base">save</span>
                    Lưu thay đổi
                </button>
                <a href="/Moderator/ManageBlogCategory" class="btn-outline w-full justify-center">
                    <span class="material-icons-round text-base">close</span>
                    Hủy
                </a>
            </div>
        </div>
    </div>
</form>

<style>
.field-group { display:flex; flex-direction:column; gap:.4rem; }
.field-label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#9CA3AF; }
.field-readonly {
    display:flex; align-items:center; gap:.5rem;
    background:#F9FAFB; border:1px solid #F3F4F6;
    border-radius:.85rem; padding:.6rem .9rem;
    font-size:.875rem; color:#374151; min-height:2.6rem;
}
</style>

@section Scripts {
<script>
function slugify(text) {
    return (text || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .replace(/-{2,}/g, '-');
}

function syncSlugFromName() {
    var name = document.getElementById('nameInput').value || '';
    var slug = slugify(name);
    document.getElementById('slugInput').value = slug;
    document.getElementById('summaryName').textContent = name.trim() || '@Model.Name';
    document.getElementById('summarySlug').textContent = slug || '@Model.Slug';
}

function setErr(inputId, errId, hasError) {
    var el = document.getElementById(inputId);
    var err = document.getElementById(errId);
    if (hasError) {
        el.classList.add('!border-red-400');
        err.classList.remove('hidden');
    } else {
        el.classList.remove('!border-red-400');
        err.classList.add('hidden');
    }
}

function submitEditForm() {
    syncSlugFromName();

    var name = (document.getElementById('nameInput').value || '').trim();
    var slug = (document.getElementById('slugInput').value || '').trim();

    setErr('nameInput', 'nameError', !name);
    setErr('slugInput', 'slugError', !slug);

    if (!name || !slug) {
        return;
    }

    document.getElementById('catEditForm').submit();
}

document.getElementById('nameInput').addEventListener('input', function() {
    syncSlugFromName();
    if (this.value.trim()) {
        setErr('nameInput', 'nameError', false);
    }
    if (document.getElementById('slugInput').value.trim()) {
        setErr('slugInput', 'slugError', false);
    }
});

syncSlugFromName();
</script>
}
