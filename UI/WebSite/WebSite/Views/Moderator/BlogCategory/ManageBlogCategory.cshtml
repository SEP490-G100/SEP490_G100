@model WebSite.Models.BlogCategory.BlogCategoryListResponse
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Manage Blog Categories";
    var currentSearch   = ViewBag.Search    as string ?? "";
    var currentIsDeleted = ViewBag.IsDeleted as string ?? "";
    var currentPage     = Model?.Page       ?? 1;
    var totalPages      = Model?.TotalPages  ?? 1;
    var cats            = Model?.Items       ?? new List<WebSite.Models.BlogCategory.BlogCategoryDto>();
}

<!-- PAGE HEADER -->
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <h1 class="page-title mt-2">
            Manage <span class="gradient-text">Blog Categories</span>
        </h1>
        <p class="page-subtitle">Create, update or remove blog category entries.</p>
    </div>
    <a href="/Moderator/CreateBlogCategory" class="btn-primary flex-shrink-0">
        <span class="material-icons-round text-base">add_circle_outline</span>
        Add New Category
    </a>
</div>

<!-- Alerts -->
@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
<!-- FILTER -->
<form method="get" action="/Moderator/ManageBlogCategory">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Search by name or slug..."
                       class="search-input pl-9 w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>
            <!-- Status Filter -->
            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                <select name="isDeleted" onchange="this.form.submit()"
                        class="search-input md:w-40 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Status</option>
                    <option value="false" selected="@(currentIsDeleted == "false" ? "selected" : null)">Active</option>
                    <option value="true"  selected="@(currentIsDeleted == "true"  ? "selected" : null)">Inactive</option>
                </select>
            </div>
            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Search
            </button>
        </div>
    </div>
</form>

<!-- TABLE -->
<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
    <div class="card-header">
        <span class="text-sm text-gray-500">
            Showing <span class="font-bold text-gray-800">@cats.Count</span>
            of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> categories
        </span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Name</th>
                    <th class="text-left">Slug</th>
                    <th class="text-center">Order</th>
                    <th class="text-center">Blogs</th>
                    <th class="text-center">Status</th>
                    <th class="text-left">Created</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!cats.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">category</span>
                            <p class="font-semibold text-gray-400">No blog categories found.</p>
                            <p class="text-xs text-gray-300 mt-1">Try adjusting your search or create a new category.</p>
                        </td>
                    </tr>
                }
                @{ int rowNum = ((currentPage - 1) * 3) + 1; }
                @foreach (var cat in cats)
                {
                    var shortSlug = cat.Slug.Length > 40 ? cat.Slug.Substring(0, 40) + "…" : cat.Slug;
                    var escapedName = cat.Name.Replace("'", "\\'").Replace("\"", "&quot;");
                    var shortName = escapedName.Length > 40 ? escapedName.Substring(0, 40) + "…" : escapedName;

                    <tr class="account-row">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
                                    <span class="material-icons-round text-blue-400 text-sm">category</span>
                                </div>
                                <span class="font-semibold text-gray-800 text-sm">@cat.Name</span>
                            </div>
                        </td>
                        <td class="text-gray-500 text-xs font-mono" title="@cat.Slug">@shortSlug</td>
                        <td class="text-center text-gray-400 text-xs font-mono">@cat.SortOrder</td>
                        <td class="text-center">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-50 text-orange-500 border border-orange-100">@cat.BlogCount</span>
                        </td>
                        <td class="text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <div class="w-2 h-2 rounded-full @(cat.IsDeleted ? "bg-red-400 ring-2 ring-red-100" : "bg-emerald-400 ring-2 ring-emerald-100")"></div>
                                <span class="badge @(cat.IsDeleted ? "badge-inactive" : "badge-active")">@(cat.IsDeleted ? "Inactive" : "Active")</span>
                            </div>
                        </td>
                        <td class="text-gray-500 text-xs">@cat.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <a href="/Moderator/ViewBlogCategoryDetail/@cat.Id" title="View &amp; Edit"
                                   class="w-8 h-8 rounded-xl hover:bg-blue-50 hover:text-blue-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-blue-200">
                                    <span class="material-icons-round text-base">edit</span>
                                </a>
                                <!-- Toggle Active/Inactive -->
                                @if (!cat.IsDeleted)
                                {
                                    <button onclick="confirmToggle('@cat.Id', '@shortName', false)" title="Deactivate"
                                            class="w-8 h-8 rounded-xl hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-red-200">
                                        <span class="material-icons-round text-base">block</span>
                                    </button>
                                }
                                else
                                {
                                    <button onclick="confirmToggle('@cat.Id', '@shortName', true)" title="Activate"
                                            class="w-8 h-8 rounded-xl hover:bg-emerald-50 hover:text-emerald-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-emerald-200">
                                        <span class="material-icons-round text-base">check_circle_outline</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Page <span class="font-bold text-gray-600">@currentPage</span> of <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&isDeleted=@currentIsDeleted&page=@(currentPage-1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }
            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&isDeleted=@currentIsDeleted&page=@p" class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }
            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&isDeleted=@currentIsDeleted&page=@(currentPage+1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- TOGGLE MODAL -->
<div id="toggleModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeModal('toggleModal')">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="toggleIconBg" class="w-12 h-12 rounded-2xl flex items-center justify-center">
                <span id="toggleIcon" class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="toggleTitle" class="text-lg font-bold text-gray-900"></h3>
                <p id="toggleSubtitle" class="text-sm text-gray-400"></p>
            </div>
        </div>
        <p id="toggleMessage" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed"></p>
        <div id="toggleFormContainer" class="flex gap-2"></div>
    </div>
</div>

@section Scripts {
<form id="csrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
<script>
function confirmToggle(id, name, activate) {
    var title    = activate ? 'Activate Category' : 'Deactivate Category';
    var subtitle = activate ? 'Make category visible to users' : 'Hide category temporarily';
    var msg      = activate ? 'Are you sure you want to activate: <strong>' + name + '</strong>?'
                            : 'Are you sure you want to deactivate: <strong>' + name + '</strong>?';

    document.getElementById('toggleTitle').textContent = title;
    document.getElementById('toggleSubtitle').textContent = subtitle;
    document.getElementById('toggleMessage').innerHTML = msg;

    var iconBg = document.getElementById('toggleIconBg');
    var icon   = document.getElementById('toggleIcon');
    iconBg.style.background = activate ? '#D1FAE5' : '#FEE2E2';
    icon.style.color        = activate ? '#10B981' : '#EF4444';
    icon.textContent        = activate ? 'check_circle_outline' : 'block';

    var btnClass = activate ? 'btn-success' : 'btn-danger';
    var btnText  = activate ? 'Confirm Activate' : 'Confirm Deactivate';

    var token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
    document.getElementById('toggleFormContainer').innerHTML =
        '<button onclick="closeModal(\'toggleModal\')" class="btn-outline flex-1 justify-center">Cancel</button>' +
        '<form method="post" action="/Moderator/ToggleBlogCategoryStatus" class="flex-1 flex">' +
        '<input name="__RequestVerificationToken" type="hidden" value="' + token + '" />' +
        '<input type="hidden" name="id" value="' + id + '" />' +
        '<input type="hidden" name="activate" value="' + (activate ? "true" : "false") + '" />' +
        '<button type="submit" class="' + btnClass + ' w-full justify-center">' + btnText + '</button>' +
        '</form>';
    document.getElementById('toggleModal').classList.remove('hidden');
}
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
</script>
<style>
.btn-danger {
    display:inline-flex; align-items:center; gap:.4rem;
    padding:.55rem 1.1rem; border-radius:.85rem;
    font-size:.85rem; font-weight:700; cursor:pointer; transition:all .15s;
    background:#FEE2E2; color:#EF4444; border:1.5px solid #FECACA;
}
.btn-danger:hover { background:#FCA5A5; border-color:#F87171; }
.btn-success {
    display:inline-flex; align-items:center; gap:.4rem;
    padding:.55rem 1.1rem; border-radius:.85rem;
    font-size:.85rem; font-weight:700; cursor:pointer; transition:all .15s;
    background:#D1FAE5; color:#10B981; border:1.5px solid #A7F3D0;
}
.btn-success:hover { background:#A7F3D0; border-color:#6EE7B7; }
</style>
}
