@model WebSite.Models.FAQ.FaqListResponse
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Manage FAQs";

    var currentSearch   = ViewBag.Search    as string ?? "";
    var currentIsActive = ViewBag.IsActive  as string ?? "";
    var currentCategory = ViewBag.Category  as string ?? "";
    var categories      = ViewBag.Categories as List<string> ?? new List<string>();
    var currentPage     = Model?.Page       ?? 1;
    var totalPages      = Model?.TotalPages  ?? 1;
    var faqs            = Model?.Items       ?? new List<WebSite.Models.FAQ.FaqDto>();
}

<!-- PAGE HEADER -->
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <h1 class="page-title mt-2">
            Manage <span class="gradient-text">FAQs</span>
        </h1>
        <p class="page-subtitle">Create, update or manage frequently asked question entries.</p>
    </div>
    <a href="/Moderator/CreateFAQ" class="btn-primary flex-shrink-0">
        <span class="material-icons-round text-base">add_circle_outline</span>
        Add New FAQ
    </a>
</div>

<!-- Alert messages -->
@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
<!-- FILTER FORM -->
<form method="get" action="/Moderator/ManageFAQ" id="filterForm">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">

            <!-- Search -->
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Search by question, answer or category..."
                       class="search-input pl-9 w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>

            <!-- Category Filter -->
            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">label_outline</span>
                <select name="category" onchange="this.form.submit()"
                        class="search-input md:w-44 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(currentCategory == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                <select name="isActive" onchange="this.form.submit()"
                        class="search-input md:w-36 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Status</option>
                    <option value="true"  selected="@(currentIsActive is "True" or "true"  ? "selected" : null)">Active</option>
                    <option value="false" selected="@(currentIsActive is "False" or "false" ? "selected" : null)">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Search
            </button>
        </div>
    </div>
</form>

<!-- FAQ TABLE -->
<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">

    <div class="card-header">
        <span class="text-sm text-gray-500">
            Showing <span class="font-bold text-gray-800">@faqs.Count</span>
            of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> FAQ entries
        </span>
        <div class="flex items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-emerald-100"></div>Active
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400 ring-2 ring-red-100"></div>Inactive
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Question</th>
                    <th class="text-left">Category</th>
                    <th class="text-center">Order</th>
                    <th class="text-center">Views</th>
                    <th class="text-left">Created</th>
                    <th class="text-left">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!faqs.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">help_outline</span>
                            <p class="font-semibold text-gray-400">No FAQ entries found.</p>
                            <p class="text-xs text-gray-300 mt-1">Try adjusting your filters or create a new FAQ.</p>
                        </td>
                    </tr>
                }
                @{ int rowNum = ((currentPage - 1) * 3) + 1; }
                @foreach (var faq in faqs)
                {
                    var truncatedQ = faq.Question.Length > 65 ? faq.Question.Substring(0, 65) + "…" : faq.Question;
                    var escapedQ   = faq.Question.Replace("'", "\\'").Replace("\"", "&quot;");
                    var shortQ     = escapedQ.Length > 50 ? escapedQ.Substring(0, 50) + "…" : escapedQ;
                    var isActive   = faq.IsActive;
                    var statusDot  = isActive ? "bg-emerald-400 ring-2 ring-emerald-100" : "bg-red-400 ring-2 ring-red-100";
                    var badgeCls   = isActive ? "badge-active" : "badge-inactive";
                    var statusLbl  = isActive ? "Active" : "Inactive";

                    <tr class="account-row" id="row-@faq.Id">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
                                    <span class="material-icons-round text-orange-400 text-sm">help_outline</span>
                                </div>
                                <span class="font-semibold text-gray-800 text-sm" title="@faq.Question">@truncatedQ</span>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(faq.Category))
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-100">@faq.Category</span>
                            }
                            else
                            {
                                <span class="text-gray-300 text-xs">—</span>
                            }
                        </td>
                        <td class="text-center text-gray-400 text-xs font-mono">@faq.SortOrder</td>
                        <td class="text-center">
                            <div class="flex items-center justify-center gap-1 text-gray-500 text-sm">
                                <span class="material-icons-round text-gray-300 text-sm">visibility</span>
                                @faq.ViewCount
                            </div>
                        </td>
                        <td class="text-gray-500 text-xs">@faq.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <!-- status-cell ID required for AJAX DOM update -->
                            <div class="flex items-center gap-1.5" id="status-cell-@faq.Id">
                                <div class="w-2 h-2 rounded-full @statusDot"></div>
                                <span class="badge @badgeCls">@statusLbl</span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <!-- View/Edit — same icon as ManageAccount (edit, blue) -->
                                <a href="/Moderator/ViewFAQDetail/@faq.Id" title="View & Edit"
                                   class="w-8 h-8 rounded-xl hover:bg-blue-50 hover:text-blue-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-blue-200">
                                    <span class="material-icons-round text-base">edit</span>
                                </a>
                                <!-- Toggle Active/Inactive — same icons as ManageAccount -->
                                @if (isActive)
                                {
                                    <button id="toggle-btn-@faq.Id"
                                            onclick="toggleFaqStatus('@faq.Id', @faq.SortOrder, true)" title="Deactivate"
                                            class="w-8 h-8 rounded-xl hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-red-200">
                                        <span class="material-icons-round text-base">block</span>
                                    </button>
                                }
                                else
                                {
                                    <button id="toggle-btn-@faq.Id"
                                            onclick="toggleFaqStatus('@faq.Id', @faq.SortOrder, false)" title="Activate"
                                            class="w-8 h-8 rounded-xl hover:bg-emerald-50 hover:text-emerald-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-emerald-200">
                                        <span class="material-icons-round text-base">check_circle_outline</span>
                                    </button>
                                }

                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Page <span class="font-bold text-gray-600">@currentPage</span> of <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&isActive=@currentIsActive&category=@currentCategory&page=@(currentPage-1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }
            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&isActive=@currentIsActive&category=@currentCategory&page=@p"
                   class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }
            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&isActive=@currentIsActive&category=@currentCategory&page=@(currentPage+1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- TOGGLE STATUS MODAL -->
<div id="toggleModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeModal('toggleModal')">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="toggleIcon" class="w-12 h-12 rounded-2xl flex items-center justify-center">
                <span class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="toggleTitle" class="text-lg font-bold text-gray-900"></h3>
                <p class="text-sm text-gray-400">This action requires confirmation</p>
            </div>
        </div>
        <p id="toggleBody" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed"></p>
        <div class="flex gap-2">
            <button onclick="closeModal('toggleModal')" class="btn-outline flex-1 justify-center">Cancel</button>
            <button id="toggleConfirmBtn" class="btn-primary flex-1 justify-center">Confirm</button>
        </div>
    </div>
</div>



<!-- Toast -->
<div id="toast" class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 px-5 py-3.5 rounded-2xl shadow-2xl text-white text-sm font-bold">
    <span id="toastIcon" class="material-icons-round text-xl"></span>
    <span id="toastMsg"></span>
</div>

@section Scripts {
@* Hidden CSRF form for AJAX *@
<form id="csrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
<script>
// ── TOGGLE STATUS MODAL ──
function toggleFaqStatus(id, sortOrder, currentlyActive) {
    var icon  = document.getElementById('toggleIcon');
    var title = document.getElementById('toggleTitle');
    var body  = document.getElementById('toggleBody');
    var btn   = document.getElementById('toggleConfirmBtn');

    if (currentlyActive) {
        // Currently Active → will Deactivate (isActive:1→0, isDeleted:0→1)
        icon.style.background = '#FEE2E2';
        icon.querySelector('span').style.color   = '#EF4444';
        icon.querySelector('span').textContent   = 'block';
        title.textContent = 'Deactivate FAQ';
        body.innerHTML = 'Do you want to <strong>deactivate</strong> this FAQ?<br/>'
            + '<span class="text-xs text-gray-400 mt-1 block">isActive: 1 → 0 &nbsp;|&nbsp; isDeleted: 0 → 1</span>';
        btn.style.background = 'linear-gradient(135deg,#EF4444,#DC2626)';
        btn.style.boxShadow  = '0 4px 14px rgba(239,68,68,0.35)';
        btn.textContent = 'Deactivate';
    } else {
        // Currently Inactive → will Activate (isActive:0→1, isDeleted:1→0)
        icon.style.background = '#D1FAE5';
        icon.querySelector('span').style.color   = '#10B981';
        icon.querySelector('span').textContent   = 'check_circle_outline';
        title.textContent = 'Activate FAQ';
        body.innerHTML = 'Do you want to <strong>activate</strong> this FAQ?<br/>'
            + '<span class="text-xs text-gray-400 mt-1 block">isActive: 0 → 1 &nbsp;|&nbsp; isDeleted: 1 → 0</span>';
        btn.style.background = 'linear-gradient(135deg,#10B981,#059669)';
        btn.style.boxShadow  = '0 4px 14px rgba(16,185,129,0.35)';
        btn.textContent = 'Activate';
    }

    btn.onclick = function() { confirmToggle(id, sortOrder, currentlyActive); };
    document.getElementById('toggleModal').classList.remove('hidden');
}

// ── CONFIRM TOGGLE via AJAX ──
function confirmToggle(id, sortOrder, wasActive) {
    var token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;
    fetch('/Moderator/ToggleFaqStatus?id=' + encodeURIComponent(id), {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: '__RequestVerificationToken=' + encodeURIComponent(token)
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        closeModal('toggleModal');
        if (data.success) {
            var nowActive = data.data && data.data.isActive;
            // Update status cell badge + dot
            var cell = document.getElementById('status-cell-' + id);
            if (cell) {
                var dot   = cell.querySelector('div');
                var badge = cell.querySelector('.badge');
                if (nowActive) {
                    dot.className   = 'w-2 h-2 rounded-full bg-emerald-400 ring-2 ring-emerald-100';
                    badge.className = 'badge badge-active';
                    badge.textContent = 'Active';
                } else {
                    dot.className   = 'w-2 h-2 rounded-full bg-red-400 ring-2 ring-red-100';
                    badge.className = 'badge badge-inactive';
                    badge.textContent = 'Inactive';
                }
            }
            // Flip toggle button
            var toggleBtn = document.getElementById('toggle-btn-' + id);
            if (toggleBtn) {
                if (nowActive) {
                    // Now active → show Deactivate button (block icon, red)
                    toggleBtn.setAttribute('onclick', "toggleFaqStatus('" + id + "'," + sortOrder + ",true)");
                    toggleBtn.setAttribute('title', 'Deactivate');
                    toggleBtn.className = 'w-8 h-8 rounded-xl hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-red-200';
                    toggleBtn.querySelector('span').textContent = 'block';
                } else {
                    // Now inactive → show Activate button (check icon, green)
                    toggleBtn.setAttribute('onclick', "toggleFaqStatus('" + id + "'," + sortOrder + ",false)");
                    toggleBtn.setAttribute('title', 'Activate');
                    toggleBtn.className = 'w-8 h-8 rounded-xl hover:bg-emerald-50 hover:text-emerald-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-emerald-200';
                    toggleBtn.querySelector('span').textContent = 'check_circle_outline';
                }
            }
            triggerToast(nowActive ? 'success' : 'warning', data.message);
        } else {
            triggerToast('error', data.message || 'Cannot change status.');
        }
    })
    .catch(function(err) {
        closeModal('toggleModal');
        triggerToast('error', 'Connection error: ' + err.message);
    });
}



function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

function triggerToast(type, msg) {
    var normalizedType = String(type || 'info').toLowerCase();
    var mappedType = normalizedType === 'success'
        ? 'success'
        : (normalizedType === 'warning' || normalizedType === 'warn' ? 'warning' : 'error');

    if (typeof window.showToast === 'function') {
        window.showToast(msg || '', { type: mappedType });
    }
}
</script>
}
