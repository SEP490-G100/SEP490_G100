@model WebSite.Models.Moderator.ModeratorComplainedProfileDetailPageModel
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Complained Profile Detail";

    var p = Model.Profile;
    var avatar = string.IsNullOrWhiteSpace(p.AvatarUrl) ? null : p.AvatarUrl.Trim();
    var isNanny = p.IsNanny;
    var isParent = p.IsParent;
    var rating = p.AverageRating ?? 0m;

    string EducationLabel(int? level) => level switch
    {
        0 => "Trung học",
        1 => "Cao đẳng",
        2 => "Đại học",
        3 => "Thạc sĩ",
        4 => "Khác",
        _ => "Chưa cập nhật"
    };

    string VerificationText(int? code) => code switch
    {
        1 => "Đang chờ duyệt xác minh",
        2 => "Đã được xác minh",
        _ => "Chưa xác minh"
    };

    string ChildAgeGroupLabel(byte? ageGroup) => ageGroup switch
    {
        0 => "0 - 1 tuổi",
        1 => "1 - 3 tuổi",
        2 => "3 - 5 tuổi",
        3 => "6 - 12 tuổi",
        _ => "Chưa cập nhật"
    };

    var dayColumns = new[] { (1, "T2"), (2, "T3"), (3, "T4"), (4, "T5"), (5, "T6"), (6, "T7"), (0, "CN") };
    var slotRows = new[] { (0, "Sáng"), (1, "Chiều"), (2, "Tối"), (3, "Đêm") };
    bool IsAvailable(int day, int slot) => p.Availabilities?.Any(a => a.DayOfWeek == day && a.TimeSlot == slot && a.IsAvailable) == true;
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6 fade-in-up">
    <div>
        <span class="section-label">Kiểm duyệt khiếu nại</span>
        <h1 class="page-title mt-2">Chi tiết <span class="gradient-text">hồ sơ bị khiếu nại</span></h1>
        <p class="page-subtitle">Góc nhìn của người kiểm duyệt đối với hồ sơ người dùng bị khiếu nại.</p>
    </div>
    <div class="flex gap-2">
        @if (Model.ComplaintId.HasValue && Model.ComplaintId.Value != Guid.Empty)
        {
            <a href="@Url.Action("ViewComplaintDetail", "ModeratorComplain", new { id = Model.ComplaintId })" class="btn-outline">
                <span class="material-icons-round text-base">arrow_back</span>
                Quay lại khiếu nại
            </a>
        }
        <a href="/Moderator/ViewAccountDetail/@p.UserId" class="btn-outline">
            <span class="material-icons-round text-base">manage_accounts</span>
            Xem chi tiết tài khoản
        </a>
    </div>
</div>

<section class="profile-page">
    <div class="profile-shell">
        <div class="profile-header">
            <div class="profile-avatar">
                @if (avatar != null)
                {
                    <img src="@avatar" alt="Avatar" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        <span class="material-icons-round" style="font-size:52px;">person</span>
                    </div>
                }
            </div>

            <div class="flex-1 min-w-[220px]">
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">
                        @p.FirstName @p.LastName
                    </h1>
                </div>
                <div class="mt-2 flex items-center gap-2 flex-wrap text-sm text-slate-500 font-semibold">
                    <span class="profile-role-chip">@(isNanny ? "Bảo mẫu" : "Phụ huynh")</span>
                    <span>@(!string.IsNullOrWhiteSpace(p.City) ? p.City : "Việt Nam")</span>
                    <span>@(p.Age?.ToString() ?? "--") tuổi</span>
                    @if (isNanny)
                    {
                        <span class="text-orange-600">Đánh giá @rating.ToString("0.##") (@(p.TotalReviews ?? 0))</span>
                    }
                </div>
            </div>
        </div>

        <div class="profile-grid">
            <div class="space-y-4">
                <div class="profile-card">
                    <h3>@(isNanny ? "Giới thiệu bản thân" : "Mô tả gia đình")</h3>
                    <p class="text-sm text-slate-600 leading-7">
                        @((isNanny ? p.Bio : p.FamilyDescription) ?? "Chưa có thông tin cập nhật.")
                    </p>
                </div>

                @if (isNanny)
                {
                    <div class="profile-card profile-card-soft">
                        <h3>Thông tin bảo mẫu</h3>
                        <div class="profile-detail-grid">
                            <div class="profile-detail-item"><div class="label">Kinh nghiệm</div><div class="value">@((p.YearsOfExperience?.ToString()) ?? "0") năm</div></div>
                            <div class="profile-detail-item"><div class="label">Học vấn</div><div class="value">@EducationLabel(p.EducationLevel)</div></div>
                            <div class="profile-detail-item"><div class="label">Lương mong muốn</div><div class="value">@((p.ExpectedSalaryMin?.ToString("0")) ?? "0") - @((p.ExpectedSalaryMax?.ToString("0")) ?? "0") VNĐ</div></div>
                            <div class="profile-detail-item"><div class="label">Bán kính di chuyển</div><div class="value">@((p.MaxTravelDistance?.ToString()) ?? "0") km</div></div>
                            <div class="profile-detail-item"><div class="label">Xác minh</div><div class="value">@VerificationText(p.VerificationStatusCode)</div></div>
                            <div class="profile-detail-item"><div class="label">Đánh giá trung bình</div><div class="value">@rating.ToString("0.##")</div></div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Kỹ năng</h3>
                        @if (p.Skills != null && p.Skills.Any())
                        {
                            <div class="skill-chip-wrap">
                                @foreach (var s in p.Skills)
                                {
                                    <span class="skill-chip">@(string.IsNullOrWhiteSpace(s.SkillName) ? s.SkillId.ToString() : s.SkillName)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chưa có kỹ năng nào.</p>
                        }
                    </div>

                    <div class="profile-card">
                        <h3>Lịch làm việc</h3>
                        <div class="schedule-grid schedule-grid--readonly">
                            <div></div>
                            @foreach (var day in dayColumns)
                            {
                                <div class="schedule-col-label">@day.Item2</div>
                            }
                            @foreach (var slot in slotRows)
                            {
                                <div class="schedule-row-label">@slot.Item2</div>
                                @foreach (var day in dayColumns)
                                {
                                    var active = IsAvailable(day.Item1, slot.Item1);
                                    <div class="schedule-cell @(active ? "active" : "")" aria-hidden="true">
                                        <span class="schedule-check">@(active ? "âœ“" : "")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                <div class="profile-card">
                    <h3>Khu vực hoạt động</h3>
                    <div id="complainedProfileMap" class="profile-map"></div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="profile-card">
                    <h3>Thông tin liên hệ</h3>
                    <div class="profile-contact-list">
                        <div class="contact-row"><span class="label">Email</span><span class="value">@p.Email</span></div>
                        <div class="contact-row"><span class="label">Số điện thoại</span><span class="value">@(p.PhoneNumber ?? "Chưa cập nhật")</span></div>
                        <div class="contact-row"><span class="label">Địa chỉ</span><span class="value">@($"{p.Address}, {p.Ward}, {p.District}, {p.City}")</span></div>
                    </div>
                </div>

                @if (isParent)
                {
                    <div class="profile-card profile-card-soft">
                        <h3>Thông tin gia đình</h3>
                        <div class="profile-detail-grid">
                            <div class="profile-detail-item"><div class="label">Số trẻ</div><div class="value">@((p.NumberOfChildren?.ToString()) ?? "Chưa cập nhật")</div></div>
                            <div class="profile-detail-item"><div class="label">Nhu cầu đặc biệt</div><div class="value">@(p.SpecialNeeds ?? "Không có")</div></div>
                            <div class="profile-detail-item"><div class="label">Ghi chú</div><div class="value">@(p.Notes ?? "Không có")</div></div>
                            <div class="profile-detail-item"><div class="label">Nhóm tuổi bé</div><div class="value">@ChildAgeGroupLabel(p.ChildAgeGroup)</div></div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Danh sách trẻ</h3>
                        @if (p.Children != null && p.Children.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var child in p.Children)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                                        <div class="font-semibold">Hồ sơ trẻ</div>
                                        <div class="text-xs text-slate-500 mt-1">@(child.ChildAgeGroup?.ToString() ?? "Unknown age group")</div>
                                        <div class="text-xs text-slate-500 mt-1">@(string.IsNullOrWhiteSpace(child.Characteristic) ? "-" : child.Characteristic)</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chưa có thông tin trẻ.</p>
                        }
                    </div>
                }

                @if (isNanny)
                {
                    <div class="profile-card">
                        <h3>Chứng chỉ</h3>
                        @if (p.Certificates != null && p.Certificates.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var cert in p.Certificates)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                                        <div class="font-semibold">@cert.Name</div>
                                        <div class="text-xs text-slate-500 mt-1">@(cert.IssuingOrganization ?? "Tổ chức không xác định")</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chưa có chứng chỉ.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (() => {
            const mapEl = document.getElementById('complainedProfileMap');
            if (!mapEl || typeof L === 'undefined') return;

            const lat = @((p.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? "null");
            const lng = @((p.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? "null");
            const hasCoord = Number.isFinite(lat) && Number.isFinite(lng);
            const center = hasCoord ? [lat, lng] : [10.776, 106.701];
            const zoom = hasCoord ? 13 : 10;

            const map = L.map('complainedProfileMap', { zoomControl: true }).setView(center, zoom);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            if (hasCoord) {
                L.marker([lat, lng]).addTo(map);
            }
        })();
    </script>
}

