@model WebSite.Models.Moderator.ModeratorComplainedProfileDetailPageModel
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Complained Profile Detail";

    var p = Model.Profile;
    var avatar = string.IsNullOrWhiteSpace(p.AvatarUrl) ? null : p.AvatarUrl.Trim();
    var isNanny = p.IsNanny;
    var isParent = p.IsParent;
    var rating = p.AverageRating ?? 0m;

    string EducationLabel(int? level) => level switch
    {
        0 => "Trung hoc",
        1 => "Cao dang",
        2 => "Dai hoc",
        3 => "Thac si",
        4 => "Khac",
        _ => "Chua cap nhat"
    };

    string VerificationText(int? code) => code switch
    {
        1 => "Dang cho duyet xac minh",
        2 => "Da duoc xac minh",
        _ => "Chua xac minh"
    };

    string ChildAgeGroupLabel(byte? ageGroup) => ageGroup switch
    {
        0 => "0 - 1 tuoi",
        1 => "1 - 3 tuoi",
        2 => "3 - 5 tuoi",
        3 => "6 - 12 tuoi",
        _ => "Chua cap nhat"
    };

    var dayColumns = new[] { (1, "T2"), (2, "T3"), (3, "T4"), (4, "T5"), (5, "T6"), (6, "T7"), (0, "CN") };
    var slotRows = new[] { (0, "Sang"), (1, "Chieu"), (2, "Toi"), (3, "Dem") };
    bool IsAvailable(int day, int slot) => p.Availabilities?.Any(a => a.DayOfWeek == day && a.TimeSlot == slot && a.IsAvailable) == true;
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6 fade-in-up">
    <div>
        <span class="section-label">Complaint Moderation</span>
        <h1 class="page-title mt-2">Complained Profile <span class="gradient-text">Detail</span></h1>
        <p class="page-subtitle">Moderator view of the complained user profile.</p>
    </div>
    <div class="flex gap-2">
        @if (Model.ComplaintId.HasValue && Model.ComplaintId.Value != Guid.Empty)
        {
            <a href="@Url.Action("ViewComplaintDetail", "ModeratorComplain", new { id = Model.ComplaintId })" class="btn-outline">
                <span class="material-icons-round text-base">arrow_back</span>
                Back to Complaint
            </a>
        }
        <a href="/Moderator/ViewAccountDetail/@p.UserId" class="btn-outline">
            <span class="material-icons-round text-base">manage_accounts</span>
            Xem chi tiết tài khoản
        </a>
    </div>
</div>

<section class="profile-page">
    <div class="profile-shell">
        <div class="profile-header">
            <div class="profile-avatar">
                @if (avatar != null)
                {
                    <img src="@avatar" alt="Avatar" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        <span class="material-icons-round" style="font-size:52px;">person</span>
                    </div>
                }
            </div>

            <div class="flex-1 min-w-[220px]">
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">
                        @p.FirstName @p.LastName
                    </h1>
                </div>
                <div class="mt-2 flex items-center gap-2 flex-wrap text-sm text-slate-500 font-semibold">
                    <span class="profile-role-chip">@(isNanny ? "Nanny" : "Parent")</span>
                    <span>@(!string.IsNullOrWhiteSpace(p.City) ? p.City : "Viet Nam")</span>
                    <span>@(p.Age?.ToString() ?? "--") tuoi</span>
                    @if (isNanny)
                    {
                        <span class="text-orange-600">Rating @rating.ToString("0.##") (@(p.TotalReviews ?? 0))</span>
                    }
                </div>
            </div>
        </div>

        <div class="profile-grid">
            <div class="space-y-4">
                <div class="profile-card">
                    <h3>@(isNanny ? "Gioi thieu ban than" : "Mo ta gia dinh")</h3>
                    <p class="text-sm text-slate-600 leading-7">
                        @((isNanny ? p.Bio : p.FamilyDescription) ?? "Chua co thong tin cap nhat.")
                    </p>
                </div>

                @if (isNanny)
                {
                    <div class="profile-card profile-card-soft">
                        <h3>Thong tin nanny</h3>
                        <div class="profile-detail-grid">
                            <div class="profile-detail-item"><div class="label">Kinh nghiem</div><div class="value">@((p.YearsOfExperience?.ToString()) ?? "0") nam</div></div>
                            <div class="profile-detail-item"><div class="label">Hoc van</div><div class="value">@EducationLabel(p.EducationLevel)</div></div>
                            <div class="profile-detail-item"><div class="label">Luong mong muon</div><div class="value">@((p.ExpectedSalaryMin?.ToString("0")) ?? "0") - @((p.ExpectedSalaryMax?.ToString("0")) ?? "0") VND</div></div>
                            <div class="profile-detail-item"><div class="label">Ban kinh di chuyen</div><div class="value">@((p.MaxTravelDistance?.ToString()) ?? "0") km</div></div>
                            <div class="profile-detail-item"><div class="label">Xac minh</div><div class="value">@VerificationText(p.VerificationStatusCode)</div></div>
                            <div class="profile-detail-item"><div class="label">Rating trung binh</div><div class="value">@rating.ToString("0.##")</div></div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Ky nang</h3>
                        @if (p.Skills != null && p.Skills.Any())
                        {
                            <div class="skill-chip-wrap">
                                @foreach (var s in p.Skills)
                                {
                                    <span class="skill-chip">@(string.IsNullOrWhiteSpace(s.SkillName) ? s.SkillId.ToString() : s.SkillName)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chua co ky nang nao.</p>
                        }
                    </div>

                    <div class="profile-card">
                        <h3>Lich lam viec</h3>
                        <div class="schedule-grid schedule-grid--readonly">
                            <div></div>
                            @foreach (var day in dayColumns)
                            {
                                <div class="schedule-col-label">@day.Item2</div>
                            }
                            @foreach (var slot in slotRows)
                            {
                                <div class="schedule-row-label">@slot.Item2</div>
                                @foreach (var day in dayColumns)
                                {
                                    var active = IsAvailable(day.Item1, slot.Item1);
                                    <div class="schedule-cell @(active ? "active" : "")" aria-hidden="true">
                                        <span class="schedule-check">@(active ? "✓" : "")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                <div class="profile-card">
                    <h3>Khu vuc hoat dong</h3>
                    <div id="complainedProfileMap" class="profile-map"></div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="profile-card">
                    <h3>Thong tin lien he</h3>
                    <div class="profile-contact-list">
                        <div class="contact-row"><span class="label">Email</span><span class="value">@p.Email</span></div>
                        <div class="contact-row"><span class="label">So dien thoai</span><span class="value">@(p.PhoneNumber ?? "Chua cap nhat")</span></div>
                        <div class="contact-row"><span class="label">Dia chi</span><span class="value">@($"{p.Address}, {p.Ward}, {p.District}, {p.City}")</span></div>
                    </div>
                </div>

                @if (isParent)
                {
                    <div class="profile-card profile-card-soft">
                        <h3>Thong tin gia dinh</h3>
                        <div class="profile-detail-grid">
                            <div class="profile-detail-item"><div class="label">So tre</div><div class="value">@((p.NumberOfChildren?.ToString()) ?? "Chua cap nhat")</div></div>
                            <div class="profile-detail-item"><div class="label">Nhu cau dac biet</div><div class="value">@(p.SpecialNeeds ?? "Khong co")</div></div>
                            <div class="profile-detail-item"><div class="label">Ghi chu</div><div class="value">@(p.Notes ?? "Khong co")</div></div>
                            <div class="profile-detail-item"><div class="label">Nhom tuoi be</div><div class="value">@ChildAgeGroupLabel(p.ChildAgeGroup)</div></div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Danh sach tre</h3>
                        @if (p.Children != null && p.Children.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var child in p.Children)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                                        <div class="font-semibold">Child profile</div>
                                        <div class="text-xs text-slate-500 mt-1">@(child.ChildAgeGroup?.ToString() ?? "Unknown age group")</div>
                                        <div class="text-xs text-slate-500 mt-1">@(string.IsNullOrWhiteSpace(child.Characteristic) ? "-" : child.Characteristic)</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chua co thong tin tre.</p>
                        }
                    </div>
                }

                @if (isNanny)
                {
                    <div class="profile-card">
                        <h3>Chung chi</h3>
                        @if (p.Certificates != null && p.Certificates.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var cert in p.Certificates)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                                        <div class="font-semibold">@cert.Name</div>
                                        <div class="text-xs text-slate-500 mt-1">@(cert.IssuingOrganization ?? "Unknown organization")</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chua co chung chi.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (() => {
            const mapEl = document.getElementById('complainedProfileMap');
            if (!mapEl || typeof L === 'undefined') return;

            const lat = @((p.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? "null");
            const lng = @((p.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? "null");
            const hasCoord = Number.isFinite(lat) && Number.isFinite(lng);
            const center = hasCoord ? [lat, lng] : [10.776, 106.701];
            const zoom = hasCoord ? 13 : 10;

            const map = L.map('complainedProfileMap', { zoomControl: true }).setView(center, zoom);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            if (hasCoord) {
                L.marker([lat, lng]).addTo(map);
            }
        })();
    </script>
}
