@model WebSite.Models.Moderator.ModeratorComplaintListResponse
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Manage Complaints";

    var currentSearch = ViewBag.Search as string ?? "";
    var currentStatus = ViewBag.Status as string ?? "";
    var currentEntityType = ViewBag.EntityType as string ?? "";
    var currentPage = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var complaints = Model?.Items ?? new List<WebSite.Models.Moderator.ModeratorComplaintListItemDto>();
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">Moderation</span>
        <h1 class="page-title mt-2">
            Manage <span class="gradient-text">Complaints</span>
        </h1>
        <p class="page-subtitle">Review complaints and track handling status.</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}

<form method="get" action="/Moderator/ManageComplaint" id="filterForm">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Search by complainer, reason, or entity type..."
                       class="search-input pl-9 w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>

            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">assignment_turned_in</span>
                <select name="status" onchange="this.form.submit()"
                        class="search-input md:w-44 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Statuses</option>
                    <option value="0" selected="@(currentStatus == "0" ? "selected" : null)">Pending</option>
                    <option value="1" selected="@(currentStatus == "1" ? "selected" : null)">Completed</option>
                </select>
            </div>

            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">category</span>
                <select name="entityType" onchange="this.form.submit()"
                        class="search-input md:w-48 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Types</option>
                    <option value="Profile" selected="@(currentEntityType == "Profile" ? "selected" : null)">Profile</option>
                    <option value="JobPosting" selected="@(currentEntityType == "JobPosting" ? "selected" : null)">Job Posting</option>
                    <option value="Conversation" selected="@(currentEntityType == "Conversation" ? "selected" : null)">Conversation</option>
                    <option value="Message" selected="@(currentEntityType == "Message" ? "selected" : null)">Message</option>
                </select>
            </div>

            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Search
            </button>
        </div>
    </div>
</form>

<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
    <div class="card-header">
        <span class="text-sm text-gray-500">
            Showing <span class="font-bold text-gray-800">@complaints.Count</span>
            of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> complaints
        </span>
        <div class="flex items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-amber-400 ring-2 ring-amber-100"></div>Pending
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-emerald-100"></div>Completed
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Complainer</th>
                    <th class="text-left">Type</th>
                    <th class="text-left">Reason</th>
                    <th class="text-left">Created</th>
                    <th class="text-left">Status</th>
                    <th class="text-left">IsDeleted</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!complaints.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">flag</span>
                            <p class="font-semibold text-gray-400">No complaints found.</p>
                            <p class="text-xs text-gray-300 mt-1">Try adjusting the filters above.</p>
                        </td>
                    </tr>
                }
                @{ int rowNum = ((currentPage - 1) * 10) + 1; }
                @foreach (var item in complaints)
                {
                    <tr id="row-@item.Id">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex flex-col">
                                <span class="font-bold text-gray-800">@item.ReporterDisplay</span>
                                <span class="text-xs text-gray-400">@item.ReporterEmail</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-parent">@item.EntityTypeLabel</span>
                        </td>
                        <td class="text-sm text-gray-600 max-w-[340px] truncate" title="@item.Reason">@item.Reason</td>
                        <td class="text-gray-500 text-xs">@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <span class="badge @item.StatusClass">@item.StatusLabel</span>
                        </td>
                        <td>
                            <div class="flex items-center gap-1.5">
                                <div class="w-2 h-2 rounded-full @(item.IsDeleted ? "bg-red-400 ring-2 ring-red-100" : "bg-emerald-400 ring-2 ring-emerald-100")"></div>
                                <span class="badge @(item.IsDeleted ? "badge-inactive" : "badge-active")">
                                    @(item.IsDeleted ? "Inactive" : "Active")
                                </span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <a href="/Moderator/ViewComplaintDetail/@item.Id" title="View Detail"
                                   class="w-8 h-8 rounded-xl hover:bg-blue-50 hover:text-blue-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-blue-200">
                                    <span class="material-icons-round text-base">visibility</span>
                                </a>

                                @if (item.IsActive)
                                {
                                    <button id="toggle-btn-@item.Id"
                                            onclick="toggleComplaintStatus('@item.Id', false)"
                                            title="Deactivate"
                                            class="w-8 h-8 rounded-xl hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-red-200">
                                        <span class="material-icons-round text-base">block</span>
                                    </button>
                                }
                                else
                                {
                                    <button id="toggle-btn-@item.Id"
                                            onclick="toggleComplaintStatus('@item.Id', true)"
                                            title="Activate"
                                            class="w-8 h-8 rounded-xl hover:bg-emerald-50 hover:text-emerald-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-emerald-200">
                                        <span class="material-icons-round text-base">check_circle_outline</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Page <span class="font-bold text-gray-600">@currentPage</span> of <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&status=@currentStatus&entityType=@currentEntityType&page=@(currentPage - 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }
            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&status=@currentStatus&entityType=@currentEntityType&page=@p"
                   class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }
            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&status=@currentStatus&entityType=@currentEntityType&page=@(currentPage + 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>

<div id="toggleComplaintModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeComplaintModal()">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="toggleComplaintIconBg" class="w-12 h-12 rounded-2xl flex items-center justify-center">
                <span id="toggleComplaintIcon" class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="toggleComplaintTitle" class="text-lg font-bold text-gray-900"></h3>
                <p id="toggleComplaintSubtitle" class="text-sm text-gray-400"></p>
            </div>
        </div>
        <p id="toggleComplaintMessage" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed"></p>
        <div class="flex gap-2">
            <button type="button" onclick="closeComplaintModal()" class="btn-outline flex-1 justify-center">Cancel</button>
            <button type="button" id="toggleComplaintConfirmBtn" class="btn-primary flex-1 justify-center"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleComplaintStatus(id, isActive) {
        const title = isActive ? 'Kích hoạt phàn nàn' : 'Vô hiệu hóa phàn nàn';
        const subtitle = isActive ? 'Hiển thị lại phàn nàn trong hệ thống' : 'Ẩn phàn nàn tạm thời khỏi hệ thống';
        const message = isActive
            ? 'Bạn có chắc muốn kích hoạt phàn nàn này?'
            : 'Bạn có chắc muốn vô hiệu hóa phàn nàn này?';

        const iconBg = document.getElementById('toggleComplaintIconBg');
        const icon = document.getElementById('toggleComplaintIcon');
        const titleEl = document.getElementById('toggleComplaintTitle');
        const subtitleEl = document.getElementById('toggleComplaintSubtitle');
        const messageEl = document.getElementById('toggleComplaintMessage');
        const confirmBtn = document.getElementById('toggleComplaintConfirmBtn');

        titleEl.textContent = title;
        subtitleEl.textContent = subtitle;
        messageEl.textContent = message;

        iconBg.style.background = isActive ? '#D1FAE5' : '#FEE2E2';
        icon.style.color = isActive ? '#10B981' : '#EF4444';
        icon.textContent = isActive ? 'check_circle_outline' : 'block';

        confirmBtn.className = (isActive ? 'btn-success' : 'btn-danger') + ' flex-1 justify-center';
        confirmBtn.textContent = isActive ? 'Confirm Activate' : 'Confirm Deactivate';
        confirmBtn.onclick = () => confirmToggleComplaintStatus(id, isActive);

        document.getElementById('toggleComplaintModal').classList.remove('hidden');
    }

    function closeComplaintModal() {
        document.getElementById('toggleComplaintModal').classList.add('hidden');
    }

    function confirmToggleComplaintStatus(id, isActive) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        fetch('/Moderator/ToggleComplaintStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `id=${encodeURIComponent(id)}&isActive=${isActive}&__RequestVerificationToken=${encodeURIComponent(token)}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                closeComplaintModal();
                if (typeof window.showToast === 'function') {
                    window.showToast(data.message || (isActive
                        ? 'Bạn đã kích hoạt phàn nàn thành công'
                        : 'Bạn đã vô hiệu hóa phàn nàn thành công'), {
                        type: isActive ? 'success' : 'warning'
                    });
                }
                setTimeout(() => window.location.reload(), 400);
            } else {
                if (typeof window.showToast === 'function') {
                    window.showToast(data.message || 'Operation failed.', { type: 'error' });
                }
            }
        })
        .catch(err => {
            closeComplaintModal();
            if (typeof window.showToast === 'function') {
                window.showToast('Connection error: ' + err.message, { type: 'error' });
            }
        });
    }
</script>

<style>
.btn-danger  { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#FEE2E2;color:#EF4444;border:1.5px solid #FECACA; }
.btn-danger:hover  { background:#FCA5A5;border-color:#F87171; }
.btn-success { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#D1FAE5;color:#10B981;border:1.5px solid #A7F3D0; }
.btn-success:hover { background:#A7F3D0;border-color:#6EE7B7; }
</style>

<form id="csrfForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>
}
