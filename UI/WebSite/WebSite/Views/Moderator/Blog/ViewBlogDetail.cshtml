@using WebSite.Enums
@model WebSite.Models.Blog.BlogDto
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Blog Detail";
    var categories = ViewBag.Categories as List<WebSite.Models.Blog.BlogCategoryOption>
                     ?? new List<WebSite.Models.Blog.BlogCategoryOption>();
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <h1 class="page-title mt-2">
            Edit <span class="gradient-text">Blog</span>
        </h1>
        <p class="page-subtitle">Update blog article details and content images.</p>
    </div>
    <a href="/Moderator/ManageBlog" class="btn-outline flex-shrink-0 flex items-center gap-1">
        <span class="material-icons-round text-base">arrow_back</span>
        Back to List
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}

<form method="post" action="/Moderator/ViewBlogDetail/@Model.Id" id="editBlogForm">
    @Html.AntiForgeryToken()
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="lg:col-span-2 flex flex-col gap-5">
            <div class="content-card p-6 fade-in-up">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <span class="material-icons-round text-indigo-400 text-base">title</span>
                    Basic Info
                </h2>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                        Title <span class="text-red-500">*</span>
                    </label>
                    <input id="titleInput" name="Title" type="text" value="@Model.Title"
                           placeholder="Blog title..."
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition" />
                    <p id="titleError" class="text-red-500 text-xs mt-1 hidden">Title cannot be empty.</p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                        Slug <span class="text-red-500">*</span>
                    </label>
                    <input id="slugInput" name="Slug" type="text" value="@Model.Slug"
                           placeholder="blog-slug"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-mono focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition" />
                    <p id="slugError" class="text-red-500 text-xs mt-1 hidden">Slug cannot be empty.</p>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Summary</label>
                    <textarea name="Summary" rows="2"
                              placeholder="Short description..."
                              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition resize-none">@(Model.Summary ?? "")</textarea>
                </div>
            </div>

            <div class="content-card p-6 fade-in-up" style="animation-delay:.05s;">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <h2 class="text-sm font-bold text-gray-700 flex items-center gap-2">
                        <span class="material-icons-round text-indigo-400 text-base">edit_note</span>
                        Content <span class="text-red-500">*</span>
                    </h2>
                    <span class="text-xs text-gray-400">Supports HTML image tags</span>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_320px] gap-5">
                    <div>
                        <textarea id="contentInput" name="Content" rows="18"
                                  class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition resize-y">@Model.Content</textarea>
                        <p id="contentError" class="text-red-500 text-xs mt-1 hidden">Content cannot be empty.</p>

                        <div class="mt-4 rounded-2xl border border-gray-100 bg-gray-50/80 p-4 space-y-4">
                            <div>
                                <h3 class="text-sm font-bold text-gray-700 flex items-center gap-2">
                                    <span class="material-icons-round text-indigo-400 text-base">perm_media</span>
                                    Content Media
                                </h3>
                                <p class="text-xs text-gray-400 mt-1">Add local images/videos, paste an image directly, or insert a media URL into the content editor.</p>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <button type="button" onclick="document.getElementById('blogMediaInput').click()" class="btn-outline w-full justify-center">
                                    <span class="material-icons-round text-base">upload</span>
                                    Add Local Media
                                </button>
                                <button type="button" onclick="insertMediaUrlPrompt()" class="btn-outline w-full justify-center">
                                    <span class="material-icons-round text-base">link</span>
                                    Insert Media URL
                                </button>
                            </div>

                            <input id="blogMediaInput" type="file" accept="image/*,video/mp4,video/webm,video/ogg,video/quicktime,.mp4,.webm,.ogg,.mov" multiple class="hidden" />

                            <div id="imageUploadHint" class="rounded-xl border border-dashed border-gray-200 bg-white px-3 py-3 text-xs text-gray-400">
                                Tip: local media is uploaded to Azure Blob, while URL media is inserted directly into the content.
                            </div>

                            <div id="uploadingState" class="hidden rounded-xl bg-blue-50 border border-blue-100 px-3 py-2 text-xs text-blue-700">
                                Uploading media...
                            </div>
                        </div>

                        <div class="mt-4 rounded-2xl border border-gray-200 bg-white overflow-hidden">
                            <div class="flex items-center justify-between gap-2 border-b border-gray-100 px-4 py-3 bg-gray-50">
                                <h3 class="text-sm font-bold text-gray-700 flex items-center gap-2">
                                    <span class="material-icons-round text-indigo-400 text-base">preview</span>
                                    Live Preview
                                </h3>
                                <span class="text-xs text-gray-400">Renders HTML content and images</span>
                            </div>
                            <div id="contentPreview" class="p-4 min-h-[220px] max-h-[560px] overflow-y-auto text-sm leading-7 text-gray-700 [&_img]:max-w-full [&_img]:h-auto [&_img]:rounded-2xl [&_img]:my-4 [&_video]:max-w-full [&_video]:rounded-2xl [&_video]:my-4 [&_video]:bg-black [&_p]:mb-3 [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mb-3 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5"></div>
                        </div>
                    </div>

                    <div class="rounded-2xl border border-gray-100 bg-gray-50/80 p-4 space-y-4">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Inserted Images</p>
                            <div id="insertedImageList" class="space-y-2 max-h-[420px] overflow-y-auto pr-1"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-5">
            <div class="content-card p-6 fade-in-up" style="animation-delay:.08s;">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <span class="material-icons-round text-indigo-400 text-base">settings</span>
                    Settings
                </h2>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Status</label>
                    <select name="Status"
                            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 transition appearance-none">
                        <option value="@((int)BlogStatus.Draft)" selected="@(Model.Status == BlogStatus.Draft ? "selected" : null)">Draft</option>
                        <option value="@((int)BlogStatus.Published)" selected="@(Model.Status == BlogStatus.Published ? "selected" : null)">Published</option>
                        <option value="@((int)BlogStatus.Archived)" selected="@(Model.Status == BlogStatus.Archived ? "selected" : null)">Archived</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Category</label>
                    <select name="CategoryId"
                            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 transition appearance-none">
                        <option value="">— No Category —</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Thumbnail URL</label>
                    <input name="ThumbnailUrl" type="url" value="@(Model.ThumbnailUrl ?? "")"
                           placeholder="https://example.com/image.jpg"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 transition" />
                </div>
            </div>

            <div class="content-card p-6 fade-in-up" style="animation-delay:.1s;">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <span class="material-icons-round text-gray-400 text-base">info_outline</span>
                    Blog Info
                </h2>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Author</span>
                        <span class="text-gray-600">@(Model.AuthorName ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Views</span>
                        <span class="text-gray-600">@Model.ViewCount</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Published</span>
                        <span class="text-gray-600">@(Model.PublishedAt?.ToString("MMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Created</span>
                        <span class="text-gray-600">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Updated</span>
                        <span class="text-gray-600">@(Model.UpdatedAt?.ToString("MMM dd, yyyy") ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Visibility</span>
                        @if (!Model.IsDeleted)
                        {
                            <span class="badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </div>
                </div>
            </div>

            <div class="content-card p-5 fade-in-up" style="animation-delay:.12s;">
                <button type="button" onclick="submitForm()" class="btn-primary w-full justify-center">
                    <span class="material-icons-round text-base">save</span>
                    Save Changes
                </button>
                <a href="/Moderator/ManageBlog" class="btn-outline w-full justify-center mt-3">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
function submitForm() {
    var title = document.getElementById('titleInput').value.trim();
    var slug = document.getElementById('slugInput').value.trim();
    var content = document.getElementById('contentInput').value.trim();

    document.getElementById('titleError').classList.toggle('hidden', !!title);
    document.getElementById('slugError').classList.toggle('hidden', !!slug);
    document.getElementById('contentError').classList.toggle('hidden', !!content);

    if (!title || !slug || !content) return;
    document.getElementById('editBlogForm').submit();
}

function getCsrfToken() {
    return document.querySelector('#editBlogForm input[name="__RequestVerificationToken"]').value;
}

function getContentInput() {
    return document.getElementById('contentInput');
}

function getContentPreview() {
    return document.getElementById('contentPreview');
}

function renderContentPreview() {
    var content = getContentInput().value.trim();
    var preview = getContentPreview();

    if (!content) {
        preview.innerHTML = '<p class="text-sm text-gray-400 italic">Content preview will appear here, including any uploaded or linked images.</p>';
        return;
    }

    preview.innerHTML = content;
}

function insertAtCursor(text) {
    var textarea = getContentInput();
    var start = textarea.selectionStart ?? textarea.value.length;
    var end = textarea.selectionEnd ?? textarea.value.length;
    var before = textarea.value.substring(0, start);
    var after = textarea.value.substring(end);
    textarea.value = before + text + after;
    var nextPosition = start + text.length;
    textarea.focus();
    textarea.selectionStart = nextPosition;
    textarea.selectionEnd = nextPosition;
    renderContentPreview();
}

function createImageMarkup(url) {
    return '\n<p><img src="' + url + '" alt="Blog image" /></p>\n';
}

function createVideoMarkup(url) {
    return '\n<p><video controls preload="metadata" src="' + url + '"></video></p>\n';
}

function appendInsertedImage(url) {
    var list = document.getElementById('insertedImageList');
    var safeUrl = encodeURIComponent(url);
    var item = document.createElement('div');
    item.className = 'rounded-2xl border border-gray-200 bg-white p-2.5 space-y-2';
    item.innerHTML =
        '<div class="aspect-[4/3] overflow-hidden rounded-xl bg-gray-100">' +
            '<img src="' + url + '" alt="Inserted blog image" class="h-full w-full object-cover" />' +
        '</div>' +
        '<div class="flex items-center gap-2">' +
            '<button type="button" class="btn-outline flex-1 justify-center !px-3 !py-2 text-xs" onclick="reinsertImage(\'' + safeUrl + '\')">Insert Again</button>' +
            '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="btn-outline flex-1 justify-center !px-3 !py-2 text-xs">Open</a>' +
        '</div>';
    list.prepend(item);
}

function isImageFile(file) {
    var type = (file.type || '').toLowerCase();
    var name = (file.name || '').toLowerCase();
    return type.startsWith('image/') || /\.(jpg|jpeg|png|webp|gif)$/i.test(name);
}

function isVideoFile(file) {
    var type = (file.type || '').toLowerCase();
    var name = (file.name || '').toLowerCase();
    return type.startsWith('video/') || /\.(mp4|webm|ogg|mov)$/i.test(name);
}

function inferMediaTypeFromUrl(url) {
    var normalized = String(url || '').toLowerCase().split('?')[0].split('#')[0];
    if (/\.(jpg|jpeg|png|webp|gif)$/.test(normalized)) return 'image';
    if (/\.(mp4|webm|ogg|mov)$/.test(normalized)) return 'video';
    return null;
}

function reinsertImage(encodedUrl) {
    var url = decodeURIComponent(encodedUrl);
    insertAtCursor(createImageMarkup(url));
}

function parseExistingImages() {
    var matches = getContentInput().value.match(/<img[^>]+src=["']([^"']+)["'][^>]*>/gi) || [];
    var urls = [];
    matches.forEach(function(match) {
        var srcMatch = match.match(/src=["']([^"']+)["']/i);
        if (srcMatch && srcMatch[1] && !urls.includes(srcMatch[1])) {
            urls.push(srcMatch[1]);
        }
    });

    var list = document.getElementById('insertedImageList');
    list.innerHTML = '';
    urls.forEach(appendInsertedImage);
}

function setUploadingState(isUploading) {
    document.getElementById('uploadingState').classList.toggle('hidden', !isUploading);
}

async function uploadBlogImages(files) {
    if (!files || !files.length) return;

    var formData = new FormData();
    Array.from(files).forEach(function(file) {
        formData.append('files', file);
    });
    formData.append('__RequestVerificationToken', getCsrfToken());

    setUploadingState(true);

    try {
        var response = await fetch('/Moderator/UploadBlogContentImages', {
            method: 'POST',
            body: formData
        });

        var result = await response.json();
        if (!result.success || !result.data || !Array.isArray(result.data.urls)) {
            throw new Error(result.message || 'Cannot upload blog images.');
        }

        result.data.urls.forEach(function(url) {
            insertAtCursor(createImageMarkup(url));
            appendInsertedImage(url);
        });

        if (typeof window.showToast === 'function') {
            window.showToast(result.message || 'Upload anh thanh cong.', { type: 'success' });
        }
    } catch (error) {
        if (typeof window.showToast === 'function') {
            window.showToast(error.message || 'Khong the upload anh blog.', { type: 'error' });
        }
    } finally {
        setUploadingState(false);
        document.getElementById('blogImageInput').value = '';
    }
}

async function uploadBlogVideos(files) {
    if (!files || !files.length) return;

    var formData = new FormData();
    Array.from(files).forEach(function(file) {
        formData.append('files', file);
    });
    formData.append('__RequestVerificationToken', getCsrfToken());

    setUploadingState(true);

    try {
        var response = await fetch('/Moderator/UploadBlogContentVideos', {
            method: 'POST',
            body: formData
        });

        var result = await response.json();
        if (!result.success || !result.data || !Array.isArray(result.data.urls)) {
            throw new Error(result.message || 'Cannot upload blog videos.');
        }

        result.data.urls.forEach(function(url) {
            insertAtCursor(createVideoMarkup(url));
        });

        if (typeof window.showToast === 'function') {
            window.showToast(result.message || 'Upload video thanh cong.', { type: 'success' });
        }
    } catch (error) {
        if (typeof window.showToast === 'function') {
            window.showToast(error.message || 'Khong the upload video blog.', { type: 'error' });
        }
    } finally {
        setUploadingState(false);
        document.getElementById('blogVideoInput').value = '';
    }
}

async function uploadLocalMedia(files) {
    if (!files || !files.length) return;

    var imageFiles = Array.from(files).filter(isImageFile);
    var videoFiles = Array.from(files).filter(isVideoFile);
    var unsupportedFiles = Array.from(files).filter(function(file) { return !isImageFile(file) && !isVideoFile(file); });

    if (unsupportedFiles.length && typeof window.showToast === 'function') {
        window.showToast('Some selected files are not supported and were skipped.', { type: 'warning' });
    }

    if (imageFiles.length) {
        await uploadBlogImages(imageFiles);
    }

    if (videoFiles.length) {
        await uploadBlogVideos(videoFiles);
    }
}

function insertMediaUrlPrompt() {
    var url = window.prompt('Paste the image or video URL you want to insert into the blog content:');
    if (!url) return;

    var trimmedUrl = url.trim();
    if (!/^https?:\/\//i.test(trimmedUrl)) {
        if (typeof window.showToast === 'function') {
            window.showToast('Media URL must start with http:// or https://', { type: 'warning' });
        }
        return;
    }

    var mediaType = inferMediaTypeFromUrl(trimmedUrl);
    if (mediaType === 'image') {
        insertAtCursor(createImageMarkup(trimmedUrl));
        appendInsertedImage(trimmedUrl);
        return;
    }

    if (mediaType === 'video') {
        insertAtCursor(createVideoMarkup(trimmedUrl));
        return;
    }

    if (typeof window.showToast === 'function') {
        window.showToast('The media URL must end with a supported image or video extension.', { type: 'warning' });
    }
}

document.getElementById('blogMediaInput').addEventListener('change', function() {
    uploadLocalMedia(this.files).finally(() => {
        this.value = '';
    });
});

getContentInput().addEventListener('input', function() {
    renderContentPreview();
});

getContentInput().addEventListener('paste', function(event) {
    var items = Array.from(event.clipboardData?.items || []);
    var imageFiles = items
        .filter(function(item) { return item.type && item.type.startsWith('image/'); })
        .map(function(item) { return item.getAsFile(); })
        .filter(Boolean);

    if (!imageFiles.length) return;

    event.preventDefault();
    uploadBlogImages(imageFiles);
});

parseExistingImages();
renderContentPreview();
</script>
}
