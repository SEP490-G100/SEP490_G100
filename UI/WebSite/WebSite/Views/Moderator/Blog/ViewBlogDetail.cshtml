@using WebSite.Enums
@model WebSite.Models.Blog.BlogDto
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Chi tiết Blog";
    var categories = ViewBag.Categories as List<WebSite.Models.Blog.BlogCategoryOption>
                     ?? new List<WebSite.Models.Blog.BlogCategoryOption>();
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <h1 class="page-title mt-2">
            Sửa <span class="gradient-text">Blog</span>
        </h1>
        <p class="page-subtitle">Cập nhật thông tin chi tiết bài viết và nội dung.</p>
    </div>
    <a href="/Moderator/ManageBlog" class="btn-outline flex-shrink-0 flex items-center gap-1">
        <span class="material-icons-round text-base">arrow_back</span>
        Quay lại danh sách
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}

<form method="post" action="/Moderator/ViewBlogDetail/@Model.Id" id="editBlogForm">
    @Html.AntiForgeryToken()
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="lg:col-span-2 flex flex-col gap-5">
            <div class="content-card p-6 fade-in-up">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <span class="material-icons-round text-indigo-400 text-base">title</span>
                    Thông tin cơ bản
                </h2>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                        Tiêu đề <span class="text-red-500">*</span>
                    </label>
                    <input id="titleInput" name="Title" type="text" value="@Model.Title"
                           placeholder="Tiêu đề bài viết..."
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition" />
                    <p id="titleError" class="text-red-500 text-xs mt-1 hidden">Tiêu đề không được để trống.</p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                        Đường dẫn (Slug) <span class="text-red-500">*</span>
                    </label>
                    <input id="slugInput" name="Slug" type="text" value="@Model.Slug"
                           placeholder="blog-slug"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-mono focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition" />
                    <p id="slugError" class="text-red-500 text-xs mt-1 hidden">Đường dẫn không được để trống.</p>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Tóm tắt</label>
                    <textarea name="Summary" rows="2"
                              placeholder="Mô tả súc tích..."
                              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition resize-none">@(Model.Summary ?? "")</textarea>
                </div>
            </div>

            <div class="content-card p-6 fade-in-up" style="animation-delay:.05s;">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <h2 class="text-sm font-bold text-gray-700 flex items-center gap-2">
                        <span class="material-icons-round text-indigo-400 text-base">edit_note</span>
                        Nội dung <span class="text-red-500">*</span>
                    </h2>
                    <span class="text-xs text-gray-400">Hỗ trợ thẻ HTML và hình ảnh</span>
                </div>

                <div>
                    <textarea id="contentInput" name="Content" rows="18"
                              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-50 transition resize-y">@Model.Content</textarea>
                    <p id="contentError" class="text-red-500 text-xs mt-1 hidden">Nội dung bài viết không được để trống.</p>
                    <p class="text-xs text-gray-400 mt-2">Sử dụng thanh công cụ TinyMCE để tải lên hình ảnh/video hoặc chèn URL phương tiện.</p>

                    <div class="mt-4 rounded-2xl border border-gray-200 bg-white overflow-hidden">
                        <div class="flex items-center justify-between gap-2 border-b border-gray-100 px-4 py-3 bg-gray-50">
                            <h3 class="text-sm font-bold text-gray-700 flex items-center gap-2">
                                <span class="material-icons-round text-indigo-400 text-base">preview</span>
                                Bản xem trước
                            </h3>
                            <span class="text-xs text-gray-400">Hiển thị nội dung HTML, hình ảnh và video</span>
                        </div>
                        <div id="contentPreview" class="p-4 min-h-[220px] max-h-[560px] overflow-y-auto text-sm leading-7 text-gray-700 [&_img]:max-w-full [&_img]:h-auto [&_img]:rounded-2xl [&_img]:my-4 [&_video]:max-w-full [&_video]:rounded-2xl [&_video]:my-4 [&_video]:bg-black [&_p]:mb-3 [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mb-3 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-5">
            <div class="content-card p-6 fade-in-up" style="animation-delay:.08s;">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <span class="material-icons-round text-indigo-400 text-base">settings</span>
                    Tùy chọn
                </h2>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Trạng thái</label>
                    <select name="Status"
                            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 transition appearance-none">
                        <option value="@((int)BlogStatus.Draft)" selected="@(Model.Status == BlogStatus.Draft ? "selected" : null)">Bản nháp</option>
                        <option value="@((int)BlogStatus.Published)" selected="@(Model.Status == BlogStatus.Published ? "selected" : null)">Xuất bản</option>
                        <option value="@((int)BlogStatus.Archived)" selected="@(Model.Status == BlogStatus.Archived ? "selected" : null)">Lưu trữ</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Danh mục</label>
                    <select name="CategoryId"
                            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 transition appearance-none">
                        <option value="">— Không có danh mục —</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ảnh bìa (URL)</label>
                    <input name="ThumbnailUrl" type="url" value="@(Model.ThumbnailUrl ?? "")"
                           placeholder="https://example.com/image.jpg"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:border-indigo-400 transition" />
                </div>
            </div>

            <div class="content-card p-6 fade-in-up" style="animation-delay:.1s;">
                <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2">
                    <span class="material-icons-round text-gray-400 text-base">info_outline</span>
                    Thông tin hệ thống
                </h2>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Tác giả</span>
                        <span class="text-gray-600">@(Model.AuthorName ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Lượt xem</span>
                        <span class="text-gray-600">@Model.ViewCount</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Ngày xuất bản</span>
                        <span class="text-gray-600">@(Model.PublishedAt?.ToString("dd/MM/yyyy") ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Ngày tạo</span>
                        <span class="text-gray-600">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Cập nhật lần cuối</span>
                        <span class="text-gray-600">@(Model.UpdatedAt?.ToString("dd/MM/yyyy") ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400 font-medium">Trạng thái ẩn/hiện</span>
                        @if (!Model.IsDeleted)
                        {
                            <span class="badge badge-active">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Đã ẩn</span>
                        }
                    </div>
                </div>
            </div>

            <div class="content-card p-5 fade-in-up" style="animation-delay:.12s;">
                <button type="button" onclick="submitForm()" class="btn-primary w-full justify-center">
                    <span class="material-icons-round text-base">save</span>
                    Lưu thay đổi
                </button>
                <a href="/Moderator/ManageBlog" class="btn-outline w-full justify-center mt-3">
                    Hủy
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
<script>
function getEditor() {
    return (typeof tinymce !== 'undefined') ? tinymce.get('contentInput') : null;
}

function syncEditorToTextarea() {
    var editor = getEditor();
    if (editor) {
        editor.save();
    }
}

function getContentValue() {
    var editor = getEditor();
    if (editor) {
        return editor.getContent();
    }
    return getContentInput().value;
}

function submitForm() {
    syncEditorToTextarea();
    var title = document.getElementById('titleInput').value.trim();
    var slug = document.getElementById('slugInput').value.trim();
    var content = getContentValue().trim();

    document.getElementById('titleError').classList.toggle('hidden', !!title);
    document.getElementById('slugError').classList.toggle('hidden', !!slug);
    document.getElementById('contentError').classList.toggle('hidden', !!content);

    if (!title || !slug || !content) return;
    document.getElementById('editBlogForm').submit();
}

function getCsrfToken() {
    return document.querySelector('#editBlogForm input[name="__RequestVerificationToken"]').value;
}

function getContentInput() {
    return document.getElementById('contentInput');
}

function getContentPreview() {
    return document.getElementById('contentPreview');
}

function renderContentPreview() {
    var content = getContentValue().trim();
    var preview = getContentPreview();

    if (!content) {
        preview.innerHTML = '<p class="text-sm text-gray-400 italic">Bản xem trước của bài viết sẽ hiển thị tại đây.</p>';
        return;
    }

    preview.innerHTML = content;
}

async function uploadMediaFiles(files, endpoint, emptyMessage) {
    if (!files || !files.length) {
        throw new Error(emptyMessage);
    }
    var formData = new FormData();
    Array.from(files).forEach(function(file) {
        formData.append('files', file);
    });
    formData.append('__RequestVerificationToken', getCsrfToken());
    var response = await fetch(endpoint, { method: 'POST', body: formData });
    var result = await response.json();
    if (!result.success || !result.data || !Array.isArray(result.data.urls) || result.data.urls.length === 0) {
        throw new Error(result.message || 'Upload failed.');
    }
    return result.data.urls;
}

function pickLocalFile(accept) {
    return new Promise(function(resolve) {
        var input = document.createElement('input');
        input.type = 'file';
        input.accept = accept;
        input.onchange = function() {
            resolve((input.files && input.files.length > 0) ? input.files[0] : null);
        };
        input.click();
    });
}

function getBlogMediaEndpoint(isImage) {
    return isImage
        ? '/Moderator/UploadBlogContentMedia?mediaType=image'
        : '/Moderator/UploadBlogContentMedia?mediaType=video';
}

function uploadSingleImageForTiny(blobInfo) {
    return new Promise(async function(resolve, reject) {
        try {
            var urls = await uploadMediaFiles(
                [blobInfo.blob()],
                getBlogMediaEndpoint(true),
                'Vui lòng chọn it nhất mot anh.'
            );
            resolve(urls[0]);
        } catch (error) {
            reject({ message: error.message || 'Không thể tải lên ảnh.' });
        }
    });
}

function handleTinyFilePicker(callback, meta) {
    var isImage = meta.filetype === 'image';
    var accept = isImage
        ? 'image/*'
        : 'video/mp4,video/webm,video/ogg,video/quicktime,.mp4,.webm,.ogg,.mov';
    var endpoint = getBlogMediaEndpoint(isImage);

    pickLocalFile(accept).then(async function(file) {
        if (!file) return;
        try {
            var urls = await uploadMediaFiles([file], endpoint, 'Vui lòng chọn file ?? upload.');
            var url = urls[0];
            if (isImage) {
                callback(url, { alt: file.name || 'image' });
            } else {
                callback(url, { source2: '', poster: '' });
            }
            if (typeof window.showToast === 'function') {
                window.showToast('Tải media thành công.', { type: 'success' });
            }
        } catch (error) {
            if (typeof window.showToast === 'function') {
                window.showToast(error.message || 'Không thể tải lên media.', { type: 'error' });
            }
        }
    });
}

function initTinyMce() {
    if (typeof tinymce === 'undefined') return;

    tinymce.init({
        selector: '#contentInput',
        license_key: 'gpl',
        menubar: false,
        height: 520,
        branding: false,
        plugins: 'link lists table code fullscreen autoresize image media',
        toolbar: 'undo redo | blocks | bold italic underline | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist | link image media | removeformat | code fullscreen',
        content_style: 'body{font-family:Segoe UI,Arial,sans-serif;font-size:14px;line-height:1.7;} img,video{max-width:100%;height:auto;border-radius:12px;}',
        automatic_uploads: true,
        images_upload_handler: function(blobInfo) {
            return uploadSingleImageForTiny(blobInfo);
        },
        file_picker_types: 'image media',
        file_picker_callback: function(callback, value, meta) {
            handleTinyFilePicker(callback, meta);
        },
        setup: function(editor) {
            editor.on('init', function() {
                syncEditorToTextarea();
                renderContentPreview();
            });
            editor.on('input change undo redo setcontent', function() {
                syncEditorToTextarea();
                renderContentPreview();
            });
        }
    });
}

getContentInput().addEventListener('input', function() {
    renderContentPreview();
});

initTinyMce();
renderContentPreview();
</script>
}

