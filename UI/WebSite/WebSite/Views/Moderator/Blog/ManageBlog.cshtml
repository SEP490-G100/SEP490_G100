@using WebSite.Enums
@model WebSite.Models.Blog.BlogListResponse
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Quản lý blog";
    var currentSearch    = ViewBag.Search    as string ?? "";
    var currentStatus    = ViewBag.Status    as string ?? "";
    var currentIsDeleted = ViewBag.IsDeleted as string ?? "";
    var currentPage      = Model?.Page       ?? 1;
    var totalPages       = Model?.TotalPages  ?? 1;
    var blogs            = Model?.Items       ?? new List<WebSite.Models.Blog.BlogDto>();

    string StatusLabel(BlogStatus s) => s switch {
        BlogStatus.Published => "Đã xuất bản",
        BlogStatus.Archived  => "Đã lưu trữ",
        _                    => "Bản nháp"
    };

    string StatusBadge(BlogStatus s) => s switch {
        BlogStatus.Published => "badge-active",
        BlogStatus.Archived  => "badge-pending",
        _                    => "badge-inactive"
    };
}

<!-- PAGE HEADER -->
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <h1 class="page-title mt-2">
            Quản lý <span class="gradient-text">blog</span>
        </h1>
        <p class="page-subtitle">Thêm mới, cập nhật hoặc quản lý các bài viết blog.</p>
    </div>
    <a href="/Moderator/CreateBlog" class="btn-primary flex-shrink-0">
        <span class="material-icons-round text-base">add_circle_outline</span>
        Thêm bài viết mới
    </a>
</div>

<!-- Alerts -->
@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<!-- FILTER -->
<form method="get" action="/Moderator/ManageBlog" class="mod-filter-form">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">
            <!-- Search -->
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Tìm theo tiêu đề hoặc đường dẫn..."
                       class="search-input pl-9 w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>
            <!-- Status Filter -->
            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">flag</span>
                <select name="status" onchange="this.form.submit()"
                        class="search-input md:w-40 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">Tất cả trạng thái</option>
                    <option value="@((int)BlogStatus.Draft)" selected="@(currentStatus == ((int)BlogStatus.Draft).ToString() ? "selected" : null)">Bản nháp</option>
                    <option value="@((int)BlogStatus.Published)" selected="@(currentStatus == ((int)BlogStatus.Published).ToString() ? "selected" : null)">Đã xuất bản</option>
                    <option value="@((int)BlogStatus.Archived)" selected="@(currentStatus == ((int)BlogStatus.Archived).ToString() ? "selected" : null)">Đã lưu trữ</option>
                </select>
            </div>
            <!-- Category Filter -->
            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">category</span>
                <select name="categoryId" onchange="this.form.submit()"
                        class="search-input md:w-48 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">Tất cả danh mục</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var c in ViewBag.Categories as List<WebSite.Models.Blog.BlogCategoryOption>)
                        {
                            if ((ViewBag.CategoryId as string) == c.Id.ToString())
                            {
                                <option value="@c.Id" selected="selected">@c.Name</option>
                            }
                            else
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <!-- Active/Inactive Filter -->
            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                <select name="isDeleted" onchange="this.form.submit()"
                        class="search-input md:w-40 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">Tất cả hiển thị</option>
                    <option value="false" selected="@(currentIsDeleted == "false" ? "selected" : null)">Hoạt động</option>
                    <option value="true"  selected="@(currentIsDeleted == "true"  ? "selected" : null)">Đã ẩn</option>
                </select>
            </div>
            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Tìm kiếm
            </button>
        </div>
    </div>
</form>

<!-- TABLE -->
<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
    <div class="card-header">
        <span class="text-sm text-gray-500">
            Hiển thị <span class="font-bold text-gray-800">@blogs.Count</span>
            trên <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> bài viết
        </span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Tiêu đề</th>
                    <th class="text-left">Danh mục</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Lượt xem</th>
                    <th class="text-center">Hoạt động</th>
                    <th class="text-left">Ngày tạo</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!blogs.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">article</span>
                            <p class="font-semibold text-gray-400">Không tìm thấy bài viết nào.</p>
                            <p class="text-xs text-gray-300 mt-1">Vui lòng thử lại với bộ lọc khác hoặc tạo bài viết mới.</p>
                        </td>
                    </tr>
                }
                @{ int rowNum = ((currentPage - 1) * (Model?.PageSize > 0 ? Model.PageSize : 10)) + 1; }
                @foreach (var blog in blogs)
                {
                    var shortTitle = blog.Title.Length > 50 ? blog.Title.Substring(0, 50) + "…" : blog.Title;
                    var escapedTitle = blog.Title.Replace("'", "\\'").Replace("\"", "&quot;");
                    var shortTitleEsc = escapedTitle.Length > 50 ? escapedTitle.Substring(0, 50) + "…" : escapedTitle;

                    <tr class="account-row">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-indigo-50 flex items-center justify-center flex-shrink-0">
                                    <span class="material-icons-round text-indigo-400 text-sm">article</span>
                                </div>
                                <div>
                                    <span class="font-semibold text-gray-800 text-sm" title="@blog.Title">@shortTitle</span>
                                    @if (!string.IsNullOrEmpty(blog.AuthorName))
                                    {
                                        <p class="text-xs text-gray-400">@blog.AuthorName</p>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(blog.CategoryName))
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-600 border border-blue-100">@blog.CategoryName</span>
                            }
                            else
                            {
                                <span class="text-gray-300 text-xs">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @StatusBadge(blog.Status)">@StatusLabel(blog.Status)</span>
                        </td>
                        <td class="text-center">
                            <div class="flex items-center justify-center gap-1 text-gray-500 text-sm">
                                <span class="material-icons-round text-gray-300 text-sm">visibility</span>
                                @blog.ViewCount
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <div class="w-2 h-2 rounded-full @(blog.IsDeleted ? "bg-red-400 ring-2 ring-red-100" : "bg-emerald-400 ring-2 ring-emerald-100")"></div>
                                <span class="badge @(blog.IsDeleted ? "badge-inactive" : "badge-active")">@(blog.IsDeleted ? "Đã ẩn" : "Hoạt động")</span>
                            </div>
                        </td>
                        <td class="text-gray-500 text-xs">@blog.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <!-- Edit -->
                                <a href="/Moderator/ViewBlogDetail/@blog.Id" title="Xem &amp; Sửa"
                                   class="w-8 h-8 rounded-xl hover:bg-blue-50 hover:text-blue-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-blue-200">
                                    <span class="material-icons-round text-base">edit</span>
                                </a>
                                <!-- Toggle Active/Inactive -->
                                @if (!blog.IsDeleted)
                                {
                                    <button onclick="confirmToggle('@blog.Id', '@shortTitleEsc', false)" title="Vô hiệu hóa"
                                            class="w-8 h-8 rounded-xl hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-red-200">
                                        <span class="material-icons-round text-base">block</span>
                                    </button>
                                }
                                else
                                {
                                    <button onclick="confirmToggle('@blog.Id', '@shortTitleEsc', true)" title="Kích hoạt"
                                            class="w-8 h-8 rounded-xl hover:bg-emerald-50 hover:text-emerald-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-emerald-200">
                                        <span class="material-icons-round text-base">check_circle_outline</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Trang <span class="font-bold text-gray-600">@currentPage</span> / <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&status=@currentStatus&isDeleted=@currentIsDeleted&categoryId=@ViewBag.CategoryId&page=@(currentPage-1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }
            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&status=@currentStatus&isDeleted=@currentIsDeleted&categoryId=@ViewBag.CategoryId&page=@p" class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }
            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&status=@currentStatus&isDeleted=@currentIsDeleted&categoryId=@ViewBag.CategoryId&page=@(currentPage+1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- TOGGLE MODAL -->
<div id="toggleModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeModal('toggleModal')">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="toggleIconBg" class="w-12 h-12 rounded-2xl flex items-center justify-center">
                <span id="toggleIcon" class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="toggleTitle" class="text-lg font-bold text-gray-900"></h3>
                <p id="toggleSubtitle" class="text-sm text-gray-400"></p>
            </div>
        </div>
        <p id="toggleMessage" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed"></p>
        <div id="toggleFormContainer" class="flex gap-2"></div>
    </div>
</div>

@section Scripts {
<form id="csrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
<script>
function confirmToggle(id, name, activate) {
    document.getElementById('toggleTitle').textContent = activate ? 'Kích hoạt bài viết' : 'Vô hiệu hóa bài viết';
    document.getElementById('toggleSubtitle').textContent = activate ? 'Hiển thị bài viết với người đọc' : 'Tạm thời ẩn bài viết này';
    document.getElementById('toggleMessage').innerHTML = (activate
        ? 'Bạn có chắc chắn muốn kích hoạt: <strong>' + name + '</strong>?'
        : 'Bạn có chắc chắn muốn vô hiệu hóa: <strong>' + name + '</strong>?');

    var iconBg = document.getElementById('toggleIconBg');
    var icon   = document.getElementById('toggleIcon');
    iconBg.style.background = activate ? '#D1FAE5' : '#FEE2E2';
    icon.style.color        = activate ? '#10B981' : '#EF4444';
    icon.textContent        = activate ? 'check_circle_outline' : 'block';

    var btnClass = activate ? 'btn-success' : 'btn-danger';
    var btnText  = activate ? 'Xác nhận Kích hoạt' : 'Xác nhận Vô hiệu hóa';
    var token = document.querySelector('#csrfForm input[name="__RequestVerificationToken"]').value;

    document.getElementById('toggleFormContainer').innerHTML =
        '<button onclick="closeModal(\'toggleModal\')" class="btn-outline flex-1 justify-center">Hủy</button>' +
        '<form method="post" action="/Moderator/ToggleBlogStatus" class="flex-1 flex">' +
        '<input name="__RequestVerificationToken" type="hidden" value="' + token + '" />' +
        '<input type="hidden" name="id" value="' + id + '" />' +
        '<input type="hidden" name="activate" value="' + (activate ? "true" : "false") + '" />' +
        '<button type="submit" class="' + btnClass + ' w-full justify-center">' + btnText + '</button>' +
        '</form>';
    document.getElementById('toggleModal').classList.remove('hidden');
}
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
</script>
<style>
.btn-danger  { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#FEE2E2;color:#EF4444;border:1.5px solid #FECACA; }
.btn-danger:hover  { background:#FCA5A5;border-color:#F87171; }
.btn-success { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#D1FAE5;color:#10B981;border:1.5px solid #A7F3D0; }
.btn-success:hover { background:#A7F3D0;border-color:#6EE7B7; }
.badge-pending { background:#FEF3C7;color:#D97706;border:1px solid #FDE68A; }
</style>
}
