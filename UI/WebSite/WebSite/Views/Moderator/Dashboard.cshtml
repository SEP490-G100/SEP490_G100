@using WebSite.Models.Account
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    int totalUsers    = ViewBag.TotalUsers    ?? 0;
    int totalParents  = ViewBag.TotalParents  ?? 0;
    int totalNannies  = ViewBag.TotalNannies  ?? 0;
    int totalInactive = ViewBag.TotalInactive ?? 0;
    var recentAccounts = ViewBag.RecentAccounts as List<AccountDto> ?? new List<AccountDto>();
}

<!-- Page header -->
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">System Overview</h1>
    <p class="text-sm text-gray-500 mt-1">Welcome back! Here's what's happening on NannyMatch today.</p>
</div>

<!-- ===== STAT CARDS ===== -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-7">

    <!-- Total Users -->
    <div class="stat-card p-5">
        <div class="flex items-start justify-between mb-4">
            <div class="icon-badge" style="background:linear-gradient(135deg,#FFF7ED,#FED7AA);">
                <span class="material-icons-round text-orange-500 text-2xl">people</span>
            </div>
        </div>
        <div class="text-3xl font-bold text-gray-900 mb-0.5">@totalUsers.ToString("N0")</div>
        <div class="text-sm text-gray-500">Total Users</div>
        <div class="mt-3 flex gap-3 text-xs text-gray-400">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-violet-400 inline-block"></span>@totalParents Parents</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-blue-400 inline-block"></span>@totalNannies Nannies</span>
        </div>
    </div>

    <!-- Parents -->
    <div class="stat-card p-5">
        <div class="flex items-start justify-between mb-4">
            <div class="icon-badge" style="background:linear-gradient(135deg,#EDE9FE,#DDD6FE);">
                <span class="material-icons-round text-violet-500 text-2xl">supervisor_account</span>
            </div>
        </div>
        <div class="text-3xl font-bold text-gray-900 mb-0.5">@totalParents.ToString("N0")</div>
        <div class="text-sm text-gray-500">Parents</div>
        @if (totalUsers > 0)
        {
            var pct = (double)totalParents / totalUsers * 100;
            <div class="mt-3">
                <div class="w-full bg-gray-100 rounded-full h-1.5">
                    <div class="bg-violet-400 h-1.5 rounded-full" style="width:@pct.ToString("F0")%"></div>
                </div>
            </div>
        }
    </div>

    <!-- Nannies -->
    <div class="stat-card p-5">
        <div class="flex items-start justify-between mb-4">
            <div class="icon-badge" style="background:linear-gradient(135deg,#DBEAFE,#BFDBFE);">
                <span class="material-icons-round text-blue-500 text-2xl">child_care</span>
            </div>
        </div>
        <div class="text-3xl font-bold text-gray-900 mb-0.5">@totalNannies.ToString("N0")</div>
        <div class="text-sm text-gray-500">Nannies</div>
        @if (totalUsers > 0)
        {
            var pct = (double)totalNannies / totalUsers * 100;
            <div class="mt-3">
                <div class="w-full bg-gray-100 rounded-full h-1.5">
                    <div class="bg-blue-400 h-1.5 rounded-full" style="width:@pct.ToString("F0")%"></div>
                </div>
            </div>
        }
    </div>

    <!-- Inactive accounts -->
    <div class="stat-card p-5">
        <div class="flex items-start justify-between mb-4">
            <div class="icon-badge" style="background:linear-gradient(135deg,#FEE2E2,#FECACA);">
                <span class="material-icons-round text-red-500 text-2xl">block</span>
            </div>
        </div>
        <div class="text-3xl font-bold text-gray-900 mb-0.5">@totalInactive.ToString("N0")</div>
        <div class="text-sm text-gray-500">Inactive Accounts</div>
        @if (totalUsers > 0)
        {
            var pct = (double)totalInactive / totalUsers * 100;
            <div class="mt-3">
                <div class="w-full bg-gray-100 rounded-full h-1.5">
                    <div class="bg-red-400 h-1.5 rounded-full" style="width:@pct.ToString("F0")%"></div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ===== ROW 2: Quick Actions + Recent Accounts ===== -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-5 mb-7">

    <!-- Quick Actions -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <h2 class="font-bold text-gray-900 text-base mb-4">Quick Actions</h2>
        <div class="space-y-3">
            <a href="/Moderator/NannyVerification"
               class="flex items-center gap-3 p-3 rounded-xl hover:bg-amber-50 border border-amber-100 group transition-all">
                <div class="w-9 h-9 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
                    <span class="material-icons-round text-amber-600 text-lg">verified_user</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-700 group-hover:text-amber-700">Review Verifications</p>
                    <p class="text-xs text-gray-400">Pending requests</p>
                </div>
                <span class="material-icons-round text-gray-300 group-hover:text-amber-500 text-lg">arrow_forward_ios</span>
            </a>
            <a href="/Moderator/ViewReports"
               class="flex items-center gap-3 p-3 rounded-xl hover:bg-red-50 border border-red-100 group transition-all">
                <div class="w-9 h-9 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0">
                    <span class="material-icons-round text-red-500 text-lg">flag</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-700 group-hover:text-red-700">Handle Reports</p>
                    <p class="text-xs text-gray-400">Violation reports</p>
                </div>
                <span class="material-icons-round text-gray-300 group-hover:text-red-400 text-lg">arrow_forward_ios</span>
            </a>
            <a href="/Moderator/ManageAccount"
               class="flex items-center gap-3 p-3 rounded-xl hover:bg-orange-50 border border-orange-100 group transition-all">
                <div class="w-9 h-9 rounded-lg bg-orange-100 flex items-center justify-center flex-shrink-0">
                    <span class="material-icons-round text-orange-500 text-lg">manage_accounts</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-700 group-hover:text-orange-700">Manage Accounts</p>
                    <p class="text-xs text-gray-400">@totalUsers total accounts</p>
                </div>
                <span class="material-icons-round text-gray-300 group-hover:text-orange-400 text-lg">arrow_forward_ios</span>
            </a>
            <a href="/Moderator/ModerateJobPostings"
               class="flex items-center gap-3 p-3 rounded-xl hover:bg-violet-50 border border-violet-100 group transition-all">
                <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
                    <span class="material-icons-round text-violet-500 text-lg">work</span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-700 group-hover:text-violet-700">Review Job Postings</p>
                    <p class="text-xs text-gray-400">Pending approval</p>
                </div>
                <span class="material-icons-round text-gray-300 group-hover:text-violet-400 text-lg">arrow_forward_ios</span>
            </a>
        </div>
    </div>

    <!-- Recent Accounts -->
    <div class="xl:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
            <h2 class="font-bold text-gray-900 text-base">Recently Joined</h2>
            <a href="/Moderator/ManageAccount" class="text-sm font-semibold text-orange-500 hover:text-orange-600">View all</a>
        </div>

        @if (!recentAccounts.Any())
        {
            <div class="px-6 py-10 text-center text-gray-400 text-sm">
                <span class="material-icons-round text-3xl mb-2 block">people_outline</span>
                No user data available yet.
            </div>
        }
        else
        {
            <div class="divide-y divide-gray-50">
                @foreach (var acc in recentAccounts)
                {
                    var avatarColors = new[] { "#F97316","#3B82F6","#8B5CF6","#10B981","#F59E0B" };
                    var bg = avatarColors[Math.Abs(acc.Id.GetHashCode()) % avatarColors.Length];
                    <div class="flex items-center gap-3 px-6 py-3.5 hover:bg-gray-50 transition-colors">
                        @if (!string.IsNullOrEmpty(acc.AvatarUrl))
                        {
                            <img src="@acc.AvatarUrl" class="user-avatar object-cover flex-shrink-0" style="background:@bg;" />
                        }
                        else
                        {
                            <div class="user-avatar flex-shrink-0" style="background:@bg;">@acc.Avatar</div>
                        }
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-gray-800 truncate">@acc.FullName</p>
                            <p class="text-xs text-gray-400 truncate">@acc.Email</p>
                        </div>
                        <div class="flex flex-col items-end gap-1 flex-shrink-0">
                            <span class="badge @(acc.PrimaryRole == "Parent" ? "badge-parent" : acc.PrimaryRole == "Nanny" ? "badge-nanny" : "badge-mod")">@acc.PrimaryRole</span>
                            <span class="text-[10px] text-gray-400">@acc.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ===== User Breakdown ===== -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
    <h2 class="font-bold text-gray-900 text-base mb-4">User Breakdown</h2>
    @if (totalUsers == 0)
    {
        <p class="text-sm text-gray-400">No data available.</p>
    }
    else
    {
        var pParent = (double)totalParents / totalUsers * 100;
        var pNanny  = (double)totalNannies / totalUsers * 100;
        var pOther  = Math.Max(0, 100 - pParent - pNanny);

        <div class="space-y-3">
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 font-medium flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-violet-400 inline-block"></span>Parents
                    </span>
                    <span class="font-bold text-gray-800">@totalParents.ToString("N0") <span class="text-gray-400 font-normal text-xs">(@pParent.ToString("F0")%)</span></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5">
                    <div class="bg-gradient-to-r from-violet-400 to-violet-500 h-2.5 rounded-full" style="width:@pParent.ToString("F0")%"></div>
                </div>
            </div>
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600 font-medium flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-400 inline-block"></span>Nannies
                    </span>
                    <span class="font-bold text-gray-800">@totalNannies.ToString("N0") <span class="text-gray-400 font-normal text-xs">(@pNanny.ToString("F0")%)</span></span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5">
                    <div class="bg-gradient-to-r from-blue-400 to-blue-500 h-2.5 rounded-full" style="width:@pNanny.ToString("F0")%"></div>
                </div>
            </div>
            @if (pOther > 0)
            {
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span class="text-gray-600 font-medium flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-gray-400 inline-block"></span>Others (Mod / Admin)
                        </span>
                        <span class="font-bold text-gray-800"><span class="text-gray-400 font-normal text-xs">(@pOther.ToString("F0")%)</span></span>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-2.5">
                        <div class="bg-gradient-to-r from-gray-300 to-gray-400 h-2.5 rounded-full" style="width:@pOther.ToString("F0")%"></div>
                    </div>
                </div>
            }
        </div>
    }
</div>
