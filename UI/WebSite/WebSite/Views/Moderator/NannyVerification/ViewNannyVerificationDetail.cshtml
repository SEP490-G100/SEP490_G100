@model WebSite.Models.Verification.VerificationRequestDetailDto
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Verification Detail";

    var avatarColors = new[] { "#F97316", "#3B82F6", "#8B5CF6", "#10B981", "#F59E0B", "#EF4444", "#EC4899", "#6366F1" };
    var avatarBg = avatarColors[Math.Abs(Model.NannyUserId.GetHashCode()) % avatarColors.Length];
    var isPending = Model.Status == 1;
    var fullAddress = string.Join(", ", new[] { Model.NannyAddress, Model.NannyWard, Model.NannyDistrict, Model.NannyCity }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
    var genderLabel = Model.NannyGender switch { 1 => "Male", 2 => "Female", _ => "Not specified" };
    var salaryTypeLabel = Model.SalaryType == 1 ? "Per Hour" : "Per Month";
    var skillGroups = Model.Skills
        .GroupBy(skill => string.IsNullOrWhiteSpace(skill.SkillCategory) ? "Other Skills" : skill.SkillCategory)
        .OrderBy(group => group.Key)
        .ToList();
    var identityDocuments = Model.Documents.Where(doc => doc.DocumentType == (int)WebSite.Enums.VerificationDocumentType.IdentityCard).ToList();
    var degreeDocuments = Model.Documents.Where(doc => doc.DocumentType == (int)WebSite.Enums.VerificationDocumentType.DegreeCertificate).ToList();
    var healthDocuments = Model.Documents.Where(doc => doc.DocumentType == (int)WebSite.Enums.VerificationDocumentType.HealthCertificate).ToList();
}

<div class="flex items-center gap-2 text-sm text-gray-400 mb-6 fade-in-up">
    <a href="/Moderator/ManageNannyVerification" class="hover:text-orange-500 transition-colors font-semibold">Nanny Verification</a>
    <span class="material-icons-round text-base">chevron_right</span>
    <span class="text-gray-600 font-semibold">@Model.FullName</span>
</div>

<div class="content-card p-6 sm:p-7 mb-6 fade-in-up overflow-hidden" style="background:linear-gradient(135deg,#FFFBEB 0%,#FFF7ED 45%,#FFFFFF 100%); border:1px solid #FED7AA;">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <div class="flex items-start gap-4">
            @if (!string.IsNullOrEmpty(Model.NannyAvatarUrl))
            {
                <img src="@Model.NannyAvatarUrl" alt="@Model.FullName" class="w-20 h-20 rounded-3xl object-cover shadow-lg border-4 border-white" />
            }
            else
            {
                <div class="w-20 h-20 rounded-3xl flex items-center justify-center text-white text-3xl font-bold shadow-lg border-4 border-white"
                     style="background:@avatarBg;">
                    @Model.FullName.FirstOrDefault().ToString().ToUpper()
                </div>
            }

            <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-orange-500">Moderator Review</p>
                <h1 class="text-2xl sm:text-3xl font-black text-gray-900 mt-2">@Model.FullName</h1>
                <p class="text-sm text-gray-500 mt-2 break-all">@Model.NannyEmail</p>

                <div class="flex flex-wrap gap-2 mt-4">
                    <span class="badge @Model.StatusClass px-3 py-1.5 text-sm">@Model.StatusLabel</span>
                    <span class="badge badge-nanny px-3 py-1.5 text-sm">Nanny</span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white text-gray-600 border border-orange-100 px-3 py-1.5 text-xs font-semibold">
                        <span class="material-icons-round text-sm">folder_open</span>
                        @Model.Documents.Count document(s)
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white text-gray-600 border border-orange-100 px-3 py-1.5 text-xs font-semibold">
                        <span class="material-icons-round text-sm">stars</span>
                        @Model.Skills.Count skill(s)
                    </span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-white text-gray-600 border border-orange-100 px-3 py-1.5 text-xs font-semibold">
                        <span class="material-icons-round text-sm">workspace_premium</span>
                        @Model.Certificates.Count certificate(s)
                    </span>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 lg:justify-end">
            <div class="rounded-2xl bg-white/90 border border-orange-100 px-4 py-3 min-w-[180px]">
                <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Submitted</p>
                <p class="font-bold text-gray-800 mt-1">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
            </div>
            @if (Model.ReviewedAt.HasValue)
            {
                <div class="rounded-2xl bg-white/90 border border-orange-100 px-4 py-3 min-w-[180px]">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Reviewed</p>
                    <p class="font-bold text-gray-800 mt-1">@Model.ReviewedAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                </div>
            }
            <a href="/Moderator/ManageNannyVerification" class="btn-outline self-start lg:self-stretch">
                <span class="material-icons-round text-base">arrow_back</span>
                Back to List
            </a>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-5 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}

<div class="grid grid-cols-1 xl:grid-cols-12 gap-5">
    <div class="xl:col-span-4 space-y-5">
        <div class="content-card p-5 fade-in-up">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-icons-round text-orange-500 text-lg">person</span>
                <h2 class="font-bold text-gray-900">Profile Snapshot</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 gap-3 text-sm">
                <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Phone</p>
                    <p class="font-semibold text-gray-700 mt-1">@(Model.NannyPhoneNumber ?? "-")</p>
                </div>
                <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Date of Birth</p>
                    <p class="font-semibold text-gray-700 mt-1">@(Model.NannyDateOfBirth.HasValue ? Model.NannyDateOfBirth.Value.ToString("MMM dd, yyyy") : "-")</p>
                </div>
                <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Gender</p>
                    <p class="font-semibold text-gray-700 mt-1">@genderLabel</p>
                </div>
                <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Experience</p>
                    <p class="font-semibold text-gray-700 mt-1">@(Model.YearsOfExperience.HasValue ? $"{Model.YearsOfExperience} year(s)" : "-")</p>
                </div>
                <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Education</p>
                    <p class="font-semibold text-gray-700 mt-1">@Model.EducationLabel</p>
                </div>
                <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3">
                    <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Travel Distance</p>
                    <p class="font-semibold text-gray-700 mt-1">@(Model.MaxTravelDistance.HasValue ? $"{Model.MaxTravelDistance} km" : "-")</p>
                </div>
            </div>

            <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3 mt-3">
                <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Expected Salary</p>
                <p class="font-semibold text-gray-700 mt-1">@(Model.ExpectedSalaryMin?.ToString("N0") ?? "-") - @(Model.ExpectedSalaryMax?.ToString("N0") ?? "-") VND (@salaryTypeLabel)</p>
            </div>

            <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3 mt-3">
                <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Address</p>
                <p class="font-semibold text-gray-700 mt-1 break-words">@(string.IsNullOrWhiteSpace(fullAddress) ? "-" : fullAddress)</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <div class="content-card p-5 fade-in-up">
                <div class="flex items-center gap-2 mb-3">
                    <span class="material-icons-round text-orange-500 text-lg">notes</span>
                    <h2 class="font-bold text-gray-900">About This Nanny</h2>
                </div>
                <p class="text-sm leading-7 text-gray-600">@Model.Bio</p>
            </div>
        }

        @if (Model.Status == 3 && !string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="content-card p-5 fade-in-up border-l-4 border-red-400">
                <div class="flex items-center gap-2 mb-3">
                    <span class="material-icons-round text-red-500 text-lg">cancel</span>
                    <h2 class="font-bold text-red-600">Rejection Reason</h2>
                </div>
                <p class="text-sm leading-7 text-gray-600">@Model.RejectionReason</p>
            </div>
        }
    </div>

    <div class="xl:col-span-8 space-y-5">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <div class="content-card p-5 fade-in-up">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-500 text-lg">psychology</span>
                        <h2 class="font-bold text-gray-900">Professional Skills</h2>
                    </div>
                    <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">@Model.Skills.Count item(s)</span>
                </div>

                @if (!Model.Skills.Any())
                {
                    <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50 px-4 py-10 text-center text-sm text-gray-400">
                        No skills added to the profile.
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var group in skillGroups)
                        {
                            <div class="rounded-2xl border border-gray-100 bg-gray-50/80 p-4">
                                <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-3">@group.Key</p>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var skill in group)
                                    {
                                        <span class="inline-flex items-center gap-2 rounded-full bg-white border border-orange-100 px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm">
                                            <span>@skill.SkillName</span>
                                            <span class="text-xs font-medium text-orange-500">@skill.ProficiencyLabel</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="content-card p-5 fade-in-up">
                <div class="flex items-center justify-between gap-3 mb-4">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-500 text-lg">workspace_premium</span>
                        <h2 class="font-bold text-gray-900">Certificates</h2>
                    </div>
                    <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">@Model.Certificates.Count item(s)</span>
                </div>

                @if (!Model.Certificates.Any())
                {
                    <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50 px-4 py-10 text-center text-sm text-gray-400">
                        No nanny certificates found.
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var certificate in Model.Certificates)
                        {
                            <div class="rounded-2xl border border-gray-100 bg-gray-50/80 p-4">
                                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="font-bold text-gray-800 break-words">@certificate.Name</p>
                                        <p class="text-sm text-gray-500 mt-1">@(string.IsNullOrWhiteSpace(certificate.IssuingOrganization) ? "Issuing organization not specified" : certificate.IssuingOrganization)</p>
                                    </div>
                                    <span class="badge @certificate.VerificationStatusClass whitespace-nowrap">@certificate.VerificationStatusLabel</span>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 text-sm">
                                    <div class="rounded-xl bg-white border border-gray-100 px-3 py-2">
                                        <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Issue Date</p>
                                        <p class="font-semibold text-gray-700 mt-1">@(certificate.IssueDate.HasValue ? certificate.IssueDate.Value.ToString("MMM dd, yyyy") : "-")</p>
                                    </div>
                                    <div class="rounded-xl bg-white border border-gray-100 px-3 py-2">
                                        <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold">Expiry Date</p>
                                        <p class="font-semibold text-gray-700 mt-1">@(certificate.ExpiryDate.HasValue ? certificate.ExpiryDate.Value.ToString("MMM dd, yyyy") : "-")</p>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(certificate.CertificateUrl))
                                {
                                    <div class="mt-4">
                                        <a href="@certificate.CertificateUrl" target="_blank" rel="noopener"
                                           class="inline-flex items-center gap-1.5 rounded-xl bg-blue-50 border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-600 hover:bg-blue-100 transition-all">
                                            <span class="material-icons-round text-sm">open_in_new</span>
                                            View certificate
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="content-card p-0 overflow-hidden fade-in-up">
            <div class="card-header">
                <div class="flex items-center gap-2">
                    <span class="material-icons-round text-orange-500 text-lg">folder_open</span>
                    <h2>Verification Documents</h2>
                </div>
                <span class="text-sm text-gray-400">@Model.Documents.Count file(s)</span>
            </div>

            @if (!Model.Documents.Any())
            {
                <div class="px-6 py-12 text-center text-gray-400 text-sm">
                    <span class="material-icons-round text-4xl mb-2 block text-gray-200">folder_off</span>
                    No documents uploaded.
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 p-5">
                    @foreach (var documentGroup in new[]
                    {
                        new { Title = "National ID", Icon = "badge", BorderClass = "border-orange-200", BackgroundClass = "bg-orange-50/50", Documents = identityDocuments },
                        new { Title = "Degree / Certificate", Icon = "school", BorderClass = "border-blue-200", BackgroundClass = "bg-blue-50/50", Documents = degreeDocuments },
                        new { Title = "Health Certificate", Icon = "medical_services", BorderClass = "border-emerald-200", BackgroundClass = "bg-emerald-50/50", Documents = healthDocuments }
                    })
                    {
                        <div class="rounded-3xl border @documentGroup.BorderClass @documentGroup.BackgroundClass p-4 shadow-sm">
                            <div class="flex items-center justify-between gap-3 mb-4">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="material-icons-round text-orange-500 text-lg">@documentGroup.Icon</span>
                                    <h3 class="font-bold text-gray-900 text-sm sm:text-base">@documentGroup.Title</h3>
                                </div>
                                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">@documentGroup.Documents.Count file(s)</span>
                            </div>

                            @if (!documentGroup.Documents.Any())
                            {
                                <div class="rounded-2xl border border-dashed border-gray-200 bg-white/80 px-4 py-8 text-center text-sm text-gray-400">
                                    No file uploaded.
                                </div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    @foreach (var doc in documentGroup.Documents)
                                    {
                                        var ext = System.IO.Path.GetExtension(doc.FileName).ToLowerInvariant();
                                        var isImage = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
                                        var isPdf = ext == ".pdf";

                                        <div class="rounded-2xl border border-white/80 bg-white p-3 shadow-sm">
                                            <div class="flex items-start gap-3">
                                                <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0"
                                                     style="background:linear-gradient(135deg,#FFF7ED,#FED7AA);">
                                                    <span class="material-icons-round text-orange-500 text-xl">@doc.TypeIcon</span>
                                                </div>

                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-bold text-gray-800 break-all">@doc.FileName</p>
                                                    @if (!string.IsNullOrEmpty(doc.FileSizeLabel))
                                                    {
                                                        <p class="text-xs text-gray-400 mt-1">@doc.FileSizeLabel</p>
                                                    }
                                                </div>
                                            </div>

                                            <div class="flex items-center justify-between gap-3 mt-3">
                                                @if (isImage)
                                                {
                                                    <a href="@doc.DocumentUrl" target="_blank" rel="noopener" title="View @doc.TypeLabel" class="flex-shrink-0">
                                                        <img src="@doc.DocumentUrl" alt="@doc.TypeLabel"
                                                             class="w-14 h-14 rounded-2xl object-cover border border-gray-200 hover:scale-105 transition-transform" />
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-400">
                                                        <span class="material-icons-round text-sm">picture_as_pdf</span>
                                                        PDF document
                                                    </div>
                                                }

                                                <a href="@doc.DocumentUrl" target="_blank" rel="noopener"
                                                   class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-blue-50 border border-blue-200 px-3 py-2 text-xs font-semibold text-blue-600 hover:bg-blue-100 transition-all flex-shrink-0">
                                                    <span class="material-icons-round text-sm">@(isPdf ? "picture_as_pdf" : "open_in_new")</span>
                                                    @(isPdf ? "Open PDF" : "View File")
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (isPending)
        {
            <div class="content-card p-6 fade-in-up">
                <div class="flex items-center gap-2 mb-5">
                    <span class="material-icons-round text-orange-500 text-lg">gavel</span>
                    <h2 class="font-bold text-gray-900">Moderator Decision</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <form method="post" action="/Moderator/ReviewVerification/@Model.Id"
                          onsubmit="return confirm('Approve this nanny verification?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="2" />
                        <button type="submit"
                                class="w-full flex items-center justify-center gap-2 px-5 py-4 rounded-2xl font-bold text-white text-sm transition-all hover:scale-[1.01] active:scale-[0.99]"
                                style="background:linear-gradient(135deg,#10B981,#059669); box-shadow:0 4px 14px rgba(16,185,129,0.35);">
                            <span class="material-icons-round text-lg">check_circle</span>
                            Approve Application
                        </button>
                    </form>

                    <button type="button" onclick="document.getElementById('rejectPanel').classList.toggle('hidden')"
                            class="w-full flex items-center justify-center gap-2 px-5 py-4 rounded-2xl font-bold text-sm text-white transition-all hover:scale-[1.01] active:scale-[0.99]"
                            style="background:linear-gradient(135deg,#EF4444,#DC2626); box-shadow:0 4px 14px rgba(239,68,68,0.35);">
                        <span class="material-icons-round text-lg">cancel</span>
                        Reject Application
                    </button>
                </div>

                <div id="rejectPanel" class="hidden mt-5 rounded-2xl border border-red-100 bg-red-50/60 p-4">
                    <form method="post" action="/Moderator/ReviewVerification/@Model.Id" onsubmit="return validateReject()">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" value="3" />
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Rejection Reason <span class="text-red-500">*</span>
                        </label>
                        <textarea id="rejectionReason" name="rejectionReason" rows="4"
                                  placeholder="Please provide a clear reason for rejection..."
                                  class="w-full border border-red-100 rounded-2xl px-4 py-3 text-sm text-gray-700 focus:outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-100 resize-none transition-all"></textarea>
                        <button type="submit"
                                class="mt-4 inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-bold text-white"
                                style="background:linear-gradient(135deg,#EF4444,#DC2626);">
                            <span class="material-icons-round text-base">send</span>
                            Submit Rejection
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function validateReject() {
        var reason = document.getElementById('rejectionReason').value.trim();
        if (!reason) {
            if (typeof window.showToast === 'function') {
                window.showToast('Please provide a rejection reason before submitting.', { type: 'warning' });
            }
            return false;
        }

        return confirm('Reject this nanny verification with the provided reason?');
    }
</script>
}
