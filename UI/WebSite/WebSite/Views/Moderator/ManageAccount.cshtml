@model WebSite.Models.Account.AccountListResponse
@{
    Layout = "~/Views/Moderator/_ModeratorLayout.cshtml";
    ViewData["Title"] = "Manage Accounts";

    var currentSearch = ViewBag.Search as string ?? "";
    var currentRole   = ViewBag.Role   as string ?? "";
    var currentStatus = ViewBag.Status as string ?? "";
    var currentPage   = Model?.Page ?? 1;
    var totalPages    = Model?.TotalPages ?? 1;
    var accounts      = Model?.Items ?? new List<WebSite.Models.Account.AccountDto>();
}

<!-- Page header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Manage Accounts</h1>
        <p class="text-sm text-gray-500 mt-1">View, update and deactivate user accounts in the system.</p>
    </div>
    <div class="flex gap-2 flex-shrink-0">
        <button class="btn-outline" onclick="exportAccounts()">
            <span class="material-icons-round text-base">download</span>
            Export Excel
        </button>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm flex items-center gap-2">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm flex items-center gap-2">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<!-- ===== FILTER / SEARCH FORM ===== -->
<form method="get" action="/Moderator/ManageAccount" id="filterForm">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-5">
        <div class="flex flex-col md:flex-row gap-3">

            <!-- Search -->
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Search by name or email..."
                       class="search-input pl-9"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>

            <!-- Role Filter -->
            <select name="role" onchange="this.form.submit()"
                    class="search-input md:w-44 !pl-3 cursor-pointer appearance-none">
                <option value="">All Roles</option>
                <option value="Parent"    @(currentRole == "Parent"    ? "selected" : "")>Parent</option>
                <option value="Nanny"     @(currentRole == "Nanny"     ? "selected" : "")>Nanny</option>
                <option value="Moderator" @(currentRole == "Moderator" ? "selected" : "")>Moderator</option>
            </select>

            <!-- Status Filter -->
            <select name="status" onchange="this.form.submit()"
                    class="search-input md:w-44 !pl-3 cursor-pointer appearance-none">
                <option value="">All Statuses</option>
                <option value="0" @(currentStatus == "0" ? "selected" : "")>Active</option>
                <option value="1" @(currentStatus == "1" ? "selected" : "")>Inactive</option>
            </select>

            <!-- Search btn -->
            <button type="submit" class="btn-primary flex-shrink-0">
                <span class="material-icons-round text-base">search</span>
                Search
            </button>
        </div>
    </div>
</form>

<!-- ===== ACCOUNT TABLE ===== -->
<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

    <!-- Table header -->
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <span class="text-sm text-gray-500">
            Showing <span class="font-bold text-gray-800">@accounts.Count</span> of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> accounts
        </span>
        <div class="flex items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>Active</div>
            <div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>Inactive</div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">User</th>
                    <th class="text-left">Email</th>
                    <th class="text-left">Role</th>
                    <th class="text-left">Joined</th>
                    <th class="text-left">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!accounts.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-12 text-gray-400">
                            <span class="material-icons-round text-4xl mb-2 block">search_off</span>
                            No accounts found matching your criteria.
                        </td>
                    </tr>
                }
                @{int rowNum = ((currentPage - 1) * 10) + 1;}
                @foreach (var acc in accounts)
                {
                    var roleBadge = acc.PrimaryRole switch
                    {
                        "Parent"    => "badge-parent",
                        "Nanny"     => "badge-nanny",
                        "Moderator" => "badge-mod",
                        _           => "badge-pending"
                    };
                    var statusBadge = acc.Status == 0 ? "badge-active" : "badge-inactive";
                    var statusLabel = acc.Status == 0 ? "Active" : "Inactive";
                    var avatarColors = new[] { "#F97316","#3B82F6","#8B5CF6","#10B981","#F59E0B","#EF4444","#EC4899","#6366F1" };
                    var avatarBg = avatarColors[Math.Abs(acc.Id.GetHashCode()) % avatarColors.Length];

                    <tr class="account-row" id="row-@acc.Id">
                        <td class="text-gray-400 text-xs">@rowNum</td>
                        <td>
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(acc.AvatarUrl))
                                {
                                    <img src="@acc.AvatarUrl" alt="@acc.FullName"
                                         class="user-avatar object-cover" style="background:@avatarBg;" />
                                }
                                else
                                {
                                    <div class="user-avatar" style="background:@avatarBg;">@acc.Avatar</div>
                                }
                                <div>
                                    <span class="font-semibold text-gray-800">@acc.FullName</span>
                                    @if (!acc.EmailConfirmed)
                                    {
                                        <span class="ml-1 text-[10px] text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">Unverified email</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-gray-500">@acc.Email</td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var r in acc.Roles)
                                {
                                    var rb = r switch { "Parent" => "badge-parent", "Nanny" => "badge-nanny", "Moderator" => "badge-mod", "Admin" => "badge-mod", _ => "badge-pending" };
                                    <span class="badge @rb">@r</span>
                                }
                            </div>
                        </td>
                        <td class="text-gray-500 text-xs">@acc.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="flex items-center gap-1.5" id="status-cell-@acc.Id">
                                <div class="w-2 h-2 rounded-full @(acc.Status == 0 ? "bg-green-400" : "bg-red-400")"></div>
                                <span class="badge @statusBadge">@statusLabel</span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <!-- View -->
                                <button onclick="viewAccount('@acc.Id')" title="View details"
                                        id="view-@acc.Id"
                                        data-id="@acc.Id"
                                        data-name="@acc.FullName"
                                        data-email="@acc.Email"
                                        data-role="@acc.PrimaryRole"
                                        data-status="@statusLabel"
                                        data-joined="@acc.CreatedAt.ToString("MMM dd, yyyy")"
                                        data-avatar-bg="@avatarBg"
                                        class="w-8 h-8 rounded-lg bg-gray-50 hover:bg-blue-50 hover:text-blue-600 flex items-center justify-center text-gray-400 transition-all border border-gray-100 hover:border-blue-200">
                                    <span class="material-icons-round text-base">visibility</span>
                                </button>
                                <!-- Toggle Status -->
                                @if (acc.Status == 0)
                                {
                                    <button onclick="toggleStatus('@acc.Id', '@acc.FullName', 1)" title="Deactivate"
                                            class="w-8 h-8 rounded-lg bg-gray-50 hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-gray-400 transition-all border border-gray-100 hover:border-red-200">
                                        <span class="material-icons-round text-base">block</span>
                                    </button>
                                }
                                else
                                {
                                    <button onclick="toggleStatus('@acc.Id', '@acc.FullName', 0)" title="Activate"
                                            class="w-8 h-8 rounded-lg bg-gray-50 hover:bg-green-50 hover:text-green-600 flex items-center justify-center text-gray-400 transition-all border border-gray-100 hover:border-green-200">
                                        <span class="material-icons-round text-base">check_circle_outline</span>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-100">
        <span class="text-sm text-gray-400">Page @currentPage of @totalPages</span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&role=@currentRole&status=@currentStatus&page=@(currentPage - 1)"
                   class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-40 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }
            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&role=@currentRole&status=@currentStatus&page=@p"
                   class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }
            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&role=@currentRole&status=@currentStatus&page=@(currentPage + 1)"
                   class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-40 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>


<!-- ===== VIEW DETAIL MODAL ===== -->
<div id="viewModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeModal('viewModal')">
    <div class="modal-box">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-bold text-gray-900">Account Details</h3>
            <button onclick="closeModal('viewModal')" class="w-8 h-8 rounded-full hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-600 transition-all">
                <span class="material-icons-round">close</span>
            </button>
        </div>
        <div class="flex items-center gap-4 mb-6 p-4 bg-orange-50 rounded-xl">
            <div id="modalAvatar" class="w-14 h-14 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg"></div>
            <div>
                <p id="modalName" class="font-bold text-gray-900 text-lg"></p>
                <p id="modalEmail" class="text-sm text-gray-500"></p>
                <span id="modalRoleBadge" class="badge badge-nanny mt-1 inline-block"></span>
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4 text-sm">
            <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-xs text-gray-400 mb-1 uppercase tracking-wide">Status</p>
                <p id="modalStatus" class="font-semibold text-gray-700"></p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-xs text-gray-400 mb-1 uppercase tracking-wide">Joined</p>
                <p id="modalJoined" class="font-semibold text-gray-700"></p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3 col-span-2">
                <p class="text-xs text-gray-400 mb-1 uppercase tracking-wide">Account ID</p>
                <p id="modalId" class="font-semibold text-gray-700 font-mono text-xs break-all"></p>
            </div>
        </div>
        <button onclick="closeModal('viewModal')" class="btn-outline w-full justify-center mt-6">Close</button>
    </div>
</div>

<!-- ===== TOGGLE STATUS MODAL ===== -->
<div id="toggleModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeModal('toggleModal')">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="toggleIcon" class="w-12 h-12 rounded-xl flex items-center justify-center">
                <span class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="toggleTitle" class="text-lg font-bold text-gray-900"></h3>
                <p class="text-sm text-gray-500">This action requires confirmation</p>
            </div>
        </div>
        <p id="toggleBody" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-xl p-3"></p>
        <div class="flex gap-2">
            <button onclick="closeModal('toggleModal')" class="btn-outline flex-1 justify-center">Cancel</button>
            <button id="toggleConfirmBtn" class="btn-primary flex-1 justify-center">Confirm</button>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div id="toast" class="fixed bottom-6 right-6 z-50 hidden items-center gap-3 px-5 py-3.5 rounded-2xl shadow-xl text-white text-sm font-semibold">
    <span id="toastIcon" class="material-icons-round text-xl"></span>
    <span id="toastMsg"></span>
</div>

@section Scripts {
<script>
    // ── VIEW ACCOUNT MODAL ──
    function viewAccount(id) {
        var btn = document.getElementById('view-' + id);
        document.getElementById('modalAvatar').style.background = btn.getAttribute('data-avatar-bg');
        document.getElementById('modalAvatar').textContent = btn.getAttribute('data-name').charAt(0).toUpperCase();
        document.getElementById('modalName').textContent   = btn.getAttribute('data-name');
        document.getElementById('modalEmail').textContent  = btn.getAttribute('data-email');
        document.getElementById('modalStatus').textContent = btn.getAttribute('data-status');
        document.getElementById('modalJoined').textContent = btn.getAttribute('data-joined');
        document.getElementById('modalId').textContent     = id;
        document.getElementById('modalRoleBadge').textContent = btn.getAttribute('data-role');
        document.getElementById('viewModal').classList.remove('hidden');
    }

    // ── TOGGLE STATUS MODAL ──
    function toggleStatus(id, name, newStatus) {
        var icon  = document.getElementById('toggleIcon');
        var title = document.getElementById('toggleTitle');
        var body  = document.getElementById('toggleBody');
        var btn   = document.getElementById('toggleConfirmBtn');

        if (newStatus === 1) {
            icon.style.background = '#FEE2E2';
            icon.querySelector('span').style.color = '#EF4444';
            icon.querySelector('span').textContent = 'block';
            title.textContent = 'Deactivate Account';
            body.innerHTML = 'Are you sure you want to <strong>deactivate</strong> the account of <strong>' + name + '</strong>? This user will no longer be able to sign in.';
            btn.style.background = 'linear-gradient(135deg,#EF4444,#DC2626)';
            btn.style.boxShadow  = '0 3px 10px rgba(239,68,68,0.3)';
            btn.textContent = 'Deactivate';
        } else {
            icon.style.background = '#D1FAE5';
            icon.querySelector('span').style.color = '#10B981';
            icon.querySelector('span').textContent = 'check_circle_outline';
            title.textContent = 'Activate Account';
            body.innerHTML = 'Are you sure you want to <strong>activate</strong> the account of <strong>' + name + '</strong>? This user will be able to sign in again.';
            btn.style.background = 'linear-gradient(135deg,#10B981,#059669)';
            btn.style.boxShadow  = '0 3px 10px rgba(16,185,129,0.3)';
            btn.textContent = 'Activate';
        }

        btn.onclick = function() { confirmToggle(id, name, newStatus); };
        document.getElementById('toggleModal').classList.remove('hidden');
    }

    // ── CONFIRM TOGGLE via AJAX ──
    function confirmToggle(id, name, newStatus) {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';

        fetch('/Moderator/ToggleStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + encodeURIComponent(id) + '&newStatus=' + newStatus + '&__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            closeModal('toggleModal');
            if (data.success) {
                var cell = document.getElementById('status-cell-' + id);
                if (cell) {
                    var dot   = cell.querySelector('div');
                    var badge = cell.querySelector('.badge');
                    if (newStatus === 0) {
                        dot.className   = 'w-2 h-2 rounded-full bg-green-400';
                        badge.className = 'badge badge-active';
                        badge.textContent = 'Active';
                    } else {
                        dot.className   = 'w-2 h-2 rounded-full bg-red-400';
                        badge.className = 'badge badge-inactive';
                        badge.textContent = 'Inactive';
                    }
                }
                showToast('success', data.message);
            } else {
                showToast('error', data.message);
            }
        })
        .catch(function(err) {
            closeModal('toggleModal');
            showToast('error', 'Connection error: ' + err.message);
        });
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    function showToast(type, msg) {
        var toast = document.getElementById('toast');
        var icon  = document.getElementById('toastIcon');
        var text  = document.getElementById('toastMsg');
        toast.style.background = type === 'success' ? 'linear-gradient(135deg,#10B981,#059669)' : 'linear-gradient(135deg,#EF4444,#DC2626)';
        icon.textContent  = type === 'success' ? 'check_circle' : 'error';
        text.textContent  = msg;
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        setTimeout(function() {
            toast.classList.add('hidden');
            toast.classList.remove('flex');
        }, 3500);
    }

    function exportAccounts() {
        alert('Excel export will be available once the API integration is complete.');
    }
</script>

@* Hidden CSRF form for AJAX calls *@
<form id="csrfForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>
}
