@model WebSite.Models.Profile.NannyBasicInfoWizardViewModel
@{
    ViewData["Title"] = "Bảo mẫu - Thông tin cơ bản";
}

<div class="nm-flow-shell nm-flow-shell--homepage">
    <div class="nm-flow-container">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Khởi tạo hồ sơ bảo mẫu</span>
                        <h1 class="nm-flow-title">Hoàn thiện hồ sơ cơ bản</h1>
                        <p class="nm-flow-subtitle">
                            Đây là thông tin nền để hồ sơ bảo mẫu hiển thị rõ trong tìm kiếm và giúp phụ huynh đánh giá nhanh mức độ phù hợp.
                        </p>
                        <div class="nm-flow-divider" aria-hidden="true"></div>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="nm-alert"></div>

                <form asp-action="Step1BasicInfo" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Latitude" id="Latitude" />
                    <input type="hidden" asp-for="Longitude" id="Longitude" />
                    <input type="hidden" asp-for="AvatarUrl" />

                    <div class="nm-form-grid">
                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Thông tin cá nhân</div>
                                <div class="nm-section-note">Ảnh đại diện, ngày sinh và địa chỉ sẽ được dùng để hoàn thiện hồ sơ nghề nghiệp ở các bước tiếp theo.</div>

                                <div class="nm-form-grid">
                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="FullName" class="nm-label">Họ và tên <span class="required">*</span></label>
                                            <input asp-for="FullName" class="nm-input" placeholder="Nguyễn Thị A" />
                                            <span asp-validation-for="FullName" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="AvatarFile" class="nm-label">Ảnh đại diện</label>
                                            <div class="nm-avatar-upload">
                                                <input type="file" asp-for="AvatarFile" id="AvatarFile" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="nm-avatar-file-input" />
                                                <button id="avatarPickBtn" type="button" class="nm-avatar-pick-btn">Chọn ảnh</button>
                                                <span id="avatarFileName" class="nm-avatar-file-name">Chưa chọn tệp</span>
                                            </div>
                                            <div class="nm-field-hint">Nên dùng ảnh rõ mặt, đúng định dạng .jpg, .jpeg, .png.</div>
                                            <div id="avatarUploadError" class="nm-error hidden"></div>
                                            <div class="mt-3">
                                                <img id="avatarPreview" class="nm-avatar-preview hidden" alt="Xem trước ảnh đại diện" />
                                            </div>
                                            <span asp-validation-for="AvatarFile" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="PhoneNumber" class="nm-label">Số điện thoại</label>
                                            <input asp-for="PhoneNumber" class="nm-input" placeholder="+84901234567" />
                                            <div class="nm-field-hint">Nhập 10 số, có thể bắt đầu bằng dấu +.</div>
                                            <span asp-validation-for="PhoneNumber" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="DateOfBirth" class="nm-label">Ngày sinh <span class="required">*</span></label>
                                            <input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" type="date" class="nm-input" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                            <span asp-validation-for="DateOfBirth" class="nm-error"></span>
                                            <div id="dateOfBirthClientError" class="nm-error hidden">Ngày sinh không được lớn hơn ngày hiện tại.</div>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="Gender" class="nm-label">Giới tính <span class="required">*</span></label>
                                            <select asp-for="Gender" class="nm-select" data-nm-select-mode="click">
                                                <option value="">Chọn giới tính</option>
                                                <option value="0">Nam</option>
                                                <option value="1">Nữ</option>
                                                <option value="2">Khác</option>
                                            </select>
                                            <span asp-validation-for="Gender" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="Address" class="nm-label">Địa chỉ chi tiết <span class="required">*</span></label>
                                            <input asp-for="Address" id="Address" class="nm-input" placeholder="Số nhà, tên đường..." />
                                            <span asp-validation-for="Address" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="City" class="nm-label">Tỉnh / Thành phố <span class="required">*</span></label>
                                            <select asp-for="City" id="City" class="nm-select">
                                                <option value="">Chọn tỉnh / thành</option>
                                            </select>
                                            <span asp-validation-for="City" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="District" class="nm-label">Quận / Huyện / Phường <span class="required">*</span></label>
                                            <select asp-for="District" id="District" class="nm-select">
                                                <option value="">Chọn khu vực</option>
                                            </select>
                                            <span asp-validation-for="District" class="nm-error"></span>
                                        </div>
                                    </div>
                                </div>

                                <div id="addressLoadError" class="nm-error hidden mt-3"></div>
                            </div>
                        </div>
                    </div>

                    <div class="nm-flow-actions">
                        <a href="@Url.Action("Index", "Home")" class="nm-btn nm-btn--ghost">Bỏ qua</a>
                        <button type="submit" name="direction" value="next" class="nm-btn nm-btn--primary">Tiếp tục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .nm-avatar-upload {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 12px 14px;
        border: 1px dashed #fdba74;
        border-radius: 16px;
        background: #fff7ed;
    }

    .nm-avatar-file-input {
        display: none;
    }

    .nm-avatar-pick-btn {
        width: fit-content;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid #f97316;
        background: #fff;
        color: #ea580c;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: .15s ease;
    }

    .nm-avatar-pick-btn:hover {
        background: #fff7ed;
        transform: translateY(-1px);
    }

    .nm-avatar-file-name {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
    }
</style>

<script>
(function () {
    var avatarInput = document.getElementById('AvatarFile');
    var avatarPickBtn = document.getElementById('avatarPickBtn');
    var avatarFileName = document.getElementById('avatarFileName');
    var avatarErr = document.getElementById('avatarUploadError');
    var avatarPreview = document.getElementById('avatarPreview');
    var currentAvatarUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvatarUrl ?? ""));
    var objectUrl = null;

    function showAvatarError(msg) {
        if (!avatarErr) return;
        avatarErr.textContent = msg || '';
        avatarErr.classList.toggle('hidden', !msg);
    }

    function clearPreview() {
        if (objectUrl) { try { URL.revokeObjectURL(objectUrl); } catch (e) { } objectUrl = null; }
        if (avatarPreview) {
            avatarPreview.src = '';
            avatarPreview.classList.add('hidden');
        }
    }

    function setPreview(src) {
        if (!avatarPreview) return;
        avatarPreview.src = src;
        avatarPreview.classList.remove('hidden');
    }

    function isAllowedImage(file) {
        if (!file) return false;
        var name = (file.name || '').toLowerCase();
        var extOk = name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg');
        var typeOk = (file.type === 'image/png' || file.type === 'image/jpeg' || file.type === 'image/jpg');
        return extOk && (typeOk || !file.type);
    }

    if (currentAvatarUrl) {
        setPreview(currentAvatarUrl);

        if (avatarFileName) {
            avatarFileName.textContent = 'Đang dùng ảnh hiện tại';
        }

        if (typeof window.updateCurrentUserAvatar === 'function') {
            window.updateCurrentUserAvatar(currentAvatarUrl);
        }
    }

    if (avatarPickBtn && avatarInput) {
        avatarPickBtn.addEventListener('click', function () {
            avatarInput.click();
        });
    }

    if (avatarInput) {
        avatarInput.addEventListener('change', function () {
            showAvatarError('');
            clearPreview();

            var file = avatarInput.files && avatarInput.files[0] ? avatarInput.files[0] : null;
            if (!file) {
                if (avatarFileName) avatarFileName.textContent = currentAvatarUrl ? 'Đang dùng ảnh hiện tại' : 'Chưa chọn tệp';
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            if (!isAllowedImage(file)) {
                avatarInput.value = '';
                showAvatarError('Chỉ cho phép upload ảnh .png, .jpg, .jpeg.');
                if (avatarFileName) avatarFileName.textContent = currentAvatarUrl ? 'Đang dùng ảnh hiện tại' : 'Chưa chọn tệp';
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            var maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
                avatarInput.value = '';
                showAvatarError('Dung lượng ảnh không được vượt quá 5MB.');
                if (avatarFileName) avatarFileName.textContent = currentAvatarUrl ? 'Đang dùng ảnh hiện tại' : 'Chưa chọn tệp';
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            if (avatarFileName) avatarFileName.textContent = file.name;
            objectUrl = URL.createObjectURL(file);
            setPreview(objectUrl);
        });
    }

    var form = document.querySelector('form[asp-action], form');
    var dateOfBirthInput = document.getElementById('DateOfBirth');
    var dateOfBirthClientError = document.getElementById('dateOfBirthClientError');
    var citySelect = document.getElementById('City');
    var districtSelect = document.getElementById('District');
    var addressInput = document.getElementById('Address');
    var latEl = document.getElementById('Latitude');
    var lngEl = document.getElementById('Longitude');
    var addressLoadError = document.getElementById('addressLoadError');
    var provinces = [];
    if (dateOfBirthInput) {
        var today = new Date();
        var todayStr = today.toISOString().split('T')[0];
        dateOfBirthInput.max = todayStr;

        function validateDateOfBirth() {
            if (!dateOfBirthInput.value) {
                dateOfBirthInput.setCustomValidity('');
                if (dateOfBirthClientError) dateOfBirthClientError.classList.add('hidden');
                return true;
            }

            if (dateOfBirthInput.value > todayStr) {
                dateOfBirthInput.setCustomValidity('Ngày sinh không được lớn hơn ngày hiện tại.');
                if (dateOfBirthClientError) dateOfBirthClientError.classList.remove('hidden');
                return false;
            }

            dateOfBirthInput.setCustomValidity('');
            if (dateOfBirthClientError) dateOfBirthClientError.classList.add('hidden');
            return true;
        }

        dateOfBirthInput.addEventListener('input', validateDateOfBirth);
        dateOfBirthInput.addEventListener('change', validateDateOfBirth);

        if (form) {
            form.addEventListener('submit', function (e) {
                if (!validateDateOfBirth()) {
                    e.preventDefault();
                    dateOfBirthInput.reportValidity();
                    dateOfBirthInput.focus();
                }
            });
        }
    }

    setAddressSelectState(true);

    fetch('/Address/LocationTree')
        .then(function (r) {
            if (!r.ok) throw new Error('address-load-failed');
            return r.json();
        })
        .then(function (data) {
            provinces = data || [];
            provinces.forEach(function (p) {
                var opt = document.createElement('option');
                opt.value = p.name;
                opt.textContent = p.name;
                opt.dataset.code = p.code;
                citySelect.appendChild(opt);
            });

            preselectFromModel();
            showAddressLoadError('');
            setAddressSelectState(false);
        })
        .catch(function () {
            provinces = [];
            setAddressSelectState(true);
            showAddressLoadError('Không tải được danh sách tỉnh thành. Vui lòng thử lại sau.');
        });

    function setAddressSelectState(disabled) {
        citySelect.disabled = disabled;
        districtSelect.disabled = disabled;
    }

    function showAddressLoadError(message) {
        if (!addressLoadError) return;
        addressLoadError.textContent = message || '';
        addressLoadError.classList.toggle('hidden', !message);
    }

    function normalizeText(value) {
        return (value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/đ/g, 'd')
            .trim();
    }

    function setSelectByNormalized(selectEl, value) {
        var target = normalizeText(value);
        if (!target) return false;
        for (var i = 0; i < selectEl.options.length; i++) {
            if (normalizeText(selectEl.options[i].value) === target) {
                selectEl.value = selectEl.options[i].value;
                return true;
            }
        }
        return false;
    }

    function ensureSelectOption(selectEl, value) {
        if (!selectEl || !value) return;
        var exists = false;
        for (var i = 0; i < selectEl.options.length; i++) {
            if (normalizeText(selectEl.options[i].value) === normalizeText(value)) {
                exists = true;
                break;
            }
        }

        if (!exists) {
            var opt = document.createElement('option');
            opt.value = value;
            opt.textContent = value;
            selectEl.appendChild(opt);
        }
    }

    function preselectFromModel() {
        var currentCity = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.City ?? ""));
        var currentDistrict = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.District ?? ""));
        if (currentCity) {
            if (!setSelectByNormalized(citySelect, currentCity)) {
                ensureSelectOption(citySelect, currentCity);
                citySelect.value = currentCity;
            }

            onCityChange(function () {
                if (currentDistrict) {
                    if (!setSelectByNormalized(districtSelect, currentDistrict)) {
                        ensureSelectOption(districtSelect, currentDistrict);
                        districtSelect.value = currentDistrict;
                    }
                    onDistrictChange();
                }
            });
        }
    }

    function onCityChange(callback) {
        districtSelect.innerHTML = '<option value="">Chọn khu vực</option>';

        var selectedCity = normalizeText(citySelect.value);
        var selected = provinces.find(function (p) { return normalizeText(p.name) === selectedCity; });
        if (!selected) { if (callback) callback(); return; }

        selected.districts.forEach(function (d) {
            var opt = document.createElement('option');
            opt.value = d.name;
            opt.textContent = d.name;
            opt.dataset.code = d.code;
            districtSelect.appendChild(opt);
        });

        if (callback) callback();
        autoGeocode();
    }

    function onDistrictChange(callback) {
        var selectedCity = normalizeText(citySelect.value);
        var selectedProv = provinces.find(function (p) { return normalizeText(p.name) === selectedCity; });
        if (!selectedProv) { if (callback) callback(); return; }

        var selectedDistrict = normalizeText(districtSelect.value);
        var selectedDist = selectedProv.districts.find(function (d) { return normalizeText(d.name) === selectedDistrict; });
        if (!selectedDist) { if (callback) callback(); return; }

        if (callback) callback();
        autoGeocode();
    }

    citySelect.addEventListener('change', function () { onCityChange(); });
    districtSelect.addEventListener('change', function () { onDistrictChange(); });

    var debounceTimer;
    addressInput.addEventListener('blur', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(autoGeocode, 300);
    });

    function autoGeocode() {
        var city = (citySelect.value || '').trim();
        var dist = (districtSelect.value || '').trim();
        if (!city) return;

        var parts = [];
        if (dist) parts.push(dist);
        parts.push(city);
        var query = parts.join(', ');

        fetch('/Address/Suggest?q=' + encodeURIComponent(query) + '&limit=1')
            .then(function (r) { return r.json(); })
            .then(function (items) {
                if (!items || !items.length) return;
                var item = items[0];
                var lat = item.latitude != null ? item.latitude : item.Latitude;
                var lng = item.longitude != null ? item.longitude : item.Longitude;
                if (latEl && lat != null) latEl.value = lat;
                if (lngEl && lng != null) lngEl.value = lng;
            })
            .catch(function () { });
    }
})();
</script>
