@model WebSite.Models.Profile.NannyBasicInfoWizardViewModel
@{
    ViewData["Title"] = "Thông tin cơ bản - Họ tên";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto">
        <div class="mb-8">
            <span class="section-label">👶 Nanny Onboarding</span>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-3">
                Bước 1: Nhập họ tên
            </h1>
            <div class="section-divider left mt-4"></div>
        </div>

        <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-8 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

            <form asp-action="Step1Name" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-6">
                    <label asp-for="FullName" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                        Họ và tên <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="FullName"
                           class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                           placeholder="VD: Nguyễn Thị A" />
                    <span asp-validation-for="FullName" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="flex justify-between mt-8">
                    @* <a href="@Url.Action("Index", "Home")"
                       class="px-6 py-2 rounded-xl border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 text-sm font-semibold">
                        Back
                    </a> *@
                    <button type="submit" name="direction" value="next"
                            class="px-6 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-semibold text-sm shadow-md">
                        Next
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

