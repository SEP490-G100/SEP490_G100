function handleConversationReportSubmit(event) {
    const conversationId = String(document.getElementById('conversationReportConversationId')?.value || '').trim();
    const submitBtn = document.getElementById('conversationReportSubmitBtn');

    if (!conversationId) {
        event.preventDefault();
        notifyChat('Không tìm thấy cuộc trò chuyện cần báo cáo.', 'error');
        return;
    }

    if (typeof tinymce !== 'undefined') tinymce.triggerSave();

    const reasonHtml = getConversationReportEditorContent('conversationReportReason');
    const evidenceHtml = getConversationReportEditorContent('conversationReportEvidence');
    const reason = extractConversationReportPlainText(reasonHtml);
    const evidence = String(evidenceHtml || '').trim();

    if (reason.length < 5 || reason.length > 500) {
        event.preventDefault();
        notifyChat('Lý do báo cáo phải từ 5 đến 500 ký tự.', 'warning');
        if (typeof tinymce !== 'undefined' && tinymce.get('conversationReportReason')) {
            tinymce.get('conversationReportReason').focus();
        } else {
            document.getElementById('conversationReportReason')?.focus();
        }
        return;
    }

    if (evidence.length > 2000) {
        event.preventDefault();
        notifyChat('Bằng chứng không được vượt quá 2000 ký tự.', 'warning');
        if (typeof tinymce !== 'undefined' && tinymce.get('conversationReportEvidence')) {
            tinymce.get('conversationReportEvidence').focus();
        } else {
            document.getElementById('conversationReportEvidence')?.focus();
        }
        return;
    }

    if (isSubmittingConversationReport) {
        event.preventDefault();
        return;
    }

    isSubmittingConversationReport = true;
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang gửi...';
    }
}

