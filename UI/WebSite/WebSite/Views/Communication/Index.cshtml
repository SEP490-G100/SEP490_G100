@{
    ViewData["Title"] = "Tin nhắn";
    ViewData["HideFooter"] = true;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <style>
        /* ─── Chat Layout ─────────────────────────────────────────── */
        .chat-shell {
            display: flex;
            height: calc(100vh - 72px);
            background: #f9fafb;
            overflow: hidden;
        }

        /* ─── Sidebar (Conversation List) ────────────────────────── */
        .chat-sidebar {
            width: 340px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border-right: 1px solid rgba(226,232,240,.8);
            box-shadow: 2px 0 12px rgba(15,23,42,.04);
        }

        .chat-sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 18px 14px;
            border-bottom: 1px solid #f1f5f9;
        }

        .chat-sidebar-title {
            font-size: 18px;
            font-weight: 800;
            color: #111827;
        }

        .chat-search-box {
            padding: 10px 14px 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .chat-search-input {
            width: 100%;
            padding: 9px 14px 9px 36px;
            border-radius: 12px;
            border: 1.5px solid #e5e7eb;
            font-size: 14px;
            background: #f9fafb;
            color: #374151;
            outline: none;
            transition: border .2s;
        }

            .chat-search-input:focus {
                border-color: #f97316;
                background: #fff;
            }

        .conv-list {
            flex: 1;
            overflow-y: auto;
            padding: 6px;
        }

        .conv-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 12px;
            border-radius: 16px;
            cursor: pointer;
            transition: all .18s ease;
            margin-bottom: 2px;
            position: relative;
        }

            .conv-item:hover {
                background: #fff7ed;
            }

            .conv-item.active {
                background: linear-gradient(135deg,#fff7ed,#ffffff);
                box-shadow: 0 4px 12px rgba(249,115,22,.1);
            }

        .conv-avatar {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: linear-gradient(135deg, #f97316, #ea580c);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            font-weight: 800;
            flex-shrink: 0;
            overflow: hidden;
        }

            .conv-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .conv-info {
            flex: 1;
            min-width: 0;
        }

        .conv-name {
            font-size: 14px;
            font-weight: 700;
            color: #111827;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .conv-preview {
            font-size: 13px;
            color: #9ca3af;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 2px;
        }

        .conv-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
            flex-shrink: 0;
        }

        .conv-time {
            font-size: 11px;
            color: #9ca3af;
        }

        .unread-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #f97316;
        }

        .conv-badge {
            min-width: 20px;
            height: 20px;
            padding: 0 5px;
            border-radius: 999px;
            background: linear-gradient(135deg,#f97316,#ea580c);
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ─── Main Chat Area ──────────────────────────────────────── */
        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* Empty state */
        .chat-empty {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #9ca3af;
            gap: 12px;
        }

            .chat-empty .material-icons-round {
                font-size: 56px;
                color: #fdba74;
            }

            .chat-empty h3 {
                font-size: 18px;
                font-weight: 700;
                color: #374151;
            }

        /* Chat header */
        .chat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            background: #fff;
            border-bottom: 1px solid #f1f5f9;
            box-shadow: 0 1px 8px rgba(15,23,42,.05);
        }

        .chat-header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-header-avatar {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg,#f97316,#ea580c);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            font-weight: 800;
            overflow: hidden;
        }

        .chat-header-name {
            font-size: 16px;
            font-weight: 800;
            color: #111827;
        }

        .chat-header-status {
            font-size: 12px;
            color: #9ca3af;
        }

        .chat-header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .chat-header-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 14px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            font-family: 'Quicksand', sans-serif;
            border: 1.5px solid #e5e7eb;
            background: #fff;
            color: #374151;
            cursor: pointer;
            white-space: nowrap;
            transition: all .18s ease;
        }

            .chat-header-pill:hover:not(:disabled) {
                color: #ea580c;
                background: #fff7ed;
                border-color: #fed7aa;
            }

            .chat-header-pill--primary {
                background: linear-gradient(135deg,#f97316,#ea580c);
                color: #fff;
                border-color: transparent;
                box-shadow: 0 4px 12px rgba(249,115,22,.22);
            }

                .chat-header-pill--primary:hover:not(:disabled) {
                    transform: translateY(-1px);
                    box-shadow: 0 8px 18px rgba(249,115,22,.3);
                }

            .chat-header-pill:disabled {
                opacity: .45;
                cursor: not-allowed;
                transform: none;
            }

        .chat-action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #fff;
            color: #6b7280;
            cursor: pointer;
            transition: all .18s ease;
        }

            .chat-action-btn:hover {
                color: #ea580c;
                background: #fff7ed;
                border-color: #fed7aa;
            }

            .chat-action-btn.danger:hover {
                color: #dc2626;
                background: #fef2f2;
                border-color: #fecaca;
            }

        /* Messages area */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            scroll-behavior: smooth;
        }

        .msg-group-date {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 8px 0;
        }

            .msg-group-date::before, .msg-group-date::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #f1f5f9;
            }

            .msg-group-date span {
                font-size: 12px;
                color: #9ca3af;
                font-weight: 600;
                white-space: nowrap;
            }

        .msg-row {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            max-width: 75%;
        }

            .msg-row.mine {
                margin-left: auto;
                flex-direction: row-reverse;
            }

        .msg-avatar {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: linear-gradient(135deg,#f97316,#ea580c);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 13px;
            font-weight: 800;
            flex-shrink: 0;
            overflow: hidden;
        }

            .msg-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .msg-bubble {
            padding: 10px 14px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.55;
            word-break: break-word;
            position: relative;
        }

        .msg-row:not(.mine) .msg-bubble {
            background: #fff;
            color: #111827;
            border: 1.5px solid #f1f5f9;
            border-bottom-left-radius: 6px;
            box-shadow: 0 2px 8px rgba(15,23,42,.06);
        }

        .msg-row.mine .msg-bubble {
            background: linear-gradient(135deg,#f97316,#ea580c);
            color: #fff;
            border-bottom-right-radius: 6px;
            box-shadow: 0 4px 12px rgba(249,115,22,.22);
        }

        .msg-bubble.deleted {
            opacity: .5;
            font-style: italic;
            font-size: 13px;
        }

        .msg-time {
            font-size: 11px;
            color: #9ca3af;
            margin-top: 3px;
            text-align: right;
        }

        .msg-row.mine .msg-time {
            text-align: left;
        }

        /* Context menu */
        .msg-ctx-menu {
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 4px;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 10px 28px rgba(15,23,42,.12);
            padding: 6px;
            z-index: 100;
            min-width: 140px;
            display: none;
        }

        .msg-row.mine .msg-ctx-menu {
            right: 0;
        }

        .msg-row:not(.mine) .msg-ctx-menu {
            left: 0;
            right: auto;
        }

        .msg-ctx-menu.open {
            display: block;
        }

        .ctx-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            color: #374151;
            transition: background .15s;
        }

            .ctx-item:hover {
                background: #f9fafb;
            }

            .ctx-item.danger {
                color: #dc2626;
            }

                .ctx-item.danger:hover {
                    background: #fef2f2;
                }

        /* Input area */
        .chat-input-area {
            padding: 14px 20px;
            background: #fff;
            border-top: 1px solid #f1f5f9;
            display: flex;
            align-items: flex-end;
            gap: 10px;
        }

        .chat-input-wrap {
            flex: 1;
            display: flex;
            align-items: flex-end;
            border: 1.5px solid #e5e7eb;
            border-radius: 18px;
            background: #f9fafb;
            padding: 8px 14px;
            gap: 8px;
            transition: border .2s;
        }

            .chat-input-wrap:focus-within {
                border-color: #f97316;
                background: #fff;
            }

        .chat-textarea {
            flex: 1;
            resize: none;
            border: none;
            outline: none;
            box-shadow: none;
            background: transparent;
            font-size: 14px;
            color: #374151;
            line-height: 1.5;
            max-height: 120px;
            overflow-y: auto;
            font-family: 'Quicksand', sans-serif;
        }

            .chat-textarea:focus,
            .chat-textarea:focus-visible {
                border: none !important;
                outline: none !important;
                box-shadow: none !important;
                --tw-ring-shadow: 0 0 #0000;
                --tw-ring-offset-shadow: 0 0 #0000;
            }

        .chat-send-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg,#f97316,#ea580c);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            box-shadow: 0 6px 16px rgba(249,115,22,.3);
            transition: all .18s ease;
            flex-shrink: 0;
        }

            .chat-send-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(249,115,22,.36);
            }

            .chat-send-btn:disabled {
                opacity: .5;
                cursor: not-allowed;
                transform: none;
            }

        .chat-blocked-banner {
            text-align: center;
            padding: 12px 16px;
            background: #fef2f2;
            border-top: 1px solid #fecaca;
            font-size: 13px;
            font-weight: 600;
            color: #dc2626;
        }

        /* Loading spinner */
        .spin {
            border: 3px solid #f1f5f9;
            border-top-color: #f97316;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            animation: spin .7s linear infinite;
            margin: 20px auto;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Modals */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.4);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            backdrop-filter: blur(4px);
        }

        .modal-card {
            background: #fff;
            border-radius: 24px;
            padding: 28px 28px 24px;
            width: min(440px, calc(100vw - 32px));
            box-shadow: 0 32px 80px rgba(15,23,42,.18);
        }

        .modal-title {
            font-size: 18px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 6px;
        }

        .modal-sub {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 20px;
        }

        .modal-input {
            width: 100%;
            padding: 10px 14px;
            border-radius: 12px;
            border: 1.5px solid #e5e7eb;
            font-size: 14px;
            color: #374151;
            outline: none;
            transition: border .2s;
            margin-bottom: 10px;
            font-family: 'Quicksand', sans-serif;
        }

            .modal-input:focus {
                border-color: #f97316;
            }

        .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 16px;
            justify-content: flex-end;
        }

        .btn-cancel {
            padding: 10px 20px;
            border-radius: 12px;
            border: 1.5px solid #e5e7eb;
            background: #fff;
            font-size: 14px;
            font-weight: 700;
            color: #6b7280;
            cursor: pointer;
            transition: all .18s;
        }

            .btn-cancel:hover {
                background: #f9fafb;
            }

        .btn-danger {
            padding: 10px 20px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg,#ef4444,#dc2626);
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(220,38,38,.24);
            transition: all .18s;
        }

            .btn-danger:hover {
                transform: translateY(-1px);
            }

        .btn-primary {
            padding: 10px 20px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg,#f97316,#ea580c);
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(249,115,22,.24);
            transition: all .18s;
        }

            .btn-primary:hover {
                transform: translateY(-1px);
            }

        @@media (max-width: 767px) {
            .chat-sidebar {
                width: 100%;
                display: none;
            }

                .chat-sidebar.mobile-open {
                    display: flex;
                    position: fixed;
                    inset: 72px 0 0;
                    z-index: 50;
                }

            .chat-main {
                width: 100%;
            }
        }

        .hiring-offer-card {
            cursor: pointer;
            border-radius: 18px;
            overflow: hidden;
            border: 1.5px solid #fed7aa;
            background: #fff;
            max-width: 280px;
            box-shadow: 0 4px 16px rgba(249,115,22,.14);
            transition: transform .18s ease, box-shadow .18s ease;
        }

            .hiring-offer-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 24px rgba(249,115,22,.22);
            }

        .hiring-offer-card__header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            background: linear-gradient(135deg,#f97316,#ea580c);
            color: #fff;
            font-size: 14px;
            font-weight: 800;
        }

        .hiring-offer-card__body {
            padding: 10px 14px 6px;
        }

        .hiring-offer-card__label {
            font-size: 13px;
            font-weight: 700;
            color: #111827;
        }

        .hiring-offer-card__hint {
            font-size: 11px;
            color: #9ca3af;
            margin-top: 3px;
        }

        .hiring-offer-card__footer {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 7px 14px;
            border-top: 1px solid #fed7aa;
            background: #fff7ed;
            font-size: 12px;
            font-weight: 700;
            color: #c2410c;
        }
    </style>
}

<div class="chat-shell" id="chatShell">

    <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════ -->
    <div class="chat-sidebar" id="chatSidebar">
        <div class="chat-sidebar-header">
            <span class="chat-sidebar-title">Tin nhắn</span>
        </div>
        <div class="chat-search-box" style="position:relative;">
            <span class="material-icons-round" style="position:absolute;left:24px;top:18px;font-size:18px;color:#9ca3af;">search</span>
            <input class="chat-search-input" id="convSearch" placeholder="Tìm hội thoại..." type="text" />
        </div>
        <div class="conv-list" id="convList">
            <div style="text-align:center;padding:30px 0;"><div class="spin"></div></div>
        </div>
    </div>

    <!-- ═══ MAIN AREA ══════════════════════════════════════════════════ -->
    <div class="chat-main" id="chatMain">
        <!-- Empty state (initial) -->
        <div class="chat-empty" id="chatEmpty">
            <span class="material-icons-round">chat_bubble_outline</span>
            <h3>Chọn một hội thoại để bắt đầu</h3>
            <p style="font-size:14px;">Các tin nhắn của bạn sẽ xuất hiện ở đây.</p>
        </div>

        <!-- Chat area (hidden until conv selected) -->
        <div id="chatArea" style="display:none;flex:1;flex-direction:column;overflow:hidden;display:none;">

            <!-- Header -->
            <div class="chat-header" id="chatHeader">
                <div class="chat-header-left">
                    <div class="chat-header-avatar" id="headerAvatar">?</div>
                    <div>
                        <div class="chat-header-name" id="headerName">-</div>
                        <div class="chat-header-status" id="headerStatus"></div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button type="button" class="chat-header-pill" id="btnChatViewProfile" disabled title="Xem trang cá nhân đối phương">Xem trang cá nhân</button>
                    <button type="button" class="chat-action-btn danger" id="btnBlockConv" title="Khóa hội thoại" aria-label="Khóa hoặc mở khóa hội thoại">
                        <span class="material-icons-round" style="font-size:18px;">block</span>
                    </button>
                </div>
            </div>

            <!-- Messages -->
            <div class="chat-messages" id="chatMessages">
                <div style="text-align:center;padding:30px 0;"><div class="spin"></div></div>
            </div>

            <!-- Blocked banner (hidden by default) -->
            <div class="chat-blocked-banner" id="blockedBanner" style="display:none;">
                <span class="material-icons-round" style="vertical-align:middle;margin-right:4px;font-size:16px;">block</span>
                Cuộc trò chuyện đã bị khóa. Bạn không thể nhắn tin.
            </div>

            <!-- Input -->
            <div class="chat-input-area" id="chatInputArea">
                <div class="chat-input-wrap">
                    <textarea class="chat-textarea" id="msgInput" placeholder="Nhắn tin..." rows="1"></textarea>
                </div>
                <button class="chat-send-btn" id="sendBtn" title="Gửi">
                    <span class="material-icons-round" style="font-size:20px;">send</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Report ═════════════════════════════════════════════════ -->
<div id="reportModal" class="modal-backdrop" style="display:none;">
    <div class="modal-card">
        <div class="modal-title">Báo cáo tin nhắn</div>
        <div class="modal-sub">Vui lòng cho chúng tôi biết lý do bạn báo cáo tin nhắn này.</div>
        <textarea class="modal-input" id="reportReason" placeholder="Lý do báo cáo..." rows="3" style="resize:none;"></textarea>
        <textarea class="modal-input" id="reportEvidence" placeholder="Bằng chứng / mô tả thêm (tùy chọn)..." rows="2" style="resize:none;"></textarea>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeReportModal()">Hủy</button>
            <button class="btn-danger" onclick="submitReport()">Gửi báo cáo</button>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Delete confirm ═════════════════════════════════════════ -->
<div id="deleteModal" class="modal-backdrop" style="display:none;">
    <div class="modal-card">
        <div class="modal-title">Xóa tin nhắn</div>
        <div class="modal-sub">Tin nhắn sẽ bị xóa khỏi cuộc hội thoại này. Hành động này không thể hoàn tác.</div>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Hủy</button>
            <button class="btn-danger" onclick="confirmDelete()">Xóa</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.ChatConfig = {
            apiBaseUrl:             '@(ViewBag.ApiBaseUrl ?? "")',
            currentUserId:          '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("sub")?.Value ?? "")',
            initialConversationId:  '@(ViewBag.InitialConversationId?.ToString() ?? "")',
            accessToken:            '@ViewBag.AccessToken'
        };
    </script>
    <script src="~/js/chat.js"></script>
    @Html.AntiForgeryToken()
}