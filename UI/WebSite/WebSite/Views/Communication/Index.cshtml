@{
    ViewData["Title"] = "Tin nhắn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
<style>
    /* ─── Chat Layout ─────────────────────────────────────────── */
    .chat-shell {
        display: flex;
        height: calc(100vh - 72px);
        background: #f9fafb;
        overflow: hidden;
    }

    /* ─── Sidebar (Conversation List) ────────────────────────── */
    .chat-sidebar {
        width: 340px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border-right: 1px solid rgba(226,232,240,.8);
        box-shadow: 2px 0 12px rgba(15,23,42,.04);
    }

    .chat-sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 18px 14px;
        border-bottom: 1px solid #f1f5f9;
    }

    .chat-sidebar-title {
        font-size: 18px;
        font-weight: 800;
        color: #111827;
    }

    .chat-search-box {
        padding: 10px 14px 12px;
        border-bottom: 1px solid #f1f5f9;
    }

    .chat-search-input {
        width: 100%;
        padding: 9px 14px 9px 36px;
        border-radius: 12px;
        border: 1.5px solid #e5e7eb;
        font-size: 14px;
        background: #f9fafb;
        color: #374151;
        outline: none;
        transition: border .2s;
    }

    .chat-search-input:focus { border-color: #f97316; background: #fff; }

    .conv-list { flex: 1; overflow-y: auto; padding: 6px; }

    .conv-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 12px;
        border-radius: 16px;
        cursor: pointer;
        transition: all .18s ease;
        margin-bottom: 2px;
        position: relative;
    }

    .conv-item:hover { background: #fff7ed; }
    .conv-item.active { background: linear-gradient(135deg,#fff7ed,#ffffff); box-shadow: 0 4px 12px rgba(249,115,22,.1); }

    .conv-avatar {
        width: 48px; height: 48px;
        border-radius: 16px;
        background: linear-gradient(135deg, #f97316, #ea580c);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 18px; font-weight: 800;
        flex-shrink: 0;
        overflow: hidden;
    }

    .conv-avatar img { width: 100%; height: 100%; object-fit: cover; }

    .conv-info { flex: 1; min-width: 0; }

    .conv-name {
        font-size: 14px; font-weight: 700; color: #111827;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .conv-preview {
        font-size: 13px; color: #9ca3af;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        margin-top: 2px;
    }

    .conv-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
    .conv-actions { display: flex; align-items: center; gap: 6px; margin-left: 2px; }
    .conv-menu-wrap { position: relative; }
    .conv-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: none;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transition: all .16s ease;
    }
    .conv-more-btn:hover {
        background: #f1f5f9;
        color: #475569;
    }

    .conv-time { font-size: 11px; color: #9ca3af; }

    .unread-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: #f97316;
    }

    .conv-badge {
        min-width: 20px; height: 20px;
        padding: 0 5px;
        border-radius: 999px;
        background: linear-gradient(135deg,#f97316,#ea580c);
        color: #fff; font-size: 11px; font-weight: 800;
        display: flex; align-items: center; justify-content: center;
    }

    /* ─── Main Chat Area ──────────────────────────────────────── */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    /* Empty state */
    .chat-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        gap: 12px;
    }

    .chat-empty .material-icons-round { font-size: 56px; color: #fdba74; }
    .chat-empty h3 { font-size: 18px; font-weight: 700; color: #374151; }

    /* Chat header */
    .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        background: #fff;
        border-bottom: 1px solid #f1f5f9;
        box-shadow: 0 1px 8px rgba(15,23,42,.05);
    }

    .chat-header-left { display: flex; align-items: center; gap: 12px; }

    .chat-header-avatar {
        width: 42px; height: 42px; border-radius: 14px;
        background: linear-gradient(135deg,#f97316,#ea580c);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 16px; font-weight: 800;
        overflow: hidden;
    }

    .chat-header-name { font-size: 16px; font-weight: 800; color: #111827; }
    .chat-header-status { font-size: 12px; color: #9ca3af; }

    .chat-header-actions { display: flex; gap: 8px; }
    .chat-menu-wrap { position: relative; }
    .chat-menu-panel {
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 14px 30px rgba(15,23,42,.14);
        min-width: 160px;
        padding: 6px;
        z-index: 120;
        display: none;
    }
    .chat-menu-panel.open { display: block; }
    .chat-menu-panel.conv-menu-panel { top: calc(100% + 4px); right: -2px; }
    .chat-menu-item {
        width: 100%;
        border: none;
        background: transparent;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        border-radius: 10px;
        text-align: left;
        font-size: 13px;
        font-weight: 700;
        color: #374151;
        cursor: pointer;
        transition: background .15s ease;
    }
    .chat-menu-item:hover { background: #f9fafb; }
    .chat-menu-item.danger { color: #dc2626; }
    .chat-menu-item.danger:hover { background: #fef2f2; }

    .nmodal {
        display: none;
    }
    .nmodal.show {
        display: flex;
    }
    .nmodal-box {
        max-height: calc(100vh - 40px);
        overflow: auto;
    }

    .chat-action-btn {
        display: flex; align-items: center; justify-content: center;
        width: 38px; height: 38px; border-radius: 12px;
        border: 1px solid #e5e7eb; background: #fff;
        color: #6b7280; cursor: pointer;
        transition: all .18s ease;
    }

    .chat-action-btn:hover { color: #ea580c; background: #fff7ed; border-color: #fed7aa; }
    .chat-action-btn.danger:hover { color: #dc2626; background: #fef2f2; border-color: #fecaca; }

    /* Messages area */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        scroll-behavior: smooth;
    }

    .msg-group-date {
        display: flex; align-items: center; gap: 10px;
        margin: 8px 0;
    }

    .msg-group-date::before, .msg-group-date::after {
        content: ''; flex: 1; height: 1px; background: #f1f5f9;
    }

    .msg-group-date span {
        font-size: 12px; color: #9ca3af; font-weight: 600;
        white-space: nowrap;
    }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        max-width: 75%;
    }

    .msg-row.mine { margin-left: auto; flex-direction: row-reverse; }

    .msg-avatar {
        width: 32px; height: 32px; border-radius: 10px;
        background: linear-gradient(135deg,#f97316,#ea580c);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 13px; font-weight: 800;
        flex-shrink: 0; overflow: hidden;
    }

    .msg-avatar img { width: 100%; height: 100%; object-fit: cover; }

    .msg-bubble {
        padding: 10px 14px;
        border-radius: 18px;
        font-size: 14px; line-height: 1.55;
        word-break: break-word;
        position: relative;
    }

    .msg-row:not(.mine) .msg-bubble {
        background: #fff;
        color: #111827;
        border: 1.5px solid #f1f5f9;
        border-bottom-left-radius: 6px;
        box-shadow: 0 2px 8px rgba(15,23,42,.06);
    }

    .msg-row.mine .msg-bubble {
        background: linear-gradient(135deg,#f97316,#ea580c);
        color: #fff;
        border-bottom-right-radius: 6px;
        box-shadow: 0 4px 12px rgba(249,115,22,.22);
    }

    .msg-bubble.deleted {
        opacity: .5;
        font-style: italic;
        font-size: 13px;
    }

    .msg-time {
        font-size: 11px; color: #9ca3af;
        margin-top: 3px;
        text-align: right;
    }

    .msg-row.mine .msg-time { text-align: left; }
    .msg-wrap {
        display: flex;
        flex-direction: column;
        gap: 3px;
        position: relative;
    }
    .msg-bubble-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .msg-row.mine .msg-bubble-row {
        flex-direction: row-reverse;
    }
    .msg-hover-actions {
        position: relative;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .16s ease, visibility .16s ease;
    }
    .msg-row:hover .msg-hover-actions,
    .msg-hover-actions.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    .msg-more-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: none;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transition: all .16s ease;
    }
    .msg-more-btn:hover {
        background: #f1f5f9;
        color: #475569;
    }

    /* Context menu */
    .msg-ctx-menu {
        position: absolute;
        top: calc(100% + 6px); right: 0;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 10px 28px rgba(15,23,42,.12);
        padding: 6px;
        z-index: 100;
        min-width: 140px;
        display: none;
    }

    .msg-ctx-menu.open { display: block; }

    .ctx-item {
        width: 100%;
        border: none;
        background: transparent;
        text-align: left;
        display: flex; align-items: center; gap: 8px;
        padding: 8px 10px; border-radius: 10px;
        font-size: 13px; font-weight: 600; cursor: pointer;
        color: #374151; transition: background .15s;
    }

    .ctx-item:hover { background: #f9fafb; }
    .ctx-item.danger { color: #dc2626; }
    .ctx-item.danger:hover { background: #fef2f2; }

    /* Input area */
    .chat-input-area {
        padding: 14px 20px;
        background: #fff;
        border-top: 1px solid #f1f5f9;
        display: flex; align-items: flex-end; gap: 10px;
    }

    .chat-input-wrap {
        flex: 1;
        display: flex; align-items: flex-end;
        border: 1.5px solid #e5e7eb;
        border-radius: 18px;
        background: #f9fafb;
        padding: 8px 14px;
        gap: 8px;
        transition: border .2s;
    }

    .chat-input-wrap:focus-within { border-color: #f97316; background: #fff; }

    .chat-textarea {
        flex: 1; resize: none; border: none; outline: none;
        background: transparent; font-size: 14px; color: #374151;
        line-height: 1.5; max-height: 120px; overflow-y: auto;
        font-family: 'Quicksand', sans-serif;
    }

    .chat-send-btn {
        width: 42px; height: 42px; border-radius: 14px;
        background: linear-gradient(135deg,#f97316,#ea580c);
        border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        color: #fff;
        box-shadow: 0 6px 16px rgba(249,115,22,.3);
        transition: all .18s ease;
        flex-shrink: 0;
    }

    .chat-send-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 20px rgba(249,115,22,.36); }
    .chat-send-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }

    .chat-blocked-banner {
        text-align: center; padding: 12px 16px;
        background: #fef2f2; border-top: 1px solid #fecaca;
        font-size: 13px; font-weight: 600; color: #dc2626;
    }

    /* Loading spinner */
    .spin {
        border: 3px solid #f1f5f9; border-top-color: #f97316;
        border-radius: 50%; width: 32px; height: 32px;
        animation: spin .7s linear infinite; margin: 20px auto;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Modals */
    .modal-backdrop {
        position: fixed; inset: 0; background: rgba(15,23,42,.4);
        display: flex; align-items: center; justify-content: center;
        z-index: 200; backdrop-filter: blur(4px);
    }

    .modal-card {
        background: #fff; border-radius: 24px;
        padding: 28px 28px 24px; width: min(440px, calc(100vw - 32px));
        box-shadow: 0 32px 80px rgba(15,23,42,.18);
    }

    .modal-title { font-size: 18px; font-weight: 800; color: #111827; margin-bottom: 6px; }
    .modal-sub { font-size: 14px; color: #6b7280; margin-bottom: 20px; }

    .modal-input {
        width: 100%; padding: 10px 14px; border-radius: 12px;
        border: 1.5px solid #e5e7eb; font-size: 14px; color: #374151;
        outline: none; transition: border .2s; margin-bottom: 10px;
        font-family: 'Quicksand', sans-serif;
    }

    .modal-input:focus { border-color: #f97316; }

    .modal-actions { display: flex; gap: 10px; margin-top: 16px; justify-content: flex-end; }

    .btn-cancel {
        padding: 10px 20px; border-radius: 12px;
        border: 1.5px solid #e5e7eb; background: #fff;
        font-size: 14px; font-weight: 700; color: #6b7280;
        cursor: pointer; transition: all .18s;
    }

    .btn-cancel:hover { background: #f9fafb; }

    .btn-danger {
        padding: 10px 20px; border-radius: 12px;
        border: none; background: linear-gradient(135deg,#ef4444,#dc2626);
        font-size: 14px; font-weight: 700; color: #fff;
        cursor: pointer; box-shadow: 0 6px 16px rgba(220,38,38,.24);
        transition: all .18s;
    }

    .btn-danger:hover { transform: translateY(-1px); }

    .btn-primary {
        padding: 10px 20px; border-radius: 12px;
        border: none; background: linear-gradient(135deg,#f97316,#ea580c);
        font-size: 14px; font-weight: 700; color: #fff;
        cursor: pointer; box-shadow: 0 6px 16px rgba(249,115,22,.24);
        transition: all .18s;
    }

    .btn-primary:hover { transform: translateY(-1px); }

    .modal-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 700;
        transition: all .18s ease;
    }
    .modal-btn-secondary {
        border: 1.5px solid #e5e7eb;
        background: #fff;
        color: #6b7280;
    }
    .modal-btn-secondary:hover {
        background: #f9fafb;
    }
    .modal-btn-primary {
        border: none;
        background: linear-gradient(135deg,#f97316,#ea580c);
        color: #fff;
        box-shadow: 0 6px 16px rgba(249,115,22,.24);
    }
    .modal-btn-primary:hover {
        transform: translateY(-1px);
    }

    @@media (max-width: 767px) {
        .chat-sidebar { width: 100%; display: none; }
        .chat-sidebar.mobile-open { display: flex; position: fixed; inset: 72px 0 0; z-index: 50; }
        .chat-main { width: 100%; }
    }
</style>
}

<div class="chat-shell" id="chatShell">

    <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════ -->
    <div class="chat-sidebar" id="chatSidebar">
        <div class="chat-sidebar-header">
            <span class="chat-sidebar-title">Tin nhắn</span>
        </div>
        <div class="chat-search-box" style="position:relative;">
            <span class="material-icons-round" style="position:absolute;left:24px;top:18px;font-size:18px;color:#9ca3af;">search</span>
            <input class="chat-search-input" id="convSearch" placeholder="Tìm hội thoại..." type="text" />
        </div>
        <div class="conv-list" id="convList">
            <div style="text-align:center;padding:30px 0;"><div class="spin"></div></div>
        </div>
    </div>

    <!-- ═══ MAIN AREA ══════════════════════════════════════════════════ -->
    <div class="chat-main" id="chatMain">
        <!-- Empty state (initial) -->
        <div class="chat-empty" id="chatEmpty">
            <span class="material-icons-round">chat_bubble_outline</span>
            <h3>Chọn một hội thoại để bắt đầu</h3>
            <p style="font-size:14px;">Các tin nhắn của bạn sẽ xuất hiện ở đây.</p>
        </div>

        <!-- Chat area (hidden until conv selected) -->
        <div id="chatArea" style="display:none;flex:1;flex-direction:column;overflow:hidden;display:none;">

            <!-- Header -->
            <div class="chat-header" id="chatHeader">
                <div class="chat-header-left">
                    <div class="chat-header-avatar" id="headerAvatar">?</div>
                    <div>
                        <div class="chat-header-name" id="headerName">-</div>
                        <div class="chat-header-status" id="headerStatus"></div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button class="chat-action-btn danger" id="btnBlockConv" title="Chặn">
                        <span class="material-icons-round" style="font-size:18px;">block</span>
                    </button>
                </div>
            </div>

            <!-- Messages -->
            <div class="chat-messages" id="chatMessages">
                <div style="text-align:center;padding:30px 0;"><div class="spin"></div></div>
            </div>

            <!-- Blocked banner (hidden by default) -->
            <div class="chat-blocked-banner" id="blockedBanner" style="display:none;">
                <span class="material-icons-round" style="vertical-align:middle;margin-right:4px;font-size:16px;">block</span>
                Cuộc trò chuyện đã bị khóa. Bạn không thể nhắn tin.
            </div>

            <!-- Input -->
            <div class="chat-input-area" id="chatInputArea">
                <div class="chat-input-wrap">
                    <textarea class="chat-textarea" id="msgInput" placeholder="Nhắn tin..." rows="1"></textarea>
                </div>
                <button class="chat-send-btn" id="sendBtn" title="Gửi">
                    <span class="material-icons-round" style="font-size:20px;">send</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL: Conversation Report ═════════════════════════════════════ -->
<div id="conversationReportModal" class="nmodal fixed inset-0 z-50 bg-black/50 backdrop-blur-sm items-center justify-center px-4" onclick="if(event.target===this)closeConversationReportModal()">
    <div class="nmodal-box bg-white rounded-2xl w-full max-w-xl shadow-2xl relative">
        <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
            <div>
                <h2 class="text-lg font-bold text-gray-900">Gửi phản nàn cuộc trò chuyện</h2>
                <p id="conversationReportTarget" class="text-xs text-gray-400 font-semibold mt-0.5">Cuộc trò chuyện</p>
            </div>
            <button type="button" onclick="closeConversationReportModal()" class="text-gray-300 hover:text-gray-700 material-icons-round text-2xl transition-colors">close</button>
        </div>
        <form id="conversationReportForm" method="post" asp-controller="Report" asp-action="ReportConversation" class="px-6 py-5 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="conversationReportConversationId" name="ConversationId" />
            <input type="hidden" id="conversationReportReturnUrl" name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Lý do phản nàn <span class="text-red-500">*</span></label>
                <textarea id="conversationReportReason" name="Reason" rows="4" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400" placeholder="Nhập lý do phản nàn..."></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Bằng chứng (không bắt buộc)</label>
                <textarea id="conversationReportEvidence" name="Evidence" rows="3" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400" placeholder="Mô tả, hình ảnh, video liên quan..."></textarea>
            </div>
            <div class="flex gap-2">
                <button type="button" onclick="closeConversationReportModal()" class="modal-btn modal-btn-secondary w-full">Huỷ</button>
                <button id="conversationReportSubmitBtn" type="submit" class="modal-btn modal-btn-primary w-full">Gửi phản nàn</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══ MODAL: Report Message ══════════════════════════════════════════ -->
<div id="reportModal" class="nmodal fixed inset-0 z-50 bg-black/50 backdrop-blur-sm items-center justify-center px-4" onclick="if(event.target===this)closeReportModal()">
    <div class="nmodal-box bg-white rounded-2xl w-full max-w-xl shadow-2xl relative">
        <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
            <div>
                <h2 class="text-lg font-bold text-gray-900">Báo cáo tin nhắn</h2>
                <p id="messageReportTarget" class="text-xs text-gray-400 font-semibold mt-0.5">Tin nhắn trong cuộc trò chuyện</p>
            </div>
            <button type="button" onclick="closeReportModal()" class="text-gray-300 hover:text-gray-700 material-icons-round text-2xl transition-colors">close</button>
        </div>
        <form id="messageReportForm" method="post" asp-controller="Report" asp-action="ReportMessage" class="px-6 py-5 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="messageReportMessageId" name="MessageId" />
            <input type="hidden" id="messageReportReturnUrl" name="ReturnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Lý do báo cáo <span class="text-red-500">*</span></label>
                <textarea id="reportReason" name="Reason" rows="4" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400" placeholder="Nhập lý do báo cáo..."></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Bằng chứng (không bắt buộc)</label>
                <textarea id="reportEvidence" name="Evidence" rows="3" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400" placeholder="Mô tả, hình ảnh, video liên quan..."></textarea>
            </div>
            <div class="flex gap-2">
                <button type="button" onclick="closeReportModal()" class="modal-btn modal-btn-secondary w-full">Huỷ</button>
                <button id="messageReportSubmitBtn" type="submit" class="modal-btn modal-btn-primary w-full">Gửi báo cáo</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══ MODAL: Delete confirm ═════════════════════════════════════════ -->
<div id="deleteModal" class="modal-backdrop" style="display:none;">
    <div class="modal-card">
        <div class="modal-title">Xoá tin nhắn</div>
        <div class="modal-sub">Tin nhắn sẽ bị xoá khỏi cuộc hội thoại này. Hành động này không thể hoàn tác.</div>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Huỷ</button>
            <button class="btn-danger" onclick="confirmDelete()">Xoá</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
// ════════════════════════════════════════════════════════════════════
//  STATE
// ════════════════════════════════════════════════════════════════════
const apiBaseUrl = '@(ViewBag.ApiBaseUrl ?? "")';
const currentUserId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("sub")?.Value ?? "")';
let activeConvId = null;
let activeConvData = null; // { isBlocked, isHidden, blockedByUserId, otherUserId, otherUserName }
let pendingDeleteMsgId = null;
let pendingReportMsgId = null;
let isSubmittingMessageReport = false;
let isSubmittingConversationReport = false;
let messageReportEditorsReady = false;
let conversationReportEditorsReady = false;
let allConversations = [];
let hubConnection = null;
let joinedConvId = null;

// ════════════════════════════════════════════════════════════════════
//  INIT
// ════════════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', async () => {
    await loadConversations();
    await initSignalR();

    const initialId = '@(ViewBag.InitialConversationId?.ToString() ?? "")';
    if (initialId && initialId !== '') {
        openConversation(initialId);
    }

    // Search filter
    document.getElementById('convSearch').addEventListener('input', e => {
        filterConversations(e.target.value.trim().toLowerCase());
    });

    // Auto-resize textarea
    const ta = document.getElementById('msgInput');
    ta.addEventListener('input', () => {
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
    });

    // Send on Enter (Shift+Enter = newline)
    ta.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });

    document.getElementById('sendBtn').addEventListener('click', sendMessage);
    document.getElementById('btnBlockConv').addEventListener('click', toggleBlock);
    document.getElementById('conversationReportForm')?.addEventListener('submit', handleConversationReportSubmit);
    document.getElementById('messageReportForm')?.addEventListener('submit', handleMessageReportSubmit);

    // Close context menus / conversation menus on outside click
    document.addEventListener('click', () => {
        closeMessageMenus();
        closeConversationMenus();
    });
});

// ════════════════════════════════════════════════════════════════════
//  CONVERSATIONS
// ════════════════════════════════════════════════════════════════════
async function loadConversations() {
    try {
        const res = await fetch('/Communication/Conversations');
        const json = await res.json();
        allConversations = json.data ?? [];
        renderConversations(allConversations);
    } catch {
        document.getElementById('convList').innerHTML = '<p style="text-align:center;color:#9ca3af;padding:20px;font-size:14px;">Không thể tải danh sách.</p>';
    }
}

function renderConversations(list) {
    const el = document.getElementById('convList');
    if (!list.length) {
        el.innerHTML = '<div style="text-align:center;color:#9ca3af;padding:30px 16px;font-size:14px;"><span class="material-icons-round" style="font-size:36px;color:#fdba74;display:block;margin-bottom:10px;">forum</span>Chưa có hội thoại nào.</div>';
        return;
    }
    el.innerHTML = list.map(c => {
        const conversationId = String(c.id || '');
        const initial = (c.otherUserName || 'U').charAt(0).toUpperCase();
        const avatarHtml = c.otherUserAvatar
            ? `<img src="${esc(c.otherUserAvatar)}" alt="${esc(c.otherUserName)}">`
            : initial;
        const isActive = c.id === activeConvId;
        const time = c.lastMessageAt ? fmtTime(c.lastMessageAt) : '';
        const badge = c.unreadCount > 0 ? `<span class="conv-badge">${c.unreadCount > 99 ? '99+' : c.unreadCount}</span>` : '';
        return `<div class="conv-item ${isActive ? 'active' : ''}" onclick="openConversation('${conversationId}')" data-id="${conversationId}" data-name="${esc(c.otherUserName)}" id="conv-${conversationId}">
            <div class="conv-avatar">${avatarHtml}</div>
            <div class="conv-info">
                <div class="conv-name">${esc(c.otherUserName || 'Người dùng')}</div>
                <div class="conv-preview">${esc(c.lastMessage || 'Bắt đầu cuộc trò chuyện...')}</div>
            </div>
            <div class="conv-meta">
                <span class="conv-time">${time}</span>
                ${badge}
            </div>
            <div class="conv-actions">
                <div class="conv-menu-wrap">
                    <button type="button" class="conv-more-btn" title="Tùy chọn" onclick="toggleConversationMenu(event,'${conversationId}')">
                        <span class="material-icons-round" style="font-size:18px;">more_horiz</span>
                    </button>
                    <div class="chat-menu-panel conv-menu-panel" id="convMenu-${conversationId}">
                        <button class="chat-menu-item danger" type="button" onclick="openConversationReportFor(event,'${conversationId}')">
                            <span class="material-icons-round" style="font-size:16px;">flag</span>
                            <span>Báo cáo</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('');
}

function filterConversations(q) {
    if (!q) { renderConversations(allConversations); return; }
    renderConversations(allConversations.filter(c => (c.otherUserName || '').toLowerCase().includes(q)));
}

// ════════════════════════════════════════════════════════════════════
//  OPEN CONVERSATION
// ════════════════════════════════════════════════════════════════════
async function openConversation(id) {
    if (activeConvId === id) return;
    const previousId = activeConvId;
    activeConvId = id;
    const reportConversationIdInput = document.getElementById('conversationReportConversationId');
    if (reportConversationIdInput) reportConversationIdInput.value = String(id);
    const reportReturnUrlInput = document.getElementById('conversationReportReturnUrl');
    if (reportReturnUrlInput) reportReturnUrlInput.value = `/Communication?conversationId=${encodeURIComponent(id)}`;
    closeConversationMenus();

    // Highlight sidebar item
    document.querySelectorAll('.conv-item').forEach(el => el.classList.remove('active'));
    const conv = document.getElementById(`conv-${id}`);
    if (conv) conv.classList.add('active');

    // Show chat area, hide empty
    document.getElementById('chatEmpty').style.display = 'none';
    const area = document.getElementById('chatArea');
    area.style.display = 'flex';
    area.style.flexDirection = 'column';

    document.getElementById('chatMessages').innerHTML = '<div style="text-align:center;padding:40px;"><div class="spin"></div></div>';
    document.getElementById('headerName').textContent = conv?.dataset?.name ?? '...';

    await loadMessages(id);
    await joinConversationIfReady(id, previousId);
    resetUnreadCount(id);
}

// ════════════════════════════════════════════════════════════════════
//  MESSAGES
// ════════════════════════════════════════════════════════════════════
async function loadMessages(convId, page = 1) {
    try {
        const res = await fetch(`/Communication/Messages?conversationId=${convId}&page=${page}&pageSize=50`);
        const json = await res.json();
        const data = json.data;

        // Update header
        document.getElementById('headerName').textContent = data.otherUserName || 'Người dùng';
        const avatarEl = document.getElementById('headerAvatar');
        avatarEl.textContent = (data.otherUserName || 'U').charAt(0).toUpperCase();

        activeConvData = {
            isBlocked: data.isBlocked,
            isHidden: data.isHidden,
            blockedByUserId: data.blockedByUserId || null,
            otherUserId: data.otherUserId,
            otherUserName: data.otherUserName
        };

        updateBlockUI(data.isBlocked);
        renderMessages(data.messages ?? []);
    } catch {
        document.getElementById('chatMessages').innerHTML = '<p style="text-align:center;color:#9ca3af;padding:20px;">Không thể tải tin nhắn.</p>';
    }
}

function renderMessages(messages) {
    const el = document.getElementById('chatMessages');
    if (!messages.length) {
        el.innerHTML = '<div style="text-align:center;color:#9ca3af;padding:40px;font-size:14px;"><span class="material-icons-round" style="font-size:36px;color:#fdba74;display:block;margin-bottom:10px;">chat_bubble_outline</span>Chưa có tin nhắn nào. Hãy bắt đầu cuộc trò chuyện!</div>';
        return;
    }

    // Messages come ordered desc, reverse for display
    const sorted = [...messages].sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
    let lastDate = '';

    el.innerHTML = sorted.map(m => {
        const isMine = resolveMessageIsMine(m);
        const dateStr = new Date(m.createdAt).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
        const dateSep = dateStr !== lastDate ? `<div class="msg-group-date"><span>${dateStr}</span></div>` : '';
        lastDate = dateStr;

        const initial = (m.senderName || 'U').charAt(0).toUpperCase();
        const avatarHtml = m.senderAvatar
            ? `<img src="${esc(m.senderAvatar)}" alt="${esc(m.senderName)}">`
            : initial;

        const ctxItem = isMine
            ? `<button type="button" class="ctx-item danger" onclick="openDeleteModal('${m.id}')"><span class="material-icons-round" style="font-size:16px;">delete</span>Xoá</button>`
            : `<button type="button" class="ctx-item danger" onclick="openReportModal('${m.id}')"><span class="material-icons-round" style="font-size:16px;">flag</span>Báo cáo</button>`;

        return `${dateSep}
        <div class="msg-row ${isMine ? 'mine' : ''}" id="msg-${m.id}">
            ${!isMine ? `<div class="msg-avatar">${avatarHtml}</div>` : ''}
            <div class="msg-wrap">
                <div class="msg-bubble-row">
                    <div class="msg-bubble ${m.isDeleted ? 'deleted' : ''}"
                         oncontextmenu="openCtxMenu(event,'${m.id}')"
                         ondblclick="openCtxMenu(event,'${m.id}')">
                        ${esc(m.content)}
                    </div>
                    <div class="msg-hover-actions" id="msgActions-${m.id}">
                        <button type="button" class="msg-more-btn" title="Tùy chọn" onclick="toggleMessageMenu(event,'${m.id}')">
                            <span class="material-icons-round" style="font-size:18px;">more_vert</span>
                        </button>
                        <div class="msg-ctx-menu" id="ctx-${m.id}">
                            ${ctxItem}
                        </div>
                    </div>
                </div>
                <div class="msg-time">${fmtMsgTime(m.createdAt)}${m.readAt ? ' ✓✓' : ''}</div>
            </div>
            ${isMine ? `<div class="msg-avatar">${avatarHtml}</div>` : ''}
        </div>`;
    }).join('');

    // Scroll to bottom
    el.scrollTop = el.scrollHeight;
}

function appendMessage(m) {
    const el = document.getElementById('chatMessages');
    // Remove empty state if present
    const empty = el.querySelector('.chat-empty, [style*="chat_bubble_outline"]');
    if (empty) empty.remove();

    const isMine = resolveMessageIsMine(m);
    const initial = (m.senderName || 'U').charAt(0).toUpperCase();
    const ctxItem = isMine
        ? `<button type="button" class="ctx-item danger" onclick="openDeleteModal('${m.id}')"><span class="material-icons-round" style="font-size:16px;">delete</span>Xoá</button>`
        : `<button type="button" class="ctx-item danger" onclick="openReportModal('${m.id}')"><span class="material-icons-round" style="font-size:16px;">flag</span>Báo cáo</button>`;

    const row = document.createElement('div');
    row.className = `msg-row ${isMine ? 'mine' : ''}`;
    row.id = `msg-${m.id}`;
    row.innerHTML = `
        ${!isMine ? `<div class="msg-avatar">${initial}</div>` : ''}
        <div class="msg-wrap">
            <div class="msg-bubble-row">
                <div class="msg-bubble" oncontextmenu="openCtxMenu(event,'${m.id}')" ondblclick="openCtxMenu(event,'${m.id}')">${esc(m.content)}</div>
                <div class="msg-hover-actions" id="msgActions-${m.id}">
                    <button type="button" class="msg-more-btn" title="Tùy chọn" onclick="toggleMessageMenu(event,'${m.id}')">
                        <span class="material-icons-round" style="font-size:18px;">more_vert</span>
                    </button>
                    <div class="msg-ctx-menu" id="ctx-${m.id}">
                        ${ctxItem}
                    </div>
                </div>
            </div>
            <div class="msg-time">${fmtMsgTime(m.createdAt)}</div>
        </div>
        ${isMine ? `<div class="msg-avatar">${initial}</div>` : ''}`;
    el.appendChild(row);
    el.scrollTop = el.scrollHeight;
}

// ════════════════════════════════════════════════════════════════════
//  SEND MESSAGE
// ════════════════════════════════════════════════════════════════════
async function sendMessage() {
    const ta = document.getElementById('msgInput');
    const text = ta.value.trim();
    if (!text || !activeConvId) return;

    ta.value = '';
    ta.style.height = 'auto';

    try {
        const usedHub = await sendMessageViaHub(text);
        if (!usedHub) {
            const res = await fetch(`/Communication/SendMessage?conversationId=${activeConvId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgery() },
                body: JSON.stringify({ content: text, messageType: 1 })
            });
            const json = await res.json();
            if (json.success) {
                appendMessage(json.data);
                updateConversationPreview(json.data, true);
            }
        }
    } catch {}
}

// ════════════════════════════════════════════════════════════════════
//  BLOCK / HIDE
// ════════════════════════════════════════════════════════════════════
async function toggleBlock() {
    if (!activeConvId || !activeConvData) return;
    if (activeConvData.isBlocked && !canCurrentUserUnblock()) {
        alert('Chỉ người đã khóa cuộc trò chuyện mới có thể mở khóa.');
        return;
    }
    const action = activeConvData.isBlocked ? 'unblock' : 'block';
    const status = await updateStatus(action);
    if (!status) return;
    activeConvData.isBlocked = !!status.isBlocked;
    activeConvData.isHidden = !!status.isHidden;
    activeConvData.blockedByUserId = status.blockedByUserId || null;
    updateBlockUI(activeConvData.isBlocked);
}

async function unblockConv() {
    if (!canCurrentUserUnblock()) {
        alert('Chỉ người đã khóa cuộc trò chuyện mới có thể mở khóa.');
        return;
    }
    const status = await updateStatus('unblock');
    if (!status) return;
    activeConvData.isBlocked = !!status.isBlocked;
    activeConvData.isHidden = !!status.isHidden;
    activeConvData.blockedByUserId = status.blockedByUserId || null;
    updateBlockUI(activeConvData.isBlocked);
}

async function hideConv() {
    if (!activeConvId) return;
    const action = activeConvData?.isHidden ? 'unhide' : 'hide';
    const status = await updateStatus(action);
    if (!status) return;
    activeConvData.isHidden = !!status.isHidden;
    if (action === 'hide') {
        alert('Hội thoại đã được ẩn.');
        allConversations = allConversations.filter(c => String(c.id) !== String(activeConvId));
        renderConversations(allConversations);
        // Reset main area
        activeConvId = null;
        activeConvData = null;
        document.getElementById('chatArea').style.display = 'none';
        document.getElementById('chatEmpty').style.display = 'flex';
    }
}

async function updateStatus(action) {
    try {
        const res = await fetch(`/Communication/UpdateStatus/${activeConvId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgery() },
            body: JSON.stringify({ action })
        });
        const json = await res.json();
        if (!res.ok || !json?.success) {
            alert(json?.message || 'Không thể cập nhật trạng thái hội thoại.');
            return null;
        }
        return json.data ?? null;
    } catch {}
    return null;
}

function canCurrentUserUnblock() {
    if (!activeConvData?.isBlocked) return true;
    return !!activeConvData.blockedByUserId && String(activeConvData.blockedByUserId) === String(currentUserId);
}

function updateBlockUI(isBlocked) {
    const banner = document.getElementById('blockedBanner');
    const inputArea = document.getElementById('chatInputArea');
    const blockBtn = document.getElementById('btnBlockConv');
    const canUnblock = canCurrentUserUnblock();

    banner.style.display = isBlocked ? 'block' : 'none';
    inputArea.style.display = isBlocked ? 'none' : 'flex';
    blockBtn.title = isBlocked ? (canUnblock ? 'Bỏ chặn' : 'Cuộc trò chuyện đang bị khóa') : 'Chặn';
    blockBtn.querySelector('.material-icons-round').textContent = isBlocked ? 'lock_open' : 'block';
    blockBtn.disabled = isBlocked && !canUnblock;
    blockBtn.style.opacity = blockBtn.disabled ? '.55' : '1';
    blockBtn.style.cursor = blockBtn.disabled ? 'not-allowed' : 'pointer';
}

// ════════════════════════════════════════════════════════════════════
//  CONTEXT MENU
// ════════════════════════════════════════════════════════════════════
function closeMessageMenus() {
    document.querySelectorAll('.msg-ctx-menu.open').forEach(m => m.classList.remove('open'));
    document.querySelectorAll('.msg-hover-actions.open').forEach(m => m.classList.remove('open'));
}

function toggleMessageMenu(event, msgId) {
    event?.preventDefault?.();
    event?.stopPropagation?.();

    const menu = document.getElementById(`ctx-${msgId}`);
    const holder = document.getElementById(`msgActions-${msgId}`);
    if (!menu || !holder) return;

    const willOpen = !menu.classList.contains('open');
    closeMessageMenus();
    if (willOpen) {
        menu.classList.add('open');
        holder.classList.add('open');
    }
}

function openCtxMenu(e, msgId) {
    e.preventDefault();
    e.stopPropagation();
    toggleMessageMenu(e, msgId);
    closeConversationMenus();
}

// ════════════════════════════════════════════════════════════════════
//  DELETE
// ════════════════════════════════════════════════════════════════════
function openDeleteModal(msgId) {
    closeMessageMenus();
    pendingDeleteMsgId = msgId;
    document.getElementById('deleteModal').style.display = 'flex';
}

function closeDeleteModal() {
    document.getElementById('deleteModal').style.display = 'none';
    pendingDeleteMsgId = null;
}

async function confirmDelete() {
    if (!pendingDeleteMsgId) return;
    try {
        const res = await fetch(`/Communication/DeleteMessage/${pendingDeleteMsgId}`, {
            method: 'DELETE',
            headers: { 'RequestVerificationToken': getAntiForgery() }
        });
        const json = await res.json();
        if (json.success) {
            applyMessageDeleted(pendingDeleteMsgId, activeConvId);
        }
    } catch {}
    closeDeleteModal();
}

// ════════════════════════════════════════════════════════════════════
//  REPORT
// ════════════════════════════════════════════════════════════════════
function toggleConversationMenu(event, conversationId) {
    event?.preventDefault?.();
    event?.stopPropagation?.();
    const panel = document.getElementById(`convMenu-${conversationId}`);
    if (!panel) return;
    const willOpen = !panel.classList.contains('open');
    closeConversationMenus();
    if (willOpen) panel.classList.add('open');
}

function closeConversationMenus() {
    document.querySelectorAll('.conv-menu-panel.open').forEach(m => m.classList.remove('open'));
}

function openConversationReportFor(event, conversationId) {
    event?.preventDefault?.();
    event?.stopPropagation?.();
    const convEl = document.getElementById(`conv-${conversationId}`);
    const conversationName = String(convEl?.dataset?.name || '').trim();
    openConversationReportModal(conversationId, conversationName);
}

function notifyChat(message, type = 'info') {
    if (typeof window.showToast === 'function') {
        window.showToast(message, { type });
    } else {
        alert(message);
    }
}

function extractConversationReportPlainText(html) {
    const div = document.createElement('div');
    div.innerHTML = String(html || '');
    return (div.textContent || div.innerText || '').replace(/\s+/g, ' ').trim();
}

function getConversationReportEditorContent(editorId) {
    if (typeof tinymce !== 'undefined') {
        const editor = tinymce.get(editorId);
        if (editor) return editor.getContent();
    }
    const input = document.getElementById(editorId);
    return input ? (input.value || '') : '';
}

function setConversationReportEditorContent(editorId, value) {
    if (typeof tinymce !== 'undefined') {
        const editor = tinymce.get(editorId);
        if (editor) {
            editor.setContent(value || '');
            return;
        }
    }
    const input = document.getElementById(editorId);
    if (input) input.value = value || '';
}

async function uploadConversationReportMediaFiles(files, endpoint, emptyMessage) {
    if (!files || !files.length) throw new Error(emptyMessage);

    const formData = new FormData();
    Array.from(files).forEach(file => formData.append('files', file));

    const response = await fetch(endpoint, {
        method: 'POST',
        credentials: 'same-origin',
        body: formData
    });

    const raw = await response.text();
    let result = null;
    if (raw) {
        try {
            result = JSON.parse(raw);
        } catch {
            if (response.redirected && response.url && response.url.includes('/Auth/Login')) {
                throw new Error('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.');
            }
            throw new Error('Server trả về dữ liệu không hợp lệ khi upload media.');
        }
    }

    if (!response.ok) {
        throw new Error((result && result.message) || (`Upload media thất bại (HTTP ${response.status}).`));
    }

    if (!result || !result.success || !result.data || !Array.isArray(result.data.urls) || result.data.urls.length === 0) {
        throw new Error((result && result.message) || 'Upload media thất bại.');
    }

    return result.data.urls;
}

function pickConversationReportFile(accept, multiple = false) {
    return new Promise((resolve) => {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = accept;
        input.multiple = !!multiple;
        input.onchange = () => {
            const files = input.files ? Array.from(input.files) : [];
            resolve(multiple ? files : (files[0] || null));
        };
        input.click();
    });
}

function uploadSingleConversationReportImageForTiny(blobInfo) {
    return new Promise(async (resolve, reject) => {
        try {
            const urls = await uploadConversationReportMediaFiles(
                [blobInfo.blob()],
                '/Report/UploadReportMedia?mediaType=image',
                'Vui lòng chọn ít nhất một ảnh.');
            resolve(urls[0]);
        } catch (error) {
            reject({ message: (error && error.message) || 'Không thể upload ảnh.' });
        }
    });
}

function handleConversationReportTinyFilePicker(callback, meta) {
    const isImage = meta.filetype === 'image';
    const accept = isImage
        ? 'image/*'
        : 'video/mp4,video/webm,video/ogg,video/quicktime,.mp4,.webm,.ogg,.mov';
    const endpoint = isImage
        ? '/Report/UploadReportMedia?mediaType=image'
        : '/Report/UploadReportMedia?mediaType=video';

    pickConversationReportFile(accept, false).then(async (file) => {
        if (!file) return;
        try {
            const urls = await uploadConversationReportMediaFiles([file], endpoint, 'Vui lòng chọn file để upload.');
            const url = urls[0];
            if (isImage) callback(url, { alt: file.name || 'image' });
            else callback(url, { source2: '', poster: '' });
        } catch (error) {
            notifyChat((error && error.message) || 'Không thể upload media.', 'error');
        }
    });
}

