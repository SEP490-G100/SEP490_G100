    <script>
        /* Auto-scroll & Drag/Swipe Marquee */
        document.querySelectorAll('.marquee-container').forEach(function (container) {
            var track = container.querySelector('.marquee-track');
            if(!track) return;
            var items = track.innerHTML;
            track.innerHTML = items + items; // Duplicate

            var isDown = false;
            var startX;
            var scrollLeft;
            var autoScrollSpeed = 1; // Pixels per frame
            var isHovered = false;

            function autoScroll() {
                if (!isDown && !isHovered) {
                    container.scrollLeft += autoScrollSpeed;
                    if (container.scrollLeft >= track.scrollWidth / 2) {
                        container.scrollLeft -= track.scrollWidth / 2;
                    } else if (container.scrollLeft <= 0) {
                        container.scrollLeft += track.scrollWidth / 2;
                    }
                }
                requestAnimationFrame(autoScroll);
            }

            container.addEventListener('mouseenter', function () { isHovered = true; });
            container.addEventListener('mouseleave', function () {
                isHovered = false;
                isDown = false;
            });

            container.addEventListener('mousedown', function (e) {
                isDown = true;
                startX = e.pageX - container.offsetLeft;
                scrollLeft = container.scrollLeft;
            });

            container.addEventListener('mouseup', function () {
                isDown = false;
            });

            container.addEventListener('mousemove', function (e) {
                if (!isDown) return;
                e.preventDefault();
                var x = e.pageX - container.offsetLeft;
                var walk = (x - startX) * 1.5; // Drag speed
                container.scrollLeft = scrollLeft - walk;

                if (container.scrollLeft >= track.scrollWidth / 2) {
                    container.scrollLeft -= track.scrollWidth / 2;
                    startX = e.pageX - container.offsetLeft;
                    scrollLeft = container.scrollLeft;
                } else if (container.scrollLeft <= 0) {
                    container.scrollLeft += track.scrollWidth / 2;
                    startX = e.pageX - container.offsetLeft;
                    scrollLeft = container.scrollLeft;
                }
            });

            // Touch support
            container.addEventListener('touchstart', function (e) {
                isDown = true;
                isHovered = true;
                startX = e.touches[0].pageX - container.offsetLeft;
                scrollLeft = container.scrollLeft;
            }, { passive: true });

            container.addEventListener('touchend', function () {
                isDown = false;
                isHovered = false;
            });

            container.addEventListener('touchmove', function (e) {
                if (!isDown) return;
                var x = e.touches[0].pageX - container.offsetLeft;
                var walk = (x - startX) * 1.5;
                container.scrollLeft = scrollLeft - walk;

                if (container.scrollLeft >= track.scrollWidth / 2) {
                    container.scrollLeft -= track.scrollWidth / 2;
                    startX = e.touches[0].pageX - container.offsetLeft;
                    scrollLeft = container.scrollLeft;
                } else if (container.scrollLeft <= 0) {
                    container.scrollLeft += track.scrollWidth / 2;
                    startX = e.touches[0].pageX - container.offsetLeft;
                    scrollLeft = container.scrollLeft;
                }
            }, { passive: true });

            requestAnimationFrame(autoScroll);
        });

        /* FAQ accordion toggle (Smooth) */
        function toggleFaq(btn) {
            var item = btn.closest('.faq-item');
            var wrapper = item.querySelector('.faq-answer-wrapper');
            var icon = btn.querySelector('.faq-icon');
            var isOpen = wrapper.classList.contains('grid-rows-[1fr]');

            /* Close all others */
            document.querySelectorAll('.faq-item').forEach(function (el) {
                if (el.querySelector('.faq-answer-wrapper')) {
                    el.querySelector('.faq-answer-wrapper').classList.remove('grid-rows-[1fr]');
                    el.querySelector('.faq-answer-wrapper').classList.add('grid-rows-[0fr]');
                }
                var existingIcon = el.querySelector('.faq-icon');
                if(existingIcon) existingIcon.style.transform = 'rotate(0deg)';
                var existingBtn = el.querySelector('.faq-btn');
                if(existingBtn) existingBtn.classList.remove('bg-orange-50/50', 'dark:bg-gray-700/40');
            });

            /* Toggle current */
            if (!isOpen) {
                wrapper.classList.remove('grid-rows-[0fr]');
                wrapper.classList.add('grid-rows-[1fr]');
                icon.style.transform = 'rotate(180deg)';
                btn.classList.add('bg-orange-50/50');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

