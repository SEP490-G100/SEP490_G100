            font-weight: 700;
            background: rgba(71, 85, 105, .36);
            border: 1px solid rgba(148, 163, 184, .18);
            transition: all .18s ease;
        }

        .nm-user-sheet__item + .nm-user-sheet__item {
            margin-top: 8px;
        }

        .nm-user-sheet__item:hover {
            color: #fff;
            border-color: rgba(251, 146, 60, .5);
            background: linear-gradient(135deg, rgba(251, 146, 60, .16), rgba(249, 115, 22, .12));
            transform: translateX(-2px);
        }

        .nm-user-sheet__item .material-icons-round {
            font-size: 20px;
            color: #d6e0ec;
            flex-shrink: 0;
        }

        .nm-user-sheet__item-label {
            flex: 1;
            text-align: left;
        }

        .nm-user-sheet__item-chev {
            font-size: 20px;
            color: #b7c4d3;
            flex-shrink: 0;
        }

        .nm-user-sheet__divider {
            height: 1px;
            margin: 14px 6px 8px;
            background: linear-gradient(90deg, rgba(148, 163, 184, .06), rgba(148, 163, 184, .5), rgba(148, 163, 184, .06));
        }

        .nm-user-sheet__footer {
            padding: 0 14px 18px;
        }

        .nm-user-sheet__item.is-logout {
            color: #fecaca;
            border-color: rgba(248, 113, 113, .42);
            background: linear-gradient(135deg, rgba(127, 29, 29, .34), rgba(153, 27, 27, .26));
        }

        .nm-user-sheet__item.is-logout .material-icons-round,
        .nm-user-sheet__item.is-logout .nm-user-sheet__item-chev {
            color: #fecaca;
        }

        .nm-user-sheet-open {
            overflow: hidden;
        }

        @@media (max-width: 767px) {
            .nm-nav-shell {
                padding: 0 12px;
            }

            .nm-nav-frame {
                min-height: 68px;
            }

            .nm-nav-frame {
                grid-template-columns: 1fr auto;
            }

            .nm-nav-frame > .nm-nav-links {
                display: none !important;
            }

            .nm-panel {
                right: -8px;
                width: min(360px, calc(100vw - 16px));
            }

            .nm-user-sheet {
                width: min(370px, calc(100vw - 8px));
            }

            .nm-user-sheet__name {
                font-size: 22px;
            }
        }
    </style>
    @RenderSection("Head", required: false)
</head>
@{
    var isHomePage = (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
                      ViewContext.RouteData.Values["action"]?.ToString() == "Index");
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string NavCls(string ctrl) => currentCtrl.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
        ? "nm-nav-link active"
        : "nm-nav-link";
    var nannyListNavCls = currentCtrl.Equals("Nanny", StringComparison.OrdinalIgnoreCase) &&
                          currentAction.Equals("List", StringComparison.OrdinalIgnoreCase)
        ? "nm-nav-link active"
        : "nm-nav-link";
    var homeNavCls = isHomePage ? "nm-nav-link active" : "nm-nav-link";
    var faqNavCls = currentCtrl.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                    currentAction.Equals("Faq", StringComparison.OrdinalIgnoreCase)
        ? "nm-nav-link active"
        : "nm-nav-link";
}
<body class="font-display bg-background-light dark:bg-background-dark text-gray-800 dark:text-gray-200 transition-colors duration-300" style="background-color: #f9fafb; color: #1f2937;" data-page="@(isHomePage ? "home" : "other")">
    <nav class="sticky top-0 z-50 bg-white/95 dark:bg-card-dark/95 backdrop-blur-lg border-b border-gray-100/80 dark:border-gray-800"
         style="box-shadow:0 1px 24px rgba(0,0,0,0.06)">
        <div class="nm-nav-shell">
            <div class="nm-nav-frame">

                <!-- Logo -->
                <a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity flex-shrink-0">
                    <div class="w-9 h-9 rounded-xl overflow-hidden flex items-center justify-center bg-gradient-to-br from-orange-100 to-orange-50 shadow-sm">
                        <img src="~/img/nanny-logo.jpg" alt="Logo NannyMatch" class="w-full h-full object-contain" />
                    </div>
                    <span class="text-xl font-bold tracking-tight"
                          style="font-family:'Quicksand',sans-serif; background:linear-gradient(135deg,#EA580C,#F97316); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent">NannyMatch</span>
                </a>

                <!-- Nav Links (giữa) -->
                <div class="hidden md:flex items-center gap-1 nm-nav-links">
                    <a href="/" class="@homeNavCls">Trang chủ</a>
                    <a href="/Search" class="@NavCls("Search")">Tìm công việc</a>
                    <a href="/Nanny/List" class="@nannyListNavCls">Tìm bảo mẫu</a>
                    <a href="/Blog" class="@NavCls("Blog")">Blog</a>
                    <a href="/Home/Faq" class="@faqNavCls">Hỏi đáp</a>
                </div>

                <!-- Actions -->
                <div class="flex items-center gap-3 flex-shrink-0">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a href="/Communication"
                           class="nm-icon-btn"
                           id="chatNavLink"
                           aria-label="Tin nhắn">
                            <span class="material-icons-round text-[20px]">chat_bubble_outline</span>
                            <span id="chatUnreadBadge" class="nm-badge-dot hidden" aria-hidden="true"></span>
                        </a>


                        <div class="relative" id="notificationDropdown">
                            <button type="button"
                                    id="notificationToggle"
                                    class="nm-icon-btn"
                                    aria-label="Thông báo">
                                <span class="material-icons-round text-[20px]">notifications</span>
                                <span id="notificationBadge" class="nm-badge-dot hidden"></span>
                            </button>

                            <div id="notificationMenu" class="nm-panel hidden">
                                <div class="nm-panel-header">
                                    <div>
                                        <p class="nm-panel-title">Thông báo</p>
                                        <p class="nm-panel-subtitle">Nhắc nhở và cập nhật quan trọng</p>
                                    </div>
                                    <div class="nm-panel-actions">
                                        <a href="/Notification/Center" class="nm-panel-link nm-panel-link--ghost">Xem tất cả</a>
                                        <button type="button" id="markAllNotificationsRead" class="nm-panel-link">
                                        Đánh dấu đã đọc
                                        </button>
                                    </div>
                                </div>
                                <div id="notificationList" class="nm-notification-list">
                                    <div class="nm-empty-state">
                                        <span class="material-icons-round">notifications_none</span>
                                        <p class="text-sm font-semibold text-gray-700">Đang tải thông báo...</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="relative" id="userDropdown">
                            <button type="button"
                                    id="userMenuToggle"
                                    aria-haspopup="dialog"
                                    aria-controls="dropdownMenu"
                                    aria-expanded="false"
                                    class="flex items-center gap-2 px-3 py-2 rounded-2xl border border-orange-100 bg-white/80 hover:bg-orange-50 dark:hover:bg-gray-800 transition-all">
                                <div class="w-8 h-8 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full overflow-hidden flex items-center justify-center text-white text-sm font-bold"
                                     data-current-user-avatar-slot
                                     data-current-user-avatar-img-class="w-full h-full object-cover"
                                     data-current-user-avatar-initial="@currentUserInitial">
                                    @if (!string.IsNullOrWhiteSpace(currentUserAvatar))
                                    {
                                        <img src="@currentUserAvatar"
                                             alt="Avatar"
                                             class="w-full h-full object-cover"
                                             data-current-user-avatar-img />
                                    }
                                    <span data-current-user-avatar-fallback
                                          class="@(string.IsNullOrWhiteSpace(currentUserAvatar) ? string.Empty : "hidden")">@currentUserInitial</span>
                                </div>
                                <span class="hidden sm:block text-sm font-semibold text-gray-700 dark:text-gray-300">
                                    @currentUserFirstName
                                </span>
                                <span class="material-icons-round text-gray-400 text-lg">expand_more</span>
                            </button>

                            <div id="userMenuBackdrop" class="nm-user-sheet-backdrop hidden"></div>
                            <div id="dropdownMenu" class="hidden nm-user-sheet">
                                <div class="nm-user-sheet__top">
                                    <button type="button" id="userMenuClose" class="nm-user-sheet__close" aria-label="Đóng menu tài khoản">
                                        <span class="material-icons-round">close</span>
                                    </button>
                                </div>
                                <div class="nm-user-sheet__profile flex flex-col px-3 py-2 border-b border-gray-100 dark:border-gray-700 mb-1 rounded-md">
                                    <span class="nm-user-sheet__avatar"
                                          data-current-user-avatar-slot
                                          data-current-user-avatar-initial="@currentUserInitial">
                                        @if (!string.IsNullOrWhiteSpace(currentUserAvatar))
                                        {
                                            <img src="@currentUserAvatar" alt="Avatar" data-current-user-avatar-img />
                                        }
                                        <span data-current-user-avatar-fallback
                                              class="@(string.IsNullOrWhiteSpace(currentUserAvatar) ? string.Empty : "hidden")">@currentUserInitial</span>
                                    </span>
                                    <div class="nm-user-sheet__profile-meta">
                                        <p class="nm-user-sheet__name">
                                            @currentUserFirstName @currentUserLastName
                                        </p>
                                        <p class="nm-user-sheet__email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                                    </div>
                                </div>

                                <p class="nm-user-sheet__section-title">Tài khoản</p>

                                <a href="@Url.Action("Index", "Profile")" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                    <span class="material-icons-round text-base">account_circle</span>
                                    Xem hồ sơ
                                </a>

                                @if (User.FindFirst("AuthProvider")?.Value != "google")
                                {
                                    <a href="/Auth/ChangePassword" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">password</span>
                                        Đổi mật khẩu
                                    </a>
                                }

                                <a href="/Subscription" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                    <span class="material-icons-round text-base">workspace_premium</span>
                                    Gói của tôi
                                </a>

                                @if (User.IsInRole("Parent"))
                                {
                                    <a href="/Search/History" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">history</span>
                                        Lịch sử bài đăng
                                    </a>
                                }

                                @if (User.IsInRole("Parent"))
                                {
                                    <a href="/Hiring/ViewHiringHistory" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">history</span>
                                        Lịch sử thuê bảo mẫu
                                    </a>
                                }

                                @if (User.IsInRole("Nanny"))
                                {
                                    <a href="/Hiring/ViewHiringHistory" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">history_toggle_off</span>
                                        Lịch sử được thuê
                                    </a>
                                }

                                @if (User.IsInRole("Parent") || User.IsInRole("Nanny"))
                                {
                                    <a href="/Contract" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">folder</span>
                                        Quản lí hợp đồng
                                    </a>
                                }

                                @if (User.IsInRole("Parent"))
                                {
                                    <a href="/Review/History" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">star</span>
                                        Đánh giá của tôi
                                    </a>
                                    <a href="/Nanny/Favorites" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">favorite</span>
                                        Bảo mẫu yêu thích
                                    </a>
                                    <a href="/Nanny/ContactRequests" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">contact_phone</span>
                                        Lịch sử yêu cầu liên hệ
                                    </a>
                                }

                                @if (User.IsInRole("Nanny"))
                                {
                                    <a href="/Search/SavedJobs" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">bookmark</span>
                                        Bài đăng đã lưu
                                    </a>
                                    <a href="/Search/Applications" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">work_history</span>
                                        Lịch sử ứng tuyển
                                    </a>
                                    <a href="/Nanny/ReceivedContactRequests" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">contact_mail</span>
                                        Yêu cầu liên hệ đã nhận
                                    </a>
                                    <a href="/VerificationRequest/NannyGetVerificationRequestList" class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">verified_user</span>
                                        Yêu cầu xác minh
                                    </a>
                                }

                                <div class="border-t border-gray-100 dark:border-gray-700 my-1"></div>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="flex cursor-pointer items-center gap-2 w-full rounded-md px-2 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-gray-700">
                                        <span class="material-icons-round text-base">logout</span>
                                        Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </div>

                        <script>
                            (() => {
                                const notificationDropdown = document.getElementById('notificationDropdown');
                                const notificationToggle = document.getElementById('notificationToggle');
                                const notificationMenu = document.getElementById('notificationMenu');
                                const notificationBadge = document.getElementById('notificationBadge');
                                const notificationList = document.getElementById('notificationList');
                                const markAllButton = document.getElementById('markAllNotificationsRead');

                                if (!notificationDropdown || !notificationToggle || !notificationMenu || !notificationBadge || !notificationList || !markAllButton) {
                                    return;
                                }

                                const UI_TEXT = {
                                    bellLabel: 'Thông báo',
                                    panelTitle: 'Thông báo',
                                    panelSubtitle: 'Nhắc nhở và cập nhật quan trọng',
                                    markAll: 'Đánh dấu đã đọc',
                                    viewAll: 'Xem tất cả',
                                    loading: 'Đang tải thông báo...',
                                    empty: 'Bạn chưa có thông báo nào.',
                                    fallbackTitle: 'Thông báo mới',
                                    fallbackBody: 'Bạn có thông báo mới từ hệ thống.',
                                    fallbackType: 'Thông báo',
                                    senderPrefix: 'Từ',
                                    loadError: 'Không thể tải thông báo lúc này.'
                                };

                                notificationToggle.setAttribute('aria-label', UI_TEXT.bellLabel);

                                const titleEl = notificationMenu.querySelector('.nm-panel-title');
                                const subtitleEl = notificationMenu.querySelector('.nm-panel-subtitle');
                                const emptyEl = notificationMenu.querySelector('.nm-empty-state p');
                                titleEl && (titleEl.textContent = UI_TEXT.panelTitle);
                                subtitleEl && (subtitleEl.textContent = UI_TEXT.panelSubtitle);
                                emptyEl && (emptyEl.textContent = UI_TEXT.loading);
                                markAllButton.textContent = UI_TEXT.markAll;

                                const panelHeader = notificationMenu.querySelector('.nm-panel-header');
                                if (panelHeader) {
                                    let actionsWrap = panelHeader.querySelector('.nm-panel-actions');
                                    if (!actionsWrap) {
                                        actionsWrap = document.createElement('div');
                                        actionsWrap.className = 'nm-panel-actions';
                                        panelHeader.appendChild(actionsWrap);
                                    }

                                    let viewAllLink = actionsWrap.querySelector('.nm-panel-link--ghost');
                                    if (!viewAllLink) {
                                        viewAllLink = document.createElement('a');
                                        viewAllLink.className = 'nm-panel-link nm-panel-link--ghost';
                                        actionsWrap.prepend(viewAllLink);
                                    }

                                    viewAllLink.href = '/Notification/Center';
                                    viewAllLink.textContent = UI_TEXT.viewAll;
                                    actionsWrap.appendChild(markAllButton);
                                }

                                const escapeHtml = (value) => String(value ?? '')
                                    .replaceAll('&', '&amp;')
                                    .replaceAll('<', '&lt;')
                                    .replaceAll('>', '&gt;')
                                    .replaceAll('"', '&quot;')
                                    .replaceAll("'", '&#39;');

                                const formatTime = (value) => {
                                    if (!value) return '';
                                    const date = new Date(value);
                                    if (Number.isNaN(date.getTime())) return '';
                                    return new Intl.DateTimeFormat('vi-VN', {
                                        day: '2-digit',
                                        month: '2-digit',
                                        year: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }).format(date);
                                };

                                const normalizeText = (value) => String(value ?? '')
                                    .trim()
                                    .toLowerCase()
                                    .replace(/\s+/g, ' ');

                                const shouldShowTypeChip = (item) => {
                                    const typeLabel = normalizeText(item?.typeLabel);
                                    const title = normalizeText(item?.title);
                                    if (!typeLabel) return false;
                                    if (typeLabel.includes('moderator')) return true;
                                    if (typeLabel.includes('kiểm duyệt')) return true;
                                    return typeLabel !== title;
                                };

                                const buildNotificationMeta = (item) => {
                                    const parts = [];
                                    if (shouldShowTypeChip(item)) {
                                        parts.push(`<span class="nm-notification-chip">${escapeHtml(item.typeLabel || UI_TEXT.fallbackType)}</span>`);
                                    }

                                    const sender = String(item?.senderLabel || '').trim();
                                    if (sender) {
                                        parts.push(`<span class="nm-notification-sender">${UI_TEXT.senderPrefix} ${escapeHtml(sender)}</span>`);
                                    }

                                    if (!parts.length) return '';
                                    return `<div class="nm-notification-item-meta">${parts.join('')}</div>`;
                                };

                                const renderEmpty = (message) => {
                                    notificationList.innerHTML = `
                                        <div class="nm-empty-state">
                                            <span class="material-icons-round">notifications_none</span>
                                            <p class="text-sm font-semibold text-gray-700">${escapeHtml(message)}</p>
                                        </div>`;
                                };

                                const getRealtimeToastConfig = (payload) => {
                                    if (!payload) return null;

                                    const type = String(payload.type || '').trim().toLowerCase();
                                    const message = payload.message || payload.title;
                                    if (message) {
                                        return {
                                            message,
                                            type: payload.toastType || 'success'
                                        };
                                    }

                                        switch (type) {
                                            case 'verification-request-submitted':
                                                return { message: 'Có yêu cầu xác minh mới đang chờ duyệt.', type: 'success' };
                                            case 'verification-request-created':
                                                return { message: 'Bạn vừa gửi yêu cầu xác minh thành công.', type: 'success' };
                                            case 'job-posting-review-required':
                                                return { message: 'Có bài đăng mới đang chờ kiểm duyệt viên duyệt.', type: 'success' };
                                            case 'complain-submitted':
                                                return { message: 'Có báo cáo mới cần xử lý.', type: 'error' };
                                            case 'verification-approved':
                                                return { message: 'Yêu cầu xác minh của bạn đã được chấp nhận.', type: 'success' };
                                            case 'verification-rejected':
                                                return { message: 'Yêu cầu xác minh của bạn đã bị từ chối.', type: 'error' };
                                            case 'job-posting-approved':
                                                return { message: 'Bài đăng của bạn đã được duyệt.', type: 'success' };
                                            case 'job-posting-rejected':
                                                return { message: 'Bài đăng của bạn đã bị từ chối.', type: 'error' };
                                            case 'job-posting-pending':
                                                return { message: 'Bài đăng của bạn đang chờ kiểm duyệt viên duyệt.', type: 'success' };
                                            case 'nanny-profile-favorited':
                                                return { message: 'Hồ sơ của bạn vừa được yêu thích.', type: 'success' };
                                            case 'system-warning':
                                                return { message: 'Có cảnh báo hệ thống cần xử lý.', type: 'error' };
                                        default:
                                            return null;
                                    }
                                };

                                const shouldSuppressRealtimeToast = (payload) => {
                                    const incomingType = String(payload?.type || '').trim().toLowerCase();
                                    const suppressType = String(window.__nmNotificationToastSuppressType || '').trim().toLowerCase();
                                    const suppressUntil = Number(window.__nmNotificationToastSuppressUntil || 0);
                                    if (!incomingType || !suppressType) return false;
                                    if (incomingType !== suppressType) return false;
                                    if (Date.now() > suppressUntil) return false;

                                    window.__nmNotificationToastSuppressType = '';
                                    window.__nmNotificationToastSuppressUntil = 0;
                                    return true;
                                };

                                const updateBadge = (count) => {
                                    if (!count || count <= 0) {
                                        notificationBadge.textContent = '';
                                        notificationBadge.classList.add('hidden');
                                        return;
                                    }

                                    notificationBadge.textContent = count > 99 ? '99+' : String(count);
                                    notificationBadge.classList.remove('hidden');
                                };

                                const loadUnreadCount = async () => {
                                    try {
                                        const response = await fetch('/Notification/UnreadCount', { credentials: 'same-origin' });
                                        const result = await response.json();
                                        updateBadge(result?.data?.unreadCount ?? 0);
                                    } catch {
                                        updateBadge(0);
                                    }
                                };

                                const loadNotifications = async () => {
                                    try {
                                        const response = await fetch('/Notification/My?page=1&pageSize=6', { credentials: 'same-origin' });
                                        const result = await response.json();
                                        const items = result?.data ?? [];
                                        const unreadCount = result?.unreadCount ?? 0;
                                        updateBadge(unreadCount);

                                        if (!items.length) {
                                            renderEmpty(UI_TEXT.empty);
                                            return;
                                         }

                                         notificationList.innerHTML = items.map(item => `
                                             <button type="button"
                                                     class="nm-notification-item ${item.isRead ? '' : 'unread'}"
                                                      data-id="${escapeHtml(item.id)}"
                                                      data-url="${escapeHtml(item.actionUrl || '')}">
                                                  <div class="nm-notification-item-title-row">
                                                      <div class="nm-notification-item-title">${escapeHtml(item.title || UI_TEXT.fallbackTitle)}</div>
                                                      ${item.isRead ? '' : '<span class="nm-notification-unread-dot" aria-hidden="true"></span>'}
                                                  </div>
                                                  ${buildNotificationMeta(item)}
                                                  <div class="nm-notification-item-body">${escapeHtml(item.content || UI_TEXT.fallbackBody)}</div>
                                                  <div class="nm-notification-item-time">${escapeHtml(formatTime(item.createdAt))}</div>
                                              </button>
                                          `).join('');
                                      } catch {
                                        renderEmpty(UI_TEXT.loadError);
                                    }
                                };

                                notificationToggle.addEventListener('click', async () => {
                                    notificationMenu.classList.toggle('hidden');
                                    if (!notificationMenu.classList.contains('hidden')) {
                                        await loadNotifications();
                                    }
                                });

                                notificationList.addEventListener('click', async (event) => {
                                    const item = event.target.closest('.nm-notification-item[data-id]');
                                    if (!item) return;

                                    try {
                                        await fetch(`/Notification/MarkRead/${item.dataset.id}`, {
                                            method: 'POST',
                                            credentials: 'same-origin'
                                        });
                                    } catch {
                                    }

                                    item.classList.remove('unread');
                                    await loadUnreadCount();

                                    window.location.href = `/Notification/Center?notificationId=${encodeURIComponent(item.dataset.id)}`;
                                });

                                markAllButton.addEventListener('click', async () => {
                                    try {
                                        await fetch('/Notification/MarkAllRead', {
                                            method: 'POST',
                                            credentials: 'same-origin'
                                        });
                                    } catch {
                                    }

                                    await loadNotifications();
                                });

                                window.addEventListener('nm:notifications-refresh', async () => {
                                    await loadUnreadCount();
                                    if (!notificationMenu.classList.contains('hidden')) {
                                        await loadNotifications();
                                    }
                                });

                                document.addEventListener('click', function(e) {
                                    if (!notificationDropdown.contains(e.target)) {
                                        notificationMenu.classList.add('hidden');
                                    }
                                });

                                const connectNotificationRealtime = async () => {
                                    if (!window.signalR) return;

                                    const connection = new signalR.HubConnectionBuilder()
                                        .withUrl('/hubs/notifications')
                                        .withAutomaticReconnect()
                                        .build();

                                    connection.on('notification:new', async (payload) => {
                                        window.__nmLastRealtimeNotificationType = String(payload?.type || '').trim().toLowerCase();
                                        window.__nmLastRealtimeNotificationMessage = String(payload?.message || payload?.title || '').trim();
                                        window.__nmLastRealtimeNotificationAt = Date.now();

                                        const toastConfig = shouldSuppressRealtimeToast(payload)
                                            ? null
                                            : getRealtimeToastConfig(payload);
                                        if (toastConfig && typeof window.showToast === 'function') {
                                            window.showToast(toastConfig.message, { type: toastConfig.type });
                                        }
                                        window.dispatchEvent(new CustomEvent('nm:notifications-refresh'));
                                    });

                                    connection.onreconnected(() => {
                                        window.dispatchEvent(new CustomEvent('nm:notifications-refresh'));
                                    });

                                    try {
                                        await connection.start();
                                    } catch {
                                    }
                                };

                                loadUnreadCount();
                                connectNotificationRealtime();
                            })();

                            (() => {
                                const chatBadge = document.getElementById('chatUnreadBadge');
                                if (!chatBadge) return;

                                const updateChatBadge = (count) => {
                                    if (!count || count <= 0) {
                                        chatBadge.textContent = '';
                                        chatBadge.classList.add('hidden');
                                        return;
                                    }
                                    chatBadge.textContent = count > 99 ? '99+' : String(count);
                                    chatBadge.classList.remove('hidden');
                                };

                                const loadChatUnread = async () => {
                                    try {
                                        const response = await fetch(`/Communication/UnreadCount?_=${Date.now()}`, {
                                            credentials: 'same-origin',
                                            cache: 'no-store'
                                        });
                                        const result = await response.json();
                                        updateChatBadge(result?.data?.unreadCount ?? 0);
                                    } catch {
                                        updateChatBadge(0);
                                    }
                                };

                                let chatUnreadTimer = null;
                                const CHAT_UNREAD_POLL_VISIBLE_MS = 2000;
                                const CHAT_UNREAD_POLL_HIDDEN_MS = 10000;

                                const restartChatUnreadPolling = () => {
                                    if (chatUnreadTimer) {
                                        window.clearInterval(chatUnreadTimer);
                                    }
                                    const interval = document.hidden
                                        ? CHAT_UNREAD_POLL_HIDDEN_MS
                                        : CHAT_UNREAD_POLL_VISIBLE_MS;
                                    chatUnreadTimer = window.setInterval(loadChatUnread, interval);
                                };

                                window.addEventListener('nm:chat-unread-refresh', () => { loadChatUnread(); });
                                window.addEventListener('nm:notifications-refresh', () => { loadChatUnread(); });
                                window.addEventListener('focus', () => { loadChatUnread(); });
                                document.addEventListener('visibilitychange', () => {
                                    if (!document.hidden) loadChatUnread();
                                    restartChatUnreadPolling();
                                });
                                loadChatUnread();
                                restartChatUnreadPolling();
                            })();

                            (() => {
                                const toggle = document.getElementById('userMenuToggle');
                                const menu = document.getElementById('dropdownMenu');
                                const backdrop = document.getElementById('userMenuBackdrop');
                                const closeBtn = document.getElementById('userMenuClose');

                                if (!toggle || !menu || !backdrop || !closeBtn) return;

                                if (backdrop.parentElement !== document.body) {
                                    document.body.appendChild(backdrop);
                                }

                                if (menu.parentElement !== document.body) {
                                    document.body.appendChild(menu);
                                }

                                let closingTimer = null;

                                const openMenu = () => {
                                    if (closingTimer) {
                                        window.clearTimeout(closingTimer);
                                        closingTimer = null;
                                    }

                                    menu.classList.remove('hidden');
                                    backdrop.classList.remove('hidden');

                                    requestAnimationFrame(() => {
                                        menu.classList.add('is-open');
                                        backdrop.classList.add('is-open');
                                    });

                                    toggle.setAttribute('aria-expanded', 'true');
                                    document.body.classList.add('nm-user-sheet-open');
                                };

                                const closeMenu = () => {
                                    menu.classList.remove('is-open');
                                    backdrop.classList.remove('is-open');
                                    toggle.setAttribute('aria-expanded', 'false');
                                    document.body.classList.remove('nm-user-sheet-open');

                                    closingTimer = window.setTimeout(() => {
                                        menu.classList.add('hidden');
                                        backdrop.classList.add('hidden');
                                    }, 320);
                                };

                                toggle.addEventListener('click', () => {
                                    if (menu.classList.contains('hidden')) {
                                        openMenu();
                                    } else {
                                        closeMenu();
                                    }
                                });

                                closeBtn.addEventListener('click', closeMenu);
                                backdrop.addEventListener('click', closeMenu);

                                document.addEventListener('keydown', (event) => {
                                    if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
                                        closeMenu();
                                    }
                                });
                            })();
                        </script>
                    }
                    else
                    {
                        <a class="hidden sm:inline-flex nm-auth-link"
                           href="/Auth/Login">Đăng nhập</a>
                        <a class="nm-primary-btn"
                           href="/Auth/Register">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </nav>

