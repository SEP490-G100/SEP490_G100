@using System.Net.Http.Headers
@using System.Text.Json
@using WebSite.Models
@using WebSite.Models.Profile
@inject IHttpClientFactory HttpFactory
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var verifyPromptCurrentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isVerifyPromptHomePage =
        string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(verifyPromptCurrentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var verifyPromptSkipControllers = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "Auth", "Onboarding", "ParentOnboarding", "NannyBasicInfo", "VerificationRequest"
    };

    var canCheckNannyVerifyPrompt =
        isVerifyPromptHomePage &&
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Nanny") &&
        string.Equals(Context.Session.GetString("ShowNannyVerifyPrompt"), "1", StringComparison.Ordinal) &&
        !verifyPromptSkipControllers.Contains(currentController);

    PersonalProfileViewModel? nannyVerifyPromptProfile = null;
    var showNannyVerifyPrompt = false;
    var nannyVerifyPromptUrl = "/VerificationRequest/NannySubmitVerificationRequest";
    var nannyVerifyPromptButton = "Xác minh hồ sơ ngay";
    var nannyVerifyPromptStatusClass = "is-not-submitted";
    var nannyVerifyPromptStatusText = "Chưa hoàn tất xác minh";
    var currentUserFirstName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? string.Empty;
    var currentUserLastName = User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value ?? string.Empty;
    var currentUserInitial = !string.IsNullOrWhiteSpace(currentUserFirstName)
        ? currentUserFirstName[..1].ToUpperInvariant()
        : "U";
    var currentUserAvatar = User.FindFirst("AvatarUrl")?.Value;

    if (canCheckNannyVerifyPrompt)
    {
        try
        {
            var token = Context.Session.GetString("AccessToken");
            if (!string.IsNullOrWhiteSpace(token))
            {
                var http = HttpFactory.CreateClient("BackendApi");
                http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

                var response = await http.GetAsync("/api/profile");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    var result = JsonSerializer.Deserialize<ApiResult<PersonalProfileViewModel>>(json, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                    if (result?.Success == true && result.Data?.IsNanny == true)
                    {
                        nannyVerifyPromptProfile = result.Data;
                        var verificationCode = result.Data.VerificationStatusCode ?? 0;

                        if (verificationCode == 2)
                        {
                            Context.Session.Remove("ShowNannyVerifyPrompt");
                        }
                        else
                        {
                            showNannyVerifyPrompt = true;
                            Context.Session.Remove("ShowNannyVerifyPrompt");

                            if (verificationCode == 1)
                            {
                                nannyVerifyPromptUrl = "/VerificationRequest/NannyGetVerificationRequestList";
                                nannyVerifyPromptButton = "Xem yêu cầu xác minh";
                                nannyVerifyPromptStatusClass = "is-pending";
                                nannyVerifyPromptStatusText = "Đang chờ duyệt";
                            }
                            else if (verificationCode == 3)
                            {
                                nannyVerifyPromptUrl = "/VerificationRequest/NannyGetVerificationRequestList";
                                nannyVerifyPromptButton = "Xem và gửi lại hồ sơ";
                                nannyVerifyPromptStatusClass = "is-rejected";
                                nannyVerifyPromptStatusText = "Đã bị từ chối";
                            }
                        }
                    }
                }
            }
        }
        catch
        {
        }
    }
}
