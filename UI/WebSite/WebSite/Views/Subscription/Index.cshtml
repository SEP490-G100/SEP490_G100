@model WebSite.Models.Subscription.SubscriptionPageViewModel
@{
    ViewData["Title"] = "Gói đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/subscription.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
}

<div class="sub-shell">
    <section class="sub-hero">
        <div class="sub-hero-copy">
            <div class="sub-role">GÓI DÀNH CHO @Model.RoleLabel.ToUpperInvariant()</div>
            <h1>@Model.Headline</h1>
            <p>@Model.Summary</p>
            <div class="sub-chip-row">
                @{
                    var forSaleCount = Model.Plans.Count(p => !p.IsTrial);
                }
                @if (Model.Plans.Count > 0)
                {
                    <span class="sub-chip">@forSaleCount gói trả phí đang mở bán</span>
                    @if (Model.Plans.Any(p => p.IsTrial))
                    {
                        <span class="sub-chip">Gói dùng thử chỉ hiện nếu bạn đang dùng thử (không mua tại đây)</span>
                    }
                    <span class="sub-chip">Danh sách gói được đồng bộ từ hệ thống quản trị</span>
                    <span class="sub-chip">Quyền lợi mỗi gói sẽ thay đổi theo cấu hình quản trị viên cập nhật</span>
                }
            </div>
        </div>

        <div class="sub-status-card">
            <span class="sub-status-label">Trạng thái hiện tại</span>
            @if (Model.HasActiveSubscription)
            {
                @if (Model.IsTrialActive)
                {
                    <strong>@Model.CurrentSubscription!.Plan.Name <span class="sub-trial-badge">Dùng thử</span></strong>
                    <p>Còn @Model.CurrentSubscription.RemainingDays ngày — hết hạn @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("dd/MM/yyyy"). Sau khi hết hạn bạn sẽ về gói miễn phí.</p>
                }
                else
                {
                    <strong>@Model.CurrentSubscription!.Plan.Name</strong>
                    <p>Còn @Model.CurrentSubscription.RemainingDays ngày và hết hạn vào @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</p>
                }
            }
            else
            {
                <strong>Miễn phí</strong>
                <p>Bạn đang ở gói mặc định của @Model.RoleLabel.ToLowerInvariant().</p>
            }

            <div class="sub-status-metrics">
                @if (Model.IsParent)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Miễn phí</span>
                        <b>@Model.FreeBenefits.MonthlyJobPostLimit bài đang hoạt động</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Thời hạn</span>
                        <b>@Model.FreeBenefits.ListingDurationDays ngày</b>
                    </div>
                }
                else if (Model.IsNanny)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Miễn phí</span>
                        <b>@Model.FreeBenefits.MonthlyApplicationLimit ứng tuyển/tháng</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Hồ sơ</span>
                        <b>Hiển thị cơ bản</b>
                    </div>
                }
            </div>
        </div>
    </section>

    @if (TempData["SubscriptionSuccess"] is string successMessage)
    {
        <div class="sub-alert sub-alert-success">@successMessage</div>
    }

    @if (TempData["SubscriptionError"] is string errorMessage)
    {
        <div class="sub-alert sub-alert-error">@errorMessage</div>
    }

    @if (!Model.SupportsSubscription)
    {
        <section class="sub-empty">
            <h2>Không xác định được vai trò gói đăng ký</h2>
            <p>Trang này hiện chỉ hỗ trợ tài khoản Phụ huynh và Bảo mẫu. Vui lòng đăng nhập đúng vai trò để mua gói.</p>
        </section>
    }
    else
    {
        <section class="sub-current">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Các gói thành viên</div>
                    <h2>So sánh quyền lợi theo gói</h2>
                    <p>Miễn phí là mốc cơ bản. Danh sách các gói trả phí bên dưới được hiển thị theo dữ liệu quản trị viên hiện có trong hệ thống.</p>
                </div>
                @if (Model.HasActiveSubscription)
                {
                    <form asp-action="CancelCurrent" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sub-secondary-btn">
                            @(Model.IsTrialActive ? "Hủy dùng thử" : "Hủy gói hiện tại")
                        </button>
                    </form>
                }
            </div>

            
            <div class="sub-grid">
                <article class="plan-card free-card">
                    <div class="plan-top">
                        <span class="plan-tag">Miễn phí</span>
                        <h3>Mặc định</h3>
                        <p>Bắt đầu nhanh, đủ để trải nghiệm và làm quen hệ thống.</p>
                    </div>
                    <div class="plan-price">0 đ</div>
                    <ul class="plan-list">
                        @foreach (var feature in Model.FreeFeatures)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                </article>

                @foreach (var plan in Model.Plans)
                {
                    var isCurrent = Model.CurrentSubscription?.Plan?.Code == plan.Code && Model.HasActiveSubscription;
                    var isHighestPricePlan = Model.Plans.Count > 0 && plan.Id == Model.Plans.OrderByDescending(p => p.Price).ThenByDescending(p => p.DurationDays).First().Id;
                    var isPlusOrProPlan =
                        (!string.IsNullOrWhiteSpace(plan.Code) &&
                            (plan.Code.Contains("PLUS", StringComparison.OrdinalIgnoreCase) ||
                             plan.Code.Contains("PRO", StringComparison.OrdinalIgnoreCase))) ||
                        (!string.IsNullOrWhiteSpace(plan.Name) &&
                            (plan.Name.Contains("Plus", StringComparison.OrdinalIgnoreCase) ||
                             plan.Name.Contains("Pro", StringComparison.OrdinalIgnoreCase)));

                    var lockPlanFeatures = isPlusOrProPlan && !isCurrent;

                    var planFeatureItems = new List<string>();
                    if (Model.IsParent)
                    {
                        planFeatureItems.Add(
                            plan.Benefits.MonthlyJobPostLimit > 0
                                ? $"Đăng tối đa {plan.Benefits.MonthlyJobPostLimit} bài mỗi tháng"
                                : "Số lượng bài đăng được mở rộng theo cấu hình gói");
                        planFeatureItems.Add(
                            plan.Benefits.ListingDurationDays > 0
                                ? $"Bài đăng hiển thị {plan.Benefits.ListingDurationDays} ngày"
                                : $"Gói có thời hạn sử dụng {plan.DurationDays} ngày");
                        planFeatureItems.Add(plan.Benefits.FeaturedBadge ? "Có huy hiệu nổi bật cho bài đăng" : "Không có huy hiệu nổi bật");
                        planFeatureItems.Add(plan.Benefits.SearchPriority ? "Được ưu tiên hiển thị trong tìm kiếm" : "Không ưu tiên hiển thị");
                    }
                    else if (Model.IsNanny)
                    {
                        planFeatureItems.Add(
                            plan.Benefits.MonthlyApplicationLimit > 0
                                ? $"Ứng tuyển tối đa {plan.Benefits.MonthlyApplicationLimit} công việc mỗi tháng"
                                : "Quyền ứng tuyển được mở rộng theo cấu hình gói");
                        planFeatureItems.Add(plan.Benefits.FeaturedBadge ? "Hồ sơ có huy hiệu nổi bật" : "Hồ sơ hiển thị thường");
                        planFeatureItems.Add(plan.Benefits.SearchPriority ? "Hồ sơ được ưu tiên hiển thị cao hơn" : "Hồ sơ có thêm quyền lợi so với gói miễn phí");
                    }

                    planFeatureItems.AddRange(
                        plan.Features.Where(feature => !string.IsNullOrWhiteSpace(feature)).Select(feature => feature.Trim()));

                    <article class="plan-card paid-card @(isHighestPricePlan ? "accent-card" : "") @(isCurrent ? "current-card" : "")">
                        <div class="plan-top">
                            <span class="plan-tag">@plan.Name@if (plan.IsTrial) { <text> · </text><span class="sub-trial-badge">Dùng thử</span> }</span>
                            <h3>@plan.Name</h3>
                            <p>@(plan.Description ?? "Gói phù hợp để mở rộng quyền lợi sử dụng.")</p>
                        </div>

                        <div class="plan-price">@plan.Price.ToString("N0")đ<span>/@plan.DurationDays ngày</span></div>

                        <div class="plan-highlight">
                            @if (Model.IsParent)
                            {
                                <span>@plan.Benefits.MonthlyJobPostLimit bài/tháng</span>
                                <span>@plan.Benefits.ListingDurationDays ngày hiển thị</span>
                            }
                            else if (Model.IsNanny)
                            {
                                <span>@plan.Benefits.MonthlyApplicationLimit ứng tuyển/tháng</span>
                                <span>@(plan.Benefits.SearchPriority ? "Ưu tiên cao hơn" : "Nổi bật hơn gói miễn phí")</span>
                            }
                        </div>

                        <div class="plan-benefit-title">Quyền lợi nhận được</div>
                        @if (lockPlanFeatures && planFeatureItems.Count > 1)
                        {
                            <ul class="plan-list">
                                <li>@planFeatureItems[0]</li>
                            </ul>

                            <div class="plan-list-lock">
                                <ul class="plan-list plan-list--blurred" aria-hidden="true">
                                    @foreach (var feature in planFeatureItems.Skip(1))
                                    {
                                        <li>@feature</li>
                                    }
                                </ul>
                                <div class="plan-list-lock-overlay">
                                    <span class="plan-list-lock-pill">Nâng cấp gói để mở khóa</span>
                                    <p>Mua gói trả phí để xem toàn bộ quyền lợi chi tiết.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="plan-list">
                                @foreach (var feature in planFeatureItems)
                                {
                                    <li>@feature</li>
                                }
                            </ul>
                        }

                        @if (lockPlanFeatures && !Model.HasActiveSubscription && !plan.IsTrial)
                        {
                            <div class="plan-lock-note">Đang hiển thị bản xem trước quyền lợi của gói @plan.Name.</div>
                        }

                        @if (isCurrent)
                        {
                            <div class="plan-current-pill">Đang sử dụng</div>
                        }
                        else if (plan.IsTrial)
                        {
                            <button type="button" class="sub-disabled-btn" disabled title="Gói dùng thử không bán tại đây">
                                Chỉ cấp khi kích hoạt ưu đãi
                            </button>
                        }
                        else if (Model.HasActiveSubscription)
                        {
                            <button type="button" class="sub-disabled-btn" disabled>
                                @(Model.IsTrialActive ? "Đang dùng thử — hủy để mua gói" : "Đang có gói hoạt động")
                            </button>
                        }
                        else
                        {
                            <form asp-action="Purchase" method="post" class="js-purchase-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="subscriptionPlanId" value="@plan.Id" />
                                <button type="submit" class="sub-primary-btn">Mua gói @plan.Name</button>
                            </form>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="sub-current sub-history">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Lịch sử giao dịch</div>
                    <h2>Theo dõi thanh toán gói đăng ký</h2>
                    <p>Hệ thống lưu lại giao dịch thành công, chờ xử lý hoặc thất bại để bạn đối soát nhanh.</p>
                </div>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                <div class="sub-empty-inline">Chưa có giao dịch đăng ký nào.</div>
            }
            else
            {
                <div class="sub-trans-list">
                    @foreach (var transaction in Model.Transactions)
                    {
                        var statusClass = transaction.Status switch
                        {
                            1 => "pending",
                            5 => "pending",
                            2 => "success",
                            3 => "failed",
                            _ => "unknown"
                        };

                        <article class="sub-trans-item sub-trans-item--@statusClass">
                            <div class="sub-trans-main">
                                <p class="sub-trans-kicker">Giao dịch</p>
                                <h3>@transaction.Id</h3>
                                <p class="sub-trans-desc">@transaction.Description</p>
                                <div class="sub-trans-facts">
                                    <span class="sub-trans-fact">
                                        <small>Tạo lúc</small>
                                        @transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    @if (transaction.CompletedAt.HasValue)
                                    {
                                        <span class="sub-trans-fact">
                                            <small>Hoàn tất</small>
                                            @transaction.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(transaction.PaymentGatewayTransactionId))
                                    {
                                        <span class="sub-trans-fact sub-trans-fact-code">
                                            <small>Mã cổng thanh toán</small>
                                            @transaction.PaymentGatewayTransactionId
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="sub-trans-meta">
                                <span class="sub-trans-badge @statusClass">@transaction.StatusLabel</span>
                                <b class="sub-trans-amount">@transaction.Amount.ToString("N0") VND</b>
                                <span class="sub-trans-role-pill">@Model.RoleLabel</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

<div id="purchaseQrModal" class="sub-pay-modal" aria-hidden="true">
    <div class="sub-pay-backdrop" data-close-pay-modal="true"></div>
    <section class="sub-pay-panel" role="dialog" aria-modal="true" aria-labelledby="subPayTitle">
        <button type="button" class="sub-pay-close" id="subPayCloseBtn" aria-label="Đóng">&times;</button>
        <p class="sub-pay-kicker">Thanh toán gói đăng ký</p>
        <h3 id="subPayTitle" class="sub-pay-title">Thanh toán qua PayOS</h3>
        <p class="sub-pay-desc">Quét QR hoặc mở trang thanh toán PayOS. Khi thanh toán thành công, hệ thống sẽ tự động kích hoạt gói.</p>

        <div class="sub-pay-main">
            <div class="sub-pay-qr-wrap">
                <div id="subPayQrCanvas" class="sub-pay-qr"></div>
                <img id="subPayQrImage" class="sub-pay-qr" alt="Mã QR thanh toán" style="display:none;" />
            </div>

            <div class="sub-pay-info">
                <div class="sub-pay-info-row"><span>Gói</span><b id="subPayPlan">-</b></div>
                <div class="sub-pay-info-row"><span>Số tiền</span><b id="subPayAmount">-</b></div>
                <div class="sub-pay-info-row"><span>Ngân hàng</span><b id="subPayBank">-</b></div>
                <div class="sub-pay-info-row"><span>Số tài khoản</span><b id="subPayAccountNumber">-</b></div>
                <div class="sub-pay-info-row"><span>Chủ tài khoản</span><b id="subPayAccountName">-</b></div>
                <div class="sub-pay-info-row"><span>Mã đơn</span><b id="subPayOrderCode">-</b></div>
                <div class="sub-pay-info-row"><span>Nội dung CK</span><b id="subPayContent">-</b></div>
                <div class="sub-pay-info-row"><span>Hiệu lực đến</span><b id="subPayExpiresAt">-</b></div>
                <div class="sub-pay-info-row"><span>Trạng thái</span><b id="subPayStatus">Chờ thanh toán</b></div>
            </div>
        </div>

        <div class="sub-pay-actions">
            <a id="subPayCheckoutLink" href="#" target="_blank" rel="noopener" class="sub-secondary-btn">Mở trang thanh toán PayOS</a>
            <a id="subPayResultLink" href="#" class="sub-primary-btn">Xem kết quả</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const forms = Array.from(document.querySelectorAll('.js-purchase-form'));
            if (!forms.length) return;

            const antiForgeryToken = document.querySelector('.js-purchase-form input[name="__RequestVerificationToken"]')?.value;
            const modal = document.getElementById('purchaseQrModal');
            const closeBtn = document.getElementById('subPayCloseBtn');
            const backdrop = modal?.querySelector('[data-close-pay-modal="true"]');
            const qrCanvas = document.getElementById('subPayQrCanvas');
            const qrImage = document.getElementById('subPayQrImage');
            const planText = document.getElementById('subPayPlan');
            const amountText = document.getElementById('subPayAmount');
            const bankText = document.getElementById('subPayBank');
            const accountNumberText = document.getElementById('subPayAccountNumber');
            const accountNameText = document.getElementById('subPayAccountName');
            const orderCodeText = document.getElementById('subPayOrderCode');
            const contentText = document.getElementById('subPayContent');
            const expiresAtText = document.getElementById('subPayExpiresAt');
            const statusText = document.getElementById('subPayStatus');
            const checkoutLink = document.getElementById('subPayCheckoutLink');
            const resultLink = document.getElementById('subPayResultLink');

            let currentTransactionId = null;
            let pollingTimer = null;
            let currentQrCode = null;

            const notify = (message, type = 'error') => {
                if (typeof window.showToast === 'function') {
                    window.showToast(message, { type });
                }
            };

            const clearPolling = () => {
                if (pollingTimer) {
                    window.clearTimeout(pollingTimer);
                    pollingTimer = null;
                }
            };

            const closeModal = () => {
                clearPolling();
                currentTransactionId = null;
                modal?.setAttribute('aria-hidden', 'true');
            };

            const renderQr = (payload, imageUrl) => {
                if (qrCanvas) {
                    qrCanvas.innerHTML = '';
                }

                if (payload && typeof window.QRCode === 'function' && qrCanvas) {
                    qrImage.style.display = 'none';
                    qrCanvas.style.display = 'block';
                    currentQrCode = new window.QRCode(qrCanvas, {
                        text: payload,
                        width: 320,
                        height: 320,
                        correctLevel: window.QRCode.CorrectLevel.M
                    });
                    return;
                }

                currentQrCode = null;
                if (qrImage) {
                    qrImage.src = imageUrl || '';
                    qrImage.style.display = 'block';
                }
                if (qrCanvas) {
                    qrCanvas.style.display = 'none';
                }
            };

            const openModal = () => {
                modal?.setAttribute('aria-hidden', 'false');
            };

            const setStatus = (text) => {
                if (statusText) statusText.textContent = text;
            };

            const formatMoney = (value) => `${Number(value || 0).toLocaleString('vi-VN')} VND`;

            const formatDateTime = (value) => {
                if (!value) return '-';
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return '-';
                return date.toLocaleString('vi-VN');
            };

            const applySession = (data) => {
                currentTransactionId = data.transactionId;
                renderQr(data.qrPayload, data.qrCodeUrl || data.checkoutUrl || '');
                if (planText) planText.textContent = data.planName || '-';
                if (amountText) amountText.textContent = formatMoney(data.amount);
                if (bankText) bankText.textContent = data.bankId || '-';
                if (accountNumberText) accountNumberText.textContent = data.accountNumber || '-';
                if (accountNameText) accountNameText.textContent = data.accountName || '-';
                if (orderCodeText) orderCodeText.textContent = data.orderCode || '-';
                if (contentText) contentText.textContent = data.paymentContent || '-';
                if (expiresAtText) expiresAtText.textContent = formatDateTime(data.expiresAt);
                if (checkoutLink) checkoutLink.href = data.checkoutUrl || data.qrCodeUrl || '#';
                if (resultLink) resultLink.href = `/Subscription/PaymentResult?transactionId=${data.transactionId}`;
                setStatus('Chờ thanh toán');
                openModal();
            };

            const pollPaymentStatus = async (attempt = 0) => {
                if (!currentTransactionId) return;

                try {
                    const response = await fetch(`/Subscription/PaymentStatus?transactionId=${currentTransactionId}`, {
                        credentials: 'same-origin'
                    });

                    const result = await response.json();
                    const data = result?.data;
                    if (data?.transactionStatusLabel) {
                        setStatus(data.transactionStatusLabel);
                    }

                    if (data?.subscriptionActivated) {
                        notify('Gói đăng ký đã được kích hoạt.', 'success');
                        window.location.href = `/Subscription/PaymentResult?transactionId=${currentTransactionId}`;
                        return;
                    }

                    if (data?.transactionStatus === 3) {
                        notify('Giao dịch đã thất bại hoặc đối soát không khớp.', 'error');
                        return;
                    }
                } catch {
                    if (attempt >= 19) {
                        notify('Không thể cập nhật trạng thái thanh toán lúc này.', 'error');
                        return;
                    }
                }

                if (attempt >= 19) return;
                pollingTimer = window.setTimeout(() => pollPaymentStatus(attempt + 1), 3000);
            };

            closeBtn?.addEventListener('click', closeModal);
            backdrop?.addEventListener('click', closeModal);
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal?.getAttribute('aria-hidden') === 'false') {
                    closeModal();
                }
            });

            forms.forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();

                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (!submitBtn) return;

                    submitBtn.disabled = true;
                    const oldLabel = submitBtn.textContent;
                    submitBtn.textContent = 'Đang tạo phiên thanh toán PayOS...';

                    const formData = new URLSearchParams(new FormData(form));
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: formData.toString(),
                            credentials: 'same-origin'
                        });

                        const result = await response.json();
                        if (!result?.success || !result?.data) {
                            notify(result?.message || 'Không tạo được giao dịch thanh toán.', 'error');
                            return;
                        }

                        const data = result.data;

                        if (!data.qrCodeUrl && !data.checkoutUrl) {
                            notify('Không tạo được mã QR thanh toán.', 'error');
                            return;
                        }

                        clearPolling();
                        applySession(data);
                        pollingTimer = window.setTimeout(() => pollPaymentStatus(0), 3000);
                    } catch {
                        notify('Không tạo được giao dịch thanh toán. Vui lòng thử lại.', 'error');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.textContent = oldLabel;
                    }
                });
            });
        })();
    </script>
}
