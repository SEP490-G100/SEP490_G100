@model WebSite.Models.Subscription.SubscriptionPageViewModel
@{
    ViewData["Title"] = "Subscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/subscription.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
}

<div class="sub-shell">
    <section class="sub-hero">
        <div class="sub-hero-copy">
            <div class="sub-role">GOI DANH CHO @Model.RoleLabel.ToUpperInvariant()</div>
            <h1>@Model.Headline</h1>
            <p>@Model.Summary</p>
            <div class="sub-chip-row">
                @if (Model.Plans.Count > 0)
                {
                    <span class="sub-chip">Dang mo ban @Model.Plans.Count goi subscription</span>
                    <span class="sub-chip">Danh sach goi duoc dong bo tu he thong quan tri</span>
                    <span class="sub-chip">Quyen loi moi goi se thay doi theo du lieu admin cap nhat</span>
                }
            </div>
        </div>

        <div class="sub-status-card">
            <span class="sub-status-label">Trang thai hien tai</span>
            @if (Model.HasActiveSubscription)
            {
                <strong>@Model.CurrentSubscription!.Plan.Name</strong>
                <p>Con @Model.CurrentSubscription.RemainingDays ngay va het han vao @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</p>
            }
            else
            {
                <strong>Free</strong>
                <p>Ban dang o goi mac dinh cua @Model.RoleLabel.ToLowerInvariant().</p>
            }

            <div class="sub-status-metrics">
                @if (Model.IsParent)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Free</span>
                        <b>@Model.FreeBenefits.MonthlyJobPostLimit bai/thang</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Thoi han</span>
                        <b>@Model.FreeBenefits.ListingDurationDays ngay</b>
                    </div>
                }
                else if (Model.IsNanny)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Free</span>
                        <b>@Model.FreeBenefits.MonthlyApplicationLimit ung tuyen/thang</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Profile</span>
                        <b>Hien thi co ban</b>
                    </div>
                }
            </div>
        </div>
    </section>

    @if (TempData["SubscriptionSuccess"] is string successMessage)
    {
        <div class="sub-alert sub-alert-success">@successMessage</div>
    }

    @if (TempData["SubscriptionError"] is string errorMessage)
    {
        <div class="sub-alert sub-alert-error">@errorMessage</div>
    }

    @if (!Model.SupportsSubscription)
    {
        <section class="sub-empty">
            <h2>Khong xac dinh duoc vai tro subscription</h2>
            <p>Trang nay hien chi ho tro tai khoan Parent va Nanny. Vui long dang nhap dung vai tro de mua goi.</p>
        </section>
    }
    else
    {
        <section class="sub-current">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Cac goi thanh vien</div>
                    <h2>So sanh quyen loi theo goi</h2>
                    <p>Free la moc co ban. Danh sach cac goi tra phi ben duoi duoc render tu du lieu admin hien co trong he thong.</p>
                </div>
                @if (Model.HasActiveSubscription)
                {
                    <form asp-action="CancelCurrent" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sub-secondary-btn">Huy goi hien tai</button>
                    </form>
                }
            </div>

            @* <div class="sub-benefit-compare">
                <article class="sub-benefit-item">
                    <span class="sub-benefit-plan">Free</span>
                    @if (Model.IsParent)
                    {
                        <h4>@Model.FreeBenefits.MonthlyJobPostLimit bai dang</h4>
                        <p>Goi mac dinh de bat dau nhanh cho phu huynh.</p>
                    }
                    else if (Model.IsNanny)
                    {
                        <h4>@Model.FreeBenefits.MonthlyApplicationLimit luot ung tuyen</h4>
                        <p>Goi mac dinh de bat dau nhanh cho bao mau.</p>
                    }
                </article>

                @foreach (var plan in Model.Plans)
                {
                    var isCurrentBenefitPlan = Model.CurrentSubscription?.Plan?.Code == plan.Code && Model.HasActiveSubscription;
                    var isHighestPricePlan = Model.Plans.Count > 0 && plan.Id == Model.Plans.OrderByDescending(p => p.Price).ThenByDescending(p => p.DurationDays).First().Id;
                    <article class="sub-benefit-item @(isCurrentBenefitPlan ? "sub-benefit-item--current" : (isHighestPricePlan ? "sub-benefit-item--accent" : "sub-benefit-item--paid"))">
                        <span class="sub-benefit-plan">@plan.Name</span>
                        @if (Model.IsParent)
                        {
                            <h4>@(plan.Benefits.MonthlyJobPostLimit > 0 ? $"{plan.Benefits.MonthlyJobPostLimit} bai dang" : "Goi tra phi")</h4>
                            <p>
                                @(plan.Benefits.ListingDurationDays > 0 ? $"{plan.Benefits.ListingDurationDays} ngay hien thi" : $"{plan.DurationDays} ngay su dung")
                                - @(plan.Benefits.SearchPriority ? "co uu tien tim kiem" : "khong uu tien tim kiem")
                            </p>
                        }
                        else if (Model.IsNanny)
                        {
                            <h4>@(plan.Benefits.MonthlyApplicationLimit > 0 ? $"{plan.Benefits.MonthlyApplicationLimit} luot ung tuyen" : "Goi tra phi")</h4>
                            <p>@(plan.Benefits.SearchPriority ? "Ho so duoc uu tien hien thi." : "Ho so co them quyen loi so voi goi Free.")</p>
                        }
                    </article>
                }
            </div> *@

            <div class="sub-grid">
                <article class="plan-card free-card">
                    <div class="plan-top">
                        <span class="plan-tag">Free</span>
                        <h3>Mac dinh</h3>
                        <p>Bat dau nhanh, du de trai nghiem va lam quen he thong.</p>
                    </div>
                    <div class="plan-price">0d</div>
                    <ul class="plan-list">
                        @foreach (var feature in Model.FreeFeatures)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                </article>

                @foreach (var plan in Model.Plans)
                {
                    var isCurrent = Model.CurrentSubscription?.Plan?.Code == plan.Code && Model.HasActiveSubscription;
                    var isHighestPricePlan = Model.Plans.Count > 0 && plan.Id == Model.Plans.OrderByDescending(p => p.Price).ThenByDescending(p => p.DurationDays).First().Id;
                    <article class="plan-card paid-card @(isHighestPricePlan ? "accent-card" : "") @(isCurrent ? "current-card" : "")">
                        <div class="plan-top">
                            <span class="plan-tag">@plan.Name</span>
                            <h3>@plan.Name</h3>
                            <p>@(plan.Description ?? "Goi phu hop de mo rong quyen loi su dung.")</p>
                        </div>

                        <div class="plan-price">@plan.Price.ToString("N0")d<span>/@plan.DurationDays ngay</span></div>

                        <div class="plan-highlight">
                            @if (Model.IsParent)
                            {
                                <span>@plan.Benefits.MonthlyJobPostLimit bai/thang</span>
                                <span>@plan.Benefits.ListingDurationDays ngay hien thi</span>
                            }
                            else if (Model.IsNanny)
                            {
                                <span>@plan.Benefits.MonthlyApplicationLimit ung tuyen/thang</span>
                                <span>@(plan.Benefits.SearchPriority ? "Uu tien cao hon" : "Noi bat hon Free")</span>
                            }
                        </div>

                        <div class="plan-benefit-title">Quyen loi nhan duoc</div>
                        <ul class="plan-list">
                            @if (Model.IsParent)
                            {
                                <li>
                                    @(plan.Benefits.MonthlyJobPostLimit > 0
                                        ? $"Dang toi da {plan.Benefits.MonthlyJobPostLimit} bai moi thang"
                                        : "So luong bai dang duoc mo rong theo cau hinh goi")
                                </li>
                                <li>
                                    @(plan.Benefits.ListingDurationDays > 0
                                        ? $"Bai dang hien thi {plan.Benefits.ListingDurationDays} ngay"
                                        : $"Goi co thoi han su dung {plan.DurationDays} ngay")
                                </li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Co badge noi bat cho bai dang" : "Khong co badge noi bat")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Duoc uu tien hien thi trong tim kiem" : "Khong uu tien hien thi")</li>
                            }
                            else if (Model.IsNanny)
                            {
                                <li>
                                    @(plan.Benefits.MonthlyApplicationLimit > 0
                                        ? $"Ung tuyen toi da {plan.Benefits.MonthlyApplicationLimit} cong viec moi thang"
                                        : "Quyen ung tuyen duoc mo rong theo cau hinh goi")
                                </li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Ho so co badge noi bat" : "Ho so hien thi thuong")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Ho so duoc uu tien hien thi cao hon" : "Ho so co them quyen loi so voi goi Free")</li>
                            }

                            @foreach (var feature in plan.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>

                        @if (isCurrent)
                        {
                            <div class="plan-current-pill">Dang su dung</div>
                        }
                        else if (Model.HasActiveSubscription)
                        {
                            <button type="button" class="sub-disabled-btn" disabled>Dang co goi hoat dong</button>
                        }
                        else
                        {
                            <form asp-action="Purchase" method="post" class="js-purchase-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="subscriptionPlanId" value="@plan.Id" />
                                <button type="submit" class="sub-primary-btn">Mua goi @plan.Name</button>
                            </form>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="sub-current sub-history">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Lich su giao dich</div>
                    <h2>Theo doi thanh toan goi subscription</h2>
                    <p>He thong luu lai giao dich thanh cong, cho xu ly hoac that bai de ban doi soat nhanh.</p>
                </div>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                <div class="sub-empty-inline">Chua co giao dich subscription nao.</div>
            }
            else
            {
                <div class="sub-trans-list">
                    @foreach (var transaction in Model.Transactions)
                    {
                        var statusClass = transaction.Status switch
                        {
                            1 => "pending",
                            5 => "pending",
                            2 => "success",
                            3 => "failed",
                            _ => "unknown"
                        };

                        <article class="sub-trans-item sub-trans-item--@statusClass">
                            <div class="sub-trans-main">
                                <p class="sub-trans-kicker">Transaction</p>
                                <h3>@transaction.Id</h3>
                                <p class="sub-trans-desc">@transaction.Description</p>
                                <div class="sub-trans-facts">
                                    <span class="sub-trans-fact">
                                        <small>Tao luc</small>
                                        @transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    @if (transaction.CompletedAt.HasValue)
                                    {
                                        <span class="sub-trans-fact">
                                            <small>Hoan tat</small>
                                            @transaction.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(transaction.PaymentGatewayTransactionId))
                                    {
                                        <span class="sub-trans-fact sub-trans-fact-code">
                                            <small>Gateway</small>
                                            @transaction.PaymentGatewayTransactionId
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="sub-trans-meta">
                                <span class="sub-trans-badge @statusClass">@transaction.StatusLabel</span>
                                <b class="sub-trans-amount">@transaction.Amount.ToString("N0") VND</b>
                                <span class="sub-trans-role-pill">@Model.RoleLabel</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

<div id="purchaseQrModal" class="sub-pay-modal" aria-hidden="true">
    <div class="sub-pay-backdrop" data-close-pay-modal="true"></div>
    <section class="sub-pay-panel" role="dialog" aria-modal="true" aria-labelledby="subPayTitle">
        <button type="button" class="sub-pay-close" id="subPayCloseBtn" aria-label="Dong">&times;</button>
        <p class="sub-pay-kicker">Thanh toan subscription</p>
        <h3 id="subPayTitle" class="sub-pay-title">Thanh toan qua PayOS</h3>
        <p class="sub-pay-desc">Quet QR hoac mo trang thanh toan PayOS. Giao dich hop le se duoc callback ve he thong va tu dong kich hoat goi.</p>

        <div class="sub-pay-main">
            <div class="sub-pay-qr-wrap">
                <div id="subPayQrCanvas" class="sub-pay-qr"></div>
                <img id="subPayQrImage" class="sub-pay-qr" alt="QR payment" style="display:none;" />
            </div>

            <div class="sub-pay-info">
                <div class="sub-pay-info-row"><span>Goi</span><b id="subPayPlan">-</b></div>
                <div class="sub-pay-info-row"><span>So tien</span><b id="subPayAmount">-</b></div>
                <div class="sub-pay-info-row"><span>Ngan hang</span><b id="subPayBank">-</b></div>
                <div class="sub-pay-info-row"><span>So tai khoan</span><b id="subPayAccountNumber">-</b></div>
                <div class="sub-pay-info-row"><span>Chu tai khoan</span><b id="subPayAccountName">-</b></div>
                <div class="sub-pay-info-row"><span>Ma don</span><b id="subPayOrderCode">-</b></div>
                <div class="sub-pay-info-row"><span>Noi dung CK</span><b id="subPayContent">-</b></div>
                <div class="sub-pay-info-row"><span>Hieu luc den</span><b id="subPayExpiresAt">-</b></div>
                <div class="sub-pay-info-row"><span>Trang thai</span><b id="subPayStatus">Cho thanh toan</b></div>
            </div>
        </div>

        <div class="sub-pay-actions">
            <a id="subPayCheckoutLink" href="#" target="_blank" rel="noopener" class="sub-secondary-btn">Mo trang thanh toan PayOS</a>
            <a id="subPayResultLink" href="#" class="sub-primary-btn">Xem ket qua</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const forms = Array.from(document.querySelectorAll('.js-purchase-form'));
            if (!forms.length) return;

            const antiForgeryToken = document.querySelector('.js-purchase-form input[name="__RequestVerificationToken"]')?.value;
            const modal = document.getElementById('purchaseQrModal');
            const closeBtn = document.getElementById('subPayCloseBtn');
            const backdrop = modal?.querySelector('[data-close-pay-modal="true"]');
            const qrCanvas = document.getElementById('subPayQrCanvas');
            const qrImage = document.getElementById('subPayQrImage');
            const planText = document.getElementById('subPayPlan');
            const amountText = document.getElementById('subPayAmount');
            const bankText = document.getElementById('subPayBank');
            const accountNumberText = document.getElementById('subPayAccountNumber');
            const accountNameText = document.getElementById('subPayAccountName');
            const orderCodeText = document.getElementById('subPayOrderCode');
            const contentText = document.getElementById('subPayContent');
            const expiresAtText = document.getElementById('subPayExpiresAt');
            const statusText = document.getElementById('subPayStatus');
            const checkoutLink = document.getElementById('subPayCheckoutLink');
            const resultLink = document.getElementById('subPayResultLink');

            let currentTransactionId = null;
            let pollingTimer = null;
            let currentQrCode = null;

            const notify = (message, type = 'error') => {
                if (typeof window.showToast === 'function') {
                    window.showToast(message, { type });
                }
            };

            const clearPolling = () => {
                if (pollingTimer) {
                    window.clearTimeout(pollingTimer);
                    pollingTimer = null;
                }
            };

            const closeModal = () => {
                clearPolling();
                currentTransactionId = null;
                modal?.setAttribute('aria-hidden', 'true');
            };

            const renderQr = (payload, imageUrl) => {
                if (qrCanvas) {
                    qrCanvas.innerHTML = '';
                }

                if (payload && typeof window.QRCode === 'function' && qrCanvas) {
                    qrImage.style.display = 'none';
                    qrCanvas.style.display = 'block';
                    currentQrCode = new window.QRCode(qrCanvas, {
                        text: payload,
                        width: 320,
                        height: 320,
                        correctLevel: window.QRCode.CorrectLevel.M
                    });
                    return;
                }

                currentQrCode = null;
                if (qrImage) {
                    qrImage.src = imageUrl || '';
                    qrImage.style.display = 'block';
                }
                if (qrCanvas) {
                    qrCanvas.style.display = 'none';
                }
            };

            const openModal = () => {
                modal?.setAttribute('aria-hidden', 'false');
            };

            const setStatus = (text) => {
                if (statusText) statusText.textContent = text;
            };

            const formatMoney = (value) => `${Number(value || 0).toLocaleString('vi-VN')} VND`;

            const formatDateTime = (value) => {
                if (!value) return '-';
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return '-';
                return date.toLocaleString('vi-VN');
            };

            const applySession = (data) => {
                currentTransactionId = data.transactionId;
                renderQr(data.qrPayload, data.qrCodeUrl || data.checkoutUrl || '');
                if (planText) planText.textContent = data.planName || '-';
                if (amountText) amountText.textContent = formatMoney(data.amount);
                if (bankText) bankText.textContent = data.bankId || '-';
                if (accountNumberText) accountNumberText.textContent = data.accountNumber || '-';
                if (accountNameText) accountNameText.textContent = data.accountName || '-';
                if (orderCodeText) orderCodeText.textContent = data.orderCode || '-';
                if (contentText) contentText.textContent = data.paymentContent || '-';
                if (expiresAtText) expiresAtText.textContent = formatDateTime(data.expiresAt);
                if (checkoutLink) checkoutLink.href = data.checkoutUrl || data.qrCodeUrl || '#';
                if (resultLink) resultLink.href = `/Subscription/PaymentResult?transactionId=${data.transactionId}`;
                setStatus('Cho thanh toan');
                openModal();
            };

            const pollPaymentStatus = async (attempt = 0) => {
                if (!currentTransactionId) return;

                try {
                    const response = await fetch(`/Subscription/PaymentStatus?transactionId=${currentTransactionId}`, {
                        credentials: 'same-origin'
                    });

                    const result = await response.json();
                    const data = result?.data;
                    if (data?.transactionStatusLabel) {
                        setStatus(data.transactionStatusLabel);
                    }

                    if (data?.subscriptionActivated) {
                        notify('Subscription da duoc kich hoat.', 'success');
                        window.location.href = `/Subscription/PaymentResult?transactionId=${currentTransactionId}`;
                        return;
                    }

                    if (data?.transactionStatus === 3) {
                        notify('Giao dich da that bai hoac doi soat khong khop.', 'error');
                        return;
                    }
                } catch {
                    if (attempt >= 19) {
                        notify('Khong the cap nhat trang thai thanh toan luc nay.', 'error');
                        return;
                    }
                }

                if (attempt >= 19) return;
                pollingTimer = window.setTimeout(() => pollPaymentStatus(attempt + 1), 3000);
            };

            closeBtn?.addEventListener('click', closeModal);
            backdrop?.addEventListener('click', closeModal);
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal?.getAttribute('aria-hidden') === 'false') {
                    closeModal();
                }
            });

            forms.forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();

                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (!submitBtn) return;

                    submitBtn.disabled = true;
                    const oldLabel = submitBtn.textContent;
                    submitBtn.textContent = 'Dang tao phien PayOS...';

                    const formData = new URLSearchParams(new FormData(form));
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: formData.toString(),
                            credentials: 'same-origin'
                        });

                        const result = await response.json();
                        if (!result?.success || !result?.data) {
                            notify(result?.message || 'Khong tao duoc giao dich thanh toan.', 'error');
                            return;
                        }

                        const data = result.data;
                        if (data.status === 'WAITING_REVIEW') {
                            window.location.href = `/Subscription/PaymentResult?transactionId=${data.transactionId}`;
                            return;
                        }

                        if (!data.qrCodeUrl && !data.checkoutUrl) {
                            notify('Khong tao duoc ma QR thanh toan.', 'error');
                            return;
                        }

                        clearPolling();
                        applySession(data);
                        pollingTimer = window.setTimeout(() => pollPaymentStatus(0), 3000);
                    } catch {
                        notify('Khong tao duoc giao dich thanh toan. Vui long thu lai.', 'error');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.textContent = oldLabel;
                    }
                });
            });
        })();
    </script>
}
