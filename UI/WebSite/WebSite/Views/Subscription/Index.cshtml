                    </article>
                }
            </div>
        </section>

        <section class="sub-current sub-history">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Lá»‹ch sá»­ giao dá»‹ch</div>
                    <h2>Theo dõi thanh toán gói subscription</h2>
                    <p>Há»‡ thá»‘ng lÆ°u láº¡i giao dá»‹ch thÃ nh cÃ´ng, chá» xá»­ lÃ½ hoáº·c tháº¥t báº¡i Ä‘á»ƒ báº¡n Ä‘á»‘i soÃ¡t nhanh.</p>
                </div>
            </div>

            @if (Model.Transactions.Count == 0)
            {
