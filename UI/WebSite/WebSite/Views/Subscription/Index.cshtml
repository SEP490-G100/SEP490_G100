                                </li>
                                <li>@(plan.Benefits.FeaturedBadge ? "CÃ³ badge ná»•i báº­t cho bÃ i Ä‘Äƒng" : "KhÃ´ng cÃ³ badge ná»•i báº­t")</li>
                                <li>@(plan.Benefits.SearchPriority ? "ÄÆ°á»£c Æ°u tiÃªn hiá»ƒn thá»‹ trong tÃ¬m kiáº¿m" : "KhÃ´ng Æ°u tiÃªn hiá»ƒn thá»‹")</li>
                            }
                            else if (Model.IsNanny)
                            {
                                <li>
                                    @(plan.Benefits.MonthlyApplicationLimit > 0
                                        ? $"á»¨ng tuyá»ƒn tá»‘i Ä‘a {plan.Benefits.MonthlyApplicationLimit} cÃ´ng viá»‡c má»—i thÃ¡ng"
                                        : "Quyá»n á»©ng tuyá»ƒn Ä‘Æ°á»£c má»Ÿ rá»™ng theo cáº¥u hÃ¬nh gÃ³i")
                                </li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Há»“ sÆ¡ cÃ³ badge ná»•i báº­t" : "Há»“ sÆ¡ hiá»ƒn thá»‹ thÆ°á»ng")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Há»“ sÆ¡ Ä‘Æ°á»£c Æ°u tiÃªn hiá»ƒn thá»‹ cao hÆ¡n" : "Há»“ sÆ¡ cÃ³ thÃªm quyá»n lá»£i so vá»›i gÃ³i Free")</li>
                            }

                            @foreach (var feature in plan.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>

                        @if (isCurrent)
                        {
                            <div class="plan-current-pill">Đang sử dụng</div>
                        }
                        else if (Model.HasActiveSubscription)
                        {
                            <button type="button" class="sub-disabled-btn" disabled>Äang cÃ³ gÃ³i hoáº¡t Ä‘á»™ng</button>
                        }
                        else
                        {
                            <form asp-action="Purchase" method="post" class="js-purchase-form">
                                @Html.AntiForgeryToken()
