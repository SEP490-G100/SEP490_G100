@model WebSite.Models.Subscription.SubscriptionPageViewModel
@{
    ViewData["Title"] = "Subscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/subscription.css" />
}

<div class="sub-shell">
    <section class="sub-hero">
        <div class="sub-hero-copy">
            <div class="sub-role">GOI DANH CHO @Model.RoleLabel.ToUpperInvariant()</div>
            <h1>@Model.Headline</h1>
            <p>@Model.Summary</p>
            <div class="sub-chip-row">
                @if (Model.IsParent)
                {
                    <span class="sub-chip">Dang bai theo cap do Free, Plus, Pro</span>
                    <span class="sub-chip">Uu tien hien thi cho bai dang Pro</span>
                    <span class="sub-chip">Gia tang thoi han bai dang</span>
                }
                else if (Model.IsNanny)
                {
                    <span class="sub-chip">Tang so luot ung tuyen moi thang</span>
                    <span class="sub-chip">Ho so co badge noi bat</span>
                    <span class="sub-chip">Uu tien hien thi cho ho so Pro</span>
                }
            </div>
        </div>
        <div class="sub-status-card">
            <span class="sub-status-label">Trang thai hien tai</span>
            @if (Model.HasActiveSubscription)
            {
                <strong>@Model.CurrentSubscription!.Plan.Name</strong>
                <p>Con @Model.CurrentSubscription.RemainingDays ngay va het han vao @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</p>
            }
            else
            {
                <strong>Free</strong>
                <p>Ban dang o goi mac dinh cua @Model.RoleLabel.ToLowerInvariant().</p>
            }
            <div class="sub-status-metrics">
                @if (Model.IsParent)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Free</span>
                        <b>@Model.FreeBenefits.MonthlyJobPostLimit bai/thang</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Thoi han</span>
                        <b>@Model.FreeBenefits.ListingDurationDays ngay</b>
                    </div>
                }
                else if (Model.IsNanny)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Free</span>
                        <b>@Model.FreeBenefits.MonthlyApplicationLimit ung tuyen/thang</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Profile</span>
                        <b>Hien thi co ban</b>
                    </div>
                }
            </div>
        </div>
    </section>

    @if (TempData["SubscriptionSuccess"] is string successMessage)
    {
        <div class="sub-alert sub-alert-success">@successMessage</div>
    }

    @if (TempData["SubscriptionError"] is string errorMessage)
    {
        <div class="sub-alert sub-alert-error">@errorMessage</div>
    }

    @if (!Model.SupportsSubscription)
    {
        <section class="sub-empty">
            <h2>Khong xac dinh duoc vai tro subscription</h2>
            <p>Trang nay hien chi ho tro tai khoan Parent va Nanny. Vui long dang nhap dung vai tro de mua goi.</p>
        </section>
    }
    else
    {
        <section class="sub-current">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Cac goi thanh vien</div>
                    <h2>So sanh goi hien tai</h2>
                    <p>Free la moc co ban. Plus va Pro mo rong quyen loi danh cho @Model.RoleLabel.ToLowerInvariant().</p>
                </div>
                @if (Model.HasActiveSubscription)
                {
                    <form asp-action="CancelCurrent" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sub-secondary-btn">Huy goi hien tai</button>
                    </form>
                }
            </div>

            <div class="sub-grid">
                <article class="plan-card free-card">
                    <div class="plan-top">
                        <span class="plan-tag">Free</span>
                        <h3>Mac dinh</h3>
                        <p>Bat dau nhanh, du de trai nghiem va lam quen he thong.</p>
                    </div>
                    <div class="plan-price">0d</div>
                    <ul class="plan-list">
                        @if (Model.IsParent)
                        {
                            <li>Toi da @Model.FreeBenefits.MonthlyJobPostLimit bai moi thang</li>
                            <li>Bai dang hien thi @Model.FreeBenefits.ListingDurationDays ngay</li>
                            <li>Khong co badge noi bat</li>
                            <li>Khong duoc uu tien trong tim kiem</li>
                        }
                        else if (Model.IsNanny)
                        {
                            <li>Toi da @Model.FreeBenefits.MonthlyApplicationLimit luot ung tuyen moi thang</li>
                            <li>Ho so hien thi thuong</li>
                            <li>Khong co badge noi bat</li>
                            <li>Khong duoc uu tien trong ket qua tim kiem</li>
                        }
                    </ul>
                </article>

                @foreach (var plan in Model.Plans)
                {
                    var isCurrent = Model.CurrentSubscription?.Plan?.Code == plan.Code && Model.HasActiveSubscription;
                    <article class="plan-card @(plan.Code.Contains("PRO") ? "pro-card" : "plus-card") @(isCurrent ? "current-card" : "")">
                        <div class="plan-top">
                            <span class="plan-tag">@plan.Name</span>
                            <h3>@plan.Name</h3>
                            <p>@(plan.Description ?? "Goi phu hop de mo rong quyen loi su dung.")</p>
                        </div>
                        <div class="plan-price">@plan.Price.ToString("N0")d<span>/@plan.DurationDays ngay</span></div>
                        <div class="plan-highlight">
                            @if (Model.IsParent)
                            {
                                <span>@plan.Benefits.MonthlyJobPostLimit bai/thang</span>
                                <span>@plan.Benefits.ListingDurationDays ngay hien thi</span>
                            }
                            else if (Model.IsNanny)
                            {
                                <span>@plan.Benefits.MonthlyApplicationLimit ung tuyen/thang</span>
                                <span>@(plan.Benefits.SearchPriority ? "Uu tien cao hon" : "Noi bat hon Free")</span>
                            }
                        </div>
                        <ul class="plan-list">
                            @if (Model.IsParent)
                            {
                                <li>Dang toi da @plan.Benefits.MonthlyJobPostLimit bai moi thang</li>
                                <li>Bai dang hien thi @plan.Benefits.ListingDurationDays ngay</li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Co badge noi bat cho bai dang" : "Khong co badge noi bat")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Duoc uu tien hien thi trong tim kiem" : "Khong uu tien hien thi")</li>
                            }
                            else if (Model.IsNanny)
                            {
                                <li>Ung tuyen toi da @plan.Benefits.MonthlyApplicationLimit cong viec moi thang</li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Ho so co badge noi bat" : "Ho so hien thi thuong")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Ho so duoc uu tien hien thi cao hon" : "Ho so duoc hien thi noi bat hon Free")</li>
                            }

                            @foreach (var feature in plan.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>

                        @if (isCurrent)
                        {
                            <div class="plan-current-pill">Dang su dung</div>
                        }
                        else if (Model.HasActiveSubscription)
                        {
                            <button type="button" class="sub-disabled-btn" disabled>Dang co goi hoat dong</button>
                        }
                        else
                        {
                            <form asp-action="Purchase" method="post" class="js-purchase-form" data-plan-name="@plan.Name" data-plan-price="@plan.Price.ToString("0")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="subscriptionPlanId" value="@plan.Id" />
                                <button type="submit" class="sub-primary-btn">Mua goi @plan.Name</button>
                            </form>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="sub-current sub-history">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Lich su giao dich</div>
                    <h2>Theo doi thanh toan goi subscription</h2>
                    <p>He thong luu lai giao dich cho thanh toan, thanh cong hoac that bai de ban doi soat nhanh.</p>
                </div>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                <div class="sub-empty-inline">Chua co giao dich subscription nao.</div>
            }
            else
            {
                <div class="sub-trans-list">
                    @foreach (var transaction in Model.Transactions)
                    {
                        var statusClass = transaction.Status switch
                        {
                            1 => "pending",
                            2 => "success",
                            3 => "failed",
                            _ => "unknown"
                        };

                        <article class="sub-trans-item">
                            <div>
                                <p class="sub-trans-kicker">Transaction</p>
                                <h3>@transaction.Id</h3>
                                <p class="sub-trans-desc">@transaction.Description</p>
                            </div>
                            <div class="sub-trans-meta">
                                <span class="sub-trans-badge @statusClass">@transaction.StatusLabel</span>
                                <b>@transaction.Amount.ToString("N0") VND</b>
                                <span>Tao luc: @transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                @if (transaction.CompletedAt.HasValue)
                                {
                                    <span>Hoan tat: @transaction.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(transaction.PaymentGatewayTransactionId))
                                {
                                    <span>Gateway: @transaction.PaymentGatewayTransactionId</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

<div id="purchaseQrModal" class="sub-pay-modal" aria-hidden="true">
    <div class="sub-pay-backdrop" data-close-pay-modal="true"></div>
    <section class="sub-pay-panel" role="dialog" aria-modal="true" aria-labelledby="subPayTitle">
        <button type="button" class="sub-pay-close" id="subPayCloseBtn" aria-label="Dong">&times;</button>
        <p class="sub-pay-kicker">Thanh toan subscription</p>
        <h3 id="subPayTitle" class="sub-pay-title">Quet QR de thanh toan</h3>
        <p class="sub-pay-desc">He thong tao transaction trang thai Pending. Sau khi callback khop giao dich, goi se tu dong kich hoat.</p>

        <div class="sub-pay-main">
            <div class="sub-pay-qr-wrap">
                <img id="subPayQrImage" class="sub-pay-qr" alt="QR payment" />
            </div>
            <div class="sub-pay-info">
                <div class="sub-pay-info-row"><span>Goi</span><b id="subPayPlan">-</b></div>
                <div class="sub-pay-info-row"><span>So tien</span><b id="subPayAmount">-</b></div>
                <div class="sub-pay-info-row"><span>Ma don</span><b id="subPayOrderCode">-</b></div>
                <div class="sub-pay-info-row"><span>Noi dung CK</span><b id="subPayContent">-</b></div>
                <div class="sub-pay-info-row"><span>Trang thai</span><b id="subPayStatus">Cho thanh toan</b></div>
            </div>
        </div>

        <div class="sub-pay-actions">
            <a id="subPayCheckoutLink" href="#" target="_blank" rel="noopener" class="sub-secondary-btn">Mo trang thanh toan</a>
            <a id="subPayResultLink" href="#" class="sub-primary-btn">Xem ket qua</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const forms = Array.from(document.querySelectorAll('.js-purchase-form'));
            if (!forms.length) return;

            const antiForgeryToken = document.querySelector('.js-purchase-form input[name="__RequestVerificationToken"]')?.value;

            forms.forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();

                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (!submitBtn) return;
                    submitBtn.disabled = true;
                    const oldLabel = submitBtn.textContent;
                    submitBtn.textContent = 'Dang chuyen den cong thanh toan...';

                    const formData = new URLSearchParams(new FormData(form));
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With': 'XMLHttpRequest',
                                ...(antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {})
                            },
                            body: formData.toString(),
                            credentials: 'same-origin'
                        });

                        const result = await response.json();
                        if (!result?.success || !result?.data) {
                            alert(result?.message || 'Khong tao duoc giao dich thanh toan.');
                            return;
                        }

                        const data = result.data;
                        if (!data.checkoutUrl) {
                            alert('Khong tao duoc lien ket thanh toan.');
                            return;
                        }

                        window.location.href = data.checkoutUrl;
                    } catch {
                        alert('Khong tao duoc giao dich thanh toan. Vui long thu lai.');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.textContent = oldLabel;
                    }
                });
            });
        })();
    </script>
}
