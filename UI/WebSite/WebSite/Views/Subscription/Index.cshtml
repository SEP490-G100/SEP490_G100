@model WebSite.Models.Subscription.SubscriptionPageViewModel
@{
    ViewData["Title"] = "Subscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/subscription.css" />
}

<div class="sub-shell">
    <section class="sub-hero">
        <div class="sub-hero-copy">
            <div class="sub-role">GÓI DÀNH CHO @Model.RoleLabel.ToUpperInvariant()</div>
            <h1>@Model.Headline</h1>
            <p>@Model.Summary</p>
            <div class="sub-chip-row">
                @if (Model.IsParent)
                {
                    <span class="sub-chip">Đăng bài theo cấp độ Free, Plus, Pro</span>
                    <span class="sub-chip">Ưu tiên hiển thị cho bài đăng Pro</span>
                    <span class="sub-chip">Gia tăng thời hạn bài đăng</span>
                }
                else if (Model.IsNanny)
                {
                    <span class="sub-chip">Tăng số lượt ứng tuyển mỗi tháng</span>
                    <span class="sub-chip">Hồ sơ có badge nổi bật</span>
                    <span class="sub-chip">Ưu tiên hiển thị cho hồ sơ Pro</span>
                }
            </div>
        </div>
        <div class="sub-status-card">
            <span class="sub-status-label">Trạng thái hiện tại</span>
            @if (Model.HasActiveSubscription)
            {
                <strong>@Model.CurrentSubscription!.Plan.Name</strong>
                <p>Còn @Model.CurrentSubscription.RemainingDays ngày và hết hạn vào @Model.CurrentSubscription.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</p>
            }
            else
            {
                <strong>Free</strong>
                <p>Bạn đang ở gói mặc định của @Model.RoleLabel.ToLowerInvariant().</p>
            }
            <div class="sub-status-metrics">
                @if (Model.IsParent)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Free</span>
                        <b>@Model.FreeBenefits.MonthlyJobPostLimit bài/tháng</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Thời hạn</span>
                        <b>@Model.FreeBenefits.ListingDurationDays ngày</b>
                    </div>
                }
                else if (Model.IsNanny)
                {
                    <div class="sub-metric">
                        <span class="sub-metric-label">Free</span>
                        <b>@Model.FreeBenefits.MonthlyApplicationLimit ứng tuyển/tháng</b>
                    </div>
                    <div class="sub-metric">
                        <span class="sub-metric-label">Profile</span>
                        <b>Hiển thị cơ bản</b>
                    </div>
                }
            </div>
        </div>
    </section>

    @if (TempData["SubscriptionSuccess"] is string successMessage)
    {
        <div class="sub-alert sub-alert-success">@successMessage</div>
    }

    @if (TempData["SubscriptionError"] is string errorMessage)
    {
        <div class="sub-alert sub-alert-error">@errorMessage</div>
    }

    @if (!Model.SupportsSubscription)
    {
        <section class="sub-empty">
            <h2>Không xác định được vai trò subscription</h2>
            <p>Trang này hiện chỉ hỗ trợ tài khoản Parent và Nanny. Vui lòng đăng nhập đúng vai trò để mua gói.</p>
        </section>
    }
    else
    {
        <section class="sub-current">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Các gói thành viên</div>
                    <h2>So sánh quyền lợi theo gói</h2>
                    <p>Free là mốc cơ bản. Plus và Pro mở rộng quyền lợi dành cho @Model.RoleLabel.ToLowerInvariant().</p>
                </div>
                @if (Model.HasActiveSubscription)
                {
                    <form asp-action="CancelCurrent" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sub-secondary-btn">Hủy gói hiện tại</button>
                    </form>
                }
            </div>

            <div class="sub-benefit-compare">
                <article class="sub-benefit-item">
                    <span class="sub-benefit-plan">Free</span>
                    @if (Model.IsParent)
                    {
                        <h4>@Model.FreeBenefits.MonthlyJobPostLimit bài đăng</h4>
                        <p>Gói mặc định để bắt đầu nhanh cho phụ huynh.</p>
                    }
                    else if (Model.IsNanny)
                    {
                        <h4>@Model.FreeBenefits.MonthlyApplicationLimit lượt ứng tuyển</h4>
                        <p>Gói mặc định để bắt đầu nhanh cho bảo mẫu.</p>
                    }
                </article>
                @foreach (var plan in Model.Plans)
                {
                    <article class="sub-benefit-item @(plan.Code.Contains("PRO") ? "is-pro" : "is-plus")">
                        <span class="sub-benefit-plan">@plan.Name</span>
                        @if (Model.IsParent)
                        {
                            <h4>@plan.Benefits.MonthlyJobPostLimit bài đăng</h4>
                            <p>@plan.Benefits.ListingDurationDays ngày hiển thị - @(plan.Benefits.SearchPriority ? "có ưu tiên" : "không ưu tiên tìm kiếm").</p>
                        }
                        else if (Model.IsNanny)
                        {
                            <h4>@plan.Benefits.MonthlyApplicationLimit lượt ứng tuyển</h4>
                            <p>@(plan.Benefits.SearchPriority ? "Hồ sơ được ưu tiên hiển thị." : "Hồ sơ nổi bật hơn Free.")</p>
                        }
                    </article>
                }
            </div>

            <div class="sub-grid">
                <article class="plan-card free-card">
                    <div class="plan-top">
                        <span class="plan-tag">Free</span>
                        <h3>Mặc định</h3>
                        <p>Bắt đầu nhanh, đủ để trải nghiệm và làm quen hệ thống.</p>
                    </div>
                    <div class="plan-price">0d</div>
                    <ul class="plan-list">
                        @foreach (var feature in Model.FreeFeatures)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                </article>

                @foreach (var plan in Model.Plans)
                {
                    var isCurrent = Model.CurrentSubscription?.Plan?.Code == plan.Code && Model.HasActiveSubscription;
                    <article class="plan-card @(plan.Code.Contains("PRO") ? "pro-card" : "plus-card") @(isCurrent ? "current-card" : "")">
                        <div class="plan-top">
                            <span class="plan-tag">@plan.Name</span>
                            <h3>@plan.Name</h3>
                            <p>@(plan.Description ?? "Gói phù hợp để mở rộng quyền lợi sử dụng.")</p>
                        </div>
                        <div class="plan-price">@plan.Price.ToString("N0")d<span>/@plan.DurationDays ngày</span></div>
                        <div class="plan-highlight">
                            @if (Model.IsParent)
                            {
                                <span>@plan.Benefits.MonthlyJobPostLimit bài/tháng</span>
                                <span>@plan.Benefits.ListingDurationDays ngày hiển thị</span>
                            }
                            else if (Model.IsNanny)
                            {
                                <span>@plan.Benefits.MonthlyApplicationLimit ứng tuyển/tháng</span>
                                <span>@(plan.Benefits.SearchPriority ? "Ưu tiên cao hơn" : "Nổi bật hơn Free")</span>
                            }
                        </div>
                        <div class="plan-benefit-title">Quyền lợi nhận được</div>
                        <ul class="plan-list">
                            @if (Model.IsParent)
                            {
                                <li>Đăng tối đa @plan.Benefits.MonthlyJobPostLimit bài mỗi tháng</li>
                                <li>Bài đăng hiển thị @plan.Benefits.ListingDurationDays ngày</li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Có badge nổi bật cho bài đăng" : "Không có badge nổi bật")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Được ưu tiên hiển thị trong tìm kiếm" : "Không ưu tiên hiển thị")</li>
                            }
                            else if (Model.IsNanny)
                            {
                                <li>Ứng tuyển tối đa @plan.Benefits.MonthlyApplicationLimit công việc mỗi tháng</li>
                                <li>@(plan.Benefits.FeaturedBadge ? "Hồ sơ có badge nổi bật" : "Hồ sơ hiển thị thường")</li>
                                <li>@(plan.Benefits.SearchPriority ? "Hồ sơ được ưu tiên hiển thị cao hơn" : "Hồ sơ được hiển thị nổi bật hơn Free")</li>
                            }

                            @foreach (var feature in plan.Features)
                            {
                                <li>@feature</li>
                            }
                        </ul>

                        @if (isCurrent)
                        {
                            <div class="plan-current-pill">Đang sử dụng</div>
                        }
                        else if (Model.HasActiveSubscription)
                        {
                            <button type="button" class="sub-disabled-btn" disabled>Đang có gói hoạt động</button>
                        }
                        else
                        {
                            <form asp-action="Purchase" method="post" class="js-purchase-form" data-plan-name="@plan.Name" data-plan-price="@plan.Price.ToString("0")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="subscriptionPlanId" value="@plan.Id" />
                                <button type="submit" class="sub-primary-btn">Mua gói @plan.Name</button>
                            </form>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="sub-current sub-history">
            <div class="sub-section-head">
                <div>
                    <div class="sub-section-label">Lịch sử giao dịch</div>
                    <h2>Theo dõi thanh toán gói subscription</h2>
                    <p>Hệ thống lưu lại giao dịch thành công, chờ xử lý hoặc thất bại để bạn đối soát nhanh.</p>
                </div>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                <div class="sub-empty-inline">Chưa có giao dịch subscription nào.</div>
            }
            else
            {
                <div class="sub-trans-list">
                    @foreach (var transaction in Model.Transactions)
                    {
                        var statusClass = transaction.Status switch
                        {
                            1 => "pending",
                            2 => "success",
                            3 => "failed",
                            _ => "unknown"
                        };

                        <article class="sub-trans-item sub-trans-item--@statusClass">
                            <div class="sub-trans-main">
                                <p class="sub-trans-kicker">Transaction</p>
                                <h3>@transaction.Id</h3>
                                <p class="sub-trans-desc">@transaction.Description</p>
                                <div class="sub-trans-facts">
                                    <span class="sub-trans-fact">
                                        <small>Tạo lúc</small>
                                        @transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    @if (transaction.CompletedAt.HasValue)
                                    {
                                        <span class="sub-trans-fact">
                                            <small>Hoàn tất</small>
                                            @transaction.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(transaction.PaymentGatewayTransactionId))
                                    {
                                        <span class="sub-trans-fact sub-trans-fact-code">
                                            <small>Gateway</small>
                                            @transaction.PaymentGatewayTransactionId
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="sub-trans-meta">
                                <span class="sub-trans-badge @statusClass">@transaction.StatusLabel</span>
                                <b class="sub-trans-amount">@transaction.Amount.ToString("N0") VND</b>
                                <span class="sub-trans-role-pill">@Model.RoleLabel</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

<div id="purchaseQrModal" class="sub-pay-modal" aria-hidden="true">
    <div class="sub-pay-backdrop" data-close-pay-modal="true"></div>
    <section class="sub-pay-panel" role="dialog" aria-modal="true" aria-labelledby="subPayTitle">
        <button type="button" class="sub-pay-close" id="subPayCloseBtn" aria-label="Đóng">&times;</button>
        <p class="sub-pay-kicker">Thanh toán subscription</p>
        <h3 id="subPayTitle" class="sub-pay-title">Quét QR để thanh toán</h3>
        <p class="sub-pay-desc">Hệ thống tạo transaction trạng thái Pending. Sau khi callback khớp giao dịch, gói sẽ tự động kích hoạt.</p>

        <div class="sub-pay-main">
            <div class="sub-pay-qr-wrap">
                <img id="subPayQrImage" class="sub-pay-qr" alt="QR payment" />
            </div>
            <div class="sub-pay-info">
                <div class="sub-pay-info-row"><span>Gói</span><b id="subPayPlan">-</b></div>
                <div class="sub-pay-info-row"><span>Số tiền</span><b id="subPayAmount">-</b></div>
                <div class="sub-pay-info-row"><span>Mã đơn</span><b id="subPayOrderCode">-</b></div>
                <div class="sub-pay-info-row"><span>Nội dung CK</span><b id="subPayContent">-</b></div>
                <div class="sub-pay-info-row"><span>Trạng thái</span><b id="subPayStatus">Chờ thanh toán</b></div>
            </div>
        </div>

        <div class="sub-pay-actions">
            <a id="subPayCheckoutLink" href="#" target="_blank" rel="noopener" class="sub-secondary-btn">Mở trang thanh toán</a>
            <a id="subPayResultLink" href="#" class="sub-primary-btn">Xem kết quả</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const forms = Array.from(document.querySelectorAll('.js-purchase-form'));
            if (!forms.length) return;

            const antiForgeryToken = document.querySelector('.js-purchase-form input[name="__RequestVerificationToken"]')?.value;
            const notify = (message, type = 'error') => {
                if (typeof window.showToast === 'function') {
                    window.showToast(message, { type });
                }
            };

            forms.forEach((form) => {
                form.addEventListener('submit', async (event) => {
                    event.preventDefault();

                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (!submitBtn) return;
                    submitBtn.disabled = true;
                    const oldLabel = submitBtn.textContent;
                    submitBtn.textContent = 'Đang chuyển đến cổng thanh toán...';

                    const formData = new URLSearchParams(new FormData(form));
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With': 'XMLHttpRequest',
                                ...(antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {})
                            },
                            body: formData.toString(),
                            credentials: 'same-origin'
                        });

                        const result = await response.json();
                        if (!result?.success || !result?.data) {
                            notify(result?.message || 'Không tạo được giao dịch thanh toán.', 'error');
                            return;
                        }

                        const data = result.data;
                        if (!data.checkoutUrl) {
                            notify('Không tạo được liên kết thanh toán.', 'error');
                            return;
                        }

                        window.location.href = data.checkoutUrl;
                    } catch {
                        notify('Không tạo được giao dịch thanh toán. Vui lòng thử lại.', 'error');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.textContent = oldLabel;
                    }
                });
            });
        })();
    </script>
}
