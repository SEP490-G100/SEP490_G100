@model WebSite.Models.Subscription.SubscriptionPaymentResultPageViewModel
@{
    ViewData["Title"] = "Ket qua thanh toan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/subscription.css" />
}

<div class="sub-shell">
    @{
        var isCancelled = Model.Cancelled;
        var isSuccess = Model.PaymentStatus?.SubscriptionActivated == true;
        var isFailed = !isCancelled && Model.PaymentStatus?.TransactionStatus == 3;
        var state = isCancelled ? "cancelled" : isSuccess ? "success" : isFailed ? "failed" : "pending";
        var statusLabel = Model.PaymentStatus?.TransactionStatusLabel ?? (isCancelled ? "Da huy" : "Cho thanh toan");
        var planLabel = Model.PaymentStatus?.PlanName ?? "Subscription";
        var resultTitle = isCancelled
            ? "Ban da huy giao dich"
            : isSuccess
                ? "Thanh toan thanh cong"
                : isFailed
                    ? "Thanh toan that bai"
                    : "Cho thanh toan";
        var resultDescription = isCancelled
            ? "Giao dich chua hoan tat. Ban co the quay lai trang subscription de tao giao dich moi."
            : isSuccess
                ? "Goi subscription cua ban da duoc kich hoat va san sang su dung."
                : isFailed
                    ? "He thong doi soat callback noi bo khong thanh cong. Ban co the tao giao dich moi."
                    : "He thong se tu dong kiem tra ket qua thanh toan tu PayOS. Neu callback den cham, trang thai se duoc cap nhat tiep trong it giay.";
    }

    <section class="sub-result-hero">
        <article class="sub-result-overview">
            <div class="sub-role">Ket qua thanh toan</div>
            <h1 id="paymentResultTitle">@resultTitle</h1>
            <p id="paymentResultDescription">@resultDescription</p>

            <div class="sub-result-tags">
                <span id="paymentResultStatusBadge" class="sub-result-status-pill sub-result-status-pill--@state">
                    <span id="paymentResultStatus">@statusLabel</span>
                </span>
                <span class="sub-result-plan-pill">Goi: <b id="paymentResultPlan">@planLabel</b></span>
            </div>
        </article>

        <aside id="paymentResultMetaCard" class="sub-result-id-card sub-result-id-card--@state">
            <span class="sub-status-label">Ma giao dich</span>
            <strong>@Model.TransactionId</strong>
            <p id="paymentStatusText">@statusLabel - @planLabel</p>
        </aside>
    </section>

    <section class="sub-result-action-card">
        <div class="sub-result-action-head">
            <span class="sub-section-label">Thanh toan</span>
            <h2>Thong tin giao dich</h2>
            <p>Neu callback den cham, trang se tiep tuc kiem tra va cap nhat ket qua cho ban.</p>
        </div>

        <div class="sub-result-facts">
            <div class="sub-result-fact">
                <span>Trang thai hien tai</span>
                <b id="paymentResultStatusText">@statusLabel</b>
            </div>
            <div class="sub-result-fact">
                <span>Goi subscription</span>
                <b id="paymentResultPlanText">@planLabel</b>
            </div>
        </div>

        <div class="sub-result-actions">
            <a href="@Url.Action("Index", "Subscription")" class="sub-primary-btn sub-result-btn">Quay lai trang goi</a>
            <a href="@Url.Action("Index", "Home")" class="sub-secondary-btn sub-result-btn">Ve trang chu</a>
        </div>
    </section>
</div>

@section Scripts {
    @if (!Model.Cancelled && Model.TransactionId != Guid.Empty)
    {
        <script>
            (() => {
                const transactionId = '@Model.TransactionId';
                const statusText = document.getElementById('paymentStatusText');
                const resultTitle = document.getElementById('paymentResultTitle');
                const resultDescription = document.getElementById('paymentResultDescription');
                const resultStatus = document.getElementById('paymentResultStatus');
                const resultPlan = document.getElementById('paymentResultPlan');
                const resultStatusText = document.getElementById('paymentResultStatusText');
                const resultPlanText = document.getElementById('paymentResultPlanText');
                const resultStatusBadge = document.getElementById('paymentResultStatusBadge');
                const resultMetaCard = document.getElementById('paymentResultMetaCard');

                let attempts = 0;
                const maxAttempts = 40;

                const setVisualState = (state) => {
                    resultStatusBadge?.classList.remove(
                        'sub-result-status-pill--pending',
                        'sub-result-status-pill--success',
                        'sub-result-status-pill--failed',
                        'sub-result-status-pill--cancelled'
                    );
                    resultMetaCard?.classList.remove(
                        'sub-result-id-card--pending',
                        'sub-result-id-card--success',
                        'sub-result-id-card--failed',
                        'sub-result-id-card--cancelled'
                    );

                    resultStatusBadge?.classList.add(`sub-result-status-pill--${state}`);
                    resultMetaCard?.classList.add(`sub-result-id-card--${state}`);
                };

                const applyStatus = (data) => {
                    if (!data) return false;

                    const status = data.transactionStatusLabel || 'Dang cho doi soat';
                    const plan = data.planName || 'Subscription';

                    if (resultStatus) resultStatus.textContent = status;
                    if (resultPlan) resultPlan.textContent = plan;
                    if (resultStatusText) resultStatusText.textContent = status;
                    if (resultPlanText) resultPlanText.textContent = plan;
                    if (statusText) statusText.textContent = `${status} - ${plan}`;

                    if (data.subscriptionActivated) {
                        setVisualState('success');
                        if (resultTitle) resultTitle.textContent = 'Thanh toan thanh cong';
                        if (resultDescription) resultDescription.textContent = 'Goi subscription cua ban da duoc kich hoat.';
                        return true;
                    }

                    if (data.transactionStatus === 3) {
                        setVisualState('failed');
                        if (resultTitle) resultTitle.textContent = 'Thanh toan that bai';
                        if (resultDescription) resultDescription.textContent = 'He thong doi soat callback noi bo khong thanh cong.';
                        return true;
                    }

                    setVisualState('pending');
                    if (resultTitle) resultTitle.textContent = 'Cho thanh toan';
                    if (resultDescription) resultDescription.textContent = 'He thong se tu dong kiem tra ket qua thanh toan tu PayOS.';
                    return false;
                };

                const poll = async () => {
                    attempts += 1;
                    try {
                        const response = await fetch(`/Subscription/PaymentStatus?transactionId=${transactionId}`, {
                            credentials: 'same-origin'
                        });
                        const result = await response.json();
                        const done = applyStatus(result?.data);
                        if (done || attempts >= maxAttempts) return;
                    } catch {
                        if (attempts >= maxAttempts) return;
                    }

                    window.setTimeout(poll, 3000);
                };

                window.setTimeout(poll, 2500);
            })();
        </script>
    }
}
