@model WebSite.Models.Nanny.NannySkillsViewModel
@{
    ViewData["Title"] = "Create your profile";
}

<div class="min-h-screen bg-[#1f242b] flex items-center justify-center px-4">
    <div class="w-full max-w-2xl bg-[#2b323b] text-gray-100 rounded-2xl shadow-2xl overflow-hidden">
        @* Progress Bar 66% *@
        <div class="h-1 bg-[#3b434e]">
            <div class="h-1 bg-pink-400" style="width:66%"></div>
        </div>

        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-lg font-semibold">Create your profile</h1>
                <button type="button" onclick="window.location.href='@Url.Action("Logout", "Auth")'" class="text-gray-400 hover:text-gray-200">×</button>
            </div>

            @* Hiển thị lỗi từ server *@
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4 bg-red-900/20 p-3 rounded-lg"></div>

            <div class="flex flex-col items-center mb-8">
                <div class="w-24 h-24 rounded-full bg-[#3b434e] flex items-center justify-center mb-4">
                    <span class="text-4xl">✨</span>
                </div>
                <div class="text-sm text-gray-300 px-4 py-2 rounded-full bg-[#3b434e]">
                    What skills do you have?
                </div>
            </div>

            <form asp-action="Skills" asp-controller="Nanny" method="post">
                @Html.AntiForgeryToken()

                <div class="space-y-5">
                    <p class="text-sm text-gray-300">Select your main skills and how experienced you are.</p>

                    @* Sử dụng vòng lặp nếu Model có danh sách SelectedSkills *@
                    @for (int i = 0; i < Model.SelectedSkills.Count; i++)
                    {
                        <div class="p-4 border border-[#3b434e] rounded-xl bg-[#1f242b]/50 mb-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-2">Skill</label>
                                <select asp-for="SelectedSkills[i].SkillId"
                                        class="w-full px-4 py-3 rounded-xl bg-[#1f242b] border border-[#3b434e] text-gray-100 focus:ring-2 focus:ring-pink-400">
                                    <option value="">-- Chọn kỹ năng --</option>
                                    @foreach (var skill in Model.AvailableSkills)
                                    {
                                        <option value="@skill.SkillId">@skill.SkillName</option>
                                    }
                                </select>
                                <span asp-validation-for="SelectedSkills[i].SkillId" class="text-red-400 text-xs"></span>
                            </div>

                            <div class="mt-4">
                                <label class="block text-sm font-medium text-gray-300 mb-2">Proficiency level</label>
                                <select asp-for="SelectedSkills[i].ProficiencyLevel"
                                        class="w-full px-4 py-3 rounded-xl bg-[#1f242b] border border-[#3b434e] text-gray-100 focus:ring-2 focus:ring-pink-400">
                                    <option value="">-- Chọn trình độ --</option>
                                    <option value="1">Cơ bản</option>
                                    <option value="2">Trung cấp</option>
                                    <option value="3">Nâng cao</option>
                                </select>
                                <span asp-validation-for="SelectedSkills[i].ProficiencyLevel" class="text-red-400 text-xs"></span>
                            </div>
                        </div>
                    }
                </div>

                <div class="flex justify-between items-center mt-8">
                    <a href="@Url.Action("Profile", "Nanny")"
                       class="px-5 py-2 rounded-full border border-[#3b434e] text-gray-200 hover:bg-[#3b434e] text-sm">
                        Back
                    </a>
                    <button type="submit"
                            class="px-6 py-2 rounded-full bg-teal-500 hover:bg-teal-400 text-white font-semibold text-sm transition-colors">
                        Next
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>