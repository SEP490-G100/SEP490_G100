@model WebSite.Models.Nanny.NannySkillsViewModel
@{
    ViewData["Title"] = "Tạo hồ sơ";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto bg-white rounded-3xl shadow-soft border border-gray-100/80 overflow-hidden">
        <div class="h-1 bg-orange-100">
            <div class="h-1 bg-orange-500" style="width:66%"></div>
        </div>

        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-lg font-bold text-slate-900">Tạo hồ sơ của bạn</h1>
                <button type="button" onclick="window.location.href='@Url.Action("Logout", "Auth")'" class="text-slate-400 hover:text-slate-700">×</button>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm mb-4 bg-red-50 p-3 rounded-xl border border-red-100"></div>

            <div class="flex flex-col items-center mb-8">
                <div class="w-24 h-24 rounded-full bg-orange-100 flex items-center justify-center mb-4">
                    <span class="text-4xl">✨</span>
                </div>
                <div class="text-sm text-orange-700 px-4 py-2 rounded-full bg-orange-50 border border-orange-100 font-semibold">
                    Bạn có những kỹ năng gì?
                </div>
            </div>

            <form asp-action="Skills" asp-controller="Nanny" method="post">
                @Html.AntiForgeryToken()

                <div class="space-y-5">
                    <p class="text-sm text-slate-500">Chọn kỹ năng chính của bạn.</p>

                    <div class="p-4 border border-orange-100 rounded-2xl bg-orange-50/40 mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">Kỹ năng</label>
                        @if (Model.AvailableSkills.Any())
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 p-4 rounded-2xl border border-orange-100 bg-white">
                                @foreach (var skill in Model.AvailableSkills)
                                {
                                    var checkedAttr = Model.SelectedSkillIds.Contains(skill.SkillId);
                                    <label class="flex items-center gap-2 text-sm text-slate-700 font-semibold">
                                        <input type="checkbox"
                                               name="SelectedSkillIds"
                                               value="@skill.SkillId"
                                               @(checkedAttr ? "checked" : null)
                                               class="rounded border-gray-300 text-orange-600 focus:ring-orange-500" />
                                        <span>@skill.SkillName</span>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Không tải được danh sách kỹ năng.</p>
                        }
                        <span asp-validation-for="SelectedSkillIds" class="text-red-600 text-xs mt-2 block"></span>
                    </div>
                </div>

                <div class="flex justify-between items-center mt-8">
                    <a href="@Url.Action("Profile", "Nanny")"
                       class="px-5 py-2 rounded-full border border-orange-200 text-orange-700 hover:bg-orange-50 text-sm font-semibold">
                        Quay lại
                    </a>
                    <button type="submit"
                            class="px-6 py-2 rounded-full bg-orange-500 hover:bg-orange-600 text-white font-semibold text-sm transition-colors">
                        Tiếp theo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
