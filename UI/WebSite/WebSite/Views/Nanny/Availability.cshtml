@model WebSite.Models.Nanny.NannyAvailabilityViewModel
@{
    ViewData["Title"] = "Khả năng làm việc của bảo mẫu";
    var dayColumns = Model.Days.Select((d, i) => new { Index = i, d.DayName }).ToList();
    var slotRows = new[]
    {
        new { Slot = 0, Label = "Buổi sáng", Name = "Morning" },
        new { Slot = 1, Label = "Buổi chiều", Name = "Afternoon" },
        new { Slot = 2, Label = "Buổi tối", Name = "Evening" },
        new { Slot = 3, Label = "Ban đêm", Name = "Night" }
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <style>
        .schedule-preset-wrap {
            margin-bottom: 1rem;
        }

        .schedule-preset-label {
            display: block;
            font-size: .86rem;
            font-weight: 800;
            color: #334155;
            margin-bottom: .45rem;
        }

        .schedule-preset-select {
            width: 100%;
            border: 1px solid #fdba74;
            border-radius: .95rem;
            background: linear-gradient(180deg, #fff, #fffaf4);
            color: #0f172a;
            font-size: .95rem;
            font-weight: 700;
            padding: .72rem .95rem;
            outline: none;
            transition: border-color .18s ease, box-shadow .18s ease;
        }

        .schedule-preset-select:focus {
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249, 115, 22, .15);
        }

        .schedule-preset-hint {
            margin-top: .45rem;
            font-size: .8rem;
            color: #64748b;
        }
    </style>
}

<section class="availability-shell">
    <div class="availability-box">
        <div class="availability-panel">
            <div class="availability-head">
                <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-orange-500">Đăng ký bảo mẫu</p>
                <h1 class="mt-2 text-2xl sm:text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">Chọn lịch làm việc</h1>
                <p class="mt-2 text-sm text-slate-500">Giao diện đồng bộ với lịch trên danh sách bài đăng.</p>
            </div>

            <div class="availability-body">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <form asp-action="Availability" asp-controller="Nanny" method="post">
                    @Html.AntiForgeryToken()

                    @for (var i = 0; i < Model.Days.Count; i++)
                    {
                        <input type="hidden" name="Days[@i].DayName" value="@Model.Days[i].DayName" />
                        <input type="hidden" name="Days[@i].DayOfWeek" value="@Model.Days[i].DayOfWeek" />
                    }

                    <div class="section-card schedule-card">
                        <div class="schedule-header">
                            <div>
                                <p class="section-title">Lịch tuần</p>
                                <p class="section-caption">Chọn các khung giờ bạn có thể nhận việc.</p>
                            </div>
                        </div>

                        <div class="schedule-preset-wrap">
                            <label class="schedule-preset-label" for="schedulePreset">Mẫu lịch nhanh</label>
                            <select id="schedulePreset" class="schedule-preset-select">
                                <option value="">-- Chọn mẫu lịch nhanh --</option>
                                <option value="morning-afternoon">Từ sáng đến chiều</option>
                                <option value="afternoon-evening">Từ chiều đến tối</option>
                                <option value="weekday-only">Làm các ngày trong tuần trừ cuối tuần</option>
                                <option value="all-week">Làm cả tuần</option>
                            </select>
                            <p class="schedule-preset-hint">Chọn mẫu để tự động tích lịch, sau đó bạn vẫn có thể chỉnh tay bên dưới.</p>
                        </div>

                        <div class="schedule-grid" id="availabilityGrid">
                            <div></div>
                            @foreach (var day in dayColumns)
                            {
                                <div class="schedule-col-label">@day.DayName</div>
                            }

                            @foreach (var row in slotRows)
                            {
                                <div class="schedule-row-label">@row.Label</div>
                                @for (var i = 0; i < Model.Days.Count; i++)
                                {
                                    var inputId = $"day-{i}-slot-{row.Slot}";
                                    var isActive = row.Slot switch
                                    {
                                        0 => Model.Days[i].Morning,
                                        1 => Model.Days[i].Afternoon,
                                        2 => Model.Days[i].Evening,
                                        _ => Model.Days[i].Night
                                    };
                                    var inputName = $"Days[{i}].{row.Name}";

                                    <input type="checkbox"
                                           id="@inputId"
                                           name="@inputName"
                                           value="true"
                                           class="availability-checkbox"
                                           @(isActive ? "checked" : null) />

                                    <button type="button"
                                            class="schedule-cell @(isActive ? "active" : "")"
                                            data-input-id="@inputId"
                                            data-day-index="@i"
                                            data-day-of-week="@Model.Days[i].DayOfWeek"
                                            data-slot="@row.Slot"
                                            aria-pressed="@(isActive ? "true" : "false")">
                                        <span class="schedule-check">@(isActive ? Html.Raw("&#10003;") : Html.Raw(""))</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <div class="availability-actions">
                        <a href="@Url.Action("Skills", "Nanny")" class="ghost-btn">Quay lại</a>
                        <button type="submit" class="profile-primary-btn">Hoàn tất</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var grid = document.getElementById('availabilityGrid');
            if (!grid) return;
            var presetSelect = document.getElementById('schedulePreset');

            function setCellState(cell, isActive) {
                var inputId = cell.getAttribute('data-input-id');
                if (!inputId) return;
                var checkbox = document.getElementById(inputId);
                if (!checkbox) return;

                checkbox.checked = isActive;
                cell.classList.toggle('active', isActive);
                cell.setAttribute('aria-pressed', isActive ? 'true' : 'false');

                var check = cell.querySelector('.schedule-check');
                if (check) check.innerHTML = isActive ? '&#10003;' : '';
            }

            var cells = Array.prototype.slice.call(grid.querySelectorAll('.schedule-cell[data-input-id]'));

            cells.forEach(function (cell) {
                cell.addEventListener('click', function () {
                    var inputId = cell.getAttribute('data-input-id');
                    if (!inputId) return;
                    var checkbox = document.getElementById(inputId);
                    if (!checkbox) return;
                    setCellState(cell, !checkbox.checked);
                });
            });

            function clearAll() {
                cells.forEach(function (cell) { setCellState(cell, false); });
            }

            function applyPreset(preset) {
                if (!preset) return;
                clearAll();

                cells.forEach(function (cell) {
                    var slot = Number(cell.getAttribute('data-slot'));
                    var dayOfWeek = Number(cell.getAttribute('data-day-of-week'));
                    var isWeekday = dayOfWeek >= 1 && dayOfWeek <= 5;
                    var shouldEnable = false;

                    if (preset === 'morning-afternoon') {
                        shouldEnable = slot === 0 || slot === 1;
                    } else if (preset === 'afternoon-evening') {
                        shouldEnable = slot === 1 || slot === 2;
                    } else if (preset === 'weekday-only') {
                        shouldEnable = isWeekday;
                    } else if (preset === 'all-week') {
                        shouldEnable = true;
                    }

                    if (shouldEnable) setCellState(cell, true);
                });
            }

            if (presetSelect) {
                presetSelect.addEventListener('change', function () {
                    applyPreset(presetSelect.value);
                });
            }
        })();
    </script>
}
