@model WebSite.Models.Nanny.NannyAvailabilityViewModel
@{
    ViewData["Title"] = "Nanny Availability";
    var dayColumns = Model.Days.Select((d, i) => new { Index = i, d.DayName }).ToList();
    var slotRows = new[]
    {
        new { Slot = 0, Label = "Morning", Name = "Morning" },
        new { Slot = 1, Label = "Afternoon", Name = "Afternoon" },
        new { Slot = 2, Label = "Evening", Name = "Evening" },
        new { Slot = 3, Label = "Night", Name = "Night" }
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<section class="availability-shell">
    <div class="availability-box">
        <div class="availability-panel">
            <div class="availability-head">
                <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-orange-500">Nanny onboarding</p>
                <h1 class="mt-2 text-2xl sm:text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">Chon lich lam viec</h1>
                <p class="mt-2 text-sm text-slate-500">UI dong bo voi lich tren JobPostList.</p>
            </div>

            <div class="availability-body">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <form asp-action="Availability" asp-controller="Nanny" method="post">
                    @Html.AntiForgeryToken()

                    @for (var i = 0; i < Model.Days.Count; i++)
                    {
                        <input type="hidden" name="Days[@i].DayName" value="@Model.Days[i].DayName" />
                        <input type="hidden" name="Days[@i].DayOfWeek" value="@Model.Days[i].DayOfWeek" />
                    }

                    <div class="section-card schedule-card">
                        <div class="schedule-header">
                            <div>
                                <p class="section-title">Weekly schedule</p>
                                <p class="section-caption">Chon cac khung gio ban co the nhan viec.</p>
                            </div>
                        </div>

                        <div class="schedule-grid" id="availabilityGrid">
                            <div></div>
                            @foreach (var day in dayColumns)
                            {
                                <div class="schedule-col-label">@day.DayName</div>
                            }

                            @foreach (var row in slotRows)
                            {
                                <div class="schedule-row-label">@row.Label</div>
                                @for (var i = 0; i < Model.Days.Count; i++)
                                {
                                    var inputId = $"day-{i}-slot-{row.Slot}";
                                    var isActive = row.Slot switch
                                    {
                                        0 => Model.Days[i].Morning,
                                        1 => Model.Days[i].Afternoon,
                                        2 => Model.Days[i].Evening,
                                        _ => Model.Days[i].Night
                                    };
                                    var inputName = $"Days[{i}].{row.Name}";

                                    <input type="hidden" name="@inputName" value="false" />
                                    <input type="checkbox"
                                           id="@inputId"
                                           name="@inputName"
                                           value="true"
                                           class="availability-checkbox"
                                           @(isActive ? "checked" : null) />

                                    <button type="button"
                                            class="schedule-cell @(isActive ? "active" : "")"
                                            data-input-id="@inputId"
                                            aria-pressed="@(isActive ? "true" : "false")">
                                        <span class="schedule-check">@(isActive ? Html.Raw("&#10003;") : Html.Raw(""))</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <div class="availability-actions">
                        <a href="@Url.Action("Skills", "Nanny")" class="ghost-btn">Back</a>
                        <button type="submit" class="profile-primary-btn">Finish</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var grid = document.getElementById('availabilityGrid');
            if (!grid) return;

            grid.querySelectorAll('.schedule-cell[data-input-id]').forEach(function (cell) {
                cell.addEventListener('click', function () {
                    var inputId = cell.getAttribute('data-input-id');
                    if (!inputId) return;
                    var checkbox = document.getElementById(inputId);
                    if (!checkbox) return;

                    checkbox.checked = !checkbox.checked;
                    var isActive = checkbox.checked;
                    cell.classList.toggle('active', isActive);
                    cell.setAttribute('aria-pressed', isActive ? 'true' : 'false');

                    var check = cell.querySelector('.schedule-check');
                    if (check) check.innerHTML = isActive ? '&#10003;' : '';
                });
            });
        })();
    </script>
}
