@{
    ViewData["Title"] = "Bảo mẫu yêu thích - NannyMatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="min-h-screen bg-[linear-gradient(180deg,#fffaf5_0%,#ffffff_45%,#fff7ed_100%)] py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-[30px] border border-orange-100 bg-white/90 shadow-[0_24px_60px_rgba(15,23,42,.08)] overflow-hidden">
            <div class="px-6 py-6 sm:px-8 border-b border-orange-100 bg-[radial-gradient(circle_at_top_right,rgba(255,237,213,.85),transparent_28%),linear-gradient(180deg,#ffffff_0%,#fffaf4_100%)]">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-orange-500">Parent zone</p>
                        <h1 class="mt-2 text-3xl font-bold text-slate-900">Danh sách nanny yêu thích</h1>
                        <p class="mt-2 text-sm leading-6 text-slate-500 max-w-2xl">
                            Quản lý các hồ sơ nanny bạn đã tìm và bộ lưu để liên hệ nhanh hơn khi cần.
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="/Nanny/List"
                           class="inline-flex items-center justify-center min-h-[48px] px-5 rounded-2xl border border-slate-200 bg-white text-slate-600 font-bold hover:bg-slate-50 transition-all">
                                Quay lại tìm nanny
                        </a>
                    </div>
                </div>
            </div>

            <div class="px-6 py-6 sm:px-8">
                <div class="mb-5 rounded-3xl border border-slate-100 bg-slate-50 px-5 py-4">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Tổng nanny yêu thích</p>
                    <p id="favoriteNannyCount" class="mt-2 text-3xl font-extrabold text-slate-900">0</p>
                </div>

                <div id="favoriteNannyList" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    <div class="rounded-3xl border border-slate-200 bg-white px-6 py-10 text-center text-slate-500 lg:col-span-2">
                        Đang tải danh sách nanny yêu thích...
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
        const listEl = document.getElementById('favoriteNannyList');
        const countEl = document.getElementById('favoriteNannyCount');

        const escapeHtml = (value) => String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');

        const notify = (message, type = 'info') => {
            if (typeof window.showToast === 'function') {
                window.showToast(message, { type });
            }
        };

        const formatCurrency = (value) => {
            const amount = Number(value);
            if (!Number.isFinite(amount) || amount <= 0) return null;
            return `${new Intl.NumberFormat('vi-VN').format(amount)} VND`;
        };

        const formatSalary = (min, max) => {
            const minText = formatCurrency(min);
            const maxText = formatCurrency(max);
            if (minText && maxText) return `${minText} - ${maxText}`;
            if (minText) return `Từ ${minText}`;
            if (maxText) return `Đến ${maxText}`;
            return 'Thương lượng';
        };

        async function removeFavorite(nannyId) {
            try {
                const response = await fetch(`/Nanny/ToggleFavorite?id=${encodeURIComponent(nannyId)}`, {
                    method: 'POST',
                    credentials: 'same-origin'
                });
                const json = await response.json();
                if (!json?.success) {
                    notify(json?.message || 'Không thể cập nhật yêu thích.', 'error');
                    return;
                }

                if (json.isFavorite) {
                    notify('Bảo mẫu này vẫn đang ở trạng thái yêu thích.', 'warning');
                    return;
                }

                notify('Đã bỏ bảo mẫu khỏi danh sách yêu thích.', 'info');
                await loadFavorites();
            } catch {
                notify('Lỗi kết nối server.', 'error');
            }
        }

        function renderItems(items) {
            if (!Array.isArray(items) || !items.length) {
                listEl.innerHTML = `
                    <div class="rounded-3xl border border-dashed border-slate-200 bg-slate-50 px-6 py-14 text-center lg:col-span-2">
                        <span class="material-icons-round text-[34px] text-orange-300">favorite_border</span>
                        <h3 class="mt-3 text-lg font-bold text-slate-900">Bạn chưa yêu thích bảo mẫu nào</h3>
                        <p class="mt-2 text-sm text-slate-500">Khi bạn tìm bảo mẫu, danh sách yêu thích sẽ hiển thị tại đây.</p>
                    </div>`;
                return;
            }

            listEl.innerHTML = items.map((item) => {
                const location = [item.district, item.city].filter(Boolean).join(', ') || 'Chưa cập nhật khu vực';
                const skills = Array.isArray(item.skills) ? item.skills : [];
                const shownSkills = skills.slice(0, 4)
                    .map((skill) => `<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">${escapeHtml(skill.skillName || 'Skill')}</span>`)
                    .join('');

                return `
                    <article class="rounded-[24px] border border-orange-100 bg-white p-5 shadow-[0_10px_30px_rgba(15,23,42,.05)]">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                                <img src="${escapeHtml(item.avatarUrl || '/img/nanny-logo.jpg')}" alt="Avatar"
                                     class="w-14 h-14 rounded-2xl object-cover border border-orange-100 bg-orange-50" />
                                <div class="min-w-0">
                                    <h3 class="text-lg font-extrabold text-slate-900 truncate">${escapeHtml(item.fullName || 'Nanny')}</h3>
                                    <p class="text-sm font-semibold text-orange-600 mt-1">${escapeHtml(location)}</p>
                                </div>
                            </div>
                            <button type="button"
                                    onclick="window.__removeFavoriteNanny('${escapeHtml(item.id)}')"
                                    class="inline-flex items-center justify-center min-h-[36px] px-3 rounded-xl border border-rose-200 bg-rose-50 text-rose-600 text-xs font-extrabold hover:bg-rose-100 transition-all">
                                Bỏ yêu thích
                            </button>
                        </div>

                        <p class="mt-3 text-sm text-slate-600 leading-6 line-clamp-2">${escapeHtml(item.bio || 'Hồ sơ chưa có mô tả.')}</p>

                        <div class="mt-4 flex flex-wrap gap-2">
                            ${item.searchPriority
                                ? '<span class="px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-bold">Nanny Pro</span><span class="px-3 py-1 rounded-full bg-orange-50 text-orange-700 text-xs font-bold">Ưu tiên hiển thị</span>'
                                : item.featuredBadge
                                    ? '<span class="px-3 py-1 rounded-full bg-orange-50 text-orange-700 text-xs font-bold">Nanny Plus</span>'
                                    : ''}
                            <span class="px-3 py-1 rounded-full bg-orange-50 text-orange-700 text-xs font-bold">${escapeHtml(formatSalary(item.expectedSalaryMin, item.expectedSalaryMax))}</span>
                            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">${item.yearsOfExperience ? `${item.yearsOfExperience} năm KN` : 'Chưa rõ kinh nghiệm'}</span>
                            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">${item.age ? `${item.age} tuổi` : 'Chưa rõ tuổi'}</span>
                        </div>

                        <div class="mt-4 flex flex-wrap gap-2">
                            ${shownSkills || '<span class="text-sm text-slate-400">Chưa có kỹ năng nổi bật.</span>'}
                        </div>
                    </article>`;
            }).join('');
        }

        async function loadFavorites() {
            try {
                const response = await fetch('/Nanny/FavoriteData?page=1&pageSize=24', { credentials: 'same-origin' });
                const json = await response.json();
                const items = json?.data ?? [];
                const totalCount = Number(json?.totalCount ?? items.length ?? 0);

                countEl.textContent = Number.isFinite(totalCount) ? String(totalCount) : '0';
                renderItems(items);
            } catch {
                listEl.innerHTML = `
                    <div class="rounded-3xl border border-red-100 bg-red-50 px-6 py-10 text-center text-red-600 lg:col-span-2">
                        Không tải được danh sách bảo mẫu yêu thích.
                    </div>`;
            }
        }

        window.__removeFavoriteNanny = removeFavorite;
        loadFavorites();
    })();
</script>
