@model WebSite.Models.Nanny.NannyBrowsePageViewModel
@{
    ViewData["Title"] = "Danh sách bảo mẫu - NannyMatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isParent = User.IsInRole("Parent");
    var hiringJobPostingId = Context.Request.Query["jobPostingId"].ToString();
    var hiringJobAppId = Context.Request.Query["jobApplicationId"].ToString();
    var hasHiringContext = isParent && !string.IsNullOrWhiteSpace(hiringJobPostingId) && !string.IsNullOrWhiteSpace(hiringJobAppId);
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/nanny-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recommendation.css" asp-append-version="true" />
}

<div class="nanny-page">
    <div class="nanny-toolbar-shell">
        <div class="nanny-toolbar">
            @* ── Tab bar — chỉ hiện với Parent, ngoài cùng bên trái ── *@
            @if (User.IsInRole("Parent") && (User.Identity?.IsAuthenticated ?? false))
            {
                <div class="rec-tab-bar">
                    <button id="nannyTabAll" class="rec-tab active" onclick="switchNannyTab('all')">
                        <span class="material-icons-round">list</span>Tất cả
                    </button>
                    <button id="nannyTabRec" class="rec-tab" onclick="switchNannyTab('rec')">
                        <span class="material-icons-round">auto_awesome</span>Gợi ý
                    </button>
                </div>
            }

            <div class="nanny-toolbar__search">
                <span class="material-icons-round">search</span>
                <input id="nannyKeyword" type="text" placeholder="Tìm theo tên, kỹ năng hoặc mô tả..." oninput="debounceNannySearch()" />
            </div>
            <div class="nanny-toolbar__actions">
                <button type="button" class="nanny-filter-trigger" onclick="openNannyFilters()">
                    <span class="material-icons-round text-[18px]">tune</span>
                    Bộ lọc
                </button>
                @if (isParent)
                {
                    <a href="/Nanny/Favorites" class="nanny-filter-trigger">
                        <span class="material-icons-round text-[18px]">favorite</span>
                        Nanny yêu thích
                    </a>
                    <a href="/Nanny/ContactRequests" class="nanny-filter-trigger">
                        <span class="material-icons-round text-[18px]">contact_phone</span>
                        Contact request
                    </a>
                }
                <span id="nannyResultCount" class="nanny-toolbar__count">Đang tải...</span>
                <a href="/Subscription" class="nanny-upgrade-btn">
                    <span class="material-icons-round text-[18px]">workspace_premium</span>
                    Upgrade
                </a>
            </div>
        </div>
    </div>

    <div class="nanny-layout">
        <div class="nanny-list-panel">

            @* ── Rec panel (Tab 2) — chỉ render với Parent ── *@
            @if (User.IsInRole("Parent") && (User.Identity?.IsAuthenticated ?? false))
            {
                <div id="recNannyPanel" class="rec-panel">
                    <div class="rec-panel__header">
                        <span class="rec-panel__label">Gợi ý nanny cho:</span>
                        <select id="recJobSelect" class="rec-panel__select" onchange="loadRecNannies(this.value)">
                            <option value="">— Chọn bài đăng —</option>
                        </select>
                    </div>
                    <div id="recNannyContent">
                        <div class="rec-panel__loading" style="padding:20px">
                            <span class="material-icons-round" style="font-size:20px;opacity:.4">arrow_upward</span>
                            Chọn bài đăng để xem nanny phù hợp
                        </div>
                    </div>
                </div>
            }

            <div id="nannyList" class="nanny-list"></div>
        </div>
        <div class="nanny-map-panel">
            <div id="nannyMap" style="z-index: 0;"></div>
        </div>
    </div>
</div>

<div id="nannyFilterModal" class="nmodal fixed inset-0 z-50 bg-black/40 backdrop-blur-sm items-center justify-center px-4" onclick="if(event.target===this)closeNannyFilters()">
    <div class="nmodal-box nanny-filter-modal bg-white rounded-2xl w-full max-w-4xl shadow-2xl relative">
        <div class="nanny-filter-modal__header">
            <div>
                <p class="nanny-filter-modal__kicker">Bộ lọc tìm kiếm</p>
                <h2 class="nanny-filter-modal__title">Tìm nanny phù hợp nhanh hơn</h2>
                <p class="nanny-filter-modal__subtitle">Chọn khu vực, kỹ năng, độ tuổi, kinh nghiệm và khoảng lương để thu hẹp danh sách hồ sơ.</p>
            </div>
            <button type="button" onclick="closeNannyFilters()" class="nanny-detail-close material-icons-round">close</button>
        </div>
        <div class="nanny-filter-modal__body">
            <div class="nanny-filter-groups">
                <section class="nanny-filter-group">
                    <div class="nanny-filter-group__head">
                        <span class="material-icons-round">location_on</span>
                        <div>
                            <h3>Khu vực làm việc</h3>
                            <p>Chọn tỉnh/thành phố và quận/huyện theo dữ liệu hành chính mới nhất.</p>
                        </div>
                    </div>
                    <div class="nanny-toolbar__filters nanny-toolbar__filters--modal">
                        <div class="nanny-filter-field">
                            <label for="nannyCity">Thành phố/Tỉnh</label>
                            <input id="nannyCity" type="text" class="nanny-filter" placeholder="Nhập để gợi ý thành phố" autocomplete="off" />
                        </div>
                        <div class="nanny-filter-field">
                            <label for="nannyDistrict">Quận/Huyện</label>
                            <input id="nannyDistrict" type="text" class="nanny-filter" placeholder="Chọn quận/huyện phù hợp" autocomplete="off" />
                        </div>
                    </div>
                </section>

                <section class="nanny-filter-group">
                    <div class="nanny-filter-group__head">
                        <span class="material-icons-round">payments</span>
                        <div>
                            <h3>Kinh nghiệm và mức lương</h3>
                            <p>Lọc theo số năm kinh nghiệm, độ tuổi và khoảng lương mong muốn.</p>
                        </div>
                    </div>
                    <div class="nanny-toolbar__filters nanny-toolbar__filters--modal nanny-toolbar__filters--modal-compact">
                        <div class="nanny-filter-field">
                            <label for="nannyExperience">Kinh nghiệm từ</label>
                            <input id="nannyExperience" type="number" min="0" class="nanny-filter nanny-filter--sm" placeholder="Ví dụ: 3" />
                        </div>
                        <div class="nanny-filter-field">
                            <label for="nannyAgeMin">Tuổi từ</label>
                            <input id="nannyAgeMin" type="number" min="18" class="nanny-filter nanny-filter--sm" placeholder="Ví dụ: 25" />
                        </div>
                        <div class="nanny-filter-field">
                            <label for="nannySalaryMin">Lương từ</label>
                            <input id="nannySalaryMin" type="number" min="0" step="500000" class="nanny-filter nanny-filter--sm" placeholder="Ví dụ: 8000000" />
                        </div>
                        <div class="nanny-filter-field">
                            <label for="nannySalaryMax">Lương đến</label>
                            <input id="nannySalaryMax" type="number" min="0" step="500000" class="nanny-filter nanny-filter--sm" placeholder="Ví dụ: 15000000" />
                        </div>
                    </div>
                </section>

                <section class="nanny-filter-group">
                    <div class="nanny-filter-group__head">
                        <span class="material-icons-round">verified</span>
                        <div>
                            <h3>Kỹ năng và xác minh</h3>
                            <p>Thu hẹp danh sách theo kỹ năng nổi bật và trạng thái xác minh.</p>
                        </div>
                    </div>
                    <div class="nanny-toolbar__filters nanny-toolbar__filters--modal">
                        <div class="nanny-filter-field">
                            <label for="nannySkillText">Kỹ năng</label>
                            <input id="nannySkillText" type="text" class="nanny-filter" placeholder="Tất cả kỹ năng" autocomplete="off" />
                            <select id="nannySkillId" class="nanny-filter nanny-filter--native" tabindex="-1" aria-hidden="true">
                                <option value="">Tất cả kỹ năng</option>
                                @foreach (var skill in Model.SkillOptions)
                                {
                                    <option value="@skill.SkillId">@skill.SkillName</option>
                                }
                            </select>
                        </div>
                        <div class="nanny-filter-field">
                            <label for="nannyVerificationText">Xác minh</label>
                            <input id="nannyVerificationText" type="text" class="nanny-filter" placeholder="Tất cả trạng thái" autocomplete="off" />
                            <select id="nannyVerification" class="nanny-filter nanny-filter--native" tabindex="-1" aria-hidden="true">
                                <option value="">Tất cả trạng thái</option>
                                <option value="2">Đã duyệt</option>
                                <option value="1">Đang chờ</option>
                                <option value="0">Chưa gửi</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="nanny-filter-group">
                    <div class="nanny-filter-group__head">
                        <span class="material-icons-round">calendar_month</span>
                        <div>
                            <h3>Lịch rảnh theo ngày</h3>
                            <p>Chọn một hoặc nhiều khung giờ để lọc nanny có lịch phù hợp.</p>
                        </div>
                    </div>
                    <div id="nannyScheduleFilter" class="nanny-filter-schedule"></div>
                </section>
            </div>
        </div>
        <div class="nanny-filter-modal__footer">
            <button type="button" class="nanny-filter-btn nanny-filter-btn--ghost" onclick="resetNannyFilters()">Đặt lại</button>
            <button type="button" class="nanny-filter-btn nanny-filter-btn--primary" onclick="applyNannyFilters()">Áp dụng bộ lọc</button>
        </div>
    </div>
</div>

<div id="nannyDetailModal" class="nmodal fixed inset-0 z-50 bg-black/50 backdrop-blur-sm items-center justify-center px-4" onclick="if(event.target===this)closeNannyDetail()">
    <div class="nmodal-box nanny-detail-box bg-white rounded-[32px] w-full max-w-4xl shadow-2xl relative">
        <div class="modal-scroll">
            <div class="nanny-detail-close-wrap">
                <button onclick="closeNannyDetail()" class="nanny-detail-close material-icons-round">close</button>
            </div>
            <div class="nanny-detail-header">
                <div class="nanny-detail-hero">
                    <img id="nd-avatar" src="/img/nanny-logo.jpg" alt="Avatar nanny" class="nanny-detail-avatar" />
                    <div class="nanny-detail-hero__content">
                        <div class="nanny-detail-badge" id="nd-verify">Đang cập nhật</div>
                        <h2 id="nd-name">Tên bảo mẫu</h2>
                        <p id="nd-location">Khu vực hoạt động</p>
                        <div class="nanny-detail-chips">
                            <span id="nd-plan" class="nanny-chip hidden"></span>
                            <span id="nd-age" class="nanny-chip">Tuổi</span>
                            <span id="nd-exp" class="nanny-chip">Kinh nghiệm</span>
                            <span id="nd-education" class="nanny-chip">Học vấn</span>
                            <span id="nd-salary" class="nanny-chip nanny-chip--strong">Lương mong muốn</span>
                        </div>
                        <div class="nanny-detail-actions">
                            <button type="button" id="nd-favoriteBtn" class="nanny-detail-favorite hidden" onclick="toggleNannyFavoriteFromDetail(event)">
                                <span class="material-icons-round">favorite_border</span>
                                <span id="nd-favoriteBtnText">Yêu thích</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nanny-detail-grid">
                <section class="nanny-detail-card">
                    <h3>Giới thiệu</h3>
                    <p id="nd-bio" class="nanny-detail-text">Chưa có mô tả.</p>
                </section>

                <section class="nanny-detail-card">
                    <h3>Thông tin liên hệ</h3>
                    <div class="nanny-meta-list">
                        <div><span>Liên hệ</span><strong id="nd-phone">Gửi request contact để kết nối trực tiếp</strong></div>
                        <div><span>Khu vực</span><strong id="nd-address">Chưa cập nhật</strong></div>
                        <div><span>Bán kính di chuyển</span><strong id="nd-travel">Chưa cập nhật</strong></div>
                        <div><span>Độ hoàn thiện hồ sơ</span><strong id="nd-completeness">0%</strong></div>
                    </div>
                </section>

                <section class="nanny-detail-card nanny-detail-card--wide">
                    <h3>Kỹ năng nổi bật</h3>
                    <div id="nd-skills" class="nanny-detail-skill-list"></div>
                </section>

                <section class="nanny-detail-card nanny-detail-card--wide">
                    <h3>Lịch rảnh</h3>
                    <div id="nd-availability" class="nanny-detail-availability"></div>
                </section>
            </div>

            <div class="nanny-detail-bottom-action">
                @if (hasHiringContext)
                {
                    <button type="button" id="nd-contactBtn" class="nanny-detail-view-btn" onclick="nannyHiringContact()">
                        <span class="material-icons-round">chat</span>
                        Lien he Nanny
                    </button>
                    <button type="button" id="nd-hireBtn" class="nanny-detail-view-btn" onclick="nannyHiringHire()">
                        <span class="material-icons-round">handshake</span>
                        Thue Nanny
                    </button>
                }
                <button type="button" id="nd-viewProfileBtn" class="nanny-detail-view-btn" onclick="viewNannyProfileDetail(event)">
                    <span class="material-icons-round">visibility</span>
                    Xem chi tiet ho so Nanny
                </button>
            </div>
        </div>
    </div>
</div>

@if (hasHiringContext)
{
    <partial name="~/Views/Hiring/_HireModal.cshtml" />
}

@section Scripts {
    <script>
        const IS_AUTH = @(isAuthenticated ? "true" : "false");
        const IS_PARENT = @(isParent ? "true" : "false");
        const HIRING_JOB_POSTING_ID = '@Html.Raw(hiringJobPostingId)';
        const HIRING_JOB_APP_ID = '@Html.Raw(hiringJobAppId)';
        const HAS_HIRING_CONTEXT = @(hasHiringContext ? "true" : "false");
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/nanny-list.js" asp-append-version="true"></script>

    <script>
    if (IS_PARENT && IS_AUTH) {
    // ── Recommendation tab (Parent — Nannies for Job) ───────────────
    const EDU_LABELS = ['Trung học','Cao đẳng','Đại học','Thạc sĩ','Khác'];

    function escNRec(v) {
        return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Lưu dữ liệu rec để dùng cho map
    window.recNannies = [];

    function renderRecNannyCard(n, idx) {
        const pct = Math.round((n.finalScore ?? 0) * 100);
        const color = pct >= 80 ? '#16a34a' : pct >= 60 ? '#f97316' : '#6b7280';
        const exp  = n.yearsOfExperience != null ? `<span class="rec-chip rec-chip--distance">${n.yearsOfExperience} năm KN</span>` : '';
        const rating = n.averageRating != null
            ? `<span class="rec-stars"><span class="material-icons-round" style="font-size:13px">star</span>${n.averageRating.toFixed(1)}</span>`
            : '';
        const dist = n.distanceKm != null
            ? `<span class="rec-chip rec-chip--distance"><span class="material-icons-round" style="font-size:11px">near_me</span>${n.distanceKm.toFixed(1)} km</span>`
            : '';
        const badgeCls = `rec-badge rec-badge--${n.matchTier || 'ok'}`;
        const skills = (n.skills || []).slice(0, 4).map(s =>
            `<span class="rec-chip rec-chip--skill">${escNRec(s.skillName ?? s)}</span>`).join('');

        return `
        <div class="rec-card rec-card--clickable" data-rec-idx="${idx}"
             onclick="openNannyDetail('${escNRec(n.nannyProfileId)}')">
            <div class="rec-card-header">
                <div class="rec-score-ring" style="--score-color:${color}">
                    <span class="rec-score-value" style="color:${color}">${pct}%</span>
                </div>
                <div class="rec-card-meta">
                    <h3 class="rec-card-title">${escNRec(n.fullName)}</h3>
                    <p class="rec-card-sub">${rating} ${exp}</p>
                </div>
            </div>
            <div class="rec-card-chips">
                ${dist}
                ${skills}
            </div>
            <div class="rec-card-footer">
                <span class="rec-ai-badge"><span class="material-icons-round" style="font-size:13px">auto_awesome</span>AI Gợi ý</span>
                <span class="${badgeCls}">${escNRec(n.matchLabel || '')}</span>
            </div>
        </div>`;
    }

    function plotRecNannyMarkers(nannies) {
        if (typeof clearNannyMarkers === 'function') clearNannyMarkers();
        if (!window.nannyMap || !window.L) return;
        nannies.forEach((n, idx) => {
            if (!n.latitude || !n.longitude) return;
            const pct = Math.round((n.finalScore ?? 0) * 100);
            const color = pct >= 80 ? '#16a34a' : pct >= 60 ? '#f97316' : '#6b7280';
            const el = document.createElement('div');
            el.className = 'nanny-marker';
            el.innerHTML = `<span style="font-size:11px;font-weight:800;color:${color}">${pct}%</span>`;
            el.style.cssText = `background:#fff;border:2px solid ${color};border-radius:999px;padding:2px 7px;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.15);cursor:pointer`;
            const marker = window.L.marker([n.latitude, n.longitude], {
                icon: window.L.divIcon({ html: el, className: '', iconAnchor: [20, 12] })
            }).addTo(window.nannyMap);
            marker.bindPopup(`<div style="font-size:.82rem;font-weight:700">${n.fullName}</div><div style="font-size:.75rem;color:#64748b">${pct}% phù hợp</div>`);
            const circle = window.L.circle([n.latitude, n.longitude], {
                radius: 600, color: '#fdba74', fillColor: '#fdba74',
                fillOpacity: 0.1, weight: 1
            }).addTo(window.nannyMap);
            window.nannyMarkers.push({ marker, circle, point: { lat: n.latitude, lng: n.longitude, zoom: 14 }, element: el });
        });
        // Fit map to rec markers
        const valid = nannies.filter(n => n.latitude && n.longitude);
        if (valid.length && window.nannyMap) {
            const bounds = window.L.latLngBounds(valid.map(n => [n.latitude, n.longitude]));
            window.suppressNextNannyMapMove = true;
            window.nannyMap.fitBounds(bounds, { padding: [32, 32], maxZoom: 14 });
        }
    }

    function bindRecNannyHover() {
        document.querySelectorAll('.rec-card[data-rec-idx]').forEach(card => {
            const idx = Number(card.dataset.recIdx);
            card.addEventListener('mouseenter', () => {
                if (typeof setNannyMarkerHover === 'function') setNannyMarkerHover(idx, true, true);
            });
            card.addEventListener('mouseleave', () => {
                if (typeof setNannyMarkerHover === 'function') setNannyMarkerHover(idx, false, false);
            });
        });
    }

    function loadRecNannies(jobId) {
        const content = document.getElementById('recNannyContent');
        if (!content) return;
        if (!jobId) {
            if (typeof clearNannyMarkers === 'function') clearNannyMarkers();
            content.innerHTML = `<div class="rec-panel__loading" style="padding:20px">
                <span class="material-icons-round" style="font-size:20px;opacity:.4">arrow_upward</span>Chọn bài đăng để xem gợi ý
            </div>`;
            return;
        }
        content.innerHTML = `<div class="rec-panel__loading">
            <span class="material-icons-round" style="font-size:22px;opacity:.4">hourglass_top</span>Đang tải...
        </div>`;
        fetch(`/Recommendation/NanniesData?jobId=${jobId}&topK=10`)
            .then(r => r.json())
            .then(res => {
                if (res.requiresUpgrade) {
                    if (typeof clearNannyMarkers === 'function') clearNannyMarkers();
                    window.recNannies = [];
                    content.innerHTML = `
                    <div class="rec-upgrade-prompt">
                        <span class="material-icons-round rec-upgrade-icon">auto_awesome</span>
                        <h3 class="rec-upgrade-title">Tính năng dành cho gói Plus / Pro</h3>
                        <p class="rec-upgrade-desc">Nâng cấp để AI tự động gợi ý những bảo mẫu phù hợp nhất với yêu cầu công việc của bạn.</p>
                        <a href="/Subscription" class="rec-upgrade-btn">
                            <span class="material-icons-round">rocket_launch</span>Nâng cấp ngay
                        </a>
                    </div>`;
                    return;
                }
                if (!res.success || !res.data || res.data.length === 0) {
                    if (typeof clearNannyMarkers === 'function') clearNannyMarkers();
                    content.innerHTML = `<div class="rec-panel__empty">
                        <span class="material-icons-round">person_search</span>
                        <p>Chưa tìm được nanny phù hợp cho bài đăng này.</p>
                    </div>`;
                } else {
                    window.recNannies = res.data;
                    content.innerHTML = `<div class="rec-card-list">${res.data.map((n,i) => renderRecNannyCard(n, i)).join('')}</div>`;
                    plotRecNannyMarkers(res.data);
                    bindRecNannyHover();
                }
            })
            .catch(() => {
                content.innerHTML = `<div class="rec-panel__empty">
                    <span class="material-icons-round">wifi_off</span><p>Không tải được gợi ý.</p>
                </div>`;
            });
    }

    function switchNannyTab(tab) {
        const tabAll = document.getElementById('nannyTabAll');
        const tabRec = document.getElementById('nannyTabRec');
        const nannyList = document.getElementById('nannyList');
        const recPanel = document.getElementById('recNannyPanel');
        const cnt = document.getElementById('nannyResultCount');

        if (tab === 'rec') {
            tabAll.classList.remove('active');
            tabRec.classList.add('active');
            nannyList.style.display = 'none';
            if (cnt) cnt.style.display = 'none';
            recPanel.classList.add('active');
            // Re-plot markers nếu đã có data
            if (window.recNannies.length) {
                plotRecNannyMarkers(window.recNannies);
                bindRecNannyHover();
            }
            // Populate job dropdown lần đầu
            const sel = document.getElementById('recJobSelect');
            if (sel && sel.options.length <= 1) {
                fetch('/Search/MyJobs')
                    .then(r => r.json())
                    .then(res => {
                        const active = (res.data || []).filter(j => j.status === 1 && j.moderationStatus === 2);
                        active.forEach(j => {
                            const opt = document.createElement('option');
                            opt.value = j.id;
                            opt.textContent = j.title;
                            sel.appendChild(opt);
                        });
                    })
                    .catch(() => {});
            }
        } else {
            if (tabRec) tabRec.classList.remove('active');
            tabAll.classList.add('active');
            nannyList.style.display = '';
            if (cnt) cnt.style.display = '';
            if (recPanel) recPanel.classList.remove('active');
            // Xoá rec markers, trigger lại search thường
            if (typeof clearNannyMarkers === 'function') clearNannyMarkers();
            if (typeof doNannySearch === 'function') doNannySearch();
        }
    }
    } // end if (IS_PARENT && IS_AUTH)
    </script>
    @if (hasHiringContext)
    {
        <script>
            async function nannyHiringContact() {
                if (!window.currentNannyDetailUserId) return;
                try {
                    const res = await fetch('/Communication/GetOrCreate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ otherUserId: window.currentNannyDetailUserId })
                    });
                    const json = await res.json();
                    if (json?.data?.id) {
                        window.location.href = `/Communication?conversationId=${json.data.id}`;
                        return;
                    }
                } catch {}
                window.location.href = '/Communication';
            }

            function nannyHiringHire() {
                const nannyName = document.getElementById('nd-name')?.textContent || '';
                window.__openHireModal?.(HIRING_JOB_POSTING_ID, HIRING_JOB_APP_ID, nannyName);
            }
        </script>
    }
}
