@model WebSite.Models.Nanny.NannyProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ bảo mẫu";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white py-10 px-4">
    <div class="max-w-3xl mx-auto">
        <div class="mb-6 text-center">
            <span class="section-label">Hồ sơ bảo mẫu</span>
            <h1 class="text-3xl font-bold text-gray-900 mt-3" style="font-family:'Quicksand',sans-serif">
                Bước 2: Kinh nghiệm & kỳ vọng công việc
            </h1>
            <div class="section-divider mt-4 mx-auto"></div>
        </div>

        <div class="bg-white/90 rounded-3xl border border-orange-100 shadow-soft overflow-hidden">
            <div class="h-1 bg-orange-100">
                <div class="h-1 bg-gradient-to-r from-orange-500 to-amber-500" style="width:33%"></div>
            </div>

            <div class="p-8">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <form asp-action="Profile" asp-controller="Nanny" method="post">
                    @Html.AntiForgeryToken()

                    <div class="space-y-5">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Giới thiệu bản thân</label>
                            <textarea asp-for="Bio" rows="4"
                                      class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400"
                                      placeholder="Chia sẻ ngắn gọn về bạn..."></textarea>
                            <span asp-validation-for="Bio" class="text-red-500 text-xs mt-1"></span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Số năm kinh nghiệm</label>
                                <input asp-for="YearsOfExperience" type="number" min="0"
                                       class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400" />
                                <span asp-validation-for="YearsOfExperience" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Trình độ học vấn</label>
                                <select asp-for="EducationLevel"
                                        class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400">
                                    <option value="">-- Chọn trình độ học vấn --</option>
                                    <option value="0">Trung học</option>
                                    <option value="1">Cao đẳng</option>
                                    <option value="2">Đại học</option>
                                    <option value="3">Thạc sĩ</option>
                                    <option value="4">Khác</option>
                                </select>
                                <span asp-validation-for="EducationLevel" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Mức lương tối thiểu</label>
                                <div class="relative">
                                    <input asp-for="ExpectedSalaryMin" type="number" step="1000" min="20000"
                                           class="w-full px-4 py-3 pr-16 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400" />
                                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-500">VND</span>
                                </div>
                                <span asp-validation-for="ExpectedSalaryMin" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Mức lương tối đa</label>
                                <div class="relative">
                                    <input asp-for="ExpectedSalaryMax" type="number" step="1000" max="500000"
                                           class="w-full px-4 py-3 pr-16 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400" />
                                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-500">VND</span>
                                </div>
                                <span asp-validation-for="ExpectedSalaryMax" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>

                        <div id="salaryRangeError" class="hidden text-red-500 text-xs bg-red-50 p-3 rounded-lg border border-red-200"></div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Khoảng cách di chuyển tối đa (km)</label>
                            <input asp-for="MaxTravelDistance" type="number"
                                   class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-orange-400" />
                            <span asp-validation-for="MaxTravelDistance" class="text-red-500 text-xs mt-1"></span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center mt-8">
                        <a href="@Url.Action("Edit", "Profile")"
                           class="px-5 py-2 rounded-full border border-orange-200 text-gray-700 hover:bg-orange-50 text-sm font-semibold">
                            Quay lại
                        </a>
                        <button type="submit"
                                class="px-6 py-2 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-semibold text-sm shadow-md">
                            Tiếp tục
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var form = document.querySelector('form[asp-action="Profile"]') || document.querySelector('form');
    var minEl = document.getElementById('ExpectedSalaryMin');
    var maxEl = document.getElementById('ExpectedSalaryMax');
    var errEl = document.getElementById('salaryRangeError');

    function showErr(msg) {
        if (!errEl) return;
        errEl.textContent = msg || '';
        errEl.classList.toggle('hidden', !msg);
    }

    function validate() {
        var min = minEl && minEl.value ? Number(minEl.value) : null;
        var max = maxEl && maxEl.value ? Number(maxEl.value) : null;

        if (min != null && min <= 20000) return 'Mức lương tối thiểu phải lớn hơn 20000 VND.';
        if (max != null && max >= 500000) return 'Mức lương tối đa phải nhỏ hơn 500000 VND.';
        if (min != null && max != null && max < min) return 'Mức lương tối đa phải lớn hơn hoặc bằng mức tối thiểu.';
        return '';
    }

    if (minEl) minEl.addEventListener('input', function () { showErr(validate()); });
    if (maxEl) maxEl.addEventListener('input', function () { showErr(validate()); });

    if (form) {
        form.addEventListener('submit', function (e) {
            var msg = validate();
            showErr(msg);
            if (msg) e.preventDefault();
        });
    }
})();
</script>
