@model WebSite.Models.Verification.SubmitVerificationRequestViewModel
@{
    ViewData["Title"] = "Gửi yêu cầu xác minh";
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var backUrl = Url.Action("NannyGetVerificationRequestList", "NannyVerificationRequest") ?? "/NannyVerificationRequest/NannyGetVerificationRequestList";
    if (!string.IsNullOrWhiteSpace(returnUrl) && Url.IsLocalUrl(returnUrl))
    {
        backUrl = returnUrl;
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">Gửi yêu cầu xác minh</h1>
            <p class="text-gray-600 dark:text-gray-400">Tách riêng 2 loại yêu cầu: hồ sơ xác minh và giấy khám sức khỏe.</p>
        </div>
        <a href="@backUrl"
           class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 font-medium transition-colors">
            <span class="material-icons-round">arrow_back</span>
            Trở về
        </a>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(300px,360px)_minmax(0,1fr)] gap-8 xl:gap-10 items-start">
        <div class="min-w-0 xl:sticky xl:top-24">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-gray-700/50 p-6 xl:max-w-sm">
                <div class="text-center mb-6">
                    <div class="w-24 h-24 mx-auto bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden mb-4 border-4 border-white dark:border-gray-800 shadow-lg">
                        @if (!string.IsNullOrEmpty(Model.NannyAvatarUrl))
                        {
                            <img src="@Model.NannyAvatarUrl" alt="Ảnh đại diện" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-gray-400">
                                <span class="material-icons-round text-4xl">person</span>
                            </div>
                        }
                    </div>
                    <h3 class="font-bold text-xl text-gray-900 dark:text-white">@Model.NannyFirstName @Model.NannyLastName</h3>
                    <p class="text-gray-500 text-sm break-all">@Model.NannyEmail</p>
                </div>

                <div class="space-y-4 min-w-0">
                    <div class="rounded-xl bg-gray-50 dark:bg-gray-900/40 p-4">
                        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Số điện thoại</div>
                        <p class="text-gray-900 dark:text-gray-200 font-medium break-words">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cung cấp" : Model.PhoneNumber)</p>
                    </div>
                    <div class="rounded-xl bg-gray-50 dark:bg-gray-900/40 p-4">
                        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Khu vực làm việc</div>
                        <p class="text-gray-900 dark:text-gray-200 font-medium break-words">@(string.IsNullOrEmpty(Model.NannyCity) ? "Chưa cập nhật" : Model.NannyCity)</p>
                    </div>
                    <div class="rounded-xl bg-gray-50 dark:bg-gray-900/40 p-4">
                        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Địa chỉ</div>
                        <p class="text-gray-900 dark:text-gray-200 font-medium break-words">@(string.IsNullOrEmpty(Model.NannyAddress) ? "Chưa cập nhật" : Model.NannyAddress)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="min-w-0">
            <form asp-action="NannySubmitProfileVerificationRequest" method="post" enctype="multipart/form-data" class="w-full flex flex-col gap-6 bg-white dark:bg-gray-800 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-gray-700/50 p-6 sm:p-8 lg:p-10">
                @Html.AntiForgeryToken()
                <ul class="nav nav-tabs mb-2 flex flex-wrap gap-2 border-b-0" id="verificationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button"
                                class="nav-link active px-4 py-2 rounded-xl border border-orange-200 bg-orange-100 text-orange-700 font-semibold"
                                data-target="verification-profile-panel"
                                aria-selected="true">
                            Hồ sơ xác minh
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button"
                                class="nav-link px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-600 font-semibold"
                                data-target="health-certificate-panel"
                                aria-selected="false">
                            Giấy khám sức khỏe
                        </button>
                    </li>
                </ul>

                <div id="verification-profile-panel" class="tab-panel space-y-6">

                <div class="rounded-2xl border border-orange-200 dark:border-gray-700 bg-orange-50/60 dark:bg-gray-900/30 p-5 sm:p-6" style="order:1;">
                    <div class="flex items-start gap-3">
                        <span class="material-icons-round text-orange-500 text-2xl">badge</span>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white"> Tải lên căn cước công dân <span class="text-red-500">*</span></h3>
                            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Tải ảnh hoặc file PDF rõ nét của căn cước công dân. Bạn có thể chọn nhiều file nếu cần mặt trước và mặt sau.</p>
                        </div>
                    </div>
                    <div class="mt-4 relative border-2 border-dashed border-orange-200 dark:border-gray-600 rounded-xl bg-white/70 dark:bg-gray-700/30 p-8 sm:p-10 text-center hover:bg-orange-50 dark:hover:bg-gray-700 transition-colors group cursor-pointer"
                         onclick="document.getElementById('IdentityCardFiles').click()">
                        <input asp-for="IdentityCardFiles" id="IdentityCardFiles" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" class="hidden"
                               onchange="handleFileSelect('IdentityCardFiles', 'identityCardPreview', 'identityCardError', event)" />
                        <span class="material-icons-round text-4xl text-orange-400 dark:text-gray-400 group-hover:scale-110 transition-transform mb-3 block">cloud_upload</span>
                        <p class="font-semibold text-gray-700 dark:text-gray-300">Nhấn để chọn file CCCD</p>
                        <p class="text-xs text-gray-500 mt-2">Chỉ nhận file ảnh JPG, JPEG, PNG, WEBP hoặc PDF. Tối đa 5MB mỗi file.</p>
                    </div>
                    <span asp-validation-for="IdentityCardFiles" class="mt-3 block text-sm text-red-600"></span>
                    <p id="identityCardError" class="mt-2 text-sm text-red-600 hidden"></p>
                    <div id="identityCardPreview" class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
                </div>

                <div class="rounded-2xl border border-orange-200 dark:border-gray-700 bg-orange-50/60 dark:bg-gray-900/30 p-5 sm:p-6" style="order:3;">
                    <div class="flex items-start gap-3">
                        <span class="material-icons-round text-orange-500 text-2xl">school</span>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white"> Tải lên bằng cấp và chứng chỉ <span class="text-gray-400 text-base">(Tùy chọn)</span></h3>
                            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Mục này không bắt buộc. Nếu có, bạn có thể tải lên ảnh hoặc file PDF bằng cấp/chứng chỉ để hồ sơ đầy đủ hơn.</p>
                        </div>
                    </div>
                    <div class="mt-4 relative border-2 border-dashed border-orange-200 dark:border-gray-600 rounded-xl bg-white/70 dark:bg-gray-700/30 p-8 sm:p-10 text-center hover:bg-orange-50 dark:hover:bg-gray-700 transition-colors group cursor-pointer"
                         onclick="document.getElementById('CertificateFiles').click()">
                        <input asp-for="CertificateFiles" id="CertificateFiles" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" class="hidden"
                               onchange="handleFileSelect('CertificateFiles', 'certificatePreview', 'certificateError', event)" />
                        <span class="material-icons-round text-4xl text-orange-400 dark:text-gray-400 group-hover:scale-110 transition-transform mb-3 block">workspace_premium</span>
                        <p class="font-semibold text-gray-700 dark:text-gray-300">Nhấn để chọn file bằng cấp, chứng chỉ</p>
                        <p class="text-xs text-gray-500 mt-2">Chỉ nhận file ảnh JPG, JPEG, PNG, WEBP hoặc PDF. Tối đa 5MB mỗi file.</p>
                    </div>
                    <span asp-validation-for="CertificateFiles" class="mt-3 block text-sm text-red-600"></span>
                    <p id="certificateError" class="mt-2 text-sm text-red-600 hidden"></p>
                    <div id="certificatePreview" class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
                </div>

                <div class="pt-4 flex justify-end" style="order:4;">
                    <button type="submit"
                            formaction="@Url.Action("NannySubmitProfileVerificationRequest", "NannyVerificationRequest")"
                            class="bg-gradient-to-r from-orange-500 to-orange-600 text-white font-bold px-8 py-3.5 rounded-xl shadow-lg shadow-orange-500/30 hover:shadow-orange-500/50 hover:-translate-y-0.5 transition-all text-sm w-full sm:w-auto">
                        Gửi yêu cầu hồ sơ xác minh
                    </button>
                </div>

                </div>

                <div id="health-certificate-panel" class="tab-panel hidden">
                <div class="rounded-2xl border border-orange-200 dark:border-gray-700 bg-orange-50/60 dark:bg-gray-900/30 p-5 sm:p-6" style="order:2;">
                    <div class="flex items-start gap-3">
                        <span class="material-icons-round text-orange-500 text-2xl">medical_services</span>
                        <div class="min-w-0 flex-1">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white"> Tải lên giấy khám sức khỏe <span class="text-red-500">*</span></h3>
                            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Đây là tài liệu bắt buộc. Hệ thống chấp nhận ảnh hoặc file PDF rõ nét, tối đa 5MB mỗi file.</p>
                        </div>
                    </div>
                    <div class="mt-4 relative border-2 border-dashed border-orange-200 dark:border-gray-600 rounded-xl bg-white/70 dark:bg-gray-700/30 p-8 sm:p-10 text-center hover:bg-orange-50 dark:hover:bg-gray-700 transition-colors group cursor-pointer"
                         onclick="document.getElementById('HealthCertificateFiles').click()">
                        <input asp-for="HealthCertificateFiles" id="HealthCertificateFiles" multiple accept=".jpg,.jpeg,.png,.webp,.pdf" class="hidden"
                               onchange="handleFileSelect('HealthCertificateFiles', 'healthCertificatePreview', 'healthCertificateError', event)" />
                        <span class="material-icons-round text-4xl text-orange-400 dark:text-gray-400 group-hover:scale-110 transition-transform mb-3 block">health_and_safety</span>
                        <p class="font-semibold text-gray-700 dark:text-gray-300">Nhấn để chọn file giấy khám sức khỏe</p>
                        <p class="text-xs text-gray-500 mt-2">Chỉ nhận file ảnh JPG, JPEG, PNG, WEBP hoặc PDF. Tối đa 5MB mỗi file.</p>
                    </div>
                    <span asp-validation-for="HealthCertificateFiles" class="mt-3 block text-sm text-red-600"></span>
                    <p id="healthCertificateError" class="mt-2 text-sm text-red-600 hidden"></p>
                    <div id="healthCertificatePreview" class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
                </div>

                <div class="rounded-2xl border border-orange-200 dark:border-gray-700 bg-orange-50/60 dark:bg-gray-900/30 p-5 sm:p-6">
                    <label asp-for="HealthCertificateExpiryDate" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                        Ngày hết hạn giấy khám sức khỏe <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="HealthCertificateExpiryDate"
                           type="date"
                           class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-100" />
                    <span asp-validation-for="HealthCertificateExpiryDate" class="mt-2 block text-sm text-red-600"></span>
                </div>

                <div class="pt-4 flex justify-end">
                    <button type="submit"
                            formaction="@Url.Action("NannySubmitHealthCertificateRequest", "NannyVerificationRequest")"
                            class="bg-gradient-to-r from-orange-500 to-orange-600 text-white font-bold px-8 py-3.5 rounded-xl shadow-lg shadow-orange-500/30 hover:shadow-orange-500/50 hover:-translate-y-0.5 transition-all text-sm w-full sm:w-auto">
                        Gửi yêu cầu giấy khám sức khỏe
                    </button>
                </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const validationErrors = [
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(message => !string.IsNullOrWhiteSpace(message)).Distinct())
                {
                    @: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)),
                }
            ];

            if (validationErrors.length > 0 && typeof window.showToast === 'function') {
                window.showToast(validationErrors[0], { type: 'error' });
            }
        })();

        (() => {
            const tabButtons = Array.from(document.querySelectorAll("#verificationTabs .nav-link"));
            const tabPanels = Array.from(document.querySelectorAll(".tab-panel"));

            if (tabButtons.length === 0 || tabPanels.length === 0) {
                return;
            }

            const setActiveTab = (targetId) => {
                tabPanels.forEach((panel) => {
                    panel.classList.toggle("hidden", panel.id !== targetId);
                });

                tabButtons.forEach((button) => {
                    const isActive = button.dataset.target === targetId;
                    button.classList.toggle("active", isActive);
                    button.classList.toggle("border-orange-200", isActive);
                    button.classList.toggle("bg-orange-100", isActive);
                    button.classList.toggle("text-orange-700", isActive);
                    button.classList.toggle("border-gray-200", !isActive);
                    button.classList.toggle("bg-white", !isActive);
                    button.classList.toggle("text-gray-600", !isActive);
                    button.setAttribute("aria-selected", isActive ? "true" : "false");
                });
            };

            tabButtons.forEach((button) => {
                button.addEventListener("click", () => setActiveTab(button.dataset.target));
            });

            const tabParam = new URLSearchParams(window.location.search).get("tab");
            const availableTabTargets = new Set(tabButtons.map((button) => button.dataset.target));
            const defaultTab = availableTabTargets.has(tabParam) ? tabParam : "verification-profile-panel";
            setActiveTab(defaultTab);
        })();

        const store = {
            IdentityCardFiles: new DataTransfer(),
            CertificateFiles: new DataTransfer(),
            HealthCertificateFiles: new DataTransfer()
        };

        const allowedExtensions = [".jpg", ".jpeg", ".png", ".webp", ".pdf"];
        const maxFileSize = 5 * 1024 * 1024;

        function showError(errorId, message) {
            const errorElement = document.getElementById(errorId);
            if (!errorElement) {
                return;
            }

            if (message) {
                errorElement.textContent = message;
                errorElement.classList.remove("hidden");
                return;
            }

            errorElement.textContent = "";
            errorElement.classList.add("hidden");
        }

        function removeFile(inputId, index, previewId) {
            const originalDt = store[inputId];
            const newDt = new DataTransfer();

            for (let i = 0; i < originalDt.files.length; i++) {
                if (i !== index) {
                    newDt.items.add(originalDt.files[i]);
                }
            }

            store[inputId] = newDt;
            document.getElementById(inputId).files = newDt.files;
            renderPreviews(inputId, previewId);
        }

        function renderPreviews(inputId, previewId) {
            const previewContainer = document.getElementById(previewId);
            previewContainer.innerHTML = "";
            const files = store[inputId].files;

            Array.from(files).forEach((file, index) => {
                const isPdf = (file.name || "").toLowerCase().endsWith(".pdf");

                if (isPdf) {
                    const div = document.createElement("div");
                    div.className = "relative aspect-square rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 shadow-sm group bg-red-50 dark:bg-gray-800/60";
                    div.innerHTML = `
                        <div class="w-full h-full flex flex-col items-center justify-center p-3 text-center">
                            <span class="material-icons-round text-4xl text-red-500 mb-2">picture_as_pdf</span>
                            <span class="text-xs font-semibold text-gray-700 dark:text-gray-200 break-all line-clamp-3" title="${file.name}">${file.name}</span>
                        </div>
                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center p-2">
                            <span class="text-white text-xs font-semibold text-center break-all mb-2 line-clamp-2" title="${file.name}">${file.name}</span>
                            <button type="button" onclick="event.stopPropagation(); removeFile('${inputId}', ${index}, '${previewId}')" class="bg-red-500 hover:bg-red-600 text-white rounded-full p-1.5 transition-colors shadow flex items-center justify-center">
                                <span class="material-icons-round text-sm block leading-none">delete</span>
                            </button>
                        </div>
                    `;
                    previewContainer.appendChild(div);
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    const div = document.createElement("div");
                    div.className = "relative aspect-square rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 shadow-sm group";
                    div.innerHTML = `
                        <img src="${e.target.result}" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center p-2">
                            <span class="text-white text-xs font-semibold text-center break-all mb-2 line-clamp-2" title="${file.name}">${file.name}</span>
                            <button type="button" onclick="event.stopPropagation(); removeFile('${inputId}', ${index}, '${previewId}')" class="bg-red-500 hover:bg-red-600 text-white rounded-full p-1.5 transition-colors shadow flex items-center justify-center">
                                <span class="material-icons-round text-sm block leading-none">delete</span>
                            </button>
                        </div>
                    `;
                    previewContainer.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        }

        function validateFile(file) {
            const lowerName = (file.name || "").toLowerCase();
            const isValidExtension = allowedExtensions.some(extension => lowerName.endsWith(extension));
            const isSupportedContentType = !file.type
                || file.type.startsWith("image/")
                || file.type === "application/pdf";

            if (!isValidExtension || !isSupportedContentType) {
                return "Bạn phải tải lên tệp định dạng ảnh hoặc PDF.";
            }

            if (file.size > maxFileSize) {
                return "Bạn chỉ được tải lên tệp có dung lượng tối đa 5MB.";
            }

            return "";
        }

        function handleFileSelect(inputId, previewId, errorId, event) {
            showError(errorId, "");

            const input = event.target;
            const newFiles = Array.from(input.files || []);
            if (newFiles.length === 0) {
                return;
            }

            const errorMessages = [];

            for (const file of newFiles) {
                const validationMessage = validateFile(file);
                if (validationMessage) {
                    if (!errorMessages.includes(validationMessage)) {
                        errorMessages.push(validationMessage);
                    }
                    continue;
                }

                store[inputId].items.add(file);
            }

            input.files = store[inputId].files;
            renderPreviews(inputId, previewId);

            if (errorMessages.length > 0) {
                showError(errorId, errorMessages[0]);
            }
        }
    </script>
}
