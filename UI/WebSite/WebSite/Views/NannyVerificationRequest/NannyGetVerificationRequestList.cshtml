@model WebSite.Models.Verification.VerificationRequestListResponse
@{
    ViewData["Title"] = "Verification Requests";

    var currentStatus = ViewBag.Status as int?;
    var currentPage = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var items = Model?.Items ?? new List<WebSite.Models.Verification.VerificationRequestListDto>();
}

@section Head {
    <link href="~/css/moderator.css" rel="stylesheet" />
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
        <div>
            <span class="section-label">Verification History</span>
            <h1 class="page-title mt-2">
                My <span class="gradient-text">Verification Requests</span>
            </h1>
            <p class="page-subtitle">Track every submission, review status, and moderator feedback in one place.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="badge badge-pending px-3 py-1.5">@(Model?.TotalCount ?? 0) Total</span>
            <a href="@Url.Action("NannySubmitVerificationRequest", "NannyVerificationRequest")" class="btn-primary flex items-center gap-2">
                <span class="material-icons-round text-base">upload_file</span>
                New Request
            </a>
        </div>
    </div>

    <form method="get" action="@Url.Action("NannyGetVerificationRequestList", "NannyVerificationRequest")" id="filterForm">
        <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
            <div class="flex flex-col md:flex-row gap-3 md:items-center">
                <div class="relative md:w-60">
                    <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                    <select name="status"
                            onchange="this.form.submit()"
                            class="search-input w-full !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                        <option value="">All Statuses</option>
                        <option value="1" selected="@(currentStatus == 1 ? "selected" : null)">Pending</option>
                        <option value="2" selected="@(currentStatus == 2 ? "selected" : null)">Approved</option>
                        <option value="3" selected="@(currentStatus == 3 ? "selected" : null)">Rejected</option>
                    </select>
                </div>
            </div>
        </div>
    </form>

    <div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
        <div class="card-header">
            <span class="text-sm text-gray-500">
                Showing <span class="font-bold text-gray-800">@items.Count</span>
                of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> request(s)
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full mod-table">
                <thead>
                    <tr>
                        <th class="text-left">#</th>
                        <th class="text-left">Submitted</th>
                        <th class="text-left">Status</th>
                        <th class="text-left">Reviewed By</th>
                        <th class="text-left">Reviewed At</th>
                        <th class="text-left">Feedback</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-16 text-gray-400">
                                <span class="material-icons-round text-5xl mb-3 block text-gray-200">verified_user</span>
                                <p class="font-semibold text-gray-400">No verification requests found.</p>
                                <p class="text-xs text-gray-300 mt-1">Try another status filter or submit a new request.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowNumber = ((currentPage - 1) * (Model?.PageSize ?? 3)) + 1;
                        foreach (var item in items)
                        {
                            <tr class="account-row">
                                <td class="text-gray-300 text-xs font-mono">@rowNumber</td>
                                <td>
                                    <div class="flex flex-col">
                                        <span class="font-semibold text-gray-800">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        <span class="text-xs text-gray-400">@item.CreatedAt.ToString("HH:mm")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @item.StatusClass">@item.StatusLabel</span>
                                </td>
                                <td class="text-gray-500 text-sm">
                                    @(!string.IsNullOrWhiteSpace(item.ReviewedByName) ? item.ReviewedByName : "-")
                                </td>
                                <td class="text-gray-500 text-sm">
                                    @(item.ReviewedAt.HasValue ? item.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>
                                <td class="text-gray-500 text-sm max-w-xs">
                                    <span class="line-clamp-2 break-words">
                                        @(!string.IsNullOrWhiteSpace(item.RejectionReason) ? item.RejectionReason : "-")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("NannyViewVerificationRequestDetail", "NannyVerificationRequest", new { id = item.Id })"
                                       class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-orange-50 text-orange-600 border border-orange-200 hover:bg-orange-100 transition-all"
                                       title="View detail">
                                        <span class="material-icons-round text-sm">visibility</span>
                                    </a>
                                </td>
                            </tr>

                            rowNumber++;
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
            <span class="text-sm text-gray-400">
                Page <span class="font-bold text-gray-600">@currentPage</span>
                of <span class="font-bold text-gray-600">@totalPages</span>
            </span>
            <div class="flex gap-1.5">
                @if (currentPage > 1)
                {
                    <a href="?status=@currentStatus&page=@(currentPage - 1)" class="page-btn">
                        <span class="material-icons-round text-sm">chevron_left</span>
                    </a>
                }
                else
                {
                    <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                        <span class="material-icons-round text-sm">chevron_left</span>
                    </button>
                }

                @for (int pageNumber = Math.Max(1, currentPage - 2); pageNumber <= Math.Min(totalPages, currentPage + 2); pageNumber++)
                {
                    <a href="?status=@currentStatus&page=@pageNumber"
                       class="page-btn @(pageNumber == currentPage ? "active" : "")">
                        @pageNumber
                    </a>
                }

                @if (currentPage < totalPages)
                {
                    <a href="?status=@currentStatus&page=@(currentPage + 1)" class="page-btn">
                        <span class="material-icons-round text-sm">chevron_right</span>
                    </a>
                }
                else
                {
                    <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                        <span class="material-icons-round text-sm">chevron_right</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>
