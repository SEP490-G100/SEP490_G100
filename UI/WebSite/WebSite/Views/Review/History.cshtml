@model WebSite.Models.Review.ReviewHistoryViewModel
@{
    ViewData["Title"] = "Đánh giá của tôi";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto px-4 py-10">

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Đánh giá của tôi</h1>
            <p class="text-gray-500 text-sm mt-1">Quản lý đánh giá bảo mẫu của bạn</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 flex items-center gap-3 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium">@TempData["Success"]</span>
        </div>
    }

    @* Tabs *@
    <div class="flex gap-2 mb-6 border-b border-gray-200">
        <button id="tabPending" onclick="switchTab('pending')"
                class="tab-btn px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors">
            Chờ đánh giá
            @if (Model.Reviewable.Any())
            {
                <span class="ml-1.5 bg-orange-100 text-orange-600 text-xs font-bold px-2 py-0.5 rounded-full">@Model.Reviewable.Count</span>
            }
        </button>
        <button id="tabDone" onclick="switchTab('done')"
                class="tab-btn px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors">
            Đã đánh giá
            @if (Model.Submitted.Any())
            {
                <span class="ml-1.5 bg-gray-100 text-gray-500 text-xs font-bold px-2 py-0.5 rounded-full">@Model.Submitted.Count</span>
            }
        </button>
    </div>

    @* Tab: Chờ đánh giá *@
    <div id="panelPending">
        @if (!Model.Reviewable.Any())
        {
            <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
                <div class="w-14 h-14 bg-orange-50 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-icons-round text-orange-300 text-2xl">star_border</span>
                </div>
                <p class="text-gray-600 font-medium">Không có hợp đồng nào cần đánh giá</p>
                <p class="text-gray-400 text-sm mt-1">Các hợp đồng đã hoàn thành sẽ hiện ở đây</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var record in Model.Reviewable)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex items-center gap-4 hover:shadow-md transition-shadow">
                        @if (!string.IsNullOrEmpty(record.NannyAvatarUrl))
                        {
                            <img src="@record.NannyAvatarUrl" alt="@record.NannyName"
                                 class="w-14 h-14 rounded-full object-cover flex-shrink-0 ring-2 ring-gray-100" />
                        }
                        else
                        {
                            <div class="w-14 h-14 rounded-full bg-rose-100 text-rose-500 flex items-center justify-center text-xl font-bold flex-shrink-0">
                                @record.NannyName.FirstOrDefault()
                            </div>
                        }
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-gray-800">@record.NannyName</p>
                            <p class="text-sm text-gray-400 mt-0.5">
                                @record.StartDate.ToString("dd/MM/yyyy")
                                @if (record.EndDate.HasValue)
                                {
                                    <span> – @record.EndDate.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </p>
                            <span class="inline-block mt-1 text-xs bg-green-100 text-green-600 px-2 py-0.5 rounded-full font-medium">Hoàn thành</span>
                        </div>
                        <a href="/Review/Create?hiringRecordId=@record.HiringRecordId"
                           class="flex-shrink-0 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors"
                           style="background: linear-gradient(135deg, #f97316, #ea580c);">
                            Đánh giá
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    @* Tab: Đã đánh giá *@
    <div id="panelDone" class="hidden">
        @if (!Model.Submitted.Any())
        {
            <div class="text-center py-16 bg-white rounded-2xl border border-gray-100">
                <div class="w-14 h-14 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-icons-round text-gray-300 text-2xl">rate_review</span>
                </div>
                <p class="text-gray-600 font-medium">Bạn chưa gửi đánh giá nào</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var r in Model.Submitted)
                {
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex items-start gap-4">
                        @if (!string.IsNullOrEmpty(r.NannyAvatarUrl))
                        {
                            <img src="@r.NannyAvatarUrl" alt="@r.NannyName"
                                 class="w-12 h-12 rounded-full object-cover flex-shrink-0 ring-2 ring-gray-100" />
                        }
                        else
                        {
                            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center text-lg font-bold flex-shrink-0">
                                @r.NannyName.FirstOrDefault()
                            </div>
                        }
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-2">
                                <p class="font-semibold text-gray-800">@r.NannyName</p>
                                <span class="text-xs text-gray-400 flex-shrink-0">@r.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="text-orange-400 text-base mt-0.5">@r.Stars</div>
                            @if (!string.IsNullOrWhiteSpace(r.Comment))
                            {
                                <p class="text-sm text-gray-600 mt-1">@r.Comment</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
    const tabPending = document.getElementById('tabPending');
    const tabDone    = document.getElementById('tabDone');
    const panelPending = document.getElementById('panelPending');
    const panelDone    = document.getElementById('panelDone');

    function switchTab(tab) {
        const isPending = tab === 'pending';
        tabPending.classList.toggle('border-orange-500', isPending);
        tabPending.classList.toggle('text-orange-600', isPending);
        tabPending.classList.toggle('border-transparent', !isPending);
        tabPending.classList.toggle('text-gray-500', !isPending);
        tabDone.classList.toggle('border-orange-500', !isPending);
        tabDone.classList.toggle('text-orange-600', !isPending);
        tabDone.classList.toggle('border-transparent', isPending);
        tabDone.classList.toggle('text-gray-500', isPending);
        panelPending.classList.toggle('hidden', !isPending);
        panelDone.classList.toggle('hidden', isPending);
    }

    // Khởi tạo tab
    switchTab('@(TempData["Success"] != null ? "done" : "pending")');
</script>
