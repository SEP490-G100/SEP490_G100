@model WebSite.Models.Review.CreateReviewViewModel
@{
    ViewData["Title"] = "Đánh giá bảo mẫu";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto px-4 py-10">

    @* Breadcrumb *@
    <nav class="text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-rose-500">Trang chủ</a>
        <span class="mx-2">/</span>
        <a href="/Review/History" class="hover:text-rose-500">Đánh giá của tôi</a>
        <span class="mx-2">/</span>
        <span class="text-gray-800">Viết đánh giá</span>
    </nav>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">

        <h1 class="text-2xl font-bold text-gray-800 mb-6">Đánh giá bảo mẫu</h1>

        @* Nanny Info Card *@
        <div class="flex items-center gap-4 p-4 bg-rose-50 rounded-xl mb-8">
            @if (!string.IsNullOrEmpty(Model.NannyAvatarUrl))
            {
                <img src="@Model.NannyAvatarUrl" alt="@Model.NannyName"
                     class="w-14 h-14 rounded-full object-cover ring-2 ring-rose-200" />
            }
            else
            {
                <div class="w-14 h-14 rounded-full bg-rose-200 flex items-center justify-center text-rose-600 text-xl font-bold">
                    @Model.NannyName.FirstOrDefault()
                </div>
            }
            <div>
                <p class="font-semibold text-gray-800 text-lg">@Model.NannyName</p>
                <p class="text-sm text-gray-500">
                    @Model.StartDate.ToString("dd/MM/yyyy")
                    @if (Model.EndDate.HasValue)
                    {
                        <span> – @Model.EndDate.Value.ToString("dd/MM/yyyy")</span>
                    }
                </p>
            </div>
        </div>

        @* Form *@
        <form asp-action="Create" method="post">
            @* Lỗi chung từ server (vd: đã đánh giá rồi, hết token, ...) *@
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] is { } rootState && rootState.Errors.Count > 0)
            {
                <div class="mb-4 rounded-xl border px-4 py-3 text-sm font-medium"
                     style="background:#fef2f2; border-color:#fecaca; color:#b91c1c;">
                    @rootState.Errors[0].ErrorMessage
                </div>
            }
            <input type="hidden" asp-for="HiringRecordId" />
            <input type="hidden" asp-for="NannyName" />
            <input type="hidden" asp-for="NannyAvatarUrl" />
            <input type="hidden" asp-for="StartDate" />
            <input type="hidden" asp-for="EndDate" />
            @Html.AntiForgeryToken()

            @* Star Rating *@
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-3">
                    Đánh giá tổng thể <span class="text-rose-500">*</span>
                </label>
                <div class="flex gap-2" id="star-container">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <button type="button"
                                class="star-btn text-4xl text-gray-300 transition-colors duration-150 hover:text-yellow-400 focus:outline-none"
                                data-value="@i"
                                aria-label="@i sao">★</button>
                    }
                </div>
                <input type="hidden" asp-for="Rating" id="rating-input" />
                <span asp-validation-for="Rating" class="text-sm text-red-500 mt-1 block"></span>
                <p class="text-sm text-gray-400 mt-2" id="rating-label">Chưa chọn</p>
            </div>

            @* Comment *@
            <div class="mb-6">
                <label asp-for="Comment" class="block text-sm font-medium text-gray-700 mb-2">
                    Nhận xét của bạn
                </label>
                <textarea asp-for="Comment" rows="5"
                          class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-rose-300 resize-none"
                          placeholder="Chia sẻ trải nghiệm của bạn với bảo mẫu này..."></textarea>
                <span asp-validation-for="Comment" class="text-sm text-red-500 mt-1 block"></span>
                <p class="text-xs text-gray-400 mt-1 text-right">
                    <span id="char-count">0</span>/2000 ký tự
                </p>
            </div>

            @* Actions *@
            <div class="flex gap-3">
                <button type="submit"
                        class="flex-1 text-white font-semibold py-3 rounded-xl transition-colors"
                        style="background: linear-gradient(135deg, #f97316, #ea580c);">
                    Gửi đánh giá
                </button>
                <a href="/Review/History"
                   class="px-6 py-3 border border-gray-300 text-gray-600 font-medium rounded-xl hover:bg-gray-50 transition-colors">
                    Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const stars = document.querySelectorAll('.star-btn');
        const ratingInput = document.getElementById('rating-input');
        const ratingLabel = document.getElementById('rating-label');
        const labels = ['', 'Tệ', 'Không tốt', 'Bình thường', 'Tốt', 'Xuất sắc'];

        function setRating(val) {
            ratingInput.value = val;
            ratingLabel.textContent = labels[val] || '';
            stars.forEach((s, idx) => {
                s.classList.toggle('text-yellow-400', idx < val);
                s.classList.toggle('text-gray-300', idx >= val);
            });
        }

        // Khởi tạo nếu đã có giá trị (lỗi validation)
        const initVal = parseInt(ratingInput.value) || 0;
        if (initVal > 0) setRating(initVal);

        stars.forEach(btn => {
            btn.addEventListener('click', () => setRating(parseInt(btn.dataset.value)));
            btn.addEventListener('mouseenter', () => {
                const v = parseInt(btn.dataset.value);
                stars.forEach((s, idx) => {
                    s.classList.toggle('text-yellow-400', idx < v);
                    s.classList.toggle('text-gray-300', idx >= v);
                });
            });
            btn.addEventListener('mouseleave', () => {
                const current = parseInt(ratingInput.value) || 0;
                setRating(current);
            });
        });

        // Char counter
        const textarea = document.querySelector('textarea[name="Comment"]');
        const counter = document.getElementById('char-count');
        textarea.addEventListener('input', () => {
            counter.textContent = textarea.value.length;
        });
    </script>
}
