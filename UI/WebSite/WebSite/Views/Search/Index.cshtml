@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>

@if (User.IsInRole("Nanny"))
{
<script>
// ── Recommendation tab (Nanny) ──────────────────────────────
let recJobsLoaded = false;
let recUpgradeRequired = false;
window.recJobs = [];

function escRecHtml(v) {
    return String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function recSalaryText(min, max, neg) {
    if (neg) return 'Thỏa thuận';
    if (min != null && max != null)
        return `${(min/1e6).toFixed(1).replace(/\.0$/,'')}M – ${(max/1e6).toFixed(1).replace(/\.0$/,'')}M`;
    if (min != null) return `Từ ${(min/1e6).toFixed(1).replace(/\.0$/,'')}M`;
    return 'Thoả thuận';
}

function recScoreColor(pct) {
    if (pct >= 80) return '#16a34a';
    if (pct >= 60) return '#f97316';
    return '#6b7280';
}

function renderRecJobCard(j, idx) {
    const pct = Math.round((j.finalScore ?? 0) * 100);
    const color = recScoreColor(pct);
    const salary = recSalaryText(j.salaryMin, j.salaryMax, j.salaryNegotiable);
    const loc = j.city ? (j.district ? `${j.district}, ${j.city}` : j.city) : '';
    const distChip = j.distanceKm != null
        ? `<span class="rec-chip rec-chip--distance"><span class="material-icons-round" style="font-size:11px">near_me</span>${j.distanceKm.toFixed(1)} km</span>`
        : '';
    const salChip = salary
        ? `<span class="rec-chip rec-chip--salary"><span class="material-icons-round" style="font-size:11px">payments</span>${escRecHtml(salary)}</span>`
        : '';
    const skills = (j.requiredSkills || []).slice(0, 4)
        .map(s => `<span class="rec-chip rec-chip--skill">${escRecHtml(s.skillName ?? s)}</span>`).join('');
    const badgeCls = `rec-badge rec-badge--${j.matchTier || 'ok'}`;

    return `
    <div class="rec-card rec-card--clickable" data-rec-idx="${idx}" onclick="openRecPreview(${idx})">
        <div class="rec-card-header">
            <div class="rec-score-ring" style="--score-color:${color}">
                <span class="rec-score-value" style="color:${color}">${pct}%</span>
            </div>
            <div class="rec-card-meta">
                <h3 class="rec-card-title">${escRecHtml(j.title)}</h3>
                ${loc ? `<p class="rec-card-sub"><span class="material-icons-round" style="font-size:12px;vertical-align:middle">location_on</span> ${escRecHtml(loc)}</p>` : ''}
            </div>
        </div>
        <div class="rec-card-chips">
            ${salChip}${distChip}
        </div>
        ${skills ? `<div class="rec-card__skills" style="margin-top:8px">${skills}</div>` : ''}
        <div class="rec-card-footer">
            <span class="rec-ai-badge"><span class="material-icons-round" style="font-size:13px">auto_awesome</span>AI Gợi ý</span>
            <span class="${badgeCls}">${escRecHtml(j.matchLabel || '')}</span>
        </div>
    </div>`;
}

function openRecPreview(idx) {
    const j = window.recJobs[idx];
    if (!j) return;
    if (typeof openPreview !== 'function') return;
    openPreview({
        id:               j.jobId,
        title:            j.title,
        city:             j.city,
        district:         j.district,
        location:         j.district || j.city || '',
        salaryMin:        j.salaryMin,
        salaryMax:        j.salaryMax,
        salaryNegotiable: j.salaryNegotiable,
        distanceKm:       j.distanceKm,
        skills:           j.requiredSkills || [],
        scheduleSlots:    [],
        parentName:       null,
        jobType:          null,
        status:           null,
        numberOfChildren: null,
        characteristic:   null,
        birthTypeLabel:   null,
        specialNeeds:     null,
        minNannyAge:      null,
        maxNannyAge:      null,
        latitude:         j.latitude ?? null,
        longitude:        j.longitude ?? null,
        description:      j.description ?? null,
        moderationStatus: null,
        moderationNote:   null,
        parentProfileId:  null
    });
    // Fly to job marker on map
    if (typeof highlightOnMap === 'function') highlightOnMap(idx);
}

function plotRecJobMarkers(jobs) {
    if (typeof clearMapMarkers === 'function') clearMapMarkers();
    if (!window.map || !window.L) return;
    jobs.forEach((j, idx) => {
        if (!j.latitude || !j.longitude) return;
        const pct = Math.round((j.finalScore ?? 0) * 100);
        const color = recScoreColor(pct);
        const el = document.createElement('div');
        el.innerHTML = `<span style="font-size:11px;font-weight:800;color:${color}">${pct}%</span>`;
        el.style.cssText = `background:#fff;border:2px solid ${color};border-radius:999px;padding:2px 7px;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.15);cursor:pointer`;
        const marker = window.L.marker([j.latitude, j.longitude], {
            icon: window.L.divIcon({ html: el, className: '', iconAnchor: [20, 12] })
        }).addTo(window.map);
        marker.bindPopup(`<div style="font-size:.82rem;font-weight:700">${escRecHtml(j.title)}</div><div style="font-size:.75rem;color:#64748b">${pct}% phù hợp</div>`);
        const circle = window.L.circle([j.latitude, j.longitude], {
            radius: 600, color: '#fdba74', fillColor: '#fdba74',
            fillOpacity: 0.1, weight: 1
        }).addTo(window.map);
        window.markers.push({ marker, circle, point: { lat: j.latitude, lng: j.longitude, zoom: 14 }, element: el });
    });
    // Fit map to rec markers
    const valid = jobs.filter(j => j.latitude && j.longitude);
    if (valid.length && window.map) {
        const bounds = window.L.latLngBounds(valid.map(j => [j.latitude, j.longitude]));
        window.suppressNextMapSearch = true;
        window.map.fitBounds(bounds, { padding: [32, 32], maxZoom: 14 });
    }
}

function bindRecJobHover() {
    document.querySelectorAll('.rec-card[data-rec-idx]').forEach(card => {
        const idx = Number(card.dataset.recIdx);
        card.addEventListener('mouseenter', () => {
            if (typeof setMarkerHover === 'function') setMarkerHover(idx, true, true);
        });
        card.addEventListener('mouseleave', () => {
            if (typeof setMarkerHover === 'function') setMarkerHover(idx, false, false);
        });
    });
}

function loadRecJobs() {
    if (recJobsLoaded || recUpgradeRequired) return;
    const content = document.getElementById('recJobContent');
    if (!content) return;

    fetch('/Recommendation/JobsData?topK=10')
        .then(r => r.json())
        .then(res => {
            if (res.requiresUpgrade) {
                recUpgradeRequired = true;
                if (typeof clearMapMarkers === 'function') clearMapMarkers();
                content.innerHTML = `
                <div class="rec-upgrade-prompt">
                    <span class="material-icons-round rec-upgrade-icon">auto_awesome</span>
                    <h3 class="rec-upgrade-title">Tính năng dành cho gói trả phí</h3>
                    <p class="rec-upgrade-desc">Nâng cấp để AI tự động gợi ý những công việc phù hợp nhất với hồ sơ của bạn — tiết kiệm thời gian tìm kiếm.</p>
                    <a href="/Subscription" class="rec-upgrade-btn">
                        <span class="material-icons-round">rocket_launch</span>Nâng cấp ngay
                    </a>
                </div>`;
                return;
            }
            if (!res.success || !res.data || res.data.length === 0) {
                if (typeof clearMapMarkers === 'function') clearMapMarkers();
                content.innerHTML = `<div class="rec-panel__empty">
                    <span class="material-icons-round">work_off</span>
                    <p>Chưa có việc phù hợp ngay lúc này.</p>
                    <p style="font-size:.78rem;margin-top:4px">Hãy cập nhật kỹ năng và hồ sơ để nhận gợi ý tốt hơn.</p>
                </div>`;
            } else {
                window.recJobs = res.data;
                content.innerHTML = `<div class="rec-card-list">${res.data.map((j, i) => renderRecJobCard(j, i)).join('')}</div>`;
                plotRecJobMarkers(res.data);
                bindRecJobHover();
            }
            recJobsLoaded = true;
        })
        .catch(() => {
            content.innerHTML = `<div class="rec-panel__empty">
                <span class="material-icons-round">wifi_off</span><p>Không tải được gợi ý.</p>
            </div>`;
        });
}

function switchSearchTab(tab) {
    const tabAll      = document.getElementById('tabAll');
    const tabRec      = document.getElementById('tabRec');
    const jobList     = document.getElementById('jobList');
    const recPanel    = document.getElementById('recJobPanel');
    const resultCount = document.getElementById('resultCount');
    const searchBar   = document.getElementById('searchCity')?.parentElement;

    if (tab === 'rec') {
        tabAll.classList.remove('active');
        tabRec.classList.add('active');
        jobList.style.display = 'none';
        if (resultCount) resultCount.style.display = 'none';
        if (searchBar)   searchBar.style.display = 'none';
        recPanel.classList.add('active');
        // Re-plot nếu đã có data, load lần đầu nếu chưa
        if (recJobsLoaded && window.recJobs.length) {
            plotRecJobMarkers(window.recJobs);
            bindRecJobHover();
        } else {
            loadRecJobs();
        }
    } else {
        tabRec.classList.remove('active');
        tabAll.classList.add('active');
        jobList.style.display = '';
        if (resultCount) resultCount.style.display = '';
        if (searchBar)   searchBar.style.display = '';
        recPanel.classList.remove('active');
        // Xoá rec markers, hiện lại job markers thường
        if (typeof clearMapMarkers === 'function') clearMapMarkers();
        if (typeof fetchJobs === 'function') fetchJobs();
    }
}
</script>
}

<script>
const API_URL = '/Search/Jobs';
const IS_AUTH = @(isAuthenticated ? "true" : "false");
const IS_PARENT = @(isParent ? "true" : "false");
const IS_NANNY = @(isNanny ? "true" : "false");
const CURRENT_USER_NAME = '@userName';

</script>
<script src="~/js/search.js" asp-append-version="true"></script>
}
