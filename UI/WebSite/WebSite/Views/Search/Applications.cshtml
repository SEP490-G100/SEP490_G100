@{
    ViewData["Title"] = "Lịch sử ứng tuyển - NannyMatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <style>
        .app-stat-card {
            position: relative;
            overflow: hidden;
            border-radius: 1.2rem;
            padding: 1rem 1.15rem;
            border: 1px solid #e2e8f0;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.6), 0 10px 24px rgba(15,23,42,.05);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .app-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 28px rgba(15, 23, 42, .08);
        }

        .app-stat-card::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: 999px;
            background: #94a3b8;
        }

        .app-stat-icon {
            position: absolute;
            right: 12px;
            top: 12px;
            font-size: 17px;
            color: #94a3b8;
            opacity: .9;
        }

        .app-stat-card--total {
            border-color: #cbd5e1;
        }

        .app-stat-card--pending {
            border-color: #fed7aa;
            background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
        }

        .app-stat-card--pending::after {
            background: #f59e0b;
        }

        .app-stat-card--withdrawn {
            border-color: #fecaca;
            background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
        }

        .app-stat-card--withdrawn::after {
            background: #f43f5e;
        }

        .app-item-card {
            border-radius: 1.35rem;
            border: 1px solid #e2e8f0;
            background: linear-gradient(180deg, #ffffff 0%, #fffdfa 100%);
            padding: 1.2rem;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .app-item-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 30px rgba(249,115,22,.12);
            border-color: #fdba74;
        }

        .app-item-card--pending {
            border-left: 4px solid #f59e0b;
        }

        .app-item-card--approved {
            border-left: 4px solid #10b981;
        }

        .app-item-card--rejected {
            border-left: 4px solid #f43f5e;
        }

        .app-item-card--withdrawn {
            border-left: 4px solid #94a3b8;
        }

        .app-status-chip {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            padding: .35rem .72rem;
            font-size: .74rem;
            font-weight: 800;
            letter-spacing: .015em;
        }

        .app-status-chip .material-icons-round {
            font-size: .92rem;
        }

        .app-status-chip--pending {
            border-color: #fde68a;
            color: #b45309;
            background: #fffbeb;
        }

        .app-status-chip--approved {
            border-color: #86efac;
            color: #047857;
            background: #ecfdf5;
        }

        .app-status-chip--rejected {
            border-color: #fda4af;
            color: #be123c;
            background: #fff1f2;
        }

        .app-status-chip--withdrawn {
            border-color: #cbd5e1;
            color: #475569;
            background: #f8fafc;
        }

        .app-timeline {
            margin-top: .85rem;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .75rem;
        }

        .app-time-card {
            border-radius: .95rem;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            padding: .72rem .85rem;
        }

        .app-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .28rem;
            min-height: 38px;
            padding: 0 .85rem;
            border-radius: .85rem;
            border: 1px solid #fda4af;
            background: #fff;
            color: #be123c;
            font-size: .74rem;
            font-weight: 800;
            transition: all .2s ease;
        }

        .app-action-btn:hover {
            background: #fff1f2;
        }

        .app-action-btn .material-icons-round {
            font-size: 1rem;
        }

        .app-empty-state {
            border-radius: 1.35rem;
            border: 1px dashed #cbd5e1;
            background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
            padding: 3rem 1.5rem;
            text-align: center;
            color: #64748b;
        }

        .app-empty-state .material-icons-round {
            font-size: 2.15rem;
            color: #cbd5e1;
        }

        .app-skeleton {
            position: relative;
            overflow: hidden;
        }

        .app-skeleton::after {
            content: '';
            position: absolute;
            inset: 0;
            transform: translateX(-100%);
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.65), transparent);
            animation: appShimmer 1.4s infinite;
        }

        .app-skeleton-line {
            height: 12px;
            border-radius: 999px;
            background: #e2e8f0;
        }

        #applicationList {
            transition: opacity .24s ease, transform .24s ease;
        }

        #applicationList.app-list-animating {
            opacity: .55;
            transform: translateY(5px);
        }

        .app-time-label {
            font-size: .67rem;
            text-transform: uppercase;
            letter-spacing: .14em;
            font-weight: 800;
            color: #94a3b8;
        }

        .app-time-value {
            margin-top: .3rem;
            font-size: .82rem;
            font-weight: 700;
            color: #334155;
        }

        @@media (max-width: 900px) {
            .app-timeline {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767px) {
            .app-page {
                padding-top: 1.4rem;
                padding-bottom: 1.9rem;
            }

            .app-page-title {
                font-size: 1.7rem;
                line-height: 1.2;
            }

            .app-header-actions {
                width: 100%;
            }

            .app-header-actions > a {
                width: 100%;
            }

            .app-stat-card {
                padding: .78rem .82rem;
                border-radius: 1rem;
            }

            .app-stat-icon {
                right: 9px;
                top: 9px;
                font-size: 15px;
            }

            #applicationTotalCount,
            #applicationPendingCount,
            #applicationWithdrawnCount {
                font-size: 1.65rem;
                line-height: 1.15;
            }

            .app-item-card {
                padding: .92rem;
                border-radius: 1rem;
            }

            .app-status-chip {
                font-size: .68rem;
                padding: .28rem .58rem;
            }

            .app-time-card {
                padding: .6rem .66rem;
                border-radius: .78rem;
            }

            .app-time-label {
                font-size: .6rem;
                letter-spacing: .11em;
            }

            .app-time-value {
                font-size: .76rem;
            }

            .app-actions {
                width: 100%;
                flex-direction: column;
                align-items: stretch !important;
            }

            .app-actions .app-action-btn {
                width: 100%;
            }
        }

        @@keyframes appShimmer {
            100% {
                transform: translateX(100%);
            }
        }
    </style>
}

<section class="app-page min-h-screen bg-[linear-gradient(180deg,#fffaf5_0%,#ffffff_45%,#fff7ed_100%)] py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-[30px] border border-orange-100 bg-white/90 shadow-[0_24px_60px_rgba(15,23,42,.08)] overflow-hidden">
            <div class="px-6 py-6 sm:px-8 border-b border-orange-100 bg-[radial-gradient(circle_at_top_right,rgba(255,237,213,.85),transparent_28%),linear-gradient(180deg,#ffffff_0%,#fffaf4_100%)]">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-orange-500">Nanny zone</p>
                        <h1 class="app-page-title mt-2 text-3xl font-bold text-slate-900">Lịch sử ứng tuyển</h1>
                        <p class="mt-2 text-sm leading-6 text-slate-500 max-w-2xl">
                            Theo dõi các đơn đã gửi cho Phụ huynh, xem trạng thái và hủy đơn khi đơn đang chờ duyệt.
                        </p>
                    </div>
                    <div class="app-header-actions flex items-center gap-3">
                        <a href="/Search"
                           class="inline-flex items-center justify-center min-h-[48px] px-5 rounded-2xl border border-slate-200 bg-white text-slate-600 font-bold hover:bg-slate-50 transition-all">
                            Quay lại tìm bài
                        </a>
                    </div>
                </div>
            </div>

            <div class="px-6 py-6 sm:px-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="app-stat-card app-stat-card--total">
                        <span class="material-icons-round app-stat-icon">stacked_bar_chart</span>
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Tổng đơn</p>
                        <p id="applicationTotalCount" class="mt-2 text-3xl font-extrabold text-slate-900">0</p>
                    </div>
                    <div class="app-stat-card app-stat-card--pending">
                        <span class="material-icons-round app-stat-icon">hourglass_top</span>
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-500">Đang chờ duyệt</p>
                        <p id="applicationPendingCount" class="mt-2 text-3xl font-extrabold text-amber-700">0</p>
                    </div>
                    <div class="app-stat-card app-stat-card--withdrawn">
                        <span class="material-icons-round app-stat-icon">do_not_disturb_on</span>
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-rose-500">Đã hủy</p>
                        <p id="applicationWithdrawnCount" class="mt-2 text-3xl font-extrabold text-rose-600">0</p>
                    </div>
                </div>

                <div id="applicationList" class="space-y-5">
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
        const listEl = document.getElementById('applicationList');
        const totalEl = document.getElementById('applicationTotalCount');
        const pendingEl = document.getElementById('applicationPendingCount');
        const withdrawnEl = document.getElementById('applicationWithdrawnCount');

        const escapeHtml = (value) => String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');

        const notify = (message, type = 'info') => {
            if (!message) return;
            if (typeof window.showToast === 'function') {
                window.showToast(message, { type });
            }
        };

        const formatDateTime = (value) => {
            if (!value) return 'Chưa cập nhật';
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return 'Chưa cập nhật';
            return new Intl.DateTimeFormat('vi-VN', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }).format(date);
        };

        const formatLocation = (item) => {
            const parts = [item?.location, item?.district, item?.city].filter(Boolean);
            return parts.length ? parts.join(', ') : 'Chưa cập nhật địa điểm';
        };

        const getStatusMeta = (status) => {
            const key = Number(status);
            if (key === 0) {
                return {
                    chipClass: 'app-status-chip--pending',
                    icon: 'schedule',
                    cardClass: 'app-item-card--pending'
                };
            }
            if (key === 1) {
                return {
                    chipClass: 'app-status-chip--approved',
                    icon: 'check_circle',
                    cardClass: 'app-item-card--approved'
                };
            }
            if (key === 2) {
                return {
                    chipClass: 'app-status-chip--rejected',
                    icon: 'cancel',
                    cardClass: 'app-item-card--rejected'
                };
            }
            return {
                chipClass: 'app-status-chip--withdrawn',
                icon: 'block',
                cardClass: 'app-item-card--withdrawn'
            };
        };

        const renderLoadingSkeleton = (count = 3) => {
            listEl.innerHTML = Array.from({ length: count }, () => `
                <article class="app-item-card app-skeleton p-5">
                    <div class="space-y-3">
                        <div class="app-skeleton-line" style="width:66%"></div>
                        <div class="app-skeleton-line" style="width:50%"></div>
                        <div class="app-skeleton-line" style="width:36%"></div>
                    </div>
                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="app-time-card"><div class="app-skeleton-line w-full"></div></div>
                        <div class="app-time-card"><div class="app-skeleton-line w-full"></div></div>
                        <div class="app-time-card"><div class="app-skeleton-line w-full"></div></div>
                    </div>
                </article>
            `).join('');
        };

        async function withdrawApplication(applicationId) {
            if (!applicationId) return;

            const confirmed = window.confirm('Bạn chắc chắn muốn hủy đơn ứng tuyển này?');
            if (!confirmed) return;

            try {
                const response = await fetch(`/Search/WithdrawApplication?applicationId=${encodeURIComponent(applicationId)}`, {
                    method: 'POST',
                    credentials: 'same-origin'
                });
                const json = await response.json();
                if (!json?.success) {
                    notify(json?.message || 'Không thể hủy đơn ứng tuyển.', 'error');
                    return;
                }

                notify(json?.message || 'Đã hủy đơn ứng tuyển.', 'success');
                await loadApplications();
            } catch {
                notify('Lỗi kết nối server.', 'error');
            }
        }

        function renderItems(items) {
            if (!Array.isArray(items) || !items.length) {
                listEl.innerHTML = `
                    <div class="app-empty-state">
                        <span class="material-icons-round text-[34px] text-orange-300">assignment</span>
                        <h3 class="mt-3 text-lg font-bold text-slate-900">Bạn chưa ứng tuyển bài đăng nào</h3>
                        <p class="mt-2 text-sm text-slate-500">Khi bạn apply, lịch sử sẽ hiển thị tại đây.</p>
                    </div>`;
                return;
            }

            listEl.innerHTML = items.map((item) => {
                const statusMeta = getStatusMeta(item.status);
                return `
                    <article class="app-item-card ${statusMeta.cardClass}">
                        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                            <div class="min-w-0">
                                <h2 class="text-lg font-extrabold text-slate-900 break-words">${escapeHtml(item.jobTitle || 'Tin đăng')}</h2>
                                <p class="mt-1 text-sm font-semibold text-slate-500">Phụ huynh: ${escapeHtml(item.parentName || 'Chưa cập nhật')}</p>
                                <p class="mt-2 text-sm font-semibold text-orange-600">${escapeHtml(formatLocation(item))}</p>
                            </div>
                            <div class="app-actions flex flex-wrap items-center gap-2">
                                <span class="app-status-chip ${statusMeta.chipClass}">
                                    <span class="material-icons-round">${statusMeta.icon}</span>
                                    ${escapeHtml(item.statusLabel || 'Đang cập nhật')}
                                </span>
                                ${item.canWithdraw ? `
                                    <button type="button"
                                            onclick="window.__withdrawApplication('${escapeHtml(item.id)}')"
                                            class="app-action-btn">
                                        <span class="material-icons-round">remove_circle</span>
                                        Hủy đơn
                                    </button>` : ''}
                            </div>
                        </div>

                        <div class="app-timeline">
                            <div class="app-time-card">
                                <p class="app-time-label">Ngày gửi đơn</p>
                                <p class="app-time-value">${escapeHtml(formatDateTime(item.appliedAt))}</p>
                            </div>
                            <div class="app-time-card">
                                <p class="app-time-label">Ngày duyệt</p>
                                <p class="app-time-value">${escapeHtml(formatDateTime(item.reviewedAt))}</p>
                            </div>
                            <div class="app-time-card">
                                <p class="app-time-label">Ngày hủy</p>
                                <p class="app-time-value">${escapeHtml(formatDateTime(item.withdrawnAt))}</p>
                            </div>
                        </div>
                    </article>`;
            }).join('');
        }

        async function loadApplications() {
            listEl.classList.add('app-list-animating');
            renderLoadingSkeleton();
            try {
                const response = await fetch('/Search/MyApplicationsData?page=1&pageSize=30', { credentials: 'same-origin' });
                const json = await response.json();

                if (!json?.success) {
                    notify(json?.message || 'Không tải được lịch sử ứng tuyển.', 'error');
                }

                const items = Array.isArray(json?.data) ? json.data : [];
                const total = Number(json?.total ?? items.length);
                const pending = items.filter((item) => Number(item?.status) === 0).length;
                const withdrawn = items.filter((item) => Number(item?.status) === 3).length;

                totalEl.textContent = Number.isFinite(total) ? String(total) : '0';
                pendingEl.textContent = String(pending);
                withdrawnEl.textContent = String(withdrawn);
                renderItems(items);
            } catch {
                listEl.innerHTML = `
                    <div class="rounded-3xl border border-red-100 bg-red-50 px-6 py-10 text-center text-red-600">
                        Không tải được lịch sử ứng tuyển.
                    </div>`;
            } finally {
                window.setTimeout(() => {
                    listEl.classList.remove('app-list-animating');
                }, 70);
            }
        }

        window.__withdrawApplication = withdrawApplication;
        loadApplications();
    })();
</script>
