@{
    ViewData["Title"] = "Chinh sua bai dang - NannyMatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var jobId = (Guid)(ViewBag.JobId ?? Guid.Empty);
    var skillOptions = ViewBag.SkillOptions as IEnumerable<WebSite.Models.Search.JobSkillOption>
        ?? System.Linq.Enumerable.Empty<WebSite.Models.Search.JobSkillOption>();
}

@section Head {
    <link rel="stylesheet" href="~/css/search.css" />
}

<section class="min-h-screen bg-[linear-gradient(180deg,#fffaf5_0%,#ffffff_45%,#fff7ed_100%)] py-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="rounded-[30px] border border-orange-100 bg-white/90 shadow-[0_24px_60px_rgba(15,23,42,.08)] overflow-hidden">
            <div class="px-6 py-6 sm:px-8 border-b border-orange-100 bg-[radial-gradient(circle_at_top_right,rgba(255,237,213,.85),transparent_28%),linear-gradient(180deg,#ffffff_0%,#fffaf4_100%)]">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-orange-500">Cap nhat bai dang</p>
                        <h1 class="mt-2 text-3xl font-bold text-slate-900">Chinh sua bai dang</h1>
                        <p class="mt-2 text-sm leading-6 text-slate-500 max-w-2xl">
                            Khi luu thay doi, bai dang cong khai se quay ve trang thai cho moderator duyet lai.
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="/Search/History"
                           class="inline-flex items-center justify-center min-h-[48px] px-5 rounded-2xl border border-slate-200 bg-white text-slate-600 font-bold hover:bg-slate-50 transition-all">
                            Quay lai lich su
                        </a>
                    </div>
                </div>
            </div>

            <div class="px-6 py-6 sm:px-8">
                <div id="editPageNotice" class="hidden rounded-2xl border px-4 py-3 text-sm font-semibold mb-5"></div>

                <form id="editPageForm" class="space-y-5">
                    <input type="hidden" id="ef-id" value="@jobId" />
                    <input type="hidden" id="ef-status" value="1" />

                    <div class="section-card">
                        <div class="section-heading">
                            <div>
                                <p class="section-title">Thong tin co ban</p>
                                <p class="section-caption">Cap nhat noi dung, luong, dia diem va do tuoi nanny mong muon.</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <label class="form-label">Tieu de bai dang</label>
                                <input type="text" id="ef-title" class="form-input" required />
                            </div>
                            <div class="md:col-span-2">
                                <label class="form-label">Mo ta chi tiet</label>
                                <textarea id="ef-desc" class="form-input resize-none" rows="3" required></textarea>
                            </div>
                            <div>
                                <label class="form-label">Loai cong viec</label>
                                <input type="text" id="ef-typeText" class="form-input form-select-picker-input" autocomplete="off" placeholder="Chon loai cong viec" />
                                <select id="ef-type" class="form-input form-select-native-hidden">
                                    <option value="1">Full-time</option>
                                    <option value="2">Part-time</option>
                                    <option value="3">Qua dem</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label">So tre can cham</label>
                                <input type="number" id="ef-children" class="form-input bg-gray-50" min="1" max="10" readonly />
                            </div>
                            <div>
                                <label class="form-label">Luong toi thieu</label>
                                <input type="text" id="ef-salMin" inputmode="numeric" class="form-input" placeholder="VD: 1.000.000" />
                            </div>
                            <div>
                                <label class="form-label">Luong toi da</label>
                                <input type="text" id="ef-salMax" inputmode="numeric" class="form-input" placeholder="VD: 3.000.000" />
                            </div>
                            <div class="md:col-span-2">
                                <label class="form-label">Tuy chon luong</label>
                                <label class="negotiable-field negotiable-field-large">
                                    <input type="checkbox" id="ef-negotiable" class="rounded accent-orange-500" />
                                    <span class="negotiable-title">Luong thuong luong</span>
                                    <span class="negotiable-caption">Bat neu ban muon trao doi muc luong truc tiep voi nanny.</span>
                                </label>
                            </div>
                            <div class="md:col-span-2">
                                <label class="form-label">Dia chi chi tiet</label>
                                <input type="text" id="ef-location" class="form-input" />
                            </div>
                            <div>
                                <label class="form-label">Thanh pho</label>
                                <input type="text" id="ef-city" class="form-input form-select-picker-input" autocomplete="off" placeholder="Nhap hoac chon thanh pho" />
                            </div>
                            <div>
                                <label class="form-label">Phuong/Xa</label>
                                <input type="text" id="ef-district" class="form-input form-select-picker-input" autocomplete="off" placeholder="Nhap hoac chon phuong/xa" />
                            </div>
                            <div>
                                <label class="form-label">Do tuoi bao mau tu</label>
                                <input type="number" id="ef-minAge" class="form-input" min="18" max="80" />
                            </div>
                            <div>
                                <label class="form-label">Do tuoi bao mau den</label>
                                <input type="number" id="ef-maxAge" class="form-input" min="18" max="80" />
                            </div>
                            <div>
                                <label class="form-label">Trang thai bai dang</label>
                                <div class="status-toggle" id="ef-statusToggle">
                                    <button type="button" class="status-option active" data-status="1">Cong khai</button>
                                    <button type="button" class="status-option" data-status="2">An bai dang</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-card schedule-card">
                        <div class="schedule-header">
                            <div>
                                <p class="section-title">Lich ngay muon tuyen</p>
                                <p class="section-caption">Cap nhat cac buoi can nanny ho tro trong tuan.</p>
                            </div>
                        </div>
                        <div id="ef-schedule" class="schedule-grid"></div>
                    </div>

                    <div class="section-card section-card-soft">
                        <div class="section-heading">
                            <div>
                                <p class="section-title">Thong tin tu profile Parent</p>
                                <p class="section-caption">Chon lai be neu can, he thong se cap nhat thong tin Child Profile tuong ung.</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div class="md:col-span-2">
                                <label class="form-label">Chon tre</label>
                                <input type="text" id="ef-childProfileText" class="form-input form-select-picker-input" autocomplete="off" placeholder="Chon tre" />
                                <select id="ef-childProfileId" class="form-input form-select-native-hidden"></select>
                            </div>
                            <div>
                                <label class="form-label">Dac diem</label>
                                <textarea id="ef-characteristic" class="form-input resize-none bg-white/80" rows="2" readonly></textarea>
                            </div>
                            <div>
                                <label class="form-label">Nhom tuoi cua be</label>
                                <input type="text" id="ef-birthType" class="form-input bg-white/80" readonly />
                            </div>
                            <div class="md:col-span-2">
                                <label class="form-label">Nhu cau dac biet</label>
                                <textarea id="ef-specialNeeds" class="form-input resize-none bg-white/80" rows="2" readonly></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="section-card section-card-plain">
                        <div class="section-heading">
                            <div>
                                <p class="section-title">Ky nang yeu cau</p>
                                <p class="section-caption">Cap nhat bo ky nang bang danh sach skill co san trong he thong.</p>
                            </div>
                        </div>
                        <div class="flex gap-2 items-center">
                            <input type="text" id="ef-skillSelectText" class="form-input form-select-picker-input" autocomplete="off" placeholder="Chon ky nang can yeu cau" />
                            <select id="ef-skillSelect" class="form-input form-select-native-hidden">
                                <option value="">Chon ky nang can yeu cau</option>
                                @foreach (var skill in skillOptions)
                                {
                                    <option value="@skill.SkillName">@skill.SkillName@(string.IsNullOrWhiteSpace(skill.Category) ? "" : $" - {skill.Category}")</option>
                                }
                            </select>
                            <button type="button" id="ef-addSkill" class="icon-pill-btn">
                                <span class="material-icons-round text-base">add</span>
                            </button>
                        </div>
                        <div id="ef-skills" class="flex flex-wrap gap-2 mt-2"></div>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row gap-3">
                        <a href="/Search/History" class="modal-btn modal-btn-secondary flex-1" style="
    align-items: center;
    display: flex;
    justify-content: center;
">
                            <span class="text-center" >Hủy</span>
                        </a>
                        <button type="submit" id="editPageSubmit" class="modal-btn modal-btn-primary flex-1">
                            <span class="modal-btn__content">
                                <span class="modal-btn__spinner" aria-hidden="true"></span>
                                <span class="modal-btn__label">Luu thay doi</span>
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
const JOB_ID = '@jobId';
let editChildren = [];
let editSkills = [];
let editSchedule = [];
const autocompleteDropdowns = new Map();
const selectPickerSyncFns = [];
let initialFormSignature = '';
let hasLoadedEditData = false;
let isSubmittingEdit = false;
let currentModerationStatus = null;
let locationTree = [];
let locationTreePromise = null;

const DAY_LABELS = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
const ROW_LABELS = ['Morning', 'Afternoon', 'Evening', 'Night'];

function escapeHtml(value) {
    return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
}

function showToast(message, type = 'info') {
    if (typeof window.showToast === 'function' && window.showToast !== showToast) {
        window.showToast(message, { type });
        return;
    }

    const fallback = document.createElement('div');
    fallback.style.position = 'fixed';
    fallback.style.right = '16px';
    fallback.style.bottom = '16px';
    fallback.style.zIndex = '12060';
    fallback.style.padding = '10px 12px';
    fallback.style.borderRadius = '10px';
    fallback.style.background = '#0f172a';
    fallback.style.color = '#fff';
    fallback.style.fontSize = '13px';
    fallback.style.fontWeight = '700';
    fallback.textContent = message;
    document.body.appendChild(fallback);
    window.setTimeout(() => fallback.remove(), 2200);
}

function sanitizeMoneyDigits(value) {
    return String(value ?? '').replace(/[^\d]/g, '');
}

function formatMoneyInputValue(value) {
    const digits = sanitizeMoneyDigits(value);
    if (!digits) return '';
    const normalized = digits.replace(/^0+(?=\d)/, '');
    const amount = Number(normalized || '0');
    return Number.isFinite(amount) ? amount.toLocaleString('vi-VN') : '';
}

function parseMoneyInput(value) {
    const digits = sanitizeMoneyDigits(value);
    if (!digits) return null;
    const normalized = digits.replace(/^0+(?=\d)/, '');
    const amount = Number(normalized || '0');
    return Number.isFinite(amount) ? amount : null;
}

function bindMoneyInputFormatting(inputId) {
    const input = document.getElementById(inputId);
    if (!input || input.dataset.moneyReady === 'true') return;

    input.dataset.moneyReady = 'true';
    const applyFormat = () => {
        input.value = formatMoneyInputValue(input.value);
    };

    input.addEventListener('input', applyFormat);
    input.addEventListener('blur', applyFormat);
    applyFormat();
}

function initMoneyInputs() {
    ['ef-salMin', 'ef-salMax'].forEach(bindMoneyInputFormatting);
}

function pushHistoryToast(message, type = 'success') {
    try {
        sessionStorage.setItem('nm:historyToast', JSON.stringify({
            message: String(message || ''),
            type: String(type || 'info'),
            createdAt: Date.now()
        }));
    } catch {
        // Ignore storage errors (private mode/quota), flow still redirects.
    }
}

function redirectToHistory(jobId) {
    window.location.href = `/Search/History?jobId=${encodeURIComponent(jobId)}`;
}

function normalizeText(value) {
    return String(value ?? '').toLowerCase().trim();
}

function normalizeLocationName(value) {
    return String(value ?? '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .toLowerCase()
        .replace(/^thanh pho\s+/i, '')
        .replace(/^tp\.?\s*/i, '')
        .replace(/^tinh\s+/i, '')
        .trim();
}

function findProvinceByName(cityName) {
    const cityKey = normalizeLocationName(cityName);
    if (!cityKey) return null;

    const exact = locationTree.find((province) => normalizeLocationName(province.name) === cityKey);
    if (exact) return exact;

    return locationTree.find((province) => {
        const provinceKey = normalizeLocationName(province.name);
        return provinceKey.includes(cityKey) || cityKey.includes(provinceKey);
    }) || null;
}

function getDistrictNamesByCity(cityName) {
    const province = findProvinceByName(cityName);
    if (!province || !Array.isArray(province.districts)) return [];
    return province.districts
        .map((district) => district?.name)
        .filter((name) => !!name);
}

function uniqueNormalizedValues(values, query) {
    const queryKey = normalizeLocationName(query);
    const seen = new Set();
    return values
        .filter((value) => !!value)
        .filter((value) => !queryKey || normalizeLocationName(value).includes(queryKey))
        .filter((value) => {
            const key = normalizeLocationName(value);
            if (!key || seen.has(key)) return false;
            seen.add(key);
            return true;
        })
        .slice(0, 40);
}

function getCityOptions(query) {
    return uniqueNormalizedValues(
        locationTree.map((province) => province?.name),
        query
    );
}

function getDistrictOptionsByCity(cityName, query) {
    return uniqueNormalizedValues(getDistrictNamesByCity(cityName), query);
}

function renderAutocompleteOptions(prefix, kind, options, onSelect) {
    const dropdown = autocompleteDropdowns.get(getAutocompleteKey(prefix, kind));
    if (!dropdown) return;

    if (!options.length) {
        dropdown.innerHTML = '';
        dropdown.classList.remove('show');
        return;
    }

    dropdown.innerHTML = options
        .map((option) => `<li data-value="${escapeHtml(option)}">${escapeHtml(option)}</li>`)
        .join('');
    dropdown.classList.add('show');

    dropdown.querySelectorAll('li').forEach((item) => {
        item.addEventListener('mousedown', (event) => {
            event.preventDefault();
            onSelect(item.dataset.value || '');
        });
    });
}

function attachAutocomplete(prefix, kind, optionGetter, onSelect) {
    const input = document.getElementById(`${prefix}-${kind}`);
    if (!input || input.dataset.acReady === 'true') return;

    input.dataset.acReady = 'true';
    input.removeAttribute('list');
    input.parentElement?.classList.add('autocomplete-field');

    const dropdown = document.createElement('ul');
    dropdown.className = 'ac-dropdown';
    input.insertAdjacentElement('afterend', dropdown);
    autocompleteDropdowns.set(getAutocompleteKey(prefix, kind), dropdown);

    let requestToken = 0;
    const showForQuery = async () => {
        const token = ++requestToken;
        const query = input.value.trim();
        const options = await Promise.resolve(optionGetter(query));
        if (token !== requestToken) return;

        renderAutocompleteOptions(prefix, kind, options, (value) => {
            input.value = value;
            onSelect(value);
            updateSubmitState();
            hideAutocomplete(prefix, kind);
        });
    };

    input.addEventListener('focus', showForQuery);
    input.addEventListener('input', showForQuery);
    input.addEventListener('blur', () => {
        setTimeout(() => hideAutocomplete(prefix, kind), 120);
    });
}

function attachLocationAutocomplete(prefix) {
    attachAutocomplete(
        prefix,
        'city',
        (query) => getCityOptions(query),
        (value) => {
            const districtInput = document.getElementById(`${prefix}-district`);
            if (districtInput) districtInput.value = '';
            handleLocationCityChange(prefix, value);
        }
    );

    attachAutocomplete(
        prefix,
        'district',
        (query) => {
            const cityValue = document.getElementById(`${prefix}-city`)?.value?.trim() || '';
            return getDistrictOptionsByCity(cityValue, query);
        },
        () => {}
    );
}

function handleLocationCityChange(prefix, explicitCityValue) {
    const cityInput = document.getElementById(`${prefix}-city`);
    const districtInput = document.getElementById(`${prefix}-district`);
    if (!cityInput) return;

    const cityValue = String(explicitCityValue ?? cityInput.value ?? '').trim();
    const districtValue = String(districtInput?.value ?? '').trim();
    const allowedDistricts = getDistrictNamesByCity(cityValue);

    if (districtInput && districtValue) {
        const districtKey = normalizeLocationName(districtValue);
        const isValidDistrict = allowedDistricts.some((value) => normalizeLocationName(value) === districtKey);
        if (!isValidDistrict) districtInput.value = '';
    }
}

function bindLocationInputs() {
    attachLocationAutocomplete('ef');

    const cityInput = document.getElementById('ef-city');
    if (!cityInput || cityInput.dataset.locationBindReady === 'true') return;

    cityInput.dataset.locationBindReady = 'true';
    cityInput.addEventListener('input', () => handleLocationCityChange('ef'));
    cityInput.addEventListener('change', () => handleLocationCityChange('ef'));
}

async function loadLocationTree() {
    if (locationTreePromise) return locationTreePromise;

    locationTreePromise = fetch('/Address/LocationTree', { credentials: 'same-origin' })
        .then((response) => (response.ok ? response.json() : []))
        .then((data) => {
            locationTree = Array.isArray(data) ? data : [];
            const cityValue = document.getElementById('ef-city')?.value?.trim() || '';
            if (cityValue) handleLocationCityChange('ef', cityValue);
            return locationTree;
        })
        .catch(() => {
            locationTree = [];
            return locationTree;
        });

    return locationTreePromise;
}

function getAutocompleteKey(prefix, kind) {
    return `${prefix}-${kind}`;
}

function hideAutocomplete(prefix, kind) {
    const dropdown = autocompleteDropdowns.get(getAutocompleteKey(prefix, kind));
    if (!dropdown) return;
    dropdown.classList.remove('show');
}

function attachSelectPicker(prefix, kind, selectId, inputId, emptyLabel, onValueChanged) {
    const select = document.getElementById(selectId);
    const input = document.getElementById(inputId);
    if (!select || !input || input.dataset.acReady === 'true') return;

    input.dataset.acReady = 'true';
    input.parentElement?.classList.add('autocomplete-field');

    const dropdown = document.createElement('ul');
    dropdown.className = 'ac-dropdown';
    input.insertAdjacentElement('afterend', dropdown);
    autocompleteDropdowns.set(getAutocompleteKey(prefix, kind), dropdown);

    const normalizedEmptyLabel = normalizeText(emptyLabel);

    const syncFromSelect = () => {
        const selectedOption = select.options[select.selectedIndex];
        input.value = selectedOption ? selectedOption.text.trim() : emptyLabel;
    };
    selectPickerSyncFns.push(syncFromSelect);

    const buildOptions = (query) => {
        const normalizedQuery = normalizeText(query);
        return Array.from(select.options)
            .map((option) => ({ value: option.value, label: option.text.trim() }))
            .filter((option) => option.label && (!normalizedQuery || normalizeText(option.label).includes(normalizedQuery)))
            .slice(0, 16);
    };

    const renderOptions = (query) => {
        const options = buildOptions(query);
        if (!options.length) {
            dropdown.innerHTML = '';
            dropdown.classList.remove('show');
            return;
        }

        dropdown.innerHTML = options.map((option) => `
            <li data-value="${escapeHtml(option.value)}" data-label="${escapeHtml(option.label)}">${escapeHtml(option.label)}</li>
        `).join('');
        dropdown.classList.add('show');

        dropdown.querySelectorAll('li').forEach((item) => {
            item.addEventListener('mousedown', (event) => {
                event.preventDefault();
                select.value = item.dataset.value || '';
                input.value = item.dataset.label || emptyLabel;
                if (typeof onValueChanged === 'function') onValueChanged(select.value);
                updateSubmitState();
                hideAutocomplete(prefix, kind);
            });
        });
    };

    syncFromSelect();
    input.addEventListener('focus', () => {
        const currentValue = input.value.trim();
        const shouldOpenAll = !currentValue || select.value === '' || normalizeText(currentValue) === normalizedEmptyLabel;
        renderOptions(shouldOpenAll ? '' : currentValue);
    });
    input.addEventListener('click', () => {
        const currentValue = input.value.trim();
        const shouldOpenAll = !currentValue || select.value === '' || normalizeText(currentValue) === normalizedEmptyLabel;
        renderOptions(shouldOpenAll ? '' : currentValue);
    });
    input.addEventListener('input', () => renderOptions(input.value.trim()));
    input.addEventListener('blur', () => {
        setTimeout(() => {
            hideAutocomplete(prefix, kind);
            syncFromSelect();
            updateSubmitState();
        }, 120);
    });
}

function syncSelectPickerTexts() {
    selectPickerSyncFns.forEach((syncFn) => syncFn());
}

function attachEditSelectPickers() {
    attachSelectPicker('ef', 'typePicker', 'ef-type', 'ef-typeText', 'Chon loai cong viec');
    attachSelectPicker('ef', 'childPicker', 'ef-childProfileId', 'ef-childProfileText', 'Chon tre', () => setProfileFields(getSelectedChild()));
    attachSelectPicker('ef', 'skillPicker', 'ef-skillSelect', 'ef-skillSelectText', 'Chon ky nang can yeu cau');
}

function showNotice(message, kind) {
    const box = document.getElementById('editPageNotice');
    if (!box) return;
    box.className = `rounded-2xl border px-4 py-3 text-sm font-semibold mb-5 ${kind === 'warn' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-orange-200 bg-orange-50 text-orange-700'}`;
    box.textContent = message;
    box.classList.remove('hidden');
}

function setEditStatus(status) {
    document.getElementById('ef-status').value = String(status);
    document.querySelectorAll('#ef-statusToggle .status-option').forEach((button) => {
        button.classList.toggle('active', Number(button.dataset.status) === status);
    });
    updateSubmitState();
}

function renderScheduleGrid() {
    const container = document.getElementById('ef-schedule');
    if (!container) return;
    const selectedSet = new Set(editSchedule.map(slot => `${slot.dayOfWeek}-${slot.timeSlot}`));
    let html = '<div></div>';
    DAY_LABELS.forEach(label => html += `<div class="schedule-col-label">${label}</div>`);
    ROW_LABELS.forEach((rowLabel, timeSlot) => {
        html += `<div class="schedule-row-label">${rowLabel}</div>`;
        for (let dayOfWeek = 0; dayOfWeek < 7; dayOfWeek += 1) {
            const key = `${dayOfWeek}-${timeSlot}`;
            const active = selectedSet.has(key);
            html += `<button type="button" class="schedule-cell ${active ? 'active' : ''}" data-day="${dayOfWeek}" data-slot="${timeSlot}"><span class="schedule-check">${active ? '&#10003;' : ''}</span></button>`;
        }
    });
    container.innerHTML = html;
    container.querySelectorAll('.schedule-cell').forEach((button) => {
        button.addEventListener('click', () => {
            const dayOfWeek = Number(button.dataset.day);
            const timeSlot = Number(button.dataset.slot);
            const idx = editSchedule.findIndex(slot => slot.dayOfWeek === dayOfWeek && slot.timeSlot === timeSlot);
            if (idx >= 0) editSchedule.splice(idx, 1);
            else editSchedule.push({ dayOfWeek, timeSlot });
            renderScheduleGrid();
            updateSubmitState();
        });
    });
}

function renderSkillCollection() {
    const container = document.getElementById('ef-skills');
    if (!container) return;
    container.innerHTML = editSkills.map(skill => `
        <span class="skill-tag">${escapeHtml(skill)}
            <button type="button" data-skill="${escapeHtml(skill)}">x</button>
        </span>`).join('');
    container.querySelectorAll('button[data-skill]').forEach((button) => {
        button.addEventListener('click', () => {
            editSkills = editSkills.filter(skill => skill !== button.dataset.skill);
            renderSkillCollection();
            updateSubmitState();
        });
    });
}

function getValidEditSkills() {
    const select = document.getElementById('ef-skillSelect');
    if (!select) return [...editSkills];

    const allowedSkills = new Set(
        Array.from(select.options)
            .map((option) => option.value?.trim())
            .filter((value) => !!value)
    );

    return editSkills.filter((skill) => allowedSkills.has(skill));
}

function normalizeScheduleForCompare(slots) {
    return [...(Array.isArray(slots) ? slots : [])]
        .map((slot) => `${Number(slot.dayOfWeek)}-${Number(slot.timeSlot)}`)
        .sort()
        .join('|');
}

function normalizeSkillsForCompare(skills) {
    return [...(Array.isArray(skills) ? skills : [])]
        .map((skill) => String(skill ?? '').trim().toLowerCase())
        .filter((skill) => !!skill)
        .sort()
        .join('|');
}

function getCurrentFormSignature() {
    return JSON.stringify({
        title: document.getElementById('ef-title')?.value?.trim() || '',
        description: document.getElementById('ef-desc')?.value?.trim() || '',
        jobType: Number(document.getElementById('ef-type')?.value || 0),
        numberOfChildren: Number(document.getElementById('ef-children')?.value || 0),
        childProfileId: document.getElementById('ef-childProfileId')?.value || '',
        salaryMin: document.getElementById('ef-salMin')?.value?.trim() || '',
        salaryMax: document.getElementById('ef-salMax')?.value?.trim() || '',
        salaryNegotiable: !!document.getElementById('ef-negotiable')?.checked,
        location: document.getElementById('ef-location')?.value?.trim() || '',
        city: document.getElementById('ef-city')?.value?.trim() || '',
        district: document.getElementById('ef-district')?.value?.trim() || '',
        minNannyAge: document.getElementById('ef-minAge')?.value?.trim() || '',
        maxNannyAge: document.getElementById('ef-maxAge')?.value?.trim() || '',
        status: Number(document.getElementById('ef-status')?.value || 0),
        schedule: normalizeScheduleForCompare(editSchedule),
        skills: normalizeSkillsForCompare(editSkills)
    });
}

function focusInvalidField(fieldId) {
    const element = document.getElementById(fieldId);
    if (!element) return;
    try {
        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
        // Ignore scroll errors.
    }
    window.setTimeout(() => {
        try { element.focus({ preventScroll: true }); }
        catch { element.focus(); }
    }, 120);
}

function validateEditPayload(payload) {
    const title = String(payload?.title ?? '').trim();
    if (!title || title.length < 5 || title.length > 200) {
        return { message: 'Tieu de bai dang phai tu 5 den 200 ky tu.', fieldId: 'ef-title' };
    }

    const description = String(payload?.description ?? '').trim();
    if (!description || description.length < 10 || description.length > 3000) {
        return { message: 'Mo ta chi tiet phai tu 10 den 3000 ky tu.', fieldId: 'ef-desc' };
    }

    if (![1, 2, 3].includes(Number(payload?.jobType))) {
        return { message: 'Loai cong viec khong hop le.', fieldId: 'ef-typeText' };
    }

    const children = Number(payload?.numberOfChildren || 0);
    if (!Number.isFinite(children) || children < 1 || children > 10) {
        return { message: 'So tre can cham phai tu 1 den 10.', fieldId: 'ef-children' };
    }

    if (!payload?.childProfileId) {
        return { message: 'Vui long chon tre tu Child Profile.', fieldId: 'ef-childProfileText' };
    }

    const location = String(payload?.location ?? '').trim();
    if (!location || location.length < 3 || location.length > 300) {
        return { message: 'Dia chi chi tiet phai tu 3 den 300 ky tu.', fieldId: 'ef-location' };
    }

    const city = String(payload?.city ?? '').trim();
    if (!city || city.length > 100) {
        return { message: 'Thanh pho la bat buoc va toi da 100 ky tu.', fieldId: 'ef-city' };
    }

    const district = String(payload?.district ?? '').trim();
    if (!district || district.length > 100) {
        return { message: 'Phuong/Xa la bat buoc va toi da 100 ky tu.', fieldId: 'ef-district' };
    }

    const salaryMin = payload?.salaryMin;
    const salaryMax = payload?.salaryMax;
    if (salaryMin != null && (!Number.isFinite(salaryMin) || salaryMin < 0 || salaryMin > 100000000)) {
        return { message: 'Luong toi thieu phai tu 0 den 100,000,000.', fieldId: 'ef-salMin' };
    }
    if (salaryMax != null && (!Number.isFinite(salaryMax) || salaryMax < 0 || salaryMax > 100000000)) {
        return { message: 'Luong toi da phai tu 0 den 100,000,000.', fieldId: 'ef-salMax' };
    }
    if (salaryMin != null && salaryMax != null && Number(salaryMin) > Number(salaryMax)) {
        return { message: 'Luong toi thieu khong duoc lon hon luong toi da.', fieldId: 'ef-salMin' };
    }

    const minAge = payload?.minNannyAge;
    const maxAge = payload?.maxNannyAge;
    if (minAge != null && (!Number.isFinite(minAge) || minAge < 18 || minAge > 80)) {
        return { message: 'Do tuoi bao mau tu phai trong khoang 18-80.', fieldId: 'ef-minAge' };
    }
    if (maxAge != null && (!Number.isFinite(maxAge) || maxAge < 18 || maxAge > 80)) {
        return { message: 'Do tuoi bao mau den phai trong khoang 18-80.', fieldId: 'ef-maxAge' };
    }
    if (minAge != null && maxAge != null && Number(minAge) > Number(maxAge)) {
        return { message: 'Do tuoi tu khong duoc lon hon do tuoi den.', fieldId: 'ef-minAge' };
    }

    if (!Array.isArray(payload?.skills) || payload.skills.length < 1) {
        return { message: 'Vui long chon it nhat 1 ky nang.', fieldId: 'ef-skillSelectText' };
    }
    if (payload.skills.length > 20) {
        return { message: 'Toi da 20 ky nang cho moi bai dang.', fieldId: 'ef-skillSelectText' };
    }

    if (!Array.isArray(payload?.scheduleSlots) || payload.scheduleSlots.length < 1) {
        return { message: 'Vui long chon it nhat 1 khung lich.', fieldId: 'ef-schedule' };
    }

    if (![1, 2].includes(Number(payload?.status))) {
        return { message: 'Trang thai bai dang khong hop le.', fieldId: 'ef-statusToggle' };
    }

    return null;
}

function isFormDirty() {
    if (!hasLoadedEditData) return false;
    return getCurrentFormSignature() !== initialFormSignature;
}

function updateSubmitState() {
    const submitBtn = document.getElementById('editPageSubmit');
    if (!submitBtn) return;

    const disabled = !hasLoadedEditData || isSubmittingEdit || !isFormDirty();
    submitBtn.disabled = disabled;
    submitBtn.classList.toggle('is-loading', isSubmittingEdit);
    submitBtn.setAttribute('aria-busy', isSubmittingEdit ? 'true' : 'false');
    submitBtn.setAttribute('aria-disabled', disabled ? 'true' : 'false');
    const submitLabel = submitBtn.querySelector('.modal-btn__label');
    if (submitLabel) {
        submitLabel.textContent = isSubmittingEdit ? 'Dang luu...' : 'Luu thay doi';
    }
    submitBtn.title = disabled && !isSubmittingEdit
        ? 'Khong co thay doi de luu'
        : '';
}

function setProfileFields(child) {
    document.getElementById('ef-characteristic').value = child?.characteristic || '';
    document.getElementById('ef-birthType').value = child?.birthTypeLabel || '';
    document.getElementById('ef-specialNeeds').value = child?.specialNeeds || '';
}

function getSelectedChild() {
    const childId = document.getElementById('ef-childProfileId').value;
    return editChildren.find(child => String(child.id).toLowerCase() === String(childId).toLowerCase()) || null;
}

function renderChildren(selectedChildId) {
    const select = document.getElementById('ef-childProfileId');
    if (!select) return;
    select.innerHTML = editChildren.length
        ? editChildren.map(child => `<option value="${escapeHtml(child.id)}">${escapeHtml(child.label)}</option>`).join('')
        : '<option value="">Chua co Child Profile</option>';
    if (selectedChildId) select.value = selectedChildId;
    syncSelectPickerTexts();
    setProfileFields(getSelectedChild());
}

async function loadEditPage() {
    try {
        const [detailRes, prefillRes] = await Promise.all([
            fetch(`/Search/Detail/${JOB_ID}`),
            fetch('/Search/Prefill')
        ]);

        const detailJson = await detailRes.json();
        const prefillJson = await prefillRes.json();
        const job = detailJson?.data || detailJson;
        const prefill = prefillJson?.data || {};

        editChildren = Array.isArray(prefill.children) ? prefill.children : [];
        renderChildren(job.childProfileId || prefill.selectedChildProfileId);

        document.getElementById('ef-title').value = job.title || '';
        document.getElementById('ef-desc').value = job.description || '';
        document.getElementById('ef-type').value = job.jobType || 1;
        document.getElementById('ef-children').value = job.numberOfChildren || prefill.numberOfChildren || 1;
        document.getElementById('ef-salMin').value = formatMoneyInputValue(job.salaryMin);
        document.getElementById('ef-salMax').value = formatMoneyInputValue(job.salaryMax);
        document.getElementById('ef-negotiable').checked = !!job.salaryNegotiable;
        document.getElementById('ef-location').value = job.location || '';
        document.getElementById('ef-city').value = job.city || '';
        document.getElementById('ef-district').value = job.district || '';
        handleLocationCityChange('ef', document.getElementById('ef-city').value);
        document.getElementById('ef-minAge').value = job.minNannyAge || '';
        document.getElementById('ef-maxAge').value = job.maxNannyAge || '';
        setEditStatus(Number(job.status) || 1);
        syncSelectPickerTexts();

        editSkills = Array.isArray(job.skills) ? [...job.skills] : [];
        editSchedule = Array.isArray(job.scheduleSlots) ? job.scheduleSlots.map(slot => ({ dayOfWeek: slot.dayOfWeek, timeSlot: slot.timeSlot })) : [];
        renderSkillCollection();
        renderScheduleGrid();
        setProfileFields(getSelectedChild());

        if (Number(job.moderationStatus) === 0) {
            showNotice('Bai dang nay dang cho moderator duyet. Ban van co the chinh sua va luu lai.', 'warn');
        } else if (Number(job.moderationStatus) === 2) {
            showNotice('Neu ban chinh sua bai dang cong khai va luu lai, bai dang se quay ve trang thai cho duyet.', 'info');
        }
        currentModerationStatus = Number(job.moderationStatus);

        initialFormSignature = getCurrentFormSignature();
        hasLoadedEditData = true;
        updateSubmitState();
    } catch {
        showToast('Khong tai duoc thong tin bai dang', 'error');
        hasLoadedEditData = false;
        updateSubmitState();
    }
}

document.getElementById('ef-childProfileId')?.addEventListener('change', () => setProfileFields(getSelectedChild()));
document.getElementById('ef-addSkill')?.addEventListener('click', () => {
    const select = document.getElementById('ef-skillSelect');
    const value = select.value.trim();
    if (!value || editSkills.includes(value)) return;
    editSkills.push(value);
    select.value = '';
    syncSelectPickerTexts();
    renderSkillCollection();
});

document.querySelectorAll('#editPageForm input, #editPageForm textarea, #editPageForm select').forEach((element) => {
    element.addEventListener('input', updateSubmitState);
    element.addEventListener('change', updateSubmitState);
});

document.querySelectorAll('#ef-statusToggle .status-option').forEach((button) => {
    button.addEventListener('click', () => setEditStatus(Number(button.dataset.status)));
});

document.getElementById('editPageForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!hasLoadedEditData) return;
    if (!isFormDirty()) {
        showToast('Chua co thay doi de luu.', 'info');
        updateSubmitState();
        return;
    }

    const validSkills = getValidEditSkills();
    if (validSkills.length !== editSkills.length) {
        editSkills = validSkills;
        renderSkillCollection();
        showToast('Mot so ky nang cu khong con hoat dong, he thong da bo qua de ban luu duoc bai dang.', 'warning');
    }

    const payload = {
        title: document.getElementById('ef-title').value.trim(),
        description: document.getElementById('ef-desc').value.trim(),
        jobType: Number(document.getElementById('ef-type').value),
        numberOfChildren: Number(document.getElementById('ef-children').value || 1),
        childProfileId: document.getElementById('ef-childProfileId').value || null,
        salaryMin: parseMoneyInput(document.getElementById('ef-salMin').value),
        salaryMax: parseMoneyInput(document.getElementById('ef-salMax').value),
        salaryNegotiable: document.getElementById('ef-negotiable').checked,
        location: document.getElementById('ef-location').value.trim(),
        city: document.getElementById('ef-city').value.trim(),
        district: document.getElementById('ef-district').value.trim(),
        minNannyAge: document.getElementById('ef-minAge').value ? Number(document.getElementById('ef-minAge').value) : null,
        maxNannyAge: document.getElementById('ef-maxAge').value ? Number(document.getElementById('ef-maxAge').value) : null,
        skills: validSkills,
        scheduleSlots: editSchedule,
        status: Number(document.getElementById('ef-status').value || 1)
    };
    const validationError = validateEditPayload(payload);
    if (validationError) {
        showToast(validationError.message, 'warning');
        if (validationError.fieldId) focusInvalidField(validationError.fieldId);
        return;
    }

    const submitBtn = document.getElementById('editPageSubmit');
    isSubmittingEdit = true;
    updateSubmitState();
    let shouldKeepDisabledForRedirect = false;

    try {
        const controller = new AbortController();
        const timeoutId = window.setTimeout(() => controller.abort(), 15000);
        const res = await fetch(`/Search/UpdateJob/${JOB_ID}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(payload),
            signal: controller.signal
        });
        window.clearTimeout(timeoutId);

        const contentType = res.headers.get('content-type') || '';
        let json = null;
        if (contentType.toLowerCase().includes('application/json')) {
            json = await res.json();
        } else {
            const text = await res.text();
            json = { success: false, message: text || 'Phan hoi khong hop le tu server.' };
        }

        const payloadResult = json?.raw && typeof json.raw === 'object' ? json.raw : json;
        const isSuccess = !!(json?.success || payloadResult?.success);
        if (!isSuccess) {
            const firstError = json?.errors && typeof json.errors === 'object'
                ? Object.values(json.errors).flat().find(Boolean)
                : null;
            showToast(firstError || payloadResult?.message || json?.message || 'Cap nhat that bai', 'error');
            return;
        }

        const successMessage = currentModerationStatus === 0
            ? 'Da cap nhat bai dang dang cho duyet.'
            : (payloadResult?.message || 'Cap nhat thanh cong. Bai dang da duoc gui moderator duyet lai');
        pushHistoryToast(successMessage, 'success');
        shouldKeepDisabledForRedirect = true;
        redirectToHistory(JOB_ID);
    } catch (error) {
        if (error?.name === 'AbortError') {
            showToast('Het thoi gian cho luu thay doi. Vui long thu lai.', 'error');
        } else {
            showToast('Loi ket noi server', 'error');
        }
    } finally {
        if (!shouldKeepDisabledForRedirect) {
            isSubmittingEdit = false;
            updateSubmitState();
        }
    }
});

function initializeEditPage() {
    ['ef-typeText', 'ef-childProfileText', 'ef-skillSelectText'].forEach((id) => {
        document.getElementById(id)?.setAttribute('autocomplete', 'off');
    });
    bindLocationInputs();
    loadLocationTree();
    initMoneyInputs();
    attachEditSelectPickers();
    updateSubmitState();
    loadEditPage();
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeEditPage, { once: true });
} else {
    initializeEditPage();
}
</script>
}
