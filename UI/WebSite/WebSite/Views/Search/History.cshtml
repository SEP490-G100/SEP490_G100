@{
    ViewData["Title"] = "Lich su bai dang - NannyMatch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/search.css" />
    <style>
        .history-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            padding: .32rem .74rem;
            border-radius: 999px;
            border: 1px solid transparent;
            font-size: .72rem;
            line-height: 1.1;
            font-weight: 800;
            letter-spacing: .01em;
        }

        .history-badge::before {
            content: "";
            width: .4rem;
            height: .4rem;
            border-radius: 999px;
            background: currentColor;
            opacity: .88;
        }

        .history-badge--approved {
            border-color: #86efac;
            background: #f0fdf4;
            color: #166534;
        }

        .history-badge--pending {
            border-color: #fdba74;
            background: #fff7ed;
            color: #c2410c;
        }

        .history-badge--rejected {
            border-color: #fca5a5;
            background: #fef2f2;
            color: #b91c1c;
        }

        .history-badge--hidden {
            border-color: #cbd5e1;
            background: #f8fafc;
            color: #475569;
        }

        .history-job-card--approved {
            border-color: #bbf7d0 !important;
            box-shadow: 0 14px 34px rgba(34, 197, 94, .10);
        }

        .history-job-card--pending {
            border-color: #fed7aa !important;
            box-shadow: 0 14px 34px rgba(249, 115, 22, .09);
        }

        .history-job-card--rejected {
            border-color: #fecaca !important;
            box-shadow: 0 14px 34px rgba(220, 38, 38, .08);
        }

        .history-approval-panel--approved {
            border-color: #bbf7d0 !important;
            background: linear-gradient(180deg, rgba(240, 253, 244, .94), rgba(255, 255, 255, .98));
        }

        .history-approval-panel--pending {
            border-color: #fed7aa !important;
            background: linear-gradient(180deg, rgba(255, 247, 237, .92), rgba(255, 255, 255, .98));
        }

        .history-approval-panel--rejected {
            border-color: #fecaca !important;
            background: linear-gradient(180deg, rgba(254, 242, 242, .94), rgba(255, 255, 255, .98));
        }

        .history-schedule .schedule-cell.active {
            background: linear-gradient(135deg, #fb923c, #f97316);
            border-color: #ea580c;
            color: #fff;
            box-shadow: 0 10px 20px rgba(249, 115, 22, .26);
        }

        .history-schedule .schedule-cell.active:hover {
            background: linear-gradient(135deg, #fb923c, #f97316);
            border-color: #ea580c;
        }

        .history-description-box {
            margin-top: .55rem;
            border: 1px solid #fed7aa;
            background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
            border-radius: 1rem;
            padding: .8rem .95rem;
        }

        .history-stat-card {
            border-radius: 1.2rem;
            border: 1px solid #e2e8f0;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            padding: 1rem 1.15rem;
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .history-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 28px rgba(15, 23, 42, .08);
        }

        .history-stat-card--total {
            border-color: #cbd5e1;
        }

        .history-stat-card--pending {
            border-color: #fed7aa;
            background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
        }

        .history-stat-card--public {
            border-color: #fdba74;
            background: linear-gradient(180deg, #fff7ed 0%, #ffffff 100%);
        }

        .history-job-card {
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .history-job-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 22px 36px rgba(15,23,42,.10);
        }

        .history-salary-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2rem;
            padding: 0 .86rem;
            border-radius: 999px;
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            color: #c2410c;
            font-size: .78rem;
            font-weight: 800;
            border: 1px solid #fed7aa;
            white-space: nowrap;
        }

        .history-note-box {
            border-radius: 1rem;
            border: 1px solid #e2e8f0;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            padding: .74rem .84rem;
        }

        .history-skill-chip {
            display: inline-flex;
            align-items: center;
            min-height: 1.75rem;
            border-radius: 999px;
            border: 1px solid #fed7aa;
            background: #ffffff;
            color: #c2410c;
            font-size: .72rem;
            font-weight: 800;
            padding: 0 .72rem;
        }

        .history-request-panel {
            border-radius: 1.35rem;
            border: 1px solid #e2e8f0;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 55%, #fffaf5 100%);
            box-shadow: 0 14px 30px rgba(15, 23, 42, .05);
        }

        .history-request-head {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
        }

        .history-request-metrics {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            margin-top: .65rem;
        }

        .history-request-metric {
            display: inline-flex;
            align-items: center;
            min-height: 1.75rem;
            padding: 0 .68rem;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #475569;
            font-size: .72rem;
            font-weight: 800;
        }

        .history-request-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .38rem;
            min-height: 2.4rem;
            padding: 0 .95rem;
            border-radius: .9rem;
            border: 1px solid #fed7aa;
            background: #fff7ed;
            color: #c2410c;
            font-size: .78rem;
            font-weight: 800;
            transition: all .2s ease;
            box-shadow: 0 10px 18px rgba(249, 115, 22, .15);
        }

        .history-request-toggle:hover {
            border-color: #fb923c;
            background: #ffedd5;
            transform: translateY(-1px);
        }

        .history-request-toggle.is-open {
            border-color: #f97316;
            background: linear-gradient(135deg, #fb923c, #f97316);
            color: #ffffff;
            box-shadow: 0 14px 24px rgba(249, 115, 22, .28);
        }

        .history-request-list {
            border-top: 1px dashed #fed7aa;
            padding-top: 1rem;
        }

        .history-request-item {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            padding: .95rem;
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .history-request-item:hover {
            transform: translateY(-1px);
            border-color: #fdba74;
            box-shadow: 0 12px 22px rgba(249, 115, 22, .12);
        }

        .history-request-item__head {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: .7rem;
        }

        .history-request-user {
            display: flex;
            align-items: center;
            gap: .65rem;
        }

        .history-request-avatar {
            width: 2.45rem;
            height: 2.45rem;
            border-radius: 999px;
            border: 1px solid #fed7aa;
            background: linear-gradient(135deg, #fff7ed, #ffedd5);
            color: #c2410c;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .88rem;
            font-weight: 900;
            text-transform: uppercase;
            overflow: hidden;
        }

        .history-request-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .history-app-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .32rem;
            padding: .3rem .72rem;
            border-radius: 999px;
            border: 1px solid transparent;
            font-size: .72rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .history-app-badge::before {
            content: "";
            width: .42rem;
            height: .42rem;
            border-radius: 999px;
            background: currentColor;
            opacity: .9;
        }

        .history-app-badge--pending {
            border-color: #fdba74;
            background: #fff7ed;
            color: #c2410c;
        }

        .history-app-badge--approved {
            border-color: #86efac;
            background: #f0fdf4;
            color: #166534;
        }

        .history-app-badge--rejected {
            border-color: #fca5a5;
            background: #fef2f2;
            color: #b91c1c;
        }

        .history-app-badge--withdrawn {
            border-color: #cbd5e1;
            background: #f8fafc;
            color: #475569;
        }

        .history-request-info-grid {
            margin-top: .75rem;
            display: grid;
            grid-template-columns: repeat(1, minmax(0, 1fr));
            gap: .5rem;
        }

        @@media (min-width: 640px) {
            .history-request-info-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        .history-request-info {
            border-radius: .8rem;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            padding: .55rem .62rem;
        }

        .history-review-note {
            border-radius: .95rem;
            border: 1px solid #fdba74;
            background: linear-gradient(180deg, rgba(255, 247, 237, .92), #ffffff);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .85);
        }

        .history-review-note textarea {
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .history-review-note textarea:focus {
            border-color: #fb923c;
            box-shadow: 0 0 0 3px rgba(251, 146, 60, .18);
        }
    </style>
}

<section class="min-h-screen bg-[linear-gradient(180deg,#fffaf5_0%,#ffffff_45%,#fff7ed_100%)] py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-[30px] border border-orange-100 bg-white/90 shadow-[0_24px_60px_rgba(15,23,42,.08)] overflow-hidden">
            <div class="px-6 py-6 sm:px-8 border-b border-orange-100 bg-[radial-gradient(circle_at_top_right,rgba(255,237,213,.85),transparent_28%),linear-gradient(180deg,#ffffff_0%,#fffaf4_100%)]">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-orange-500">Bai dang cua toi</p>
                        <h1 class="mt-2 text-3xl font-bold text-slate-900">Lich su bai dang</h1>
                        <p class="mt-2 text-sm leading-6 text-slate-500 max-w-2xl">
                            Theo doi trang thai duyet, ghi chu cua moderator va toan bo thong tin cua cac bai dang ban da tao.
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="/Search"
                           class="inline-flex items-center justify-center min-h-[48px] px-5 rounded-2xl border border-slate-200 bg-white text-slate-600 font-bold hover:bg-slate-50 transition-all">
                            Quay lai tim bai
                        </a>
                    </div>
                </div>
            </div>

            <div class="px-6 py-6 sm:px-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="history-stat-card history-stat-card--total">
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">Tong bai dang</p>
                        <p id="historyTotalCount" class="mt-2 text-3xl font-extrabold text-slate-900">0</p>
                    </div>
                    <div class="history-stat-card history-stat-card--pending">
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-500">Dang cho duyet</p>
                        <p id="historyPendingCount" class="mt-2 text-3xl font-extrabold text-amber-700">0</p>
                    </div>
                    <div class="history-stat-card history-stat-card--public">
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-500">Dang hien thi</p>
                        <p id="historyPublishedCount" class="mt-2 text-3xl font-extrabold text-orange-600">0</p>
                    </div>
                </div>

                <div id="historyPageBody" class="space-y-5">
                    <div class="rounded-3xl border border-slate-200 bg-white px-6 py-10 text-center text-slate-500">
                        Dang tai lich su bai dang...
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="jobApplicationDetailModal" class="nmodal fixed inset-0 z-50 bg-black/50 backdrop-blur-sm items-center justify-center px-4" onclick="if(event.target===this)window.__closeJobApplicationDetailModal?.()">
    <div class="nmodal-box bg-white rounded-[28px] w-full max-w-3xl shadow-2xl relative">
        <button type="button"
                onclick="window.__closeJobApplicationDetailModal?.()"
                class="absolute top-4 right-4 z-30 inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-400 shadow-[0_10px_18px_rgba(15,23,42,.12)] hover:text-slate-600 hover:border-slate-300 transition-colors">
            <span class="material-icons-round">close</span>
        </button>
        <div class="modal-scroll">
            <div class="sticky top-0 z-20 px-6 py-5 border-b border-slate-100 bg-[linear-gradient(180deg,#ffffff_0%,#fffaf4_100%)]">
                <div class="flex items-start gap-4 pr-12">
                    <div>
                        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-orange-500">Request ung tuyen</p>
                        <h3 id="jobAppModalTitle" class="mt-2 text-xl font-bold text-slate-900">Chi tiet request</h3>
                        <p id="jobAppModalSubTitle" class="mt-2 text-sm text-slate-500">Xem thong tin va duyet request tu Nanny.</p>
                    </div>
                </div>
            </div>

            <div class="px-6 py-5 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                    <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Nanny</p>
                        <p id="jobAppNannyName" class="mt-2 text-base font-extrabold text-slate-900">-</p>
                        <p id="jobAppNannyLocation" class="mt-1 text-sm text-slate-500">-</p>
                    </div>
                    <div class="rounded-2xl border border-slate-100 bg-slate-50 p-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Trang thai request</p>
                        <div id="jobAppStatusWrap" class="mt-2"></div>
                        <p id="jobAppAppliedAt" class="mt-2 text-sm text-slate-500">-</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                    <div class="rounded-2xl border border-slate-100 bg-white p-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">So dien thoai</p>
                        <p id="jobAppPhone" class="mt-2 font-bold text-slate-900">-</p>
                    </div>
                    <div class="rounded-2xl border border-slate-100 bg-white p-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Kinh nghiem</p>
                        <p id="jobAppExperience" class="mt-2 font-bold text-slate-900">-</p>
                    </div>
                    <div class="rounded-2xl border border-slate-100 bg-white p-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Muc luong mong muon</p>
                        <p id="jobAppSalary" class="mt-2 font-bold text-slate-900">-</p>
                    </div>
                    <div class="rounded-2xl border border-slate-100 bg-white p-3">
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Ly do tu choi</p>
                        <p id="jobAppRejectReasonDisplay" class="mt-2 text-slate-600">Chua co.</p>
                    </div>
                </div>

                <div id="jobAppRejectReasonWrap" class="history-review-note p-4">
                    <label for="jobAppRejectReason" class="block text-sm font-bold text-amber-700">Ly do tu choi (bat buoc khi Reject)</label>
                    <textarea id="jobAppRejectReason"
                              rows="3"
                              class="mt-2 w-full rounded-xl border border-amber-200 bg-white px-3 py-2 text-sm text-slate-700 focus:outline-none"
                              placeholder="Nhap ly do parent tu choi request..."></textarea>
                </div>
            </div>

            <div class="px-6 pb-6 pt-2 flex flex-wrap items-center justify-between gap-3">
                <a id="jobAppViewProfileBtn"
                   href="#"
                   target="_blank"
                   rel="noopener"
                   class="hidden inline-flex items-center justify-center gap-2 min-h-[42px] px-5 rounded-xl border border-orange-200 bg-orange-50 text-orange-600 font-bold hover:bg-orange-100 transition-all">
                    <span class="material-icons-round text-base">visibility</span>
                    Xem chi tiet ho so Nanny
                </a>

                <div class="ml-auto flex flex-wrap items-center justify-end gap-3">
                    <button type="button"
                            onclick="window.__closeJobApplicationDetailModal?.()"
                            class="inline-flex items-center justify-center min-h-[42px] px-5 rounded-xl border border-slate-200 bg-white text-slate-600 font-bold hover:bg-slate-50 transition-all">
                        Dong
                    </button>
                    <button type="button"
                            id="jobAppApproveBtn"
                            onclick="window.__submitJobApplicationReview?.(1)"
                            class="inline-flex items-center justify-center gap-2 min-h-[42px] px-5 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-700 font-bold hover:bg-emerald-100 transition-all">
                        <span class="material-icons-round text-base">check_circle</span>
                        Chap nhan
                    </button>
                    <button type="button"
                            id="jobAppRejectBtn"
                            onclick="window.__submitJobApplicationReview?.(2)"
                            class="inline-flex items-center justify-center gap-2 min-h-[42px] px-5 rounded-xl border border-rose-200 bg-rose-50 text-rose-700 font-bold hover:bg-rose-100 transition-all">
                        <span class="material-icons-round text-base">cancel</span>
                        Tu choi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Hiring/_ApplicantList.cshtml" />

<script>
    (() => {
        const HISTORY_TOAST_KEY = 'nm:historyToast';
        const moderationLabels = {
            0: 'Dang cho duyet',
            1: 'Da bi tu choi',
            2: 'Cong khai'
        };

        const postStatusLabels = {
            1: 'Cong khai',
            2: 'An bai dang'
        };
        const moderationBadgeClasses = {
            0: 'history-badge history-badge--pending',
            1: 'history-badge history-badge--rejected',
            2: 'history-badge history-badge--approved'
        };
        const postStatusBadgeClasses = {
            1: 'history-badge history-badge--approved',
            2: 'history-badge history-badge--hidden'
        };
        const cardToneClasses = {
            0: 'history-job-card--pending',
            1: 'history-job-card--rejected',
            2: 'history-job-card--approved'
        };
        const approvalPanelToneClasses = {
            0: 'history-approval-panel--pending',
            1: 'history-approval-panel--rejected',
            2: 'history-approval-panel--approved'
        };

        const rowLabels = ['Morning', 'Afternoon', 'Evening', 'Night'];
        const dayLabels = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
        const focusParams = new URLSearchParams(window.location.search);
        const focusJobId = focusParams.get('jobId');
        const focusApplicationId = focusParams.get('applicationId');
        const historyJobsById = new Map();
        const applicationCache = new Map();
        let activeReviewContext = null;
        let isSubmittingReview = false;

        const applicationStatusLabels = {
            0: 'Dang cho duyet',
            1: 'Dang xem xet',
            2: 'Da duoc chon',
            3: 'Da bi tu choi',
            4: 'Da huy'
        };
        const applicationBadgeClasses = {
            0: 'history-app-badge history-app-badge--pending',
            1: 'history-app-badge history-app-badge--approved',
            2: 'history-app-badge history-app-badge--rejected',
            3: 'history-app-badge history-app-badge--rejected',
            4: 'history-app-badge history-app-badge--withdrawn'
        };

        const escapeHtml = (value) => String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');

        const showHistoryToast = (message, type = 'info') => {
            if (!message) return;
            if (typeof window.showToast === 'function') {
                window.showToast(message, { type });
                return;
            }

            const fallback = document.createElement('div');
            fallback.style.position = 'fixed';
            fallback.style.right = '16px';
            fallback.style.bottom = '16px';
            fallback.style.zIndex = '12060';
            fallback.style.padding = '10px 12px';
            fallback.style.borderRadius = '10px';
            fallback.style.background = '#0f172a';
            fallback.style.color = '#fff';
            fallback.style.fontSize = '13px';
            fallback.style.fontWeight = '700';
            fallback.textContent = String(message);
            document.body.appendChild(fallback);
            window.setTimeout(() => fallback.remove(), 2200);
        };

        const consumeHistoryToast = () => {
            try {
                const raw = sessionStorage.getItem(HISTORY_TOAST_KEY);
                if (!raw) return;
                sessionStorage.removeItem(HISTORY_TOAST_KEY);

                const parsed = JSON.parse(raw);
                const createdAt = Number(parsed?.createdAt || 0);
                if (!createdAt || Date.now() - createdAt > 60000) return;

                showHistoryToast(parsed?.message || 'Cap nhat bai dang thanh cong.', parsed?.type || 'success');
            } catch {
                // Ignore invalid storage payloads.
            }
        };

        const formatSalary = (value) => value ? `${(Number(value) / 1000).toFixed(0)}k/gio` : 'Khong xac dinh';
        const formatSalaryRange = (min, max) => {
            if (min && max) return `${formatSalary(min)} - ${formatSalary(max)}`;
            if (min) return `Tu ${formatSalary(min)}`;
            if (max) return `Den ${formatSalary(max)}`;
            return 'Khong xac dinh';
        };

        const formatAgeRange = (min, max) => {
            if (min && max) return `${min} - ${max} tuoi`;
            if (min) return `Tu ${min} tuoi`;
            if (max) return `Den ${max} tuoi`;
            return 'Khong yeu cau';
        };

        const renderScheduleGrid = (slots) => {
            if (!Array.isArray(slots) || !slots.length) {
                return '<span class="text-sm text-slate-400">Chua chon lich cu the.</span>';
            }

            const selectedSet = new Set(slots.map((slot) => `${slot.dayOfWeek}-${slot.timeSlot}`));
            let html = '<div class="schedule-grid schedule-grid--readonly history-schedule"><div></div>';

            dayLabels.forEach((label) => {
                html += `<div class="schedule-col-label">${label}</div>`;
            });

            rowLabels.forEach((rowLabel, timeSlot) => {
                html += `<div class="schedule-row-label">${rowLabel}</div>`;
                for (let dayOfWeek = 0; dayOfWeek < 7; dayOfWeek += 1) {
                    const active = selectedSet.has(`${dayOfWeek}-${timeSlot}`);
                    html += `
                        <div class="schedule-cell ${active ? 'active' : ''}" aria-hidden="true">
                            <span class="schedule-check">${active ? '&#10003;' : ''}</span>
                        </div>`;
                }
            });

            html += '</div>';
            return html;
        };

        const formatDateTime = (value) => {
            if (!value) return 'Chua cap nhat';
            const parsed = new Date(value);
            if (Number.isNaN(parsed.getTime())) return 'Chua cap nhat';
            return parsed.toLocaleString('vi-VN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
        };

        const renderApplicationBadge = (status) => `
            <span class="${applicationBadgeClasses[Number(status)] || 'history-app-badge history-app-badge--pending'}">
                ${escapeHtml(applicationStatusLabels[status] || 'Dang cap nhat')}
            </span>`;

        const getNameInitial = (fullName) => {
            const normalized = String(fullName ?? '').trim();
            if (!normalized) return 'N';
            const token = normalized.split(/\s+/).find(Boolean) || 'N';
            return token.charAt(0).toUpperCase();
        };

        const renderRequestMetrics = (jobId, applications) => {
            const metricsEl = document.getElementById(`historyRequestMetrics-${jobId}`);
            if (!metricsEl) return;

            const total = applications.length;
            const pending = applications.filter((item) => Number(item.status) === 0).length;
            const approved = applications.filter((item) => Number(item.status) === 1 || Number(item.status) === 2).length;
            const rejected = applications.filter((item) => Number(item.status) === 3 || Number(item.status) === 4).length;

            metricsEl.innerHTML = `
                <span class="history-request-metric">Tong: ${total}</span>
                <span class="history-request-metric">Pending: ${pending}</span>
                <span class="history-request-metric">Chap nhan: ${approved}</span>
                <span class="history-request-metric">Tu choi: ${rejected}</span>`;
        };

        const updateApplicationSummary = (jobId, applications) => {
            const summaryEl = document.getElementById(`historyRequestSummary-${jobId}`);
            if (!summaryEl) return;
            renderRequestMetrics(jobId, applications);

            if (!applications.length) {
                summaryEl.textContent = 'Chua co request ung tuyen nao.';
                return;
            }

            const pendingCount = applications.filter((item) => Number(item.status) === 0).length;
            summaryEl.textContent = pendingCount > 0
                ? `Co ${pendingCount} request dang cho duyet trong tong so ${applications.length} request.`
                : `Tat ca ${applications.length} request da duoc xu ly.`;
        };

        const renderApplicationList = (jobId, applications) => {
            const listEl = document.getElementById(`historyRequestList-${jobId}`);
            if (!listEl) return;

            if (!applications.length) {
                listEl.innerHTML = `
                    <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
                        Chua co request ung tuyen cho bai dang nay.
                    </div>`;
                updateApplicationSummary(jobId, applications);
                return;
            }

            listEl.innerHTML = `
                <div class="space-y-3">
                    ${applications.map((item) => `
                        <article class="history-request-item">
                            <div class="history-request-item__head">
                                <div class="history-request-user">
                                    <span class="history-request-avatar">
                                        ${item?.nanny?.avatarUrl
                                            ? `<img src="${escapeHtml(item.nanny.avatarUrl)}" alt="Nanny avatar" />`
                                            : escapeHtml(getNameInitial(item?.nanny?.fullName))}
                                    </span>
                                    <div>
                                        <p class="text-sm font-extrabold text-slate-900">${escapeHtml(item?.nanny?.fullName || 'Nanny')}</p>
                                        <p class="mt-1 text-xs text-slate-500">${escapeHtml([item?.nanny?.district, item?.nanny?.city].filter(Boolean).join(', ') || 'Chua cap nhat khu vuc')}</p>
                                    </div>
                                </div>
                                ${renderApplicationBadge(item.status)}
                            </div>
                            <div class="history-request-info-grid text-xs text-slate-600">
                                <div class="history-request-info">
                                    <p class="font-bold text-slate-500">Ngay ung tuyen</p>
                                    <p class="mt-1 font-semibold text-slate-700">${escapeHtml(formatDateTime(item.appliedAt))}</p>
                                </div>
                                <div class="history-request-info">
                                    <p class="font-bold text-slate-500">Kinh nghiem</p>
                                    <p class="mt-1 font-semibold text-slate-700">${item?.nanny?.yearsOfExperience ? `${item.nanny.yearsOfExperience} nam` : 'Chua cap nhat'}</p>
                                </div>
                                <div class="history-request-info">
                                    <p class="font-bold text-slate-500">Luong mong muon</p>
                                    <p class="mt-1 font-semibold text-slate-700">${escapeHtml(formatSalaryRange(item?.nanny?.expectedSalaryMin, item?.nanny?.expectedSalaryMax))}</p>
                                </div>
                            </div>
                            <div class="mt-3 flex items-center justify-end gap-2">
                                ${Number(item.status) === 0 ? `
                                <button type="button"
                                        data-jobappid="${escapeHtml(item.id)}"
                                        data-jobpostingid="${escapeHtml(jobId)}"
                                        onclick="window.__approveApplicant?.(this)"
                                        class="inline-flex items-center justify-center gap-1 min-h-[36px] px-3 rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 text-xs font-bold hover:bg-emerald-100 transition-all">
                                    <span class="material-icons-round" style="font-size:14px">check_circle</span>
                                    Dong y
                                </button>` : ''}
                                <button type="button"
                                        onclick="window.__openJobApplicationDetail?.('${escapeHtml(jobId)}','${escapeHtml(item.id)}')"
                                        class="inline-flex items-center justify-center min-h-[36px] px-3 rounded-lg border border-orange-200 bg-orange-50 text-orange-600 text-xs font-bold hover:bg-orange-100 transition-all">
                                    Xem chi tiet request
                                </button>
                            </div>
                        </article>`).join('')}
                </div>`;

            updateApplicationSummary(jobId, applications);
        };

        const setRequestLoadingState = (jobId, message) => {
            const listEl = document.getElementById(`historyRequestList-${jobId}`);
            if (!listEl) return;
            listEl.innerHTML = `
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
                    ${escapeHtml(message)}
                </div>`;
        };

        const delay = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));

        const loadJobApplications = async (jobId, forceReload = false, options = {}) => {
            const shouldRenderList = options?.renderList !== false;
            const silent = options?.silent === true;
            if (!jobId) return [];
            if (!forceReload && applicationCache.has(jobId)) {
                const cached = applicationCache.get(jobId) || [];
                if (shouldRenderList) renderApplicationList(jobId, cached);
                else updateApplicationSummary(jobId, cached);
                return cached;
            }

            if (shouldRenderList) {
                setRequestLoadingState(jobId, 'Dang tai request ung tuyen...');
            }
            try {
                const response = await fetch(`/Hiring/${encodeURIComponent(jobId)}/Applicants`, { credentials: 'same-origin' });
                const json = await response.json();
                if (!json?.success) throw new Error(json?.message || 'Khong tai duoc request.');

                const raw = Array.isArray(json?.data) ? json.data : [];
                const applications = raw.map((item) => ({
                    id: item.jobApplicationId,
                    status: item.status,
                    appliedAt: item.appliedAt,
                    rejectionReason: null,
                    nanny: {
                        userId: item.nannyUserId,
                        profileId: item.nannyProfileId,
                        fullName: item.nannyName,
                        avatarUrl: item.nannyAvatar,
                        phoneNumber: null,
                        city: null,
                        district: null,
                        yearsOfExperience: item.yearsOfExperience,
                        expectedSalaryMin: item.expectedSalaryMin,
                        expectedSalaryMax: item.expectedSalaryMax
                    }
                }));
                applicationCache.set(jobId, applications);
                if (shouldRenderList) renderApplicationList(jobId, applications);
                else updateApplicationSummary(jobId, applications);
                return applications;
            } catch (error) {
                if (shouldRenderList) {
                    setRequestLoadingState(jobId, 'Khong tai duoc request ung tuyen.');
                }
                if (!silent) {
                    showHistoryToast(error?.message || 'Khong tai duoc request ung tuyen.', 'error');
                }
                return [];
            }
        };

        const preloadApplicationSummary = async (jobId) => {
            if (!jobId) return;
            await loadJobApplications(jobId, false, { renderList: false, silent: true });

            // Retry mot lan neu request preload dau tien bi truot.
            if (!applicationCache.has(jobId)) {
                await delay(320);
                await loadJobApplications(jobId, true, { renderList: false, silent: true });
            }
        };

        const preloadApplicationSummaries = async (jobs) => {
            const tasks = (jobs || [])
                .filter((job) => !!job?.id)
                .map((job) => preloadApplicationSummary(String(job.id)));

            if (!tasks.length) return;
            await Promise.allSettled(tasks);
        };

        const toggleJobApplications = async (jobId, forceOpen = false) => {
            const listEl = document.getElementById(`historyRequestList-${jobId}`);
            const toggleBtn = document.getElementById(`historyRequestToggle-${jobId}`);
            if (!listEl || !toggleBtn) return;

            const shouldOpen = forceOpen || listEl.classList.contains('hidden');
            if (!shouldOpen) {
                listEl.classList.add('hidden');
                toggleBtn.classList.remove('is-open');
                toggleBtn.innerHTML = '<span class="material-icons-round text-base">visibility</span>Xem request';
                return;
            }

            listEl.classList.remove('hidden');
            toggleBtn.classList.add('is-open');
            toggleBtn.innerHTML = '<span class="material-icons-round text-base">expand_less</span>Thu gon';
            await loadJobApplications(jobId);
        };

        const setReviewButtonState = (canReview, submitting = false) => {
            const approveBtn = document.getElementById('jobAppApproveBtn');
            const rejectBtn = document.getElementById('jobAppRejectBtn');
            const reasonWrap = document.getElementById('jobAppRejectReasonWrap');
            const reasonInput = document.getElementById('jobAppRejectReason');
            const disabled = submitting || !canReview;

            if (approveBtn) {
                approveBtn.disabled = disabled;
                approveBtn.classList.toggle('opacity-60', disabled);
                approveBtn.classList.toggle('cursor-not-allowed', disabled);
            }

            if (rejectBtn) {
                rejectBtn.disabled = disabled;
                rejectBtn.classList.toggle('opacity-60', disabled);
                rejectBtn.classList.toggle('cursor-not-allowed', disabled);
            }

            if (reasonWrap) reasonWrap.classList.toggle('hidden', !canReview);
            if (reasonInput) reasonInput.disabled = !canReview || submitting;
        };

        const closeJobApplicationDetailModal = () => {
            activeReviewContext = null;
            isSubmittingReview = false;
            document.getElementById('jobApplicationDetailModal')?.classList.remove('show');
            const reasonInput = document.getElementById('jobAppRejectReason');
            if (reasonInput) reasonInput.value = '';
            const viewProfileBtn = document.getElementById('jobAppViewProfileBtn');
            if (viewProfileBtn) {
                viewProfileBtn.classList.add('hidden');
                viewProfileBtn.removeAttribute('href');
            }
        };

        const openJobApplicationDetail = async (jobId, applicationId) => {
            if (!jobId || !applicationId) return;

            let applications = applicationCache.get(jobId);
            if (!applications) {
                applications = await loadJobApplications(jobId);
            }

            const application = (applications || []).find((item) => String(item.id).toLowerCase() === String(applicationId).toLowerCase());
            if (!application) {
                showHistoryToast('Khong tim thay request can xem.', 'warning');
                return;
            }

            const job = historyJobsById.get(jobId);
            const canReview = Number(application.status) === 0;
            activeReviewContext = { jobId, applicationId };

            document.getElementById('jobAppModalTitle').textContent = job?.title || 'Chi tiet request';
            document.getElementById('jobAppModalSubTitle').textContent = canReview
                ? 'Request dang cho duyet. Ban co the chap nhan hoac tu choi.'
                : 'Request nay da duoc xu ly. Ban dang xem lai chi tiet.';
            document.getElementById('jobAppNannyName').textContent = application?.nanny?.fullName || 'Nanny';
            document.getElementById('jobAppNannyLocation').textContent = [application?.nanny?.district, application?.nanny?.city].filter(Boolean).join(', ') || 'Chua cap nhat khu vuc';
            document.getElementById('jobAppStatusWrap').innerHTML = renderApplicationBadge(application.status);
            document.getElementById('jobAppAppliedAt').textContent = `Ngay ung tuyen: ${formatDateTime(application.appliedAt)}`;
            document.getElementById('jobAppPhone').textContent = application?.nanny?.phoneNumber || 'Chua cap nhat';
            document.getElementById('jobAppExperience').textContent = application?.nanny?.yearsOfExperience ? `${application.nanny.yearsOfExperience} nam` : 'Chua cap nhat';
            document.getElementById('jobAppSalary').textContent = formatSalaryRange(application?.nanny?.expectedSalaryMin, application?.nanny?.expectedSalaryMax);
            document.getElementById('jobAppRejectReasonDisplay').textContent = application?.rejectionReason || 'Chua co.';

            const viewProfileBtn = document.getElementById('jobAppViewProfileBtn');
            if (viewProfileBtn) {
                const userId = application?.nanny?.userId ? String(application.nanny.userId) : '';
                if (userId) {
                    if (Number(application.status) === 1) {
                        viewProfileBtn.setAttribute('href', `/Profile/ViewUser?userId=${encodeURIComponent(userId)}&jobPostingId=${encodeURIComponent(jobId)}&jobApplicationId=${encodeURIComponent(application.id)}`);
                        viewProfileBtn.innerHTML = '<span class="material-icons-round text-base">handshake</span> Xem ho so &amp; Thue Nanny';
                    } else {
                        viewProfileBtn.setAttribute('href', `/Profile/ViewUser?userId=${encodeURIComponent(userId)}`);
                        viewProfileBtn.innerHTML = '<span class="material-icons-round text-base">visibility</span> Xem chi tiet ho so Nanny';
                    }
                    viewProfileBtn.classList.remove('hidden');
                } else {
                    viewProfileBtn.classList.add('hidden');
                    viewProfileBtn.removeAttribute('href');
                }
            }

            const rejectReasonInput = document.getElementById('jobAppRejectReason');
            if (rejectReasonInput) rejectReasonInput.value = application?.rejectionReason || '';

            setReviewButtonState(canReview, false);
            document.getElementById('jobApplicationDetailModal')?.classList.add('show');
        };

        const submitJobApplicationReview = async (action) => {
            if (!activeReviewContext || isSubmittingReview) return;
            const { jobId, applicationId } = activeReviewContext;

            const reasonInput = document.getElementById('jobAppRejectReason');
            const rejectionReason = reasonInput?.value.trim() || '';
            if (Number(action) === 2 && !rejectionReason) {
                showHistoryToast('Vui long nhap ly do khi Reject request.', 'warning');
                reasonInput?.focus();
                return;
            }
            if (Number(action) === 2 && rejectionReason.length < 8) {
                showHistoryToast('Ly do tu choi can toi thieu 8 ky tu.', 'warning');
                reasonInput?.focus();
                return;
            }

            isSubmittingReview = true;
            setReviewButtonState(true, true);

            try {
                const endpoint = Number(action) === 1
                    ? `/Hiring/${encodeURIComponent(jobId)}/Applicants/${encodeURIComponent(applicationId)}/Approve`
                    : `/Search/ReviewJobApplication?applicationId=${encodeURIComponent(applicationId)}`;
                const payload = Number(action) === 1
                    ? {}
                    : { action: Number(action), rejectionReason: Number(action) === 2 ? rejectionReason : null };
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(payload)
                });

                const json = await response.json();
                if (!json?.success) {
                    showHistoryToast(json?.message || 'Khong the xu ly request ung tuyen.', 'error');
                    setReviewButtonState(true, false);
                    isSubmittingReview = false;
                    return;
                }

                showHistoryToast(json?.message || 'Cap nhat request ung tuyen thanh cong.', 'success');
                await loadJobApplications(jobId, true);
                window.dispatchEvent(new CustomEvent('nm:notifications-refresh'));
                closeJobApplicationDetailModal();
            } catch {
                showHistoryToast('Khong the xu ly request ung tuyen.', 'error');
                setReviewButtonState(true, false);
                isSubmittingReview = false;
            }
        };

        async function loadHistoryPage() {
            const body = document.getElementById('historyPageBody');
            const totalEl = document.getElementById('historyTotalCount');
            const pendingEl = document.getElementById('historyPendingCount');
            const publishedEl = document.getElementById('historyPublishedCount');

            try {
                const res = await fetch('/Search/MyJobs');
                const json = await res.json();
                const jobs = json.data || [];
                historyJobsById.clear();
                applicationCache.clear();
                jobs.forEach((job) => {
                    if (job?.id) historyJobsById.set(String(job.id), job);
                });

                totalEl.textContent = jobs.length;
                pendingEl.textContent = jobs.filter((job) => Number(job.moderationStatus) === 0).length;
                publishedEl.textContent = jobs.filter((job) => Number(job.status) === 1 && Number(job.moderationStatus) === 2).length;

                if (!jobs.length) {
                    body.innerHTML = `
                        <div class="rounded-3xl border border-dashed border-slate-200 bg-slate-50 px-6 py-14 text-center">
                            <span class="material-icons-round text-[34px] text-orange-300">history</span>
                            <h3 class="mt-3 text-lg font-bold text-slate-900">Ban chua co bai dang nao</h3>
                            <p class="mt-2 text-sm text-slate-500">Khi ban tao bai dang dau tien, lich su se hien o day.</p>
                        </div>`;
                    return;
                }

                body.innerHTML = jobs.map((job) => `
                    <article data-job-id="${escapeHtml(job.id)}" class="history-job-card ${cardToneClasses[Number(job.moderationStatus)] || 'history-job-card--pending'} rounded-[28px] border border-slate-100 bg-white shadow-[0_14px_34px_rgba(15,23,42,.06)] overflow-hidden">
                        <div class="px-6 py-5 border-b border-slate-100 bg-[linear-gradient(180deg,#ffffff_0%,#fffaf5_100%)]">
                            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h2 class="text-lg font-bold text-slate-900">${escapeHtml(job.title || 'Tin dang')}</h2>
                                        <span class="${moderationBadgeClasses[Number(job.moderationStatus)] || 'history-badge history-badge--pending'}">${escapeHtml(moderationLabels[job.moderationStatus] || 'Dang cap nhat')}</span>
                                        <span class="${postStatusBadgeClasses[Number(job.status)] || 'history-badge history-badge--hidden'}">${escapeHtml(postStatusLabels[job.status] || 'Dang cap nhat')}</span>
                                    </div>
                                    <p class="mt-2 text-sm text-slate-500">${escapeHtml([job.location, job.district, job.city].filter(Boolean).join(', ') || 'Chua cap nhat dia diem')}</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="history-salary-badge">
                                        ${job.salaryNegotiable ? 'Thuong luong' : escapeHtml(formatSalaryRange(job.salaryMin, job.salaryMax))}
                                    </div>
                                    ${[0, 2].includes(Number(job.moderationStatus)) ? `
                                        <a href="/Search/Edit/${job.id}"
                                           class="inline-flex items-center justify-center min-h-[40px] px-4 rounded-xl border border-orange-200 bg-white text-orange-600 text-sm font-bold hover:bg-orange-50 transition-all">
                                            Chinh sua
                                        </a>` : ''}
                                </div>
                            </div>
                        </div>

                        <div class="px-6 py-5 grid grid-cols-1 xl:grid-cols-[1.15fr_.85fr] gap-5">
                            <div class="space-y-4">
                                <div>
                                    <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">Mo ta</p>
                                    <div class="history-description-box">
                                        <p class="text-sm leading-6 text-slate-600">${escapeHtml(job.description || 'Khong co mo ta chi tiet.')}</p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="rounded-3xl border border-slate-100 bg-slate-50 px-4 py-4">
                                        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">So tre</p>
                                        <p class="mt-2 text-base font-extrabold text-slate-900">${job.numberOfChildren ? `${job.numberOfChildren} be` : 'Chua cap nhat'}</p>
                                    </div>
                                    <div class="rounded-3xl border border-slate-100 bg-slate-50 px-4 py-4">
                                        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">Do tuoi nanny</p>
                                        <p class="mt-2 text-base font-extrabold text-slate-900">${formatAgeRange(job.minNannyAge, job.maxNannyAge)}</p>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">Lich ngay muon tuyen</p>
                                    <div class="mt-3">${renderScheduleGrid(job.scheduleSlots || [])}</div>
                                </div>
                            </div>

                            <div class="history-approval-panel ${approvalPanelToneClasses[Number(job.moderationStatus)] || 'history-approval-panel--pending'} rounded-3xl border border-orange-100 bg-orange-50/40 px-5 py-4">
                                <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-orange-500">Chi tiet duyet bai</p>
                                <div class="mt-4 space-y-3 text-sm text-slate-600">
                                    <div class="flex items-start justify-between gap-4">
                                        <span class="font-bold text-slate-500">Trang thai</span>
                                        <span class="${moderationBadgeClasses[Number(job.moderationStatus)] || 'history-badge history-badge--pending'}">${escapeHtml(moderationLabels[job.moderationStatus] || 'Dang cap nhat')}</span>
                                    </div>
                                    <div class="flex items-start justify-between gap-4">
                                        <span class="font-bold text-slate-500">Hien thi</span>
                                        <span class="${postStatusBadgeClasses[Number(job.status)] || 'history-badge history-badge--hidden'}">${escapeHtml(postStatusLabels[job.status] || 'Dang cap nhat')}</span>
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-500 mb-2">Ghi chu moderator</p>
                                        <div class="history-note-box text-sm leading-6 text-slate-600">
                                            ${escapeHtml(job.moderationNote || 'Chua co ghi chu tu moderator.')}
                                        </div>
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-500 mb-2">Ky nang yeu cau</p>
                                        <div class="flex flex-wrap gap-2">
                                            ${(job.skills && job.skills.length)
                                                ? job.skills.map((skill) => `<span class="history-skill-chip">${escapeHtml(skill)}</span>`).join('')
                                                : '<span class="text-sm text-slate-400">Chua co ky nang yeu cau.</span>'}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="px-6 pb-6">
                            <div class="history-request-panel p-4">
                                <div class="history-request-head">
                                    <div>
                                        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">Request tu nanny</p>
                                        <p id="historyRequestSummary-${escapeHtml(job.id)}" class="mt-2 text-sm text-slate-500">Dang tai so luong request ung tuyen...</p>
                                        <div id="historyRequestMetrics-${escapeHtml(job.id)}" class="history-request-metrics">
                                            <span class="history-request-metric">Tong: ...</span>
                                            <span class="history-request-metric">Pending: ...</span>
                                            <span class="history-request-metric">Chap nhan: ...</span>
                                            <span class="history-request-metric">Tu choi: ...</span>
                                        </div>
                                    </div>
                                    <button id="historyRequestToggle-${escapeHtml(job.id)}"
                                            type="button"
                                            class="history-request-toggle"
                                            onclick="window.__toggleJobApplications?.('${escapeHtml(job.id)}')">
                                        <span class="material-icons-round text-base">visibility</span>
                                        Xem request
                                    </button>
                                </div>
                                <div id="historyRequestList-${escapeHtml(job.id)}" class="history-request-list hidden mt-4"></div>
                            </div>
                        </div>
                    </article>`).join('');

                await preloadApplicationSummaries(jobs);

                if (focusJobId) {
                    const target = body.querySelector(`[data-job-id="${focusJobId}"]`);
                    if (target) {
                        target.classList.add('ring-4', 'ring-orange-200', 'border-orange-300', 'shadow-[0_18px_42px_rgba(249,115,22,.16)]');
                        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        await toggleJobApplications(focusJobId, true);
                        if (focusApplicationId) {
                            await openJobApplicationDetail(focusJobId, focusApplicationId);
                        }
                    }
                }
            } catch {
                body.innerHTML = `
                    <div class="rounded-3xl border border-red-100 bg-red-50 px-6 py-10 text-center text-red-600">
                        Khong tai duoc lich su bai dang.
                    </div>`;
            }
        }

        window.__toggleJobApplications = toggleJobApplications;
        window.__openJobApplicationDetail = openJobApplicationDetail;
        window.__closeJobApplicationDetailModal = closeJobApplicationDetailModal;
        window.__submitJobApplicationReview = submitJobApplicationReview;
        window.__approveApplicant = async (btn) => {
            const jobAppId = btn?.dataset?.jobappid;
            const jobPostingId = btn?.dataset?.jobpostingid;
            if (!jobAppId || !jobPostingId) return;

            btn.disabled = true;
            const oldHtml = btn.innerHTML;
            btn.textContent = 'Dang xu ly...';
            try {
                const res = await fetch(`/Hiring/${jobPostingId}/Applicants/${jobAppId}/Approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const json = await res.json();
                if (!json?.success) throw new Error(json?.message || 'Co loi xay ra.');

                showHistoryToast('Da dong y ung vien. Vao ho so de thue chinh thuc.', 'success');
                applicationCache.delete(jobPostingId);
                await loadJobApplications(jobPostingId, true);
            } catch (err) {
                showHistoryToast(err?.message || 'Khong the dong y ung vien.', 'error');
                btn.disabled = false;
                btn.innerHTML = oldHtml;
            }
        };

        loadHistoryPage();
        window.setTimeout(consumeHistoryToast, 120);
    })();
</script>
