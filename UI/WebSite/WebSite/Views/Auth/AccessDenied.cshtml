@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Không có quyền truy cập";

    var returnUrl = ViewBag.ReturnUrl as string;
    var isAdmin = User.IsInRole("Admin");
    var isModerator = User.IsInRole("Moderator");
    var isNanny = User.IsInRole("Nanny");
    var isParent = User.IsInRole("Parent");

    var suggestedUrl = "/";
    var suggestedText = "Quay về trang chủ";
    var suggestedIcon = "home";

    if (isAdmin)
    {
        suggestedUrl = "/Admin/Dashboard";
        suggestedText = "Đi đến trang quản trị";
        suggestedIcon = "space_dashboard";
    }
    else if (isModerator)
    {
        suggestedUrl = "/Moderator/Dashboard";
        suggestedText = "Đi đến trang điều phối";
        suggestedIcon = "fact_check";
    }
    else if (isNanny)
    {
        suggestedUrl = "/Search/FindJobs";
        suggestedText = "Đi đến trang tìm việc";
        suggestedIcon = "work";
    }
    else if (isParent)
    {
        suggestedUrl = "/Nanny/List";
        suggestedText = "Đi đến trang tìm bảo mẫu";
        suggestedIcon = "child_care";
    }
}

<section class="max-w-5xl mx-auto px-4 py-16 md:py-20">
    <div class="rounded-3xl border border-orange-100 bg-gradient-to-br from-white via-orange-50/40 to-amber-50/30 shadow-[0_24px_70px_rgba(251,146,60,0.14)] overflow-hidden">
        <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
            <div class="p-8 md:p-12 lg:p-14">
                <div class="inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-4 py-1.5 text-sm font-semibold text-orange-700 mb-6">
                    <span class="material-icons-round text-base">lock_person</span>
                    403 - Truy cập bị từ chối
                </div>

                <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-4">
                    Bạn không có quyền mở trang này
                </h1>

                <p class="text-slate-600 text-base md:text-lg leading-relaxed max-w-2xl">
                    Hệ thống đã chặn truy cập để bảo vệ dữ liệu theo vai trò tài khoản. Hãy quay về khu vực hợp lệ để tiếp tục sử dụng.
                </p>

                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <div class="mt-6 rounded-2xl border border-orange-100 bg-white/80 p-4">
                        <div class="text-xs uppercase tracking-wider font-bold text-slate-500 mb-1">Đường dẫn vừa truy cập</div>
                        <div class="text-sm font-semibold text-slate-800 break-all">@returnUrl</div>
                    </div>
                }

                <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a href="@suggestedUrl" class="inline-flex items-center gap-2 min-h-[46px] px-5 rounded-full font-bold text-white bg-gradient-to-r from-orange-500 to-orange-600 shadow-[0_14px_30px_rgba(249,115,22,0.28)] hover:brightness-105 transition">
                        <span class="material-icons-round text-base">@suggestedIcon</span>
                        @suggestedText
                    </a>
                    <a href="/" class="inline-flex items-center gap-2 min-h-[46px] px-5 rounded-full border border-slate-200 text-slate-700 font-semibold bg-white hover:border-orange-300 hover:text-orange-700 transition">
                        <span class="material-icons-round text-base">arrow_back</span>
                        Về trang chủ
                    </a>
                </div>
            </div>

            <div class="relative p-8 md:p-12 bg-[radial-gradient(circle_at_18%_12%,rgba(251,146,60,0.2),transparent_44%),radial-gradient(circle_at_86%_88%,rgba(251,191,36,0.22),transparent_40%),linear-gradient(180deg,#fff7ed_0%,#fff_100%)] border-t lg:border-t-0 lg:border-l border-orange-100">
                <div class="h-full rounded-3xl border border-orange-200/70 bg-white/70 backdrop-blur p-6 md:p-8 flex flex-col justify-between">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-orange-100 text-orange-600 flex items-center justify-center mb-5">
                            <span class="material-icons-round text-3xl">admin_panel_settings</span>
                        </div>
                        <h2 class="text-xl font-extrabold text-slate-900 mb-3">Vì sao bạn thấy màn này?</h2>
                        <ul class="space-y-2.5 text-sm md:text-base text-slate-600">
                            <li class="flex gap-2.5">
                                <span class="material-icons-round text-orange-500 text-lg mt-0.5">check_circle</span>
                                <span>Bạn đã đăng nhập nhưng vai trò hiện tại không phù hợp với trang yêu cầu.</span>
                            </li>
                            <li class="flex gap-2.5">
                                <span class="material-icons-round text-orange-500 text-lg mt-0.5">check_circle</span>
                                <span>Trang này chỉ mở cho nhóm quyền chuyên biệt như Admin, Moderator hoặc Nanny.</span>
                            </li>
                            <li class="flex gap-2.5">
                                <span class="material-icons-round text-orange-500 text-lg mt-0.5">check_circle</span>
                                <span>Không có dữ liệu nào bị thay đổi, bạn có thể quay lại khu vực hợp lệ ngay.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-8 rounded-2xl border border-orange-100 bg-orange-50/70 p-4">
                        <div class="text-sm font-semibold text-orange-900">Gợi ý</div>
                        <p class="text-sm text-orange-800 mt-1 leading-relaxed">
                            Nếu bạn cần truy cập trang này cho công việc, hãy liên hệ quản trị viên để được cấp đúng vai trò.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
