@model WebSite.Models.Auth.VerifyEmailViewModel
@{
    ViewData["Title"] = "Xác thực email";
}

<div class="min-h-[60vh] flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8">
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-icons-round text-3xl text-green-500">mark_email_read</span>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Xác thực email</h1>
                <p class="text-gray-500 dark:text-gray-400 mt-2">Nhập mã OTP đã gửi đến email của bạn</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-sm">
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-xl mb-4 text-sm">
                    @TempData["Info"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm">
                    @TempData["Error"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm"></div>
            }

            <form asp-action="VerifyEmail" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Mã OTP</label>
                        <input asp-for="OtpCode" maxlength="6" placeholder="000000"
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all text-center text-2xl tracking-[0.5em] font-mono" />
                        <span asp-validation-for="OtpCode" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white py-3 rounded-xl font-bold shadow-lg shadow-green-500/30 transition-all hover:scale-[1.02] active:scale-95">
                        Xác thực
                    </button>
                </div>
            </form>

            <form asp-action="ResendVerifyEmail" method="post" class="mt-4 text-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Không nhận được mã?
                    <button id="resendBtn" type="submit" disabled
                            class="font-semibold text-gray-400 bg-transparent border-none cursor-not-allowed p-0 transition-colors">
                        Gửi lại sau <span id="countdown">180</span>s
                    </button>
                </p>
            </form>

<script>
(function () {
    const btn = document.getElementById('resendBtn');
    const counter = document.getElementById('countdown');
    let seconds = 180;
    const timer = setInterval(() => {
        seconds--;
        counter.textContent = seconds;
        if (seconds <= 0) {
            clearInterval(timer);
            btn.disabled = false;
            btn.className = 'font-semibold text-orange-500 hover:text-orange-600 underline-offset-2 hover:underline bg-transparent border-none cursor-pointer p-0 transition-colors';
            btn.innerHTML = 'Gửi lại mã OTP';
        }
    }, 1000);
})();
</script>
        </div>
    </div>
</div>
