@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="min-h-[60vh] flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8">
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-orange-100 dark:bg-orange-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-icons-round text-3xl text-primary">password</span>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Đổi mật khẩu</h1>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-sm">
                    @TempData["Success"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm"></div>
            }

            <form id="changePasswordForm" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Mật khẩu hiện tại</label>
                        <div class="relative">
                            <input type="password" name="currentPassword" id="currentPassword" required
                                   class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all pr-12" />
                            <button type="button" onclick="togglePwd('currentPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <span class="material-icons-round text-xl">visibility_off</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Mật khẩu mới</label>
                        <div class="relative">
                            <input type="password" name="newPassword" id="newPassword" required minlength="8" placeholder="Tối thiểu 8 ký tự"
                                   class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all pr-12" />
                            <button type="button" onclick="togglePwd('newPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <span class="material-icons-round text-xl">visibility_off</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Xác nhận mật khẩu mới</label>
                        <div class="relative">
                            <input type="password" id="confirmPassword" required minlength="8" placeholder="Nhập lại mật khẩu mới"
                                   class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all pr-12" />
                            <button type="button" onclick="togglePwd('confirmPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <span class="material-icons-round text-xl">visibility_off</span>
                            </button>
                        </div>
                        <p id="confirmError" class="text-red-500 text-xs mt-1 hidden">Mật khẩu xác nhận không khớp.</p>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full bg-primary hover:bg-primaryDark text-white py-3 rounded-xl font-bold shadow-lg shadow-orange-500/30 transition-all hover:scale-[1.02] active:scale-95">
                        Đổi mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function togglePwd(id, btn) {
        var input = document.getElementById(id);
        var icon = btn.querySelector('span');
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility_off';
        }
    }

    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        var newPwd = document.getElementById('newPassword').value;
        var confirmPwd = document.getElementById('confirmPassword').value;
        var errEl = document.getElementById('confirmError');
        var confirmInput = document.getElementById('confirmPassword');
        if (newPwd !== confirmPwd) {
            e.preventDefault();
            errEl.classList.remove('hidden');
            confirmInput.classList.add('border-red-500');
            confirmInput.focus();
        } else {
            errEl.classList.add('hidden');
            confirmInput.classList.remove('border-red-500');
        }
    });
</script>
