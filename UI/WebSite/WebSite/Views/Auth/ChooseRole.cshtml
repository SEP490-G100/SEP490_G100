@{
    ViewData["Title"] = "Chọn Vai Trò";
}

<div class="nm-flow-shell">
    <div class="nm-flow-container max-w-5xl">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Vai trò sử dụng</span>
                        <h1 class="nm-flow-title">Chọn đúng vai trò ngay từ đầu</h1>
                        <p class="nm-flow-subtitle">
                            Lựa chọn này quyết định luồng nhập thông tin tiếp theo và các tính năng hệ thống mở cho bạn sau khi vào trang.
                        </p>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="nm-alert">@TempData["Error"]</div>
                }

                <form asp-action="ChooseRole" method="post" id="chooseRoleForm">
                    @Html.AntiForgeryToken()

                    <div class="nm-choice-grid">
                        <label class="cursor-pointer">
                            <input type="radio" name="Role" value="Parent" class="sr-only nm-choice-input" />
                            <span class="nm-choice-card">
                                <span class="nm-choice-card__check">
                                    <span class="material-icons-round text-sm">check</span>
                                </span>
                                <span class="nm-choice-card__icon">
                                    <span class="material-icons-round text-4xl">family_restroom</span>
                                </span>
                                <span class="nm-choice-card__title">Phụ Huynh</span>
                                <span class="nm-choice-card__text">
                                    Đăng bài tìm nanny, xem profile, gửi yêu cầu liên hệ và quản lý quá trình tìm người chăm bé.
                                </span>
                            </span>
                        </label>

                        <label class="cursor-pointer">
                            <input type="radio" name="Role" value="Nanny" class="sr-only nm-choice-input" />
                            <span class="nm-choice-card">
                                <span class="nm-choice-card__check">
                                    <span class="material-icons-round text-sm">check</span>
                                </span>
                                <span class="nm-choice-card__icon">
                                    <span class="material-icons-round text-4xl">child_care</span>
                                </span>
                                <span class="nm-choice-card__title">Người Giữ Trẻ</span>
                                <span class="nm-choice-card__text">
                                    Tạo profile nghề nghiệp, cập nhật kỹ năng, lịch rảnh và nhận yêu cầu từ phụ huynh trên hệ thống.
                                </span>
                            </span>
                        </label>
                    </div>

                    <div class="nm-flow-actions">
                        <a asp-action="Register" class="nm-btn nm-btn--ghost">Quay Lại</a>
                        <button type="submit" id="submitBtn" disabled class="nm-btn nm-btn--primary">Tiếp Tục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.getElementById('submitBtn').disabled = false;
            });
        });
    </script>
}
