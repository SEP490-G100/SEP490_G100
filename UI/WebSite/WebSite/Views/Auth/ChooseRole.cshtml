@{
    ViewData["Title"] = "Chọn vai trò";
}

<div class="min-h-[60vh] flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-lg">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8">
            <div class="text-center mb-8">
                <div class="text-5xl mb-4">Bạn đang tìm kiếm điều gì?</div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Chọn vai trò của bạn</h1>
                <p class="text-gray-500 dark:text-gray-400 mt-2">Bạn muốn sử dụng NannyMatch với vai trò nào?</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="ChooseRole" method="post" id="chooseRoleForm">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                    <!-- Parent Card -->
                    <label class="group cursor-pointer">
                        <input type="radio" name="Role" value="Parent" class="sr-only peer" />
                        <div class="flex flex-col items-center gap-3 p-6 rounded-2xl border-2 border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 transition-all duration-300
                                    peer-checked:border-orange-500 peer-checked:bg-orange-50 dark:peer-checked:bg-orange-900/20 peer-checked:shadow-lg peer-checked:shadow-orange-500/20
                                    hover:border-orange-300 hover:shadow-md">
                            <div class="text-5xl"></div>
                            <div class="text-center">
                                <p class="font-bold text-gray-900 dark:text-white text-lg">Phụ huynh</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Tìm người trông trẻ cho con em bạn</p>
                            </div>
                            <div class="w-5 h-5 rounded-full border-2 border-gray-300 peer-checked:border-orange-500 peer-checked:bg-orange-500 transition-all
                                        group-[input:checked]:border-orange-500 flex items-center justify-center mt-2">
                            </div>
                        </div>
                    </label>

                    <!-- Nanny Card -->
                    <label class="group cursor-pointer">
                        <input type="radio" name="Role" value="Nanny" class="sr-only peer" />
                        <div class="flex flex-col items-center gap-3 p-6 rounded-2xl border-2 border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 transition-all duration-300
                                    peer-checked:border-green-500 peer-checked:bg-green-50 dark:peer-checked:bg-green-900/20 peer-checked:shadow-lg peer-checked:shadow-green-500/20
                                    hover:border-green-300 hover:shadow-md">
                            <div class="text-5xl"></div>
                            <div class="text-center">
                                <p class="font-bold text-gray-900 dark:text-white text-lg">Người trông trẻ</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Tìm việc trông trẻ phù hợp với bạn</p>
                            </div>
                            <div class="w-5 h-5 rounded-full border-2 border-gray-300 peer-checked:border-green-500 peer-checked:bg-green-500 transition-all
                                        flex items-center justify-center mt-2">
                            </div>
                        </div>
                    </label>
                </div>

                <button type="submit" id="submitBtn" disabled
                        class="w-full py-3 rounded-xl font-bold shadow-lg transition-all text-white
                               bg-gray-300 dark:bg-gray-600 cursor-not-allowed
                               enabled:bg-orange-500 enabled:hover:bg-orange-600 enabled:shadow-orange-500/30 enabled:cursor-pointer enabled:hover:scale-[1.02] enabled:active:scale-95">
                    Tiếp tục
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.getElementById('submitBtn').disabled = false;

                // Update visual radio indicators
                document.querySelectorAll('input[name="Role"]').forEach(function (r) {
                    var indicator = r.closest('label').querySelector('.w-5.h-5');
                    if (r.checked) {
                        indicator.innerHTML = '<svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="5"/></svg>';
                    } else {
                        indicator.innerHTML = '';
                    }
                });
            });
        });
    </script>
}
