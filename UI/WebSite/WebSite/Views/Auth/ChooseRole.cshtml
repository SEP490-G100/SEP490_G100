@{
    ViewData["Title"] = "Chon vai tro";
}

<div class="nm-flow-shell">
    <div class="nm-flow-container max-w-5xl">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Vai tro su dung</span>
                        <h1 class="nm-flow-title">Chon dung vai tro ngay tu dau</h1>
                        <p class="nm-flow-subtitle">
                            Lua chon nay quyet dinh luong nhap thong tin tiep theo va cac tinh nang he thong mo cho ban sau khi vao trang.
                        </p>
                    </div>
                    <div class="nm-flow-progress" aria-hidden="true">
                        <span class="nm-progress-step">1</span>
                        <span class="nm-progress-line"></span>
                        <span class="nm-progress-step is-active">2</span>
                        <span class="nm-progress-line"></span>
                        <span class="nm-progress-step">3</span>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="nm-alert">@TempData["Error"]</div>
                }

                <form asp-action="ChooseRole" method="post" id="chooseRoleForm">
                    @Html.AntiForgeryToken()

                    <div class="nm-choice-grid">
                        <label class="cursor-pointer">
                            <input type="radio" name="Role" value="Parent" class="sr-only nm-choice-input" />
                            <span class="nm-choice-card">
                                <span class="nm-choice-card__check">
                                    <span class="material-icons-round text-sm">check</span>
                                </span>
                                <span class="nm-choice-card__icon">
                                    <span class="material-icons-round text-4xl">family_restroom</span>
                                </span>
                                <span class="nm-choice-card__title">Parent</span>
                                <span class="nm-choice-card__text">
                                    Dang bai tim nanny, xem ho so, gui contact request va quan ly qua trinh tim nguoi cham be.
                                </span>
                            </span>
                        </label>

                        <label class="cursor-pointer">
                            <input type="radio" name="Role" value="Nanny" class="sr-only nm-choice-input" />
                            <span class="nm-choice-card">
                                <span class="nm-choice-card__check">
                                    <span class="material-icons-round text-sm">check</span>
                                </span>
                                <span class="nm-choice-card__icon">
                                    <span class="material-icons-round text-4xl">child_care</span>
                                </span>
                                <span class="nm-choice-card__title">Nanny</span>
                                <span class="nm-choice-card__text">
                                    Tao ho so nghe nghiep, cap nhat ky nang, lich ranh va nhan request tu phu huynh tren he thong.
                                </span>
                            </span>
                        </label>
                    </div>

                    <div class="nm-flow-actions">
                        <a asp-action="Register" class="nm-btn nm-btn--ghost">Quay lai</a>
                        <button type="submit" id="submitBtn" disabled class="nm-btn nm-btn--primary">Tiep tuc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.getElementById('submitBtn').disabled = false;
            });
        });
    </script>
}
