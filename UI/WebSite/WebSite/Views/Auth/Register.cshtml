@model WebSite.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="min-h-[60vh] flex items-center justify-center py-16 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Tạo tài khoản</h1>
                <p class="text-gray-500 dark:text-gray-400 mt-2">Tham gia NannyMatch miễn phí</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm">
                    @TempData["Error"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-sm"></div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Họ</label>
                            <input asp-for="FirstName" placeholder="Nguyễn"
                                   class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all" />
                            <span asp-validation-for="FirstName" class="text-red-500 text-xs mt-1"></span>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Tên</label>
                            <input asp-for="LastName" placeholder="An"
                                   class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all" />
                            <span asp-validation-for="LastName" class="text-red-500 text-xs mt-1"></span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Email</label>
                        <input asp-for="Email" type="email" placeholder="email@example.com"
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all" />
                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Số điện thoại (tuỳ chọn)</label>
                        <input asp-for="PhoneNumber" type="tel" placeholder="0901234567"
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all" />
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Mật khẩu</label>
                        <div class="relative">
                            <input asp-for="Password" type="text" placeholder="Tối thiểu 8 ký tự" id="regPassword"
                                   class="pwd-field w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all pr-12" />
                            <button type="button" onclick="togglePassword('regPassword', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <span class="material-icons-round text-xl">visibility_off</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu"
                               class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 outline-none transition-all" />
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1"></span>
                    </div>



                    <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white py-3 rounded-xl font-bold shadow-lg shadow-orange-500/30 transition-all hover:scale-[1.02] active:scale-95">
                        Đăng ký
                    </button>
                </div>
            </form>

            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-gray-200 dark:border-gray-600"></div></div>
                <div class="relative flex justify-center text-sm"><span class="px-4 bg-white dark:bg-gray-800 text-gray-500">hoặc</span></div>
            </div>

            <div id="g_id_onload"
                 data-client_id="@ViewBag.GoogleClientId"
                 data-context="signup"
                 data-ux_mode="popup"
                 data-callback="onGoogleSignIn"
                 data-auto_prompt="false">
            </div>
            <div class="g_id_signin" data-type="standard" data-size="large" data-theme="outline" data-text="signup_with" data-shape="pill" data-width="400"></div>

            <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6">
                Đã có tài khoản?
                <a asp-action="Login" class="font-semibold text-orange-500 hover:text-orange-600">Đăng nhập</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        function onGoogleSignIn(response) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("GoogleLogin")';
            var token = document.createElement('input');
            token.type = 'hidden'; token.name = 'idToken'; token.value = response.credential;
            var antiForgery = document.querySelector('input[name="__RequestVerificationToken"]');
            var af = document.createElement('input');
            af.type = 'hidden'; af.name = '__RequestVerificationToken'; af.value = antiForgery.value;
            form.appendChild(token); form.appendChild(af);
            document.body.appendChild(form); form.submit();
        }

        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('.material-icons-round');
            var isShowing = input.classList.toggle('show');
            icon.textContent = isShowing ? 'visibility' : 'visibility_off';
        }
    </script>
}
