@model WebSite.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký";
}

<div class="nm-flow-shell">
    <div class="nm-flow-container max-w-5xl">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Tài Khoản Mới</span>
                        <h1 class="nm-flow-title">Tạo Tài Khoản NannyMatch</h1>
                        <p class="nm-flow-subtitle">
                            Hoàn tất tài khoản trong một màn hình gọn gàng. Sau bước này hệ thống sẽ dẫn bạn vào luồng nhập thông tin theo vai trò.
                        </p>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="nm-alert">@TempData["Error"]</div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="nm-alert"></div>
                }

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="nm-form-grid">
                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Thông Tin Tài Khoản</div>
                                <div class="nm-section-note">Nhập thông tin cơ bản để tạo tài khoản. Số điện thoại có thể bổ sung sau.</div>

                                <div class="nm-form-grid">
                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="FirstName" class="nm-label">Họ <span class="required">*</span></label>
                                            <input asp-for="FirstName" class="nm-input" placeholder="Nguyễn" />
                                            <span asp-validation-for="FirstName" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="LastName" class="nm-label">Tên <span class="required">*</span></label>
                                            <input asp-for="LastName" class="nm-input" placeholder="An" />
                                            <span asp-validation-for="LastName" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="Email" class="nm-label">Email <span class="required">*</span></label>
                                            <input asp-for="Email" type="email" class="nm-input" placeholder="email@example.com" />
                                            <span asp-validation-for="Email" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="PhoneNumber" class="nm-label">Số Điện Thoại</label>
                                            <input asp-for="PhoneNumber" type="tel" class="nm-input" placeholder="0901234567" />
                                            <div class="nm-field-hint">Trường này không bắt buộc, bạn có thể cập nhật sau trong profile.</div>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="Password" class="nm-label">Mật Khẩu <span class="required">*</span></label>
                                            <div class="nm-password-wrap">
                                                <input asp-for="Password" type="text" id="regPassword" class="nm-input pwd-field" placeholder="Tối thiểu 8 ký tự" />
                                                <button type="button" onclick="togglePassword('regPassword', this)" class="nm-password-toggle" aria-label="Hiển thị mật khẩu">
                                                    <span class="material-icons-round text-xl">visibility_off</span>
                                                </button>
                                            </div>
                                            <span asp-validation-for="Password" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="ConfirmPassword" class="nm-label">Xác Nhận Mật Khẩu <span class="required">*</span></label>
                                            <input asp-for="ConfirmPassword" type="password" class="nm-input" placeholder="Nhập lại mật khẩu" />
                                            <span asp-validation-for="ConfirmPassword" class="nm-error"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="nm-flow-actions">
                        <a asp-action="Login" class="nm-btn nm-btn--ghost">Đã Có Tài Khoản</a>
                        <button type="submit" class="nm-btn nm-btn--primary">Đăng Ký</button>
                    </div>
                </form>

                <div class="nm-divider"><span>Hoặc</span></div>

                <div id="g_id_onload"
                     data-client_id="@ViewBag.GoogleClientId"
                     data-context="signup"
                     data-ux_mode="popup"
                     data-callback="onGoogleSignIn"
                     data-auto_prompt="false">
                </div>

                <div class="nm-google-wrap">
                    <div class="g_id_signin"
                         data-type="standard"
                         data-size="large"
                         data-theme="outline"
                         data-text="signup_with"
                         data-shape="pill"
                         data-width="360"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        function onGoogleSignIn(response) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("GoogleLogin")';

            var token = document.createElement('input');
            token.type = 'hidden';
            token.name = 'idToken';
            token.value = response.credential;

            var antiForgery = document.querySelector('input[name="__RequestVerificationToken"]');
            var af = document.createElement('input');
            af.type = 'hidden';
            af.name = '__RequestVerificationToken';
            af.value = antiForgery.value;

            form.appendChild(token);
            form.appendChild(af);
            document.body.appendChild(form);
            form.submit();
        }

        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('.material-icons-round');
            var isShowing = input.type === 'text';
            input.type = isShowing ? 'password' : 'text';
            icon.textContent = isShowing ? 'visibility_off' : 'visibility';
        }
    </script>
}
