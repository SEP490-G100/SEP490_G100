@model WebSite.Models.Admin.CreateModeratorRequest
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Tạo Kiểm Duyệt Viên";
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">Hành Động Quản Trị</span>
        <h1 class="page-title mt-2">
            Tạo <span class="gradient-text">Kiểm Duyệt Viên</span>
        </h1>
        <p class="page-subtitle">Thêm một kiểm duyệt viên mới vào đội ngũ quản trị nền tảng.</p>
    </div>
    <a href="/Admin/ManageModerators" class="btn-outline flex-shrink-0">
        <span class="material-icons-round text-base">arrow_back</span>
        Quay Lại Danh Sách
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}

<form method="post" action="/Admin/CreateModerator">
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 space-y-5">
            <div class="content-card p-0 fade-in-up">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">lock</span>
                        <h2>Thông Tin Đăng Nhập <span class="text-xs text-red-500 font-semibold ml-1">* bắt buộc</span></h2>
                    </div>
                </div>

                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="field-group sm:col-span-2">
                        <label asp-for="Email" class="field-label">Email <span class="text-red-400">*</span></label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-base pointer-events-none">email</span>
                            <input asp-for="Email" id="emailInput" type="email" placeholder="moderator@nannymatch.vn" class="search-input !pl-9 w-full" />
                        </div>
                        <span asp-validation-for="Email" class="text-xs text-red-500 mt-1"></span>
                    </div>

                    <div class="field-group sm:col-span-2">
                        <label asp-for="Password" class="field-label">Mật Khẩu <span class="text-red-400">*</span></label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-base pointer-events-none">lock_outline</span>
                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="Tối thiểu 8 kí tự, có kí tự đặc biệt"
                                   class="search-input !pl-9 w-full pr-10" />
                            <button type="button"
                                    onclick="togglePassword()"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none">
                                <span id="pwdIcon" class="material-icons-round text-base">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-xs text-red-500 mt-1"></span>
                    </div>
                </div>
            </div>

            <div class="content-card p-0 fade-in-up" style="animation-delay:.05s;">
                <div class="card-header">
                    <div class="flex items-center gap-2">
                        <span class="material-icons-round text-orange-400">person</span>
                        <h2>Thông Tin Cá Nhân</h2>
                    </div>
                </div>

                <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="field-group">
                        <label asp-for="FirstName" class="field-label">Họ <span class="text-red-400">*</span></label>
                        <input asp-for="FirstName" id="firstNameInput" type="text" placeholder="Ví dụ: Nguyễn" class="search-input w-full" />
                        <span asp-validation-for="FirstName" class="text-xs text-red-500 mt-1"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="LastName" class="field-label">Tên <span class="text-red-400">*</span></label>
                        <input asp-for="LastName" id="lastNameInput" type="text" placeholder="Ví dụ: An" class="search-input w-full" />
                        <span asp-validation-for="LastName" class="text-xs text-red-500 mt-1"></span>
                    </div>

                    <div class="field-group sm:col-span-2">
                        <label asp-for="PhoneNumber" class="field-label">
                            Số Điện Thoại
                            <span class="text-gray-400 text-xs normal-case ml-1">(không bắt buộc)</span>
                        </label>
                        <div class="relative">
                            <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-base pointer-events-none">phone</span>
                            <input asp-for="PhoneNumber"
                                   id="phoneInput"
                                   type="tel"
                                   placeholder="10-11 chữ số"
                                   pattern="^[0-9]{10,11}$"
                                   maxlength="11"
                                   oninput="validatePhone(this)"
                                   class="search-input !pl-9 w-full" />
                        </div>
                        <p id="phone-error" class="text-xs text-red-500 mt-1 hidden">
                            Số điện thoại phải có 10-11 chữ số (chỉ chứa số).
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-5">
            <div class="content-card p-6 text-center fade-in-up" style="animation-delay:.08s;">
                <div class="w-20 h-20 rounded-full bg-orange-50 flex items-center justify-center text-orange-300 ring-4 ring-orange-50 mb-4 mx-auto dashed-border">
                    <span class="material-icons-round text-3xl">add_photo_alternate</span>
                </div>

                <h3 class="font-bold text-gray-900 text-lg">Kiểm Duyệt Viên Mới</h3>
                <p class="text-sm text-gray-400 mt-0.5">Nhập đầy đủ thông tin</p>

                <div class="flex flex-wrap gap-1.5 justify-center mt-3">
                    <span class="badge badge-mod">Kiểm Duyệt Viên</span>
                </div>
            </div>

            <div class="content-card p-4 space-y-2.5 fade-in-up" style="animation-delay:.12s;">
                <button type="submit" class="btn-primary w-full justify-center">
                    <span class="material-icons-round text-base">person_add</span>
                    Tạo Kiểm Duyệt Viên
                </button>
                <a href="/Admin/ManageModerators" class="btn-outline w-full justify-center">
                    <span class="material-icons-round text-base">close</span>
                    Hủy
                </a>
            </div>

            <div class="bg-orange-50 border border-orange-100 rounded-2xl p-4 flex gap-3 fade-in-up" style="animation-delay:.15s;">
                <span class="material-icons-round text-orange-400 text-xl flex-shrink-0">info</span>
                <p class="text-xs text-orange-800 leading-relaxed">
                    Mặc định, tài khoản kiểm duyệt viên mới được tạo với trạng thái <strong class="text-orange-900">Hoạt Động</strong> và có thể đăng nhập ngay bằng thông tin đã cung cấp.
                </p>
            </div>
        </div>
    </div>
</form>

<style>
.field-group { display: flex; flex-direction: column; gap: .4rem; }
.field-label {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #9CA3AF;
}
.dashed-border {
    border: 2px dashed #FED7AA;
}
input.input-validation-error {
    border-color: #f87171 !important;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function validatePhone(input) {
            var val = input.value.replace(/\D/g, '');
            input.value = val;

            var err = document.getElementById('phone-error');
            if (val.length > 0 && (val.length < 10 || val.length > 11)) {
                err.classList.remove('hidden');
                input.classList.add('!border-red-400');
            } else {
                err.classList.add('hidden');
                input.classList.remove('!border-red-400');
            }
        }

        function togglePassword() {
            var input = document.getElementById('passwordInput');
            var icon = document.getElementById('pwdIcon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>
}
