@model List<WebSite.Models.Admin.AdminPlanDto>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Subscription Plans";
}

<!-- PAGE HEADER -->
<div class="mb-7 fade-in-up flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
        <span class="section-label">Subscription</span>
        <h1 class="page-title mt-2">
            Manage <span class="gradient-text">Plans</span>
        </h1>
        <p class="page-subtitle">Tạo, chỉnh sửa và xóa các gói subscription.</p>
    </div>
    <button onclick="openCreateModal()"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-400 to-orange-500 text-white px-5 py-2.5 rounded-xl font-semibold shadow-lg shadow-orange-500/30 hover:-translate-y-0.5 transition-all">
        <span class="material-icons-round text-xl">add</span>
        Tạo gói mới
    </button>
</div>

<!-- ALERTS -->
@if (TempData["Success"] != null)
{
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm font-semibold">
        ✅ @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm font-semibold">
        ❌ @TempData["Error"]
    </div>
}

<!-- PLAN TABLE -->
<div class="content-card overflow-hidden fade-in-up">
    <div class="card-header flex items-center justify-between">
        <h2>📦 Danh sách gói (@Model.Count gói)</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="px-6 py-16 text-center text-gray-400 text-sm">
            <span class="material-icons-round text-5xl mb-3 block text-gray-200">card_membership</span>
            Chưa có gói nào. Nhấn "Tạo gói mới" để bắt đầu.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                    <tr>
                        <th class="px-5 py-3 text-left">Tên gói</th>
                        <th class="px-5 py-3 text-left">Giá</th>
                        <th class="px-5 py-3 text-left">Thời hạn</th>
                        <th class="px-5 py-3 text-left">Features</th>
                        <th class="px-5 py-3 text-center">User đang dùng</th>
                        <th class="px-5 py-3 text-center">Trạng thái</th>
                        <th class="px-5 py-3 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var plan in Model)
                    {
                        <tr class="hover:bg-orange-50/30 transition-colors">
                            <td class="px-5 py-3.5">
                                <p class="font-bold text-gray-800">@plan.Name</p>
                                <p class="text-xs text-gray-400 mt-0.5">@plan.Description</p>
                            </td>
                            <td class="px-5 py-3.5 font-semibold text-gray-700">
                                @plan.Price.ToString("N0") ₫
                            </td>
                            <td class="px-5 py-3.5 text-gray-600">@plan.DurationDays ngày</td>
                            <td class="px-5 py-3.5">
                                @if (plan.Features.Any())
                                {
                                    <ul class="space-y-0.5">
                                        @foreach (var f in plan.Features)
                                        {
                                            <li class="text-xs text-gray-500 flex items-center gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-orange-400 inline-block flex-shrink-0"></span>@f
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-300 italic">Chưa có</span>
                                }
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                <span class="font-bold text-gray-700">@plan.ActiveSubscriberCount</span>
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                @if (plan.IsActive)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive">Inactive</span>
                                }
                            </td>
                            <td class="px-5 py-3.5 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button onclick="openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(plan)))"
                                            class="p-1.5 rounded-lg hover:bg-orange-100 text-orange-500 transition-colors" title="Chỉnh sửa">
                                        <span class="material-icons-round text-base">edit</span>
                                    </button>
                                    @if (plan.ActiveSubscriberCount == 0)
                                    {
                                        <form method="post" asp-action="DeletePlan" asp-route-id="@plan.Id"
                                              onsubmit="return confirm('Xóa gói «@plan.Name»? Hành động này không thể hoàn tác.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1.5 rounded-lg hover:bg-red-100 text-red-400 transition-colors" title="Xóa">
                                                <span class="material-icons-round text-base">delete</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-300" title="Không thể xóa khi còn user đang dùng">
                                            <span class="material-icons-round text-base">lock</span>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ═══ CREATE MODAL ═══ -->
<div id="createModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 p-6">
        <h2 class="text-lg font-bold text-gray-800 mb-5">✨ Tạo gói mới</h2>
        <form method="post" asp-action="CreatePlan">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("~/Views/Admin/Partials/_PlanFormFields.cshtml", new WebSite.Models.Admin.AdminPlanDto())
            <div class="flex gap-3 mt-6">
                <button type="submit" class="flex-1 bg-gradient-to-r from-orange-400 to-orange-500 text-white py-2.5 rounded-xl font-semibold">
                    Tạo gói
                </button>
                <button type="button" onclick="closeModal('createModal')"
                        class="flex-1 bg-gray-100 text-gray-700 py-2.5 rounded-xl font-semibold hover:bg-gray-200 transition-colors">
                    Hủy
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ═══ EDIT MODAL ═══ -->
<div id="editModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 p-6">
        <h2 class="text-lg font-bold text-gray-800 mb-5">✏️ Chỉnh sửa gói</h2>
        <form method="post" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editId" />
            <div class="space-y-4">
                <div>
                    <label class="text-sm font-semibold text-gray-600">Tên gói</label>
                    <input id="editName" name="Name" class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" />
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-600">Mô tả</label>
                    <input id="editDescription" name="Description" class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-sm font-semibold text-gray-600">Giá (₫)</label>
                        <input id="editPrice" name="Price" type="number" min="0" class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" />
                    </div>
                    <div>
                        <label class="text-sm font-semibold text-gray-600">Thời hạn (ngày)</label>
                        <input id="editDuration" name="DurationDays" type="number" min="1" class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" />
                    </div>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-600">Features (mỗi dòng 1 tính năng)</label>
                    <textarea id="editFeatures" name="FeaturesRaw" rows="4"
                              class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 resize-none"></textarea>
                </div>
                <div class="flex items-center gap-3">
                    <input id="editIsActive" name="IsActive" type="checkbox" class="rounded" />
                    <label for="editIsActive" class="text-sm font-semibold text-gray-600">Kích hoạt (hiển thị cho người dùng)</label>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-600">Sort Order</label>
                    <input id="editSortOrder" name="SortOrder" type="number" min="0" class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" />
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="submit" class="flex-1 bg-gradient-to-r from-orange-400 to-orange-500 text-white py-2.5 rounded-xl font-semibold">
                    Lưu thay đổi
                </button>
                <button type="button" onclick="closeModal('editModal')"
                        class="flex-1 bg-gray-100 text-gray-700 py-2.5 rounded-xl font-semibold hover:bg-gray-200 transition-colors">
                    Hủy
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Create form fields inline for simplicity -->
<div id="createFormFields" class="hidden">
    <div class="space-y-4">
        <div>
            <label class="text-sm font-semibold text-gray-600">Tên gói <span class="text-red-400">*</span></label>
            <input name="Name" required class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="VD: Gói Pro" />
        </div>
        <div>
            <label class="text-sm font-semibold text-gray-600">Mô tả</label>
            <input name="Description" class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="text-sm font-semibold text-gray-600">Giá (₫) <span class="text-red-400">*</span></label>
                <input name="Price" type="number" min="0" required class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="99000" />
            </div>
            <div>
                <label class="text-sm font-semibold text-gray-600">Thời hạn (ngày) <span class="text-red-400">*</span></label>
                <input name="DurationDays" type="number" min="1" required class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="30" />
            </div>
        </div>
        <div>
            <label class="text-sm font-semibold text-gray-600">Features (mỗi dòng 1 tính năng)</label>
            <textarea name="FeaturesRaw" rows="4"
                      class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 resize-none"
                      placeholder="Badge noi bat&#10;Uu tien tim kiem&#10;Dang toi da 5 bai/thang"></textarea>
        </div>
        <div class="flex items-center gap-3">
            <input name="IsActive" type="checkbox" checked class="rounded" id="createIsActive" />
            <label for="createIsActive" class="text-sm font-semibold text-gray-600">Kích hoạt ngay</label>
        </div>
    </div>
</div>

<script>
function openCreateModal() {
    // Build create form inline
    const modal = document.getElementById('createModal');
    const formContent = document.getElementById('createFormFields').innerHTML;
    const formEl = modal.querySelector('form');
    // Replace placeholder partial with actual fields
    const placeholder = formEl.querySelector('[data-partial]');
    if (placeholder) placeholder.outerHTML = formContent;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function openEditModal(plan) {
    document.getElementById('editId').value = plan.id;
    document.getElementById('editName').value = plan.name || '';
    document.getElementById('editDescription').value = plan.description || '';
    document.getElementById('editPrice').value = plan.price || 0;
    document.getElementById('editDuration').value = plan.durationDays || 30;
    document.getElementById('editFeatures').value = (plan.features || []).join('\n');
    document.getElementById('editIsActive').checked = plan.isActive;
    document.getElementById('editSortOrder').value = plan.sortOrder || 0;
    document.getElementById('editForm').action = `/Admin/EditPlan/${plan.id}`;

    const modal = document.getElementById('editModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeModal(id) {
    const modal = document.getElementById(id);
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

// Close on backdrop click
['createModal','editModal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
        if (e.target === this) closeModal(id);
    });
});
</script>

<!-- Inline create modal — rebuild the form properly -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const createModal = document.getElementById('createModal');
    const form = createModal.querySelector('form');
    const fieldsHtml = document.getElementById('createFormFields').innerHTML;
    // Replace partial placeholder
    const partialEl = form.querySelector('[data-partial="plan-fields"]');
    if (partialEl) partialEl.outerHTML = fieldsHtml;
});
</script>
