@model WebSite.Models.Admin.AdminSubscriptionPlanListResponse
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Subscription Plans";

    var currentSearch = ViewBag.Search as string ?? "";
    var currentTargetRole = ViewBag.TargetRole as string ?? "";
    var currentStatus = ViewBag.IsActive as bool?;
    var currentStatusValue = currentStatus.HasValue ? currentStatus.Value.ToString().ToLowerInvariant() : "";
    var currentPage = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var pageSize = Model?.PageSize ?? 3;
    var plans = Model?.Items ?? new List<WebSite.Models.Admin.AdminSubscriptionPlanListItemViewModel>();
    var preservedQuery = Context.Request.Query
        .Where(q =>
            !string.Equals(q.Key, "toastType", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(q.Key, "toastMessage", StringComparison.OrdinalIgnoreCase))
        .SelectMany(q => q.Value, (q, value) =>
            $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(value ?? string.Empty)}");
    var currentUrl = preservedQuery.Any()
        ? $"{Context.Request.Path}?{string.Join("&", preservedQuery)}"
        : Context.Request.Path.ToString();
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">Subscription Management</span>
        <h1 class="page-title mt-2">Manage <span class="gradient-text">Subscription Plans</span></h1>
        <p class="page-subtitle">Create, review, activate or deactivate subscription plans for Parent and Nanny.</p>
    </div>
    <a href="/Admin/CreateSubscriptionPlan" class="btn-primary flex-shrink-0">
        <span class="material-icons-round text-base">add_circle</span>
        Add New SubscriptionPlan
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<form method="get" action="/Admin/ManageSubscriptionPlan" id="filterForm">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Search by plan name or code..."
                       class="search-input search-input--with-icon w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>

            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">group</span>
                <select name="targetRole" onchange="this.form.submit()"
                        class="search-input search-input--with-icon md:w-44 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Roles</option>
                    <option value="Parent" selected="@(currentTargetRole == "Parent" ? "selected" : null)">Parent</option>
                    <option value="Nanny" selected="@(currentTargetRole == "Nanny" ? "selected" : null)">Nanny</option>
                </select>
            </div>

            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                <select name="isActive" onchange="this.form.submit()"
                        class="search-input search-input--with-icon md:w-44 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(currentStatus == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(currentStatus == false ? "selected" : null)">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Search
            </button>
        </div>
    </div>
</form>

<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
    <div class="card-header">
        <span class="text-sm text-gray-500">
            Showing <span class="font-bold text-gray-800">@plans.Count</span>
            of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> plans
        </span>
        <div class="flex items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-emerald-100"></div>Active
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400 ring-2 ring-red-100"></div>Inactive
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Plan</th>
                    <th class="text-left">Role</th>
                    <th class="text-left">Price</th>
                    <th class="text-left">Duration</th>
                    <th class="text-left">Status</th>
                    <th class="text-left">Usage</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!plans.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">inventory_2</span>
                            <p class="font-semibold text-gray-400">No subscription plans found.</p>
                            <p class="text-xs text-gray-300 mt-1">Try adjusting the filters above or create a new plan.</p>
                        </td>
                    </tr>
                }

                @{ int rowNum = ((currentPage - 1) * pageSize) + 1; }
                @foreach (var plan in plans)
                {
                    var roleBadge = plan.TargetRole == "Parent" ? "badge-parent" : "badge-nanny";
                    var statusBadge = plan.IsActive ? "badge-active" : "badge-inactive";
                    var statusLabel = plan.IsActive ? "Active" : "Inactive";

                    <tr class="account-row">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex flex-col">
                                <span class="font-bold text-gray-800">@plan.Name</span>
                                <span class="text-xs text-gray-400 font-mono">@plan.Code</span>
                            </div>
                        </td>
                        <td><span class="badge @roleBadge">@plan.TargetRole</span></td>
                        <td class="text-gray-500 text-sm">@plan.Price.ToString("N0") đ</td>
                        <td class="text-gray-500 text-sm">@plan.DurationDays day(s)</td>
                        <td>
                            <div class="flex items-center gap-1.5">
                                <div class="w-2 h-2 rounded-full @(plan.IsActive ? "bg-emerald-400 ring-2 ring-emerald-100" : "bg-red-400 ring-2 ring-red-100")"></div>
                                <span class="badge @statusBadge">@statusLabel</span>
                            </div>
                        </td>
                        <td class="text-gray-500 text-sm">
                            <div>@plan.FeatureCount feature(s)</div>
                            <div class="text-xs text-gray-400">@plan.ActiveSubscriberCount active subscriber(s)</div>
                        </td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <a href="/Admin/ViewSubscriptionPlanDetail/@plan.Id"
                                   title="View detail"
                                   class="w-8 h-8 rounded-xl hover:bg-orange-50 hover:text-orange-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-orange-200">
                                    <span class="material-icons-round text-base">visibility</span>
                                </a>

                                <button type="button"
                                        onclick="openTogglePlanModal('@plan.Id', @(!plan.IsActive ? "true" : "false"))"
                                        title="@(plan.IsActive ? "Deactivate" : "Activate")"
                                        class="w-8 h-8 rounded-xl @(plan.IsActive ? "hover:bg-red-50 hover:text-red-500 hover:border-red-200" : "hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200") flex items-center justify-center text-gray-300 transition-all border border-gray-100">
                                    <span class="material-icons-round text-base">@(plan.IsActive ? "block" : "check_circle_outline")</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Page <span class="font-bold text-gray-600">@currentPage</span> of <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&targetRole=@currentTargetRole&isActive=@currentStatusValue&page=@(currentPage - 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&targetRole=@currentTargetRole&isActive=@currentStatusValue&page=@p" class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }

            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&targetRole=@currentTargetRole&isActive=@currentStatusValue&page=@(currentPage + 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>

<div id="togglePlanModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeTogglePlanModal()">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="togglePlanIconBg" class="w-12 h-12 rounded-2xl flex items-center justify-center">
                <span id="togglePlanIcon" class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="togglePlanTitle" class="text-lg font-bold text-gray-900"></h3>
                <p id="togglePlanSubtitle" class="text-sm text-gray-400"></p>
            </div>
        </div>
        <p id="togglePlanMessage" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed"></p>
        <div id="togglePlanFormContainer" class="flex gap-2"></div>
    </div>
</div>

@section Scripts {
    <form id="togglePlanCsrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <script>
        function openTogglePlanModal(id, isActive) {
            const activate = isActive === true || isActive === 'true';
            document.getElementById('togglePlanTitle').textContent = activate ? 'Kích hoạt gói' : 'Vô hiệu hóa gói';
            document.getElementById('togglePlanSubtitle').textContent = activate ? 'Hiển thị lại gói cho người dùng' : 'Tạm ngừng gói khỏi danh sách khả dụng';
            document.getElementById('togglePlanMessage').textContent = activate
                ? 'Bạn có chắc muốn kích hoạt gói này không?'
                : 'Bạn có chắc muốn vô hiệu hóa gói này không?';

            const iconBg = document.getElementById('togglePlanIconBg');
            const icon = document.getElementById('togglePlanIcon');
            iconBg.style.background = activate ? '#D1FAE5' : '#FEE2E2';
            icon.style.color = activate ? '#10B981' : '#EF4444';
            icon.textContent = activate ? 'check_circle_outline' : 'block';

            const token = document.querySelector('#togglePlanCsrfForm input[name="__RequestVerificationToken"]').value;
            const returnUrl = '@(currentUrl.Replace("'", "\\'"))';
            const btnClass = activate ? 'btn-success' : 'btn-danger';
            const btnText = activate ? 'Confirm Activate' : 'Confirm Deactivate';

            document.getElementById('togglePlanFormContainer').innerHTML =
                '<button type="button" onclick="closeTogglePlanModal()" class="btn-outline flex-1 justify-center">Cancel</button>' +
                '<form method="post" action="/Admin/ToggleSubscriptionPlanStatus" class="flex-1 flex">' +
                '<input name="__RequestVerificationToken" type="hidden" value="' + token + '" />' +
                '<input type="hidden" name="id" value="' + id + '" />' +
                '<input type="hidden" name="isActive" value="' + (activate ? 'true' : 'false') + '" />' +
                '<input type="hidden" name="returnUrl" value="' + returnUrl + '" />' +
                '<button type="submit" class="' + btnClass + ' w-full justify-center">' + btnText + '</button>' +
                '</form>';

            document.getElementById('togglePlanModal').classList.remove('hidden');
        }

        function closeTogglePlanModal() {
            document.getElementById('togglePlanModal').classList.add('hidden');
        }
    </script>
    <style>
        .btn-danger { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#FEE2E2;color:#EF4444;border:1.5px solid #FECACA; }
        .btn-danger:hover { background:#FCA5A5;border-color:#F87171; }
        .btn-success { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#D1FAE5;color:#10B981;border:1.5px solid #A7F3D0; }
        .btn-success:hover { background:#A7F3D0;border-color:#6EE7B7; }
    </style>
}
