<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Quản trị | NannyMatch</title>
    <link href="~/css/tailwind.generated.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/unified-dropdown.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/toast.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="font-display bg-gray-50 text-gray-800" style="font-family:'Quicksand',sans-serif;">

    <div class="flex h-screen overflow-hidden">

        <!-- ===== SIDEBAR ===== -->
        <aside id="sidebar" class="mod-sidebar fixed inset-y-0 left-0 z-40 flex flex-col text-white transition-all duration-300 overflow-hidden"
               style="width:260px; background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%);">

            <!-- Brand -->
            <div class="flex items-center gap-3 px-5 py-5 border-b border-white/10">
                <img src="~/img/nanny-logo.jpg" alt="Logo" class="w-9 h-9 rounded-xl object-cover shadow-lg flex-shrink-0" />
                <div class="sidebar-text overflow-hidden">
                    <span class="text-lg font-bold tracking-tight" style="background:linear-gradient(135deg,#F97316,#FB923C);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">NannyMatch</span>
                    <p class="text-[10px] text-gray-400 -mt-0.5 uppercase tracking-widest">Bảng Điều Khiển</p>
                </div>
            </div>

            <!-- Nav -->
            <nav class="flex-1 px-3 py-5 space-y-1 overflow-y-auto overflow-x-hidden">

                <p class="sidebar-text px-2 text-[10px] uppercase tracking-widest text-slate-500 mb-2 font-semibold">Tổng Quan</p>

                <a href="/Admin/Dashboard"
                   class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "bg-orange-500/20 text-orange-400 border border-orange-500/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                    <span class="material-icons-round text-xl flex-shrink-0">dashboard</span>
                    <span class="sidebar-text">Trang Chủ</span>
                </a>

                <p class="sidebar-text px-2 text-[10px] uppercase tracking-widest text-slate-500 mt-5 mb-2 font-semibold">Quản Lý</p>

                <a href="/Admin/ManageModerators"
                   class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["action"]?.ToString() is "ManageModerators" or "EditModerator" or "CreateModerator" ? "bg-orange-500/20 text-orange-400 border border-orange-500/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                    <span class="material-icons-round text-xl flex-shrink-0">manage_accounts</span>
                    <span class="sidebar-text">Quản Lý Kiểm Duyệt Viên</span>
                </a>

                <a href="/Admin/ManageSubscriptionPlan"
                   class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["action"]?.ToString() is "ManageSubscriptionPlan" or "ViewSubscriptionPlanDetail" or "CreateSubscriptionPlan" ? "bg-orange-500/20 text-orange-400 border border-orange-500/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                    <span class="material-icons-round text-xl flex-shrink-0">workspace_premium</span>
                    <span class="sidebar-text">Gói Đăng Ký</span>
                </a>

                <a href="/Admin/ManageAdminNotification"
                   class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["action"]?.ToString() is "ManageAdminNotification" or "ViewAdminNotificationDetail" or "CreateAdminNotification" ? "bg-orange-500/20 text-orange-400 border border-orange-500/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                    <span class="material-icons-round text-xl flex-shrink-0">campaign</span>
                    <span class="sidebar-text">Quản Lý Thông Báo</span>
                </a>

                <a href="/Admin/RecommendationConfig"
                   class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["action"]?.ToString() == "RecommendationConfig" ? "bg-orange-500/20 text-orange-400 border border-orange-500/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                    <span class="material-icons-round text-xl flex-shrink-0">tune</span>
                    <span class="sidebar-text">Cấu Hình Gợi Ý</span>
                </a>

            </nav>

            <!-- Bottom: User info + logout -->
            <div class="p-4 border-t border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-lg"
                         style="background:linear-gradient(135deg,#F97316,#EA580C);">
                        @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="sidebar-text flex-1 min-w-0">
                        <p class="text-sm font-semibold text-white truncate">
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Quản trị viên")
                        </p>
                        <p class="text-[10px] text-orange-400 uppercase tracking-wider font-bold">Quản Trị Viên</p>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="sidebar-text flex-shrink-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" title="Đăng Xuất"
                                class="w-8 h-8 rounded-lg hover:bg-red-500/20 flex items-center justify-center text-slate-400 hover:text-red-400 transition-all">
                            <span class="material-icons-round text-xl">logout</span>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- ===== MAIN CONTENT ===== -->
        <div id="mainContent" class="flex flex-col flex-1 min-w-0 transition-all duration-300" style="margin-left:260px;">

            <!-- Top Header Bar -->
            <header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-gray-100 flex flex-col"
                    style="box-shadow:0 2px 20px rgba(249,115,22,0.07);">
                <!-- Gạch nhấn cam -->
                <div class="admin-topbar-accent"></div>
                <!-- Header row -->
                <div class="flex items-center justify-between px-6" style="height:60px;">
                    <div class="flex items-center gap-4">
                        <button id="sidebarToggle" onclick="toggleSidebar()"
                                class="w-9 h-9 rounded-xl hover:bg-orange-50 flex items-center justify-center text-gray-400 hover:text-orange-600 transition-all">
                            <span class="material-icons-round">menu</span>
                        </button>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-gray-400">NannyMatch</span>
                            <span class="material-icons-round text-gray-300 text-sm">chevron_right</span>
                            <span class="font-bold"
                                  style="background:linear-gradient(135deg,#F97316,#EA580C);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;">
                                @ViewData["Title"]
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <button class="relative w-9 h-9 rounded-xl hover:bg-orange-50 flex items-center justify-center text-gray-400 hover:text-orange-600 transition-all">
                            <span class="material-icons-round">notifications_none</span>
                        </button>
                        <div class="flex items-center gap-2 pl-3 border-l border-gray-100">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-md"
                                 style="background:linear-gradient(135deg,#F97316,#EA580C);">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "A")
                            </div>
                            <span class="text-sm font-semibold text-gray-700 hidden sm:block">
                                @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Quản trị viên")
                            </span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/unified-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        var sidebarCollapsed = false;
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var main    = document.getElementById('mainContent');
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.style.width = '72px'; main.style.marginLeft = '72px';
                sidebar.classList.add('collapsed');
            } else {
                sidebar.style.width = '260px'; main.style.marginLeft = '260px';
                sidebar.classList.remove('collapsed');
            }
        }

        (() => {
            const params = new URLSearchParams(window.location.search);
            const toastMessage = params.get('toastMessage');
            const toastType = params.get('toastType');

            if (!toastMessage || typeof window.showToast !== 'function') {
                return;
            }

            window.showToast(toastMessage, { type: toastType });
            params.delete('toastMessage');
            params.delete('toastType');

            const nextQuery = params.toString();
            const nextUrl = `${window.location.pathname}${nextQuery ? `?${nextQuery}` : ''}${window.location.hash || ''}`;
            window.history.replaceState({}, document.title, nextUrl);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
