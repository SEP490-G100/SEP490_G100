@model WebSite.Models.Admin.AdminNotificationListResponse
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Thông Báo";

    var currentSearch = ViewBag.Search as string ?? "";
    var currentDeleted = ViewBag.IsDeleted as bool?;
    var currentDeletedValue = currentDeleted.HasValue ? currentDeleted.Value.ToString().ToLowerInvariant() : "";
    var currentPage = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var pageSize = Model?.PageSize ?? 3;
    var notifications = Model?.Items ?? new List<WebSite.Models.Admin.AdminNotificationListItemViewModel>();
    var preservedQuery = Context.Request.Query
        .Where(q =>
            !string.Equals(q.Key, "toastType", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(q.Key, "toastMessage", StringComparison.OrdinalIgnoreCase))
        .SelectMany(q => q.Value, (q, value) =>
            $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(value ?? string.Empty)}");
    var currentUrl = preservedQuery.Any()
        ? $"{Context.Request.Path}?{string.Join("&", preservedQuery)}"
        : Context.Request.Path.ToString();
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">Quản Lý Thông Báo</span>
        <h1 class="page-title mt-2">Quản Lý <span class="gradient-text">Thông Báo</span></h1>
        <p class="page-subtitle">Gửi thông báo đến toàn bộ người dùng hoặc nhóm vai trò cụ thể, và kiểm tra trạng thái hiển thị của chúng.</p>
    </div>
    <a href="/Admin/CreateAdminNotification" class="btn-primary flex-shrink-0">
        <span class="material-icons-round text-base">add_circle</span>
        Tạo Thông Báo Mới
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<form method="get" action="/Admin/ManageAdminNotification" id="filterForm">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Tìm kiếm theo tiêu đề hoặc nội dung..."
                       class="search-input search-input--with-icon w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>

            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                <select name="isDeleted" onchange="this.form.submit()"
                        class="search-input admin-filter-select md:w-44 !pl-9 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">Tất Cả</option>
                    <option value="false" selected="@(currentDeleted == false ? "selected" : null)">Hoạt Động</option>
                    <option value="true" selected="@(currentDeleted == true ? "selected" : null)">Đã Vô Hiệu Hóa</option>
                </select>
            </div>

            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Tìm Kiếm
            </button>
        </div>
    </div>
</form>

<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
    <div class="card-header">
        <span class="text-sm text-gray-500">
            Hiển thị <span class="font-bold text-gray-800">@notifications.Count</span>
            trong số <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> thông báo
        </span>
        <div class="flex items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-emerald-100"></div>Hoạt Động
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400 ring-2 ring-red-100"></div>Vô Hiệu Hóa
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Thông Báo</th>
                    <th class="text-left">Mục Tiêu</th>
                    <th class="text-left">Người Nhận</th>
                    <th class="text-left">Đã Tạo</th>
                    <th class="text-left">Trạng Thái</th>
                    <th class="text-center">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @if (!notifications.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">notifications_off</span>
                            <p class="font-semibold text-gray-400">Không tìm thấy thông báo nào.</p>
                            <p class="text-xs text-gray-300 mt-1">Hãy thử điều chỉnh bộ lọc hoặc tạo một thông báo mới.</p>
                        </td>
                    </tr>
                }

                @{ int rowNum = ((currentPage - 1) * pageSize) + 1; }
                @foreach (var item in notifications)
                {
                    var statusBadge = item.IsDeleted ? "badge-inactive" : "badge-active";
                    var statusLabel = item.IsDeleted ? "Vô Hiệu Hóa" : "Hoạt Động";
                    var targetLabel = item.TargetType == "Role" ? item.TargetRole : "All Roles";
                    var targetBadge = item.TargetType == "Role"
                        ? (item.TargetRole == "Parent" ? "badge-parent" : item.TargetRole == "Nanny" ? "badge-nanny" : "badge-mod")
                        : "badge-pending";

                    <tr class="account-row">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex flex-col min-w-[280px]">
                                <span class="font-bold text-gray-800">@item.Title</span>
                                <span class="text-xs text-gray-400 line-clamp-2">@item.ContentPreview</span>
                            </div>
                        </td>
                        <td><span class="badge @targetBadge">@targetLabel</span></td>
                        <td class="text-gray-500 text-sm">@item.RecipientCount người nhận</td>
                        <td class="text-gray-500 text-sm">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="flex items-center gap-1.5">
                                <div class="w-2 h-2 rounded-full @(item.IsDeleted ? "bg-red-400 ring-2 ring-red-100" : "bg-emerald-400 ring-2 ring-emerald-100")"></div>
                                <span class="badge @statusBadge">@statusLabel</span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <a href="/Admin/ViewAdminNotificationDetail/@item.Id"
                                   title="View detail"
                                   class="w-8 h-8 rounded-xl hover:bg-orange-50 hover:text-orange-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-orange-200">
                                    <span class="material-icons-round text-base">visibility</span>
                                </a>

                                <button type="button"
                                        onclick="openToggleNotificationModal('@item.Id', @(!item.IsDeleted ? "true" : "false"))"
                                        title="@(item.IsDeleted ? "Kích Hoạt" : "Vô Hiệu Hóa")"
                                        class="w-8 h-8 rounded-xl @(item.IsDeleted ? "hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200" : "hover:bg-red-50 hover:text-red-500 hover:border-red-200") flex items-center justify-center text-gray-300 transition-all border border-gray-100">
                                    <span class="material-icons-round text-base">@(item.IsDeleted ? "check_circle_outline" : "block")</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Trang <span class="font-bold text-gray-600">@currentPage</span> / <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&isDeleted=@currentDeletedValue&page=@(currentPage - 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&isDeleted=@currentDeletedValue&page=@p" class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }

            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&isDeleted=@currentDeletedValue&page=@(currentPage + 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>

<div id="toggleNotificationModal" class="modal-backdrop hidden" onclick="if(event.target===this)closeToggleNotificationModal()">
    <div class="modal-box">
        <div class="flex items-center gap-3 mb-4">
            <div id="toggleNotificationIconBg" class="w-12 h-12 rounded-2xl flex items-center justify-center">
                <span id="toggleNotificationIcon" class="material-icons-round text-2xl"></span>
            </div>
            <div>
                <h3 id="toggleNotificationTitle" class="text-lg font-bold text-gray-900"></h3>
                <p id="toggleNotificationSubtitle" class="text-sm text-gray-400"></p>
            </div>
        </div>
        <p id="toggleNotificationMessage" class="text-sm text-gray-600 mb-6 bg-gray-50 rounded-2xl p-4 border border-gray-100 leading-relaxed"></p>
        <div id="toggleNotificationFormContainer" class="flex gap-2"></div>
    </div>
</div>

@section Scripts {
    <form id="toggleNotificationCsrfForm" style="display:none;">@Html.AntiForgeryToken()</form>
    <script>
        function openToggleNotificationModal(id, isDeleted) {
            const activate = isDeleted === false || isDeleted === 'false';
            document.getElementById('toggleNotificationTitle').textContent = activate ? 'Kích hoạt thông báo' : 'Vô hiệu hóa thông báo';
            document.getElementById('toggleNotificationSubtitle').textContent = activate ? 'Hiển thị lại thông báo trong hệ thống' : 'Ẩn thông báo khỏi trạng thái hoạt động';
            document.getElementById('toggleNotificationMessage').textContent = activate
                ? 'Bạn có chắc muốn kích hoạt thông báo này không?'
                : 'Bạn có chắc muốn vô hiệu hóa thông báo này không?';

            const iconBg = document.getElementById('toggleNotificationIconBg');
            const icon = document.getElementById('toggleNotificationIcon');
            iconBg.style.background = activate ? '#D1FAE5' : '#FEE2E2';
            icon.style.color = activate ? '#10B981' : '#EF4444';
            icon.textContent = activate ? 'check_circle_outline' : 'block';

            const token = document.querySelector('#toggleNotificationCsrfForm input[name="__RequestVerificationToken"]').value;
            const returnUrl = '@(currentUrl.Replace("'", "\\'"))';
            const btnClass = activate ? 'btn-success' : 'btn-danger';
            const btnText = activate ? 'Xác Nhận Kích Hoạt' : 'Xác Nhận Vô Hiệu Hóa';

            document.getElementById('toggleNotificationFormContainer').innerHTML =
                '<button type="button" onclick="closeToggleNotificationModal()" class="btn-outline flex-1 justify-center">Hủy</button>' +
                '<form method="post" action="/Admin/ToggleAdminNotificationStatus" class="flex-1 flex">' +
                '<input name="__RequestVerificationToken" type="hidden" value="' + token + '" />' +
                '<input type="hidden" name="id" value="' + id + '" />' +
                '<input type="hidden" name="isDeleted" value="' + (activate ? 'false' : 'true') + '" />' +
                '<input type="hidden" name="returnUrl" value="' + returnUrl + '" />' +
                '<button type="submit" class="' + btnClass + ' w-full justify-center">' + btnText + '</button>' +
                '</form>';

            document.getElementById('toggleNotificationModal').classList.remove('hidden');
        }

        function closeToggleNotificationModal() {
            document.getElementById('toggleNotificationModal').classList.add('hidden');
        }
    </script>
    <style>
        .btn-danger { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#FEE2E2;color:#EF4444;border:1.5px solid #FECACA; }
        .btn-danger:hover { background:#FCA5A5;border-color:#F87171; }
        .btn-success { display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:.85rem;font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s;background:#D1FAE5;color:#10B981;border:1.5px solid #A7F3D0; }
        .btn-success:hover { background:#A7F3D0;border-color:#6EE7B7; }
    </style>
}
