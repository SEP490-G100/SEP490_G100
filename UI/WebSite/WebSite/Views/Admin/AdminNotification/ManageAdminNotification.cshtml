@model WebSite.Models.Admin.AdminNotificationListResponse
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Notifications";

    var currentSearch = ViewBag.Search as string ?? "";
    var currentDeleted = ViewBag.IsDeleted as bool?;
    var currentDeletedValue = currentDeleted.HasValue ? currentDeleted.Value.ToString().ToLowerInvariant() : "";
    var currentPage = Model?.Page ?? 1;
    var totalPages = Model?.TotalPages ?? 1;
    var pageSize = Model?.PageSize ?? 3;
    var notifications = Model?.Items ?? new List<WebSite.Models.Admin.AdminNotificationListItemViewModel>();
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7 fade-in-up">
    <div>
        <span class="section-label">Notification Management</span>
        <h1 class="page-title mt-2">Manage <span class="gradient-text">Notifications</span></h1>
        <p class="page-subtitle">Broadcast announcements to all users or specific roles, and review their availability.</p>
    </div>
    <a href="/Admin/CreateAdminNotification" class="btn-primary flex-shrink-0">
        <span class="material-icons-round text-base">add_circle</span>
        Create New Notification
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">error_outline</span>
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-2xl text-sm flex items-center gap-2 fade-in-up">
        <span class="material-icons-round text-base">check_circle_outline</span>
        @TempData["Success"]
    </div>
}

<form method="get" action="/Admin/ManageAdminNotification" id="filterForm">
    <div class="content-card p-4 mb-5 fade-in-up" style="animation-delay:.05s;">
        <div class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
                <input name="search" type="text" value="@currentSearch"
                       placeholder="Search by title or content..."
                       class="search-input search-input--with-icon w-full border border-gray-200 rounded-xl px-4 py-2 font-medium"
                       onkeydown="if(event.key==='Enter'){this.form.submit();}" />
            </div>

            <div class="relative">
                <span class="material-icons-round absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-base pointer-events-none">toggle_on</span>
                <select name="isDeleted" onchange="this.form.submit()"
                        class="search-input search-input--with-icon md:w-44 cursor-pointer appearance-none border border-gray-200 rounded-xl px-4 py-2 font-medium">
                    <option value="">All Statuses</option>
                    <option value="false" selected="@(currentDeleted == false ? "selected" : null)">Active</option>
                    <option value="true" selected="@(currentDeleted == true ? "selected" : null)">Inactive</option>
                </select>
            </div>

            <button type="submit" class="btn-primary flex-shrink-0 flex items-center gap-1">
                <span class="material-icons-round text-base">search</span>
                Search
            </button>
        </div>
    </div>
</form>

<div class="content-card overflow-hidden fade-in-up" style="animation-delay:.1s;">
    <div class="card-header">
        <span class="text-sm text-gray-500">
            Showing <span class="font-bold text-gray-800">@notifications.Count</span>
            of <span class="font-bold text-gray-800">@(Model?.TotalCount ?? 0)</span> notifications
        </span>
        <div class="flex items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-emerald-100"></div>Active
            </div>
            <div class="flex items-center gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-red-400 ring-2 ring-red-100"></div>Inactive
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full mod-table">
            <thead>
                <tr>
                    <th class="text-left">#</th>
                    <th class="text-left">Notification</th>
                    <th class="text-left">Target</th>
                    <th class="text-left">Recipients</th>
                    <th class="text-left">Created</th>
                    <th class="text-left">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!notifications.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-16 text-gray-400">
                            <span class="material-icons-round text-5xl mb-3 block text-gray-200">notifications_off</span>
                            <p class="font-semibold text-gray-400">No admin notifications found.</p>
                            <p class="text-xs text-gray-300 mt-1">Try adjusting the filters above or create a new broadcast.</p>
                        </td>
                    </tr>
                }

                @{ int rowNum = ((currentPage - 1) * pageSize) + 1; }
                @foreach (var item in notifications)
                {
                    var statusBadge = item.IsDeleted ? "badge-inactive" : "badge-active";
                    var statusLabel = item.IsDeleted ? "Inactive" : "Active";
                    var targetLabel = item.TargetType == "Role" ? item.TargetRole : "All Roles";
                    var targetBadge = item.TargetType == "Role"
                        ? (item.TargetRole == "Parent" ? "badge-parent" : item.TargetRole == "Nanny" ? "badge-nanny" : "badge-mod")
                        : "badge-pending";

                    <tr class="account-row">
                        <td class="text-gray-300 text-xs font-mono">@rowNum</td>
                        <td>
                            <div class="flex flex-col min-w-[280px]">
                                <span class="font-bold text-gray-800">@item.Title</span>
                                <span class="text-xs text-gray-400 line-clamp-2">@item.ContentPreview</span>
                            </div>
                        </td>
                        <td><span class="badge @targetBadge">@targetLabel</span></td>
                        <td class="text-gray-500 text-sm">@item.RecipientCount user(s)</td>
                        <td class="text-gray-500 text-sm">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="flex items-center gap-1.5">
                                <div class="w-2 h-2 rounded-full @(item.IsDeleted ? "bg-red-400 ring-2 ring-red-100" : "bg-emerald-400 ring-2 ring-emerald-100")"></div>
                                <span class="badge @statusBadge">@statusLabel</span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center justify-center gap-1.5">
                                <a href="/Admin/ViewAdminNotificationDetail/@item.Id"
                                   title="View detail"
                                   class="w-8 h-8 rounded-xl hover:bg-orange-50 hover:text-orange-600 flex items-center justify-center text-gray-300 transition-all border border-gray-100 hover:border-orange-200">
                                    <span class="material-icons-round text-base">visibility</span>
                                </a>

                                <form method="post" action="/Admin/ToggleAdminNotificationStatus" class="inline" onsubmit="return confirm('@(item.IsDeleted ? "Activate" : "Deactivate") this notification?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="isDeleted" value="@(!item.IsDeleted ? "true" : "false")" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button type="submit"
                                            title="@(item.IsDeleted ? "Activate" : "Deactivate")"
                                            class="w-8 h-8 rounded-xl @(item.IsDeleted ? "hover:bg-emerald-50 hover:text-emerald-600 hover:border-emerald-200" : "hover:bg-red-50 hover:text-red-500 hover:border-red-200") flex items-center justify-center text-gray-300 transition-all border border-gray-100">
                                        <span class="material-icons-round text-base">@(item.IsDeleted ? "check_circle_outline" : "block")</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    rowNum++;
                }
            </tbody>
        </table>
    </div>

    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-50">
        <span class="text-sm text-gray-400">
            Page <span class="font-bold text-gray-600">@currentPage</span> of <span class="font-bold text-gray-600">@totalPages</span>
        </span>
        <div class="flex gap-1.5">
            @if (currentPage > 1)
            {
                <a href="?search=@currentSearch&isDeleted=@currentDeletedValue&page=@(currentPage - 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_left</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_left</span>
                </button>
            }

            @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
            {
                <a href="?search=@currentSearch&isDeleted=@currentDeletedValue&page=@p" class="page-btn @(p == currentPage ? "active" : "")">@p</a>
            }

            @if (currentPage < totalPages)
            {
                <a href="?search=@currentSearch&isDeleted=@currentDeletedValue&page=@(currentPage + 1)" class="page-btn">
                    <span class="material-icons-round text-sm">chevron_right</span>
                </a>
            }
            else
            {
                <button class="page-btn opacity-30 cursor-not-allowed" disabled>
                    <span class="material-icons-round text-sm">chevron_right</span>
                </button>
            }
        </div>
    </div>
</div>
