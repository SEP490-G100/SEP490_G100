@using WebSite.Controllers
@using WebSite.Models.Profile
@model List<ChildProfileViewModel>

@{
    ViewData["Title"] = "Quản lý con em";
}

<div class="min-h-screen bg-gradient-to-br from-green-50 via-emerald-50/30 to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <span class="section-label">👨‍👩‍👧‍👦 Gia đình</span>
                <h1 class="text-4xl font-bold text-gray-900 dark:text-white mt-3" style="font-family:'Quicksand',sans-serif">
                    Quản lý <span class="gradient-text">con em</span>
                </h1>
                <div class="section-divider left mt-4"></div>
            </div>
            <a href="@Url.Action("AddChild", "Profile")" 
               class="flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl w-full sm:w-auto">
                <span class="material-icons-round">add_circle</span>
                Thêm con em
            </a>
        </div>

        @if (Model?.Count > 0)
        {
            <!-- Children Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                @foreach (var child in Model)
                {
                    <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-6 lg:p-8 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm hover:shadow-lg transition-all duration-300">
                        <!-- Child Header -->
                        <div class="flex items-start justify-between mb-6 pb-4 border-b border-gray-100 dark:border-gray-700/50">
                            <div>
                                <h3 class="text-2xl font-bold text-gray-900 dark:text-white" style="font-family:'Quicksand',sans-serif">
                                    @(string.IsNullOrEmpty(child.Name) ? "Con (không có tên)" : child.Name)
                                </h3>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                                    Ngày sinh: @child.DateOfBirth.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <a href="@Url.Action("EditChild", "Profile", new { childId = child.Id })"
                                   class="p-2 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 rounded-lg hover:bg-blue-200 dark:hover:bg-blue-900/50 transition-colors">
                                    <span class="material-icons-round text-xl">edit</span>
                                </a>
                                <form method="post" action="@Url.Action("DeleteChild", "Profile")" 
                                      style="display:inline" 
                                      onsubmit="return confirm('Bạn chắc chắn muốn xóa con em này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="childId" value="@child.Id">
                                    <button type="submit" class="p-2 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition-colors">
                                        <span class="material-icons-round text-xl">delete</span>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Child Details Grid -->
                        <div class="grid grid-cols-2 gap-4">
                            <!-- Gender -->
                            <div>
                                <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">👥 Giới tính</p>
                                <p class="font-medium text-gray-900 dark:text-white">
                                    @if (child.Gender.HasValue)
                                    {
                                        @(child.Gender == 0 ? "Nam" : child.Gender == 1 ? "Nữ" : "Khác")
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">--</span>
                                    }
                                </p>
                            </div>

                            <!-- Created Date -->
                            <div>
                                <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">📅 Tạo ngày</p>
                                <p class="font-medium text-gray-900 dark:text-white">@child.CreatedAt.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <!-- Allergies -->
                        @if (!string.IsNullOrEmpty(child.Allergies))
                        {
                            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/50">
                                <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">⚠️ Dị ứng</p>
                                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-900/30 rounded-xl p-3">
                                    <p class="text-sm text-yellow-800 dark:text-yellow-300">@child.Allergies</p>
                                </div>
                            </div>
                        }

                        <!-- Special Needs -->
                        @if (!string.IsNullOrEmpty(child.SpecialNeeds))
                        {
                            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/50">
                                <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">🎯 Nhu cầu đặc biệt</p>
                                <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-900/30 rounded-xl p-3">
                                    <p class="text-sm text-blue-800 dark:text-blue-300">@child.SpecialNeeds</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-12 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm text-center">
                <div class="mb-6">
                    <span class="text-6xl">👶</span>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Chưa có con em nào</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-6">Bắt đầu bằng cách thêm thông tin con em của bạn</p>
                <a href="@Url.Action("AddChild", "Profile")" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl">
                    <span class="material-icons-round">add_circle</span>
                    Thêm con em ngay
                </a>
            </div>
        }

        <!-- Back Button -->
        <div class="mt-8">
            <a href="@Url.Action("Index", "Profile")" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-bold rounded-xl transition-all duration-300">
                <span class="material-icons-round">arrow_back</span>
                Quay lại hồ sơ
            </a>
        </div>
    </div>
</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 8px;
        border: none;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
        padding: 1.25rem;
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-footer {
        border-top: 1px solid #e0e0e0;
        padding: 1rem 1.5rem;
        border-radius: 0 0 8px 8px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn {
        border-radius: 5px;
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }

    .badge {
        padding: 0.35em 0.65em;
    }

    .alert {
        border-radius: 5px;
        border: none;
    }
</style>
