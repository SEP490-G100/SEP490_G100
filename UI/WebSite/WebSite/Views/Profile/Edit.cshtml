@using WebSite.Models.Profile
@model EditPersonalInfoViewModel

@{
    ViewData["Title"] = "Chinh sua ho so";
    var avatarUrl = (Model.AvatarUrl ?? "").Trim();
    var isNanny = Model.IsNanny;
    var dobMax = DateOnly.FromDateTime(DateTime.Today.AddYears(-18)).ToString("yyyy-MM-dd");
}

@section Head {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<section class="profile-page">
    <div class="profile-shell">
        <div class="profile-header">
            <div class="flex-1 min-w-[220px]">
                <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-orange-500">Profile</p>
                <h1 class="mt-2 text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">Chinh sua thong tin ca nhan</h1>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form id="editProfileForm" method="post" enctype="multipart/form-data" class="mt-4">
            @Html.AntiForgeryToken()

            <div class="profile-grid">
                <div class="space-y-4">
                    <div class="profile-card">
                        <h3>Thong tin ca nhan</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="form-label" for="FirstName">Ho</label>
                                <input asp-for="FirstName" id="FirstName" class="form-input" required />
                            </div>
                            <div>
                                <label class="form-label" for="LastName">Ten</label>
                                <input asp-for="LastName" id="LastName" class="form-input" required />
                            </div>
                            <div>
                                <label class="form-label" for="PhoneNumber">Dien thoai</label>
                                <input asp-for="PhoneNumber" id="PhoneNumber" class="form-input" />
                            </div>
                            <div>
                                <label class="form-label" for="DateOfBirth">Ngay sinh</label>
                                <input asp-for="DateOfBirth" id="DateOfBirth" type="date" max="@dobMax" class="form-input" />
                                @if (isNanny)
                                {
                                    <p class="text-xs text-slate-500 mt-1">Nanny phai du 18 tuoi tro len.</p>
                                }
                                <p id="dobError" class="hidden text-xs text-red-600 mt-1"></p>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="form-label">Gioi tinh</label>
                            <input type="hidden" asp-for="Gender" id="Gender" />
                            <div class="inline-grid grid-cols-2 gap-2 p-2 rounded-2xl border border-slate-200 bg-slate-50" style="max-width:280px">
                                <button type="button" class="gender-btn" data-value="0">Nam</button>
                                <button type="button" class="gender-btn" data-value="1">Nu</button>
                            </div>
                        </div>
                    </div>

                    @if (isNanny)
                    {
                        <div class="profile-card profile-card-soft">
                            <h3>Thong tin nghe nghiep (Nanny)</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="form-label" for="Bio">Gioi thieu</label>
                                    <textarea asp-for="Bio" id="Bio" rows="3" class="form-input resize-none"></textarea>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="form-label" for="YearsOfExperience">Nam kinh nghiem</label>
                                        <input asp-for="YearsOfExperience" id="YearsOfExperience" type="number" min="0" class="form-input" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="EducationLevel">Hoc van</label>
                                        <select asp-for="EducationLevel" id="EducationLevel" class="form-input">
                                            <option value="">-- Chon --</option>
                                            <option value="0">Trung hoc</option>
                                            <option value="1">Cao dang</option>
                                            <option value="2">Dai hoc</option>
                                            <option value="3">Thac si</option>
                                            <option value="4">Khac</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="form-label" for="ExpectedSalaryMin">Luong toi thieu</label>
                                        <input asp-for="ExpectedSalaryMin" id="ExpectedSalaryMin" type="text" inputmode="numeric" autocomplete="off" class="form-input" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="ExpectedSalaryMax">Luong toi da</label>
                                        <input asp-for="ExpectedSalaryMax" id="ExpectedSalaryMax" type="text" inputmode="numeric" autocomplete="off" class="form-input" />
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label" for="MaxTravelDistance">Khoang cach di chuyen toi da (km)</label>
                                    <input asp-for="MaxTravelDistance" id="MaxTravelDistance" type="number" min="0" class="form-input" />
                                </div>
                                <div>
                                    <label class="form-label">Ky nang</label>
                                    @if (Model.AvailableSkills.Any())
                                    {
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 p-4 rounded-2xl border border-orange-100 bg-white">
                                            @foreach (var skill in Model.AvailableSkills)
                                            {
                                                var checkedAttr = Model.SelectedSkillIds.Contains(skill.SkillId);
                                                <label class="flex items-center gap-2 text-sm text-slate-700 font-semibold">
                                                    <input type="checkbox"
                                                           name="SelectedSkillIds"
                                                           value="@skill.SkillId"
                                                           @(checkedAttr ? "checked" : null)
                                                           class="rounded border-gray-300 text-orange-600 focus:ring-orange-500" />
                                                    <span>@skill.SkillName</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-slate-500">Khong tai duoc danh sach ky nang.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="profile-card">
                        <h3>Dia chi va ban do</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="form-label" for="Address">Dia chi chi tiet</label>
                                <input asp-for="Address" id="Address" class="form-input" placeholder="So nha, ten duong..." />
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="form-label" for="City">Tinh/Thanh</label>
                                    <input asp-for="City" id="City" class="form-input" list="cityOptions" placeholder="Nhap hoac chon Tinh/Thanh" autocomplete="off" />
                                    <datalist id="cityOptions"></datalist>
                                </div>
                                <div>
                                    <label class="form-label" for="District">Phuong/Xa</label>
                                    <input asp-for="District" id="District" class="form-input" list="districtOptions" placeholder="Nhap hoac chon Phuong/Xa" autocomplete="off" />
                                    <datalist id="districtOptions"></datalist>
                                </div>
                            </div>
                            <p id="selectedAddressSummary" class="text-xs text-slate-500 font-semibold">
                                Dang chon: @(string.IsNullOrWhiteSpace(Model.District) ? "-" : Model.District), @(string.IsNullOrWhiteSpace(Model.City) ? "-" : Model.City)
                            </p>
                            <div id="addressLoadError" class="hidden text-sm text-red-600"></div>
                            <div id="map" class="profile-map"></div>
                            <input asp-for="Latitude" id="Latitude" type="hidden" />
                            <input asp-for="Longitude" id="Longitude" type="hidden" />
                            <p class="text-xs font-semibold text-slate-500">Toa do: <span id="coords-display">@Model.Latitude, @Model.Longitude</span></p>
                        </div>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="profile-card">
                        <h3>Anh dai dien</h3>
                        <div class="flex flex-col items-center">
                            <img id="avatarPreview"
                                 class="@((string.IsNullOrWhiteSpace(avatarUrl) ? "hidden " : "") + "w-40 h-40 rounded-3xl object-cover border border-gray-200 bg-gray-50")"
                                 src="@avatarUrl"
                                 alt="Avatar preview" />
                            <input type="hidden" asp-for="AvatarUrl" value="@avatarUrl" />

                            <div class="w-full mt-4">
                                <label class="form-label" for="AvatarFile">Upload anh (.jpg, .png)</label>
                                <input type="file" asp-for="AvatarFile" id="AvatarFile" accept=".jpg,.png" class="form-input" />
                                <p class="text-xs text-slate-500 mt-1">Chi cho phep file .jpg hoac .png</p>
                                <p id="avatarUploadError" class="hidden text-xs text-red-600 mt-1"></p>
                            </div>
                            <div class="w-full mt-3">
                                <label class="form-label" for="avatarPathDisplay">Duong dan file da chon</label>
                                <input type="text" id="avatarPathDisplay" class="form-input" readonly value="" />
                            </div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Hanh dong</h3>
                        <div class="space-y-2">
                            <a href="@Url.Action("Index", "Profile")" class="ghost-btn w-full">Huy bo</a>
                            <button type="submit" class="profile-primary-btn w-full">Luu thong tin</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<div id="profileToast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-[9999] rounded-xl border border-orange-200 bg-orange-500 text-white px-4 py-3 text-sm font-bold shadow-xl">
    @((TempData["Success"] ?? "").ToString())
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var isNanny = @(isNanny ? "true" : "false");
            var form = document.getElementById("editProfileForm");
            var dobInput = document.getElementById("DateOfBirth");
            var dobError = document.getElementById("dobError");

            var genderInput = document.getElementById("Gender");
            var genderButtons = document.querySelectorAll(".gender-btn");
            function syncGenderUI() {
                var current = (genderInput.value || "").trim();
                genderButtons.forEach(function (btn) {
                    var active = btn.getAttribute("data-value") === current;
                    btn.classList.toggle("status-option", true);
                    btn.classList.toggle("active", active);
                });
            }
            genderButtons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    genderInput.value = btn.getAttribute("data-value");
                    syncGenderUI();
                });
            });
            syncGenderUI();

            var avatarInput = document.getElementById("AvatarFile");
            var avatarErr = document.getElementById("avatarUploadError");
            var avatarPreview = document.getElementById("avatarPreview");
            var avatarPathDisplay = document.getElementById("avatarPathDisplay");
            var currentAvatarUrl = "@avatarUrl";
            var objectUrl = null;
            var salaryInputs = [
                document.getElementById("ExpectedSalaryMin"),
                document.getElementById("ExpectedSalaryMax")
            ].filter(Boolean);

            function showAvatarError(msg) {
                avatarErr.textContent = msg || "";
                avatarErr.classList.toggle("hidden", !msg);
            }
            function isAllowedImage(file) {
                if (!file) return false;
                var name = (file.name || "").toLowerCase();
                return name.endsWith(".jpg") || name.endsWith(".png");
            }
            function clearPreview() {
                if (objectUrl) { try { URL.revokeObjectURL(objectUrl); } catch (e) { } objectUrl = null; }
                avatarPreview.src = "";
                avatarPreview.classList.add("hidden");
            }
            function setPreview(src) {
                avatarPreview.src = src;
                avatarPreview.classList.remove("hidden");
            }

            if (currentAvatarUrl) setPreview(currentAvatarUrl);
            avatarPathDisplay.value = "";

            avatarInput.addEventListener("change", function () {
                showAvatarError("");
                var file = avatarInput.files && avatarInput.files[0] ? avatarInput.files[0] : null;
                avatarPathDisplay.value = avatarInput.value || "";

                if (!file) {
                    clearPreview();
                    if (currentAvatarUrl) setPreview(currentAvatarUrl);
                    return;
                }
                if (!isAllowedImage(file)) {
                    avatarInput.value = "";
                    avatarPathDisplay.value = "";
                    clearPreview();
                    showAvatarError("Chi cho phep file .jpg hoac .png.");
                    if (currentAvatarUrl) setPreview(currentAvatarUrl);
                    return;
                }
                clearPreview();
                objectUrl = URL.createObjectURL(file);
                setPreview(objectUrl);
            });

            function getDigits(value) {
                return (value || "").replace(/\D/g, "");
            }

            function formatMoneyValue(value) {
                var digits = getDigits(value);
                if (!digits) return "";
                return digits.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
            }

            salaryInputs.forEach(function (input) {
                input.addEventListener("input", function () {
                    input.value = formatMoneyValue(input.value);
                });

                input.addEventListener("blur", function () {
                    input.value = formatMoneyValue(input.value);
                });

                if (input.value) {
                    input.value = formatMoneyValue(input.value);
                }
            });

            function validateNannyDob() {
                if (!isNanny) return true;
                var value = dobInput.value;
                if (!value) {
                    dobError.textContent = "Vui long chon ngay sinh.";
                    dobError.classList.remove("hidden");
                    return false;
                }
                var dob = new Date(value + "T00:00:00");
                var today = new Date();
                var age = today.getFullYear() - dob.getFullYear();
                var monthDiff = today.getMonth() - dob.getMonth();
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) age--;
                if (age < 18) {
                    dobError.textContent = "Nanny phai tu 18 tuoi tro len.";
                    dobError.classList.remove("hidden");
                    return false;
                }
                dobError.classList.add("hidden");
                dobError.textContent = "";
                return true;
            }

            form.addEventListener("submit", function (e) {
                if (!validateNannyDob()) {
                    e.preventDefault();
                    return;
                }

                salaryInputs.forEach(function (input) {
                    input.value = getDigits(input.value);
                });
            });
            dobInput.addEventListener("change", validateNannyDob);

            var toast = document.getElementById("profileToast");
            if (toast && toast.textContent.trim()) {
                toast.classList.remove("hidden");
                setTimeout(function () {
                    toast.classList.add("hidden");
                }, 2500);
            }

            var initialLat = parseFloat(document.getElementById("Latitude").value) || 21.0285;
            var initialLng = parseFloat(document.getElementById("Longitude").value) || 105.8542;
            var map = L.map("map").setView([initialLat, initialLng], 13);
            L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
                attribution: "&copy; CartoDB",
                maxZoom: 19
            }).addTo(map);

            var marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            function updateCoordinates(lat, lng) {
                document.getElementById("Latitude").value = lat.toFixed(6);
                document.getElementById("Longitude").value = lng.toFixed(6);
                document.getElementById("coords-display").innerText = lat.toFixed(6) + ", " + lng.toFixed(6);
            }
            marker.on("dragend", function () {
                var p = marker.getLatLng();
                updateCoordinates(p.lat, p.lng);
            });
            map.on("click", function (e) {
                marker.setLatLng([e.latlng.lat, e.latlng.lng]);
                updateCoordinates(e.latlng.lat, e.latlng.lng);
            });

            var cityInput = document.getElementById("City");
            var districtInput = document.getElementById("District");
            var cityOptions = document.getElementById("cityOptions");
            var districtOptions = document.getElementById("districtOptions");
            var selectedAddressSummary = document.getElementById("selectedAddressSummary");
            var addressInput = document.getElementById("Address");
            var addressLoadError = document.getElementById("addressLoadError");
            var provinces = [];
            var currentCity = "@(Model.City ?? "")";
            var currentDistrict = "@(Model.District ?? "")";

            if (currentCity && !cityInput.value) cityInput.value = currentCity;
            if (currentDistrict && !districtInput.value) districtInput.value = currentDistrict;

            setAddressInputState(true);
            fetch("/Address/LocationTree")
                .then(function (r) {
                    if (!r.ok) throw new Error("address-load-failed");
                    return r.json();
                })
                .then(function (data) {
                    provinces = data || [];
                    renderCityOptions(cityInput.value || currentCity);
                    renderDistrictOptions(cityInput.value || currentCity, districtInput.value || currentDistrict);
                    showAddressLoadError("");
                    setAddressInputState(false);
                })
                .catch(function () {
                    provinces = [];
                    setAddressInputState(true);
                    showAddressLoadError("Khong tai duoc danh sach tinh thanh.");
                });

            function setAddressInputState(disabled) {
                cityInput.disabled = disabled;
                districtInput.disabled = disabled;
            }
            function showAddressLoadError(message) {
                addressLoadError.textContent = message || "";
                addressLoadError.classList.toggle("hidden", !message);
            }
            function normalizeText(value) {
                return (value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d")
                    .trim();
            }
            function appendOption(listEl, value) {
                if (!value) return;
                var exists = Array.from(listEl.options).some(function (opt) {
                    return normalizeText(opt.value) === normalizeText(value);
                });
                if (!exists) {
                    var option = document.createElement("option");
                    option.value = value;
                    listEl.appendChild(option);
                }
            }
            function getProvinceByName(cityName) {
                var normalizedCity = normalizeText(cityName);
                if (!normalizedCity) return null;
                var exact = provinces.find(function (p) { return normalizeText(p.name) === normalizedCity; });
                if (exact) return exact;
                return provinces.find(function (p) {
                    var key = normalizeText(p.name);
                    return key.includes(normalizedCity) || normalizedCity.includes(key);
                }) || null;
            }
            function renderCityOptions(filterText) {
                cityOptions.innerHTML = "";
                var filterKey = normalizeText(filterText);
                provinces
                    .filter(function (p) {
                        if (!filterKey) return true;
                        return normalizeText(p.name).includes(filterKey);
                    })
                    .slice(0, 80)
                    .forEach(function (p) {
                        appendOption(cityOptions, p.name);
                    });
                appendOption(cityOptions, currentCity);
                appendOption(cityOptions, cityInput.value);
            }
            function renderDistrictOptions(cityName, filterText) {
                districtOptions.innerHTML = "";
                var province = getProvinceByName(cityName);
                var districts = province && Array.isArray(province.districts) ? province.districts : [];
                var filterKey = normalizeText(filterText);
                districts
                    .filter(function (d) {
                        if (!filterKey) return true;
                        return normalizeText(d.name).includes(filterKey);
                    })
                    .slice(0, 120)
                    .forEach(function (d) {
                        appendOption(districtOptions, d.name);
                    });
                appendOption(districtOptions, currentDistrict);
                appendOption(districtOptions, districtInput.value);
            }
            function onCityInputChanged() {
                renderCityOptions(cityInput.value);
                renderDistrictOptions(cityInput.value, districtInput.value);
                updateSelectedAddressSummary();
            }
            function onDistrictInputChanged() {
                renderDistrictOptions(cityInput.value, districtInput.value);
                updateSelectedAddressSummary();
            }
            function updateSelectedAddressSummary() {
                if (!selectedAddressSummary) return;
                var city = (cityInput.value || "").trim();
                var district = (districtInput.value || "").trim();
                selectedAddressSummary.textContent = "Dang chon: " + (district || "-") + ", " + (city || "-");
            }

            cityInput.addEventListener("focus", function () { renderCityOptions(cityInput.value); });
            districtInput.addEventListener("focus", function () { renderDistrictOptions(cityInput.value, districtInput.value); });
            cityInput.addEventListener("input", onCityInputChanged);
            cityInput.addEventListener("change", function () {
                onCityInputChanged();
                autoGeocode();
            });
            districtInput.addEventListener("input", onDistrictInputChanged);
            districtInput.addEventListener("change", function () {
                onDistrictInputChanged();
                autoGeocode();
            });
            addressInput.addEventListener("blur", function () { autoGeocode(); });
            updateSelectedAddressSummary();

            function autoGeocode() {
                var city = (cityInput.value || "").trim();
                var dist = (districtInput.value || "").trim();
                if (!city) return;
                var parts = [];
                if (dist) parts.push(dist);
                parts.push(city);
                var query = parts.join(", ");

                fetch("/Address/Suggest?q=" + encodeURIComponent(query) + "&limit=1")
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        if (!items || !items.length) return;
                        var item = items[0];
                        var lat = item.latitude != null ? item.latitude : item.Latitude;
                        var lng = item.longitude != null ? item.longitude : item.Longitude;
                        if (lat != null && lng != null) {
                            updateCoordinates(parseFloat(lat), parseFloat(lng));
                            marker.setLatLng([lat, lng]);
                            map.setView([lat, lng], 13);
                        }
                    })
                    .catch(function () { });
            }
        });
    </script>
}
