@using WebSite.Models.Profile
@model EditPersonalInfoViewModel

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
    var avatarUrl = (Model.AvatarUrl ?? "").Trim();
    var avatarUrlJson = System.Text.Json.JsonSerializer.Serialize(avatarUrl);
    var isNanny = Model.IsNanny;
    var dobMax = (isNanny
        ? DateOnly.FromDateTime(DateTime.Today.AddYears(-31))
        : DateOnly.FromDateTime(DateTime.Today))
        .ToString("yyyy-MM-dd");
}

@section Head {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<section class="profile-page">
    <div class="profile-shell">
        <div class="profile-header">
            <div class="flex-1 min-w-[220px]">
                <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-orange-500">Hồ sơ</p>
                <h1 class="mt-2 text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">Chỉnh sửa thông tin cá nhân</h1>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form id="editProfileForm" method="post" enctype="multipart/form-data" class="mt-4">
            @Html.AntiForgeryToken()

            <div class="profile-grid">
                <div class="space-y-4">
                    <div class="profile-card">
                        <h3>Thông tin cá nhân</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="form-label" for="FirstName">Họ</label>
                                <input asp-for="FirstName" id="FirstName" class="form-input" required />
                            </div>
                            <div>
                                <label class="form-label" for="LastName">Tên</label>
                                <input asp-for="LastName" id="LastName" class="form-input" required />
                            </div>
                            <div>
                                <label class="form-label" for="PhoneNumber">Điện thoại</label>
                                <input asp-for="PhoneNumber" id="PhoneNumber" class="form-input" />
                            </div>
                            <div>
                                <label class="form-label" for="DateOfBirth">Ngày sinh</label>
                                <input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" id="DateOfBirth" type="date" max="@dobMax" class="form-input" />
                                @if (isNanny)
                                {
                                    <p class="text-xs text-slate-500 mt-1">Nanny phải lớn hơn 30 tuổi.</p>
                                }
                                <p id="dobError" class="hidden text-xs text-red-600 mt-1"></p>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="form-label">Giới tính</label>
                            <input type="hidden" asp-for="Gender" id="Gender" />
                            <div class="gender-segment" role="group" aria-label="Chọn giới tính">
                                <button type="button" class="gender-btn" data-value="0">Nam</button>
                                <button type="button" class="gender-btn" data-value="1">Nữ</button>
                            </div>
                        </div>
                    </div>

                    @if (isNanny)
                    {
                        <div class="profile-card profile-card-soft">
                            <h3>Thông tin nghề nghiệp (Nanny)</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="form-label" for="Bio">Giới thiệu</label>
                                    <textarea asp-for="Bio" id="Bio" rows="3" class="form-input resize-none"></textarea>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="form-label" for="YearsOfExperience">Năm kinh nghiệm</label>
                                        <input asp-for="YearsOfExperience" id="YearsOfExperience" type="number" min="0" class="form-input" />
                                    </div>
                                    <div>
                                        <label class="form-label" for="EducationLevel">Học vấn</label>
                                        <select asp-for="EducationLevel" id="EducationLevel" class="form-input">
                                            <option value="">-- Chọn --</option>
                                            <option value="0">Trung học</option>
                                            <option value="1">Cao đẳng</option>
                                            <option value="2">Đại học</option>
                                            <option value="3">Thạc sĩ</option>
                                            <option value="4">Khác</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="form-label" for="ExpectedSalaryMin">Lương tối thiểu</label>
                                        <input asp-for="ExpectedSalaryMin" id="ExpectedSalaryMin" type="text" inputmode="numeric" autocomplete="off" class="form-input" />
                                        <span asp-validation-for="ExpectedSalaryMin" class="text-xs text-red-600 mt-1 block"></span>
                                    </div>
                                    <div>
                                        <label class="form-label" for="ExpectedSalaryMax">Lương tối đa</label>
                                        <input asp-for="ExpectedSalaryMax" id="ExpectedSalaryMax" type="text" inputmode="numeric" autocomplete="off" class="form-input" />
                                        <span asp-validation-for="ExpectedSalaryMax" class="text-xs text-red-600 mt-1 block"></span>
                                    </div>
                                </div>
                                <p id="salaryError" class="hidden text-xs text-red-600 mt-1"></p>
                                <p class="text-xs text-slate-500">Lương hợp lệ từ 8.000.000 đến 50.000.000 VND.</p>
                                <div>
                                    <label class="form-label" for="MaxTravelDistance">Khoảng cách di chuyển tối đa (km)</label>
                                    <input asp-for="MaxTravelDistance" id="MaxTravelDistance" type="number" min="0" class="form-input" />
                                </div>
                                <div>
                                    <label class="form-label">Kỹ năng</label>
                                    @if (Model.AvailableSkills.Any())
                                    {
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 p-4 rounded-2xl border border-orange-100 bg-white">
                                            @foreach (var skill in Model.AvailableSkills)
                                            {
                                                var checkedAttr = Model.SelectedSkillIds.Contains(skill.SkillId);
                                                <label class="flex items-center gap-2 text-sm text-slate-700 font-semibold">
                                                    <input type="checkbox"
                                                           name="SelectedSkillIds"
                                                           value="@skill.SkillId"
                                                           @(checkedAttr ? "checked" : null)
                                                           class="rounded border-gray-300 text-orange-600 focus:ring-orange-500" />
                                                    <span>@skill.SkillName</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-slate-500">Không tải được danh sách kỹ năng.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="profile-card">
                        <h3>Địa chỉ và bản đồ</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="form-label" for="Address">Địa chỉ chi tiết</label>
                                <input asp-for="Address" id="Address" class="form-input" placeholder="Số nhà, tên đường..." />
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="form-label" for="City">Tỉnh/Thành</label>
                                    <div class="location-input-wrap">
                                        <input asp-for="City" id="City" class="form-input location-input" list="cityOptions" placeholder="Nhập hoặc chọn Tỉnh/Thành" autocomplete="off" />
                                        <button type="button" class="location-picker-btn" data-target-input="City" aria-label="Mở gợi ý Tỉnh/Thành">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <datalist id="cityOptions"></datalist>
                                </div>
                                <div>
                                    <label class="form-label" for="District">Phường/Xã</label>
                                    <div class="location-input-wrap">
                                        <input asp-for="District" id="District" class="form-input location-input" list="districtOptions" placeholder="Nhập hoặc chọn Phường/Xã" autocomplete="off" />
                                        <button type="button" class="location-picker-btn" data-target-input="District" aria-label="Mở gợi ý Phường/Xã">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                            </svg>
                                        </button>
                                    </div>
                                    <datalist id="districtOptions"></datalist>
                                </div>
                            </div>
                            <p id="selectedAddressSummary" class="text-xs text-slate-500 font-semibold">
                                Đang chọn: @(string.IsNullOrWhiteSpace(Model.District) ? "-" : Model.District), @(string.IsNullOrWhiteSpace(Model.City) ? "-" : Model.City)
                            </p>
                            <div id="addressLoadError" class="hidden text-sm text-red-600"></div>
                            <div id="map" class="profile-map"></div>
                            <input asp-for="Latitude" id="Latitude" type="hidden" />
                            <input asp-for="Longitude" id="Longitude" type="hidden" />
                            <p class="text-xs font-semibold text-slate-500">Tọa độ: <span id="coords-display">@Model.Latitude, @Model.Longitude</span></p>
                        </div>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="profile-card">
                        <h3>Ảnh đại diện</h3>
                        <div class="avatar-editor">
                            <div class="avatar-preview-shell">
                                <img id="avatarPreview"
                                     class="@((string.IsNullOrWhiteSpace(avatarUrl) ? "hidden " : "") + "avatar-preview-img")"
                                     src="@avatarUrl"
                                     alt="Xem trước ảnh đại diện" />
                                <div id="avatarPlaceholder" class="@((string.IsNullOrWhiteSpace(avatarUrl) ? "" : "hidden ") + "avatar-preview-placeholder")">
                                    Chưa có ảnh
                                </div>
                            </div>
                            <input type="hidden" asp-for="AvatarUrl" value="@avatarUrl" />

                            <div class="w-full mt-4">
                                <label class="form-label" for="AvatarFile">Tải ảnh lên (.jpg, .jpeg, .png)</label>
                                <input type="file" asp-for="AvatarFile" id="AvatarFile" accept=".jpg,.jpeg,.png" class="hidden" />
                                <div class="avatar-upload-actions">
                                    <button type="button" id="avatarUploadBtn" class="profile-primary-btn flex-1">Chọn ảnh</button>
                                    <button type="button" id="avatarResetBtn" class="ghost-btn">Bỏ chọn</button>
                                </div>
                                <p class="text-xs text-slate-500 mt-2">Chỉ cho phép file .jpg, .jpeg hoặc .png</p>
                                <p id="avatarUploadError" class="hidden text-xs text-red-600 mt-1"></p>
                            </div>
                            <div class="w-full mt-3">
                                <p id="avatarFileName" class="avatar-file-name">Chưa chọn tệp nào.</p>
                            </div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Hành động</h3>
                        <div class="space-y-2">
                            <a href="@Url.Action("Index", "Profile")" class="ghost-btn w-full">Hủy bỏ</a>
                            <button type="submit" class="profile-primary-btn w-full">Lưu thông tin</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<div id="profileToast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-[9999] rounded-xl border border-orange-200 bg-orange-500 text-white px-4 py-3 text-sm font-bold shadow-xl">
    @((TempData["Success"] ?? "").ToString())
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var isNanny = @(isNanny ? "true" : "false");
            var form = document.getElementById("editProfileForm");
            var dobInput = document.getElementById("DateOfBirth");
            var dobError = document.getElementById("dobError");

            var genderInput = document.getElementById("Gender");
            var genderButtons = document.querySelectorAll(".gender-btn");
            function syncGenderUI() {
                var current = (genderInput.value || "").trim();
                genderButtons.forEach(function (btn) {
                    var active = btn.getAttribute("data-value") === current;
                    btn.classList.toggle("active", active);
                });
            }
            genderButtons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    genderInput.value = btn.getAttribute("data-value");
                    syncGenderUI();
                });
            });
            syncGenderUI();

            var avatarInput = document.getElementById("AvatarFile");
            var avatarErr = document.getElementById("avatarUploadError");
            var avatarPreview = document.getElementById("avatarPreview");
            var avatarPlaceholder = document.getElementById("avatarPlaceholder");
            var avatarUploadBtn = document.getElementById("avatarUploadBtn");
            var avatarResetBtn = document.getElementById("avatarResetBtn");
            var avatarFileName = document.getElementById("avatarFileName");
            var currentAvatarUrl = @Html.Raw(avatarUrlJson);
            var salaryInputs = [
                document.getElementById("ExpectedSalaryMin"),
                document.getElementById("ExpectedSalaryMax")
            ].filter(Boolean);
            var salaryError = document.getElementById("salaryError");
            var minSalaryAllowed = 8000000;
            var maxSalaryAllowed = 50000000;

            function showAvatarError(msg) {
                avatarErr.textContent = msg || "";
                avatarErr.classList.toggle("hidden", !msg);
            }
            function isAllowedImage(file) {
                if (!file) return false;
                var name = (file.name || "").toLowerCase();
                return name.endsWith(".jpg") || name.endsWith(".jpeg") || name.endsWith(".png");
            }
            function clearPreview() {
                avatarPreview.src = "";
                avatarPreview.classList.add("hidden");
                if (avatarPlaceholder) avatarPlaceholder.classList.remove("hidden");
            }
            function setPreview(src) {
                if (!avatarPreview) return;
                avatarPreview.onerror = function () {
                    avatarPreview.classList.add("hidden");
                    if (avatarPlaceholder) avatarPlaceholder.classList.remove("hidden");
                    showAvatarError("Không thể hiển thị ảnh xem trước. Vui lòng chọn ảnh khác.");
                };
                avatarPreview.src = src;
                avatarPreview.classList.remove("hidden");
                if (avatarPlaceholder) avatarPlaceholder.classList.add("hidden");
            }
            function setAvatarFileName(value) {
                if (!avatarFileName) return;
                avatarFileName.textContent = value || "Chưa chọn tệp nào.";
            }
            function restoreInitialAvatar() {
                clearPreview();
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                setAvatarFileName("");
                showAvatarError("");
            }

            restoreInitialAvatar();

            avatarUploadBtn.addEventListener("click", function () {
                avatarInput.click();
            });

            avatarResetBtn.addEventListener("click", function () {
                avatarInput.value = "";
                restoreInitialAvatar();
            });

            avatarInput.addEventListener("change", function () {
                showAvatarError("");
                var file = avatarInput.files && avatarInput.files[0] ? avatarInput.files[0] : null;
                setAvatarFileName(file ? file.name : "");

                if (!file) {
                    restoreInitialAvatar();
                    return;
                }
                if (!isAllowedImage(file)) {
                    avatarInput.value = "";
                    restoreInitialAvatar();
                    showAvatarError("Chỉ cho phép file .jpg, .jpeg hoặc .png.");
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    var result = e && e.target ? e.target.result : null;
                    if (typeof result === "string" && result.length > 0) {
                        clearPreview();
                        setPreview(result);
                        return;
                    }

                    restoreInitialAvatar();
                    showAvatarError("Không thể đọc file ảnh để xem trước.");
                };
                reader.onerror = function () {
                    restoreInitialAvatar();
                    showAvatarError("Không thể đọc file ảnh để xem trước.");
                };
                reader.readAsDataURL(file);
            });

            function getDigits(value) {
                return (value || "").replace(/\D/g, "");
            }

            function formatMoneyValue(value) {
                var digits = getDigits(value);
                if (!digits) return "";
                return digits.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
            }

            salaryInputs.forEach(function (input) {
                input.addEventListener("input", function () {
                    input.value = formatMoneyValue(input.value);
                    validateSalaryRange();
                });

                input.addEventListener("blur", function () {
                    input.value = formatMoneyValue(input.value);
                    validateSalaryRange();
                });

                if (input.value) {
                    input.value = formatMoneyValue(input.value);
                }
            });

            function parseSalaryInput(input) {
                if (!input) return null;
                var digits = getDigits(input.value);
                return digits ? Number(digits) : null;
            }

            function showSalaryError(message) {
                if (!salaryError) return;
                salaryError.textContent = message || "";
                salaryError.classList.toggle("hidden", !message);
            }

            function validateSalaryRange() {
                if (!isNanny) return true;

                var salaryMin = parseSalaryInput(document.getElementById("ExpectedSalaryMin"));
                var salaryMax = parseSalaryInput(document.getElementById("ExpectedSalaryMax"));

                if (salaryMin != null && (salaryMin < minSalaryAllowed || salaryMin > maxSalaryAllowed)) {
                    showSalaryError("Lương tối thiểu phải trong khoảng 8.000.000 - 50.000.000 VND.");
                    return false;
                }

                if (salaryMax != null && (salaryMax < minSalaryAllowed || salaryMax > maxSalaryAllowed)) {
                    showSalaryError("Lương tối đa phải trong khoảng 8.000.000 - 50.000.000 VND.");
                    return false;
                }

                if (salaryMin != null && salaryMax != null && salaryMin > salaryMax) {
                    showSalaryError("Lương tối thiểu không được lớn hơn lương tối đa.");
                    return false;
                }

                showSalaryError("");
                return true;
            }

            function validateNannyDob() {
                if (!isNanny) return true;
                var value = dobInput.value;
                if (!value) {
                    dobError.textContent = "Vui lòng chọn ngày sinh.";
                    dobError.classList.remove("hidden");
                    return false;
                }
                var dob = new Date(value + "T00:00:00");
                var today = new Date();
                var age = today.getFullYear() - dob.getFullYear();
                var monthDiff = today.getMonth() - dob.getMonth();
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) age--;
                if (age <= 30) {
                    dobError.textContent = "Bảo mẫu phải lớn hơn 30 tuổi.";
                    dobError.classList.remove("hidden");
                    return false;
                }
                dobError.classList.add("hidden");
                dobError.textContent = "";
                return true;
            }

            form.addEventListener("submit", function (e) {
                if (!validateNannyDob()) {
                    e.preventDefault();
                    return;
                }

                if (!validateSalaryRange()) {
                    e.preventDefault();
                    return;
                }

                salaryInputs.forEach(function (input) {
                    input.value = getDigits(input.value);
                });
            });
            dobInput.addEventListener("change", validateNannyDob);

            var toast = document.getElementById("profileToast");
            if (toast && toast.textContent.trim()) {
                toast.classList.remove("hidden");
                setTimeout(function () {
                    toast.classList.add("hidden");
                }, 2500);
            }

            var initialLat = parseFloat(document.getElementById("Latitude").value) || 21.0285;
            var initialLng = parseFloat(document.getElementById("Longitude").value) || 105.8542;
            var map = L.map("map").setView([initialLat, initialLng], 13);
            L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
                attribution: "&copy; CartoDB",
                maxZoom: 19
            }).addTo(map);

            var marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            function updateCoordinates(lat, lng) {
                document.getElementById("Latitude").value = lat.toFixed(6);
                document.getElementById("Longitude").value = lng.toFixed(6);
                document.getElementById("coords-display").innerText = lat.toFixed(6) + ", " + lng.toFixed(6);
            }
            marker.on("dragend", function () {
                var p = marker.getLatLng();
                updateCoordinates(p.lat, p.lng);
            });
            map.on("click", function (e) {
                marker.setLatLng([e.latlng.lat, e.latlng.lng]);
                updateCoordinates(e.latlng.lat, e.latlng.lng);
            });

            var cityInput = document.getElementById("City");
            var districtInput = document.getElementById("District");
            var cityOptions = document.getElementById("cityOptions");
            var districtOptions = document.getElementById("districtOptions");
            var selectedAddressSummary = document.getElementById("selectedAddressSummary");
            var addressInput = document.getElementById("Address");
            var addressLoadError = document.getElementById("addressLoadError");
            var locationPickerButtons = document.querySelectorAll(".location-picker-btn");
            var provinces = [];
            var htmlDecodeElement = document.createElement("textarea");
            var currentCity = "@(Model.City ?? "")";
            var currentDistrict = "@(Model.District ?? "")";

            function decodeHtmlEntities(value) {
                if (!value) return "";
                htmlDecodeElement.innerHTML = value;
                return htmlDecodeElement.value || "";
            }
            function sanitizeAddressLabel(value) {
                return decodeHtmlEntities(value || "")
                    .replace(/\s+/g, " ")
                    .trim();
            }

            if (currentCity && !cityInput.value) cityInput.value = currentCity;
            if (currentDistrict && !districtInput.value) districtInput.value = currentDistrict;
            cityInput.value = sanitizeAddressLabel(cityInput.value);
            districtInput.value = sanitizeAddressLabel(districtInput.value);
            currentCity = sanitizeAddressLabel(currentCity);
            currentDistrict = sanitizeAddressLabel(currentDistrict);

            setAddressInputState(true);
            fetch("/Address/LocationTree")
                .then(function (r) {
                    if (!r.ok) throw new Error("address-load-failed");
                    return r.json();
                })
                .then(function (data) {
                    provinces = sanitizeAddressTree(data || []);
                    renderCityOptions(cityInput.value || currentCity);
                    renderDistrictOptions(cityInput.value || currentCity, districtInput.value || currentDistrict);
                    showAddressLoadError("");
                    setAddressInputState(false);
                })
                .catch(function () {
                    provinces = [];
                    setAddressInputState(true);
                    showAddressLoadError("Không tải được danh sách tỉnh thành.");
                });

            function setAddressInputState(disabled) {
                cityInput.disabled = disabled;
                districtInput.disabled = disabled;
            }
            function showAddressLoadError(message) {
                addressLoadError.textContent = message || "";
                addressLoadError.classList.toggle("hidden", !message);
            }
            function normalizeText(value) {
                return sanitizeAddressLabel(value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/\u0111/g, "d")
                    .replace(/\u0110/g, "d")
                    .replace(/Ä‘/g, "d")
                    .trim();
            }
            function sortByFilterAndName(items, filterKey, getName) {
                return items.slice().sort(function (a, b) {
                    var aName = sanitizeAddressLabel(getName(a));
                    var bName = sanitizeAddressLabel(getName(b));
                    var aKey = normalizeText(aName);
                    var bKey = normalizeText(bName);
                    var aRank = !filterKey ? 0 : (aKey === filterKey ? 0 : (aKey.startsWith(filterKey) ? 1 : 2));
                    var bRank = !filterKey ? 0 : (bKey === filterKey ? 0 : (bKey.startsWith(filterKey) ? 1 : 2));
                    if (aRank !== bRank) return aRank - bRank;
                    return aName.localeCompare(bName, "vi", { sensitivity: "base" });
                });
            }
            function sanitizeAddressTree(rawTree) {
                if (!Array.isArray(rawTree)) return [];
                var provinceMap = new Map();

                rawTree.forEach(function (province) {
                    var provinceName = sanitizeAddressLabel(province && province.name);
                    if (!provinceName) return;
                    var provinceKey = normalizeText(provinceName);
                    if (!provinceKey) return;

                    if (!provinceMap.has(provinceKey)) {
                        provinceMap.set(provinceKey, { name: provinceName, districts: [] });
                    }

                    var targetProvince = provinceMap.get(provinceKey);
                    var districtMap = new Map();
                    (targetProvince.districts || []).forEach(function (district) {
                        districtMap.set(normalizeText(district.name), district);
                    });

                    var districts = Array.isArray(province && province.districts) ? province.districts : [];
                    districts.forEach(function (district) {
                        var districtName = sanitizeAddressLabel(district && district.name);
                        if (!districtName) return;
                        var districtKey = normalizeText(districtName);
                        if (!districtKey || districtMap.has(districtKey)) return;
                        districtMap.set(districtKey, { name: districtName });
                    });

                    targetProvince.districts = Array.from(districtMap.values()).sort(function (a, b) {
                        return a.name.localeCompare(b.name, "vi", { sensitivity: "base" });
                    });
                });

                return Array.from(provinceMap.values()).sort(function (a, b) {
                    return a.name.localeCompare(b.name, "vi", { sensitivity: "base" });
                });
            }
            function appendOption(listEl, value) {
                if (!value) return;
                var cleanedValue = sanitizeAddressLabel(value);
                if (!cleanedValue) return;
                var exists = Array.from(listEl.options).some(function (opt) {
                    return normalizeText(opt.value) === normalizeText(cleanedValue);
                });
                if (!exists) {
                    var option = document.createElement("option");
                    option.value = cleanedValue;
                    listEl.appendChild(option);
                }
            }
            function getProvinceByName(cityName) {
                var normalizedCity = normalizeText(cityName);
                if (!normalizedCity) return null;
                var exact = provinces.find(function (p) { return normalizeText(p.name) === normalizedCity; });
                if (exact) return exact;
                return provinces.find(function (p) {
                    var key = normalizeText(p.name);
                    return key.includes(normalizedCity) || normalizedCity.includes(key);
                }) || null;
            }
            function renderCityOptions(filterText) {
                cityOptions.innerHTML = "";
                var filterKey = normalizeText(filterText);
                sortByFilterAndName(
                    provinces.filter(function (p) {
                        if (!filterKey) return true;
                        return normalizeText(p.name).includes(filterKey);
                    }),
                    filterKey,
                    function (p) { return p.name; }
                )
                    .slice(0, 80)
                    .forEach(function (p) {
                        appendOption(cityOptions, p.name);
                    });

                if (!filterKey && currentCity) {
                    appendOption(cityOptions, currentCity);
                }
            }
            function isDistrictInCity(cityName, districtName) {
                var province = getProvinceByName(cityName);
                if (!province || !districtName) return false;
                var districtKey = normalizeText(districtName);
                return (province.districts || []).some(function (d) {
                    return normalizeText(d.name) === districtKey;
                });
            }
            function renderDistrictOptions(cityName, filterText) {
                districtOptions.innerHTML = "";
                var province = getProvinceByName(cityName);
                var districts = province && Array.isArray(province.districts) ? province.districts : [];
                var filterKey = normalizeText(filterText);
                sortByFilterAndName(
                    districts.filter(function (d) {
                        if (!filterKey) return true;
                        return normalizeText(d.name).includes(filterKey);
                    }),
                    filterKey,
                    function (d) { return d.name; }
                )
                    .slice(0, 120)
                    .forEach(function (d) {
                        appendOption(districtOptions, d.name);
                    });

                if (!filterKey && currentDistrict && isDistrictInCity(cityName, currentDistrict)) {
                    appendOption(districtOptions, currentDistrict);
                }
            }
            function onCityInputChanged() {
                cityInput.value = sanitizeAddressLabel(cityInput.value);
                renderCityOptions(cityInput.value);
                if (!isDistrictInCity(cityInput.value, districtInput.value)) {
                    districtInput.value = "";
                }
                renderDistrictOptions(cityInput.value, districtInput.value);
                updateSelectedAddressSummary();
            }
            function onDistrictInputChanged() {
                districtInput.value = sanitizeAddressLabel(districtInput.value);
                renderDistrictOptions(cityInput.value, districtInput.value);
                updateSelectedAddressSummary();
            }
            function updateSelectedAddressSummary() {
                if (!selectedAddressSummary) return;
                var city = (cityInput.value || "").trim();
                var district = (districtInput.value || "").trim();
                selectedAddressSummary.textContent = "Đang chọn: " + (district || "-") + ", " + (city || "-");
            }

            cityInput.addEventListener("focus", function () { renderCityOptions(cityInput.value); });
            districtInput.addEventListener("focus", function () { renderDistrictOptions(cityInput.value, districtInput.value); });
            cityInput.addEventListener("input", onCityInputChanged);
            cityInput.addEventListener("change", function () {
                onCityInputChanged();
                autoGeocode();
            });
            districtInput.addEventListener("input", onDistrictInputChanged);
            districtInput.addEventListener("change", function () {
                onDistrictInputChanged();
                autoGeocode();
            });
            locationPickerButtons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var targetId = btn.getAttribute("data-target-input");
                    var input = targetId ? document.getElementById(targetId) : null;
                    if (!input || input.disabled) return;
                    input.focus();
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                });
            });
            addressInput.addEventListener("blur", function () { autoGeocode(); });
            updateSelectedAddressSummary();

            function autoGeocode() {
                var city = (cityInput.value || "").trim();
                var dist = (districtInput.value || "").trim();
                if (!city) return;
                var parts = [];
                if (dist) parts.push(dist);
                parts.push(city);
                var query = parts.join(", ");

                fetch("/Address/Suggest?q=" + encodeURIComponent(query) + "&limit=1")
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        if (!items || !items.length) return;
                        var item = items[0];
                        var lat = item.latitude != null ? item.latitude : item.Latitude;
                        var lng = item.longitude != null ? item.longitude : item.Longitude;
                        if (lat != null && lng != null) {
                            updateCoordinates(parseFloat(lat), parseFloat(lng));
                            marker.setLatLng([lat, lng]);
                            map.setView([lat, lng], 13);
                        }
                    })
                    .catch(function () { });
            }
        });
    </script>
}
