@using WebSite.Controllers
@using WebSite.Models.Profile
@model UpdateChildProfileViewModel

@{
    ViewData["Title"] = "Chỉnh sửa thông tin con em";
}


<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white dark:from-gray-950 dark:via-gray-900 dark:to-gray-950 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <div class="mb-8 text-center sm:text-left">
            <span class="section-label mx-auto sm:mx-0">✏️ Chỉnh sửa</span>
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mt-3" style="font-family:'Quicksand',sans-serif">
                Cập nhật <span class="gradient-text">thông tin con em</span>
            </h1>
            <div class="section-divider left mx-auto sm:mx-0 mt-4"></div>
        </div>

        <div class="bg-white/80 dark:bg-card-dark/80 rounded-3xl p-6 lg:p-10 shadow-soft border border-gray-100/80 dark:border-gray-800/50 backdrop-blur-md">
            <form method="post" class="space-y-8">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id">

                <!-- Basic Information -->
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-3" style="font-family:'Quicksand',sans-serif">
                        <div class="w-10 h-10 bg-orange-100 dark:bg-orange-950/30 rounded-xl flex items-center justify-center text-orange-600 dark:text-orange-400">
                            <span class="material-icons-round">person</span>
                        </div>
                        Thông tin cơ bản
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Child Age Group -->
                        <div class="space-y-2">
                            <label for="ChildAgeGroup" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest ml-1 pointer-events-none">
                                🎂 Nhóm tuổi
                            </label>
                            <select class="w-full px-5 py-4 bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 rounded-2xl focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all outline-none text-gray-900 dark:text-white font-medium"
                                    id="ChildAgeGroup" name="ChildAgeGroup">
                                <option value="">-- Chọn nhóm tuổi --</option>
                                <option value="1" selected="@(Model.ChildAgeGroup == WebSite.Enums.ChildAgeGroup.Baby)">Em bé (0-1 tuổi)</option>
                                <option value="2" selected="@(Model.ChildAgeGroup == WebSite.Enums.ChildAgeGroup.Toddler)">Toddler (1-3 tuổi)</option>
                                <option value="3" selected="@(Model.ChildAgeGroup == WebSite.Enums.ChildAgeGroup.Preschooler)">Mầm non (3-5 tuổi)</option>
                                <option value="4" selected="@(Model.ChildAgeGroup == WebSite.Enums.ChildAgeGroup.Gradeschooler)">Học sinh tiểu học (6-12 tuổi)</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.ChildAgeGroup, "", new { @class = "text-red-500 text-sm font-medium mt-1 ml-1" })
                        </div>
                    </div>
                </div>

                <!-- Health & Special Information -->
                <div class="pt-8 border-t border-gray-100 dark:border-gray-800 space-y-8">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-3" style="font-family:'Quicksand',sans-serif">
                        <div class="w-10 h-10 bg-blue-100 dark:bg-blue-950/30 rounded-xl flex items-center justify-center text-blue-600 dark:text-blue-400">
                            <span class="material-icons-round">health_and_safety</span>
                        </div>
                        Thông tin chi tiết
                    </h3>

                    <div class="grid grid-cols-1 gap-8">
                        <!-- Special Needs -->
                        <div class="space-y-2">
                            <label for="SpecialNeeds" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest ml-1 pointer-events-none">
                                🎯 Nhu cầu đặc biệt (nếu có)
                            </label>
                            <textarea class="w-full px-5 py-4 bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 rounded-2xl focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all outline-none text-gray-900 dark:text-white font-medium resize-none shadow-sm"
                                      id="SpecialNeeds" name="SpecialNeeds" rows="3" placeholder="Mô tả các nhu cầu đặc biệt nếu có...">@Model.SpecialNeeds</textarea>
                            @Html.ValidationMessageFor(m => m.SpecialNeeds, "", new { @class = "text-red-500 text-sm font-medium mt-1 ml-1" })
                        </div>

                        <!-- Characteristic -->
                        <div class="space-y-2">
                            <label for="Characteristic" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest ml-1 pointer-events-none">
                                ✨ Đặc điểm tính cách
                            </label>
                            <textarea class="w-full px-5 py-4 bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 rounded-2xl focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all outline-none text-gray-900 dark:text-white font-medium resize-none shadow-sm"
                                      id="Characteristic" name="Characteristic" rows="3" placeholder="Mô tả đặc điểm tính cách của con...">@Model.Characteristic</textarea>
                            @Html.ValidationMessageFor(m => m.Characteristic, "", new { @class = "text-red-500 text-sm font-medium mt-1 ml-1" })
                        </div>

                        <!-- Notes -->
                        <div class="space-y-2">
                            <label for="Notes" class="block text-sm font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest ml-1 pointer-events-none">
                                📝 Ghi chú thêm
                            </label>
                            <textarea class="w-full px-5 py-4 bg-gray-50 dark:bg-gray-900/50 border border-gray-200 dark:border-gray-700 rounded-2xl focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all outline-none text-gray-900 dark:text-white font-medium resize-none shadow-sm"
                                      id="Notes" name="Notes" rows="4" placeholder="Các thông tin thêm về con em...">@Model.Notes</textarea>
                            @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-red-500 text-sm font-medium mt-1 ml-1" })
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-8 flex flex-col sm:flex-row gap-4">
                    <button type="submit" 
                            class="flex-1 flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold rounded-2xl transition-all duration-300 shadow-glow hover:shadow-xl">
                        <span class="material-icons-round">save</span>
                        Lưu thay đổi
                    </button>
                    <a href="@Url.Action("Children", "Profile")" 
                       class="flex-1 flex items-center justify-center gap-2 px-8 py-4 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 font-bold rounded-2xl transition-all duration-300 hover:bg-gray-200 dark:hover:bg-gray-700 border border-transparent hover:border-gray-300 dark:hover:border-gray-600">
                        <span class="material-icons-round">close</span>
                        Hủy bỏ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .shadow-soft { box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05); }
    .shadow-glow { box-shadow: 0 10px 25px -5px rgba(249, 115, 22, 0.4); }
    .bg-card-dark { background-color: #111827; }
    .gradient-text { 
        background: linear-gradient(135deg, #EA580C 0%, #F97316 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
    }
</style>
        padding: 0.5rem 0.75rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    .btn {
        border-radius: 5px;
        padding: 0.5rem 1rem;
    }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
</style>
