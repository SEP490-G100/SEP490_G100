@using WebSite.Controllers
@model PersonalProfileViewModel
@using WebSite.Models.Profile

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <span class="section-label">👤 Hồ sơ của tôi</span>
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mt-3" style="font-family:'Quicksand',sans-serif">
                Thông tin <span class="gradient-text">cá nhân</span>
            </h1>
            <div class="section-divider left mt-4"></div>
        </div>

        <!-- Main Card -->
        <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-8 lg:p-10 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm">
            <!-- Profile Information Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                <!-- Email -->
                <div class="space-y-2">
                    <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">📧 Email</label>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">@Model.Email</p>
                </div>

                <!-- Full Name -->
                <div class="space-y-2">
                    <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">👤 Họ tên</label>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">@Model.FirstName @Model.LastName</p>
                </div>

                <!-- Phone -->
                <div class="space-y-2">
                    <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">📱 Số điện thoại</label>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">
                        @(Model.PhoneNumber?.ToString() ?? "Chưa được cập nhật")
                    </p>
                </div>

                <!-- Date of Birth -->
                <div class="space-y-2">
                    <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">🎂 Ngày sinh</label>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">
                        @(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa được cập nhật")
                    </p>
                </div>

                <!-- Gender -->
                <div class="space-y-2">
                    <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">👥 Giới tính</label>
                    <p class="text-lg font-semibold text-gray-900 dark:text-white">
                        @if (Model.Gender.HasValue)
                        {
                            @(Model.Gender == 0 ? "Nam" : Model.Gender == 1 ? "Nữ" : "Khác")
                        }
                        else
                        {
                            <span class="text-gray-400">Chưa được cập nhật</span>
                        }
                    </p>
                </div>

                <!-- Roles -->
                <div class="space-y-2">
                    <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">🏷️ Vị trí</label>
                    <div>
                        @if (Model.Roles.Any())
                        {
                            @foreach(var role in Model.Roles)
                            {
                                <span class="inline-block bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300 px-3 py-1 rounded-full text-sm font-medium mr-2 mb-2">@role</span>
                            }
                        }
                        else
                        {
                            <span class="text-gray-400">Chưa được gán vị trị</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Address Section -->
            <div class="pt-8 border-t border-gray-100 dark:border-gray-700/50">
                <label class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider block mb-3">📍 Địa chỉ</label>
                <p class="text-lg font-semibold text-gray-900 dark:text-white">
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        @($"{Model.Address}, {Model.Ward}, {Model.District}, {Model.City}")
                    }
                    else
                    {
                        <span class="text-gray-400">Chưa được cập nhật</span>
                    }
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 mt-10 pt-8 border-t border-gray-100 dark:border-gray-700/50">
                <a href="@Url.Action("Edit", "Profile")" 
                   class="flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl">
                    <span class="material-icons-round text-xl">edit</span>
                    Chỉnh sửa thông tin
                </a>
                @if (Model.IsParent)
                {
                    <a href="@Url.Action("Children", "Profile")" 
                       class="flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl">
                        <span class="material-icons-round text-xl">groups</span>
                        Quản lý con em
                    </a>
                }
            </div>
        </div>
    </div>
</div>
    }

    .fw-bold {
        color: #333;
    }
</style>
