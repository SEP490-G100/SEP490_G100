@model WebSite.Models.Profile.PersonalProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var avatar = string.IsNullOrWhiteSpace(Model.AvatarUrl) ? null : Model.AvatarUrl.Trim();
    var isNanny = Model.IsNanny;
    var isParent = Model.IsParent;
    var rating = Model.AverageRating ?? 0;

    string EducationLabel(int? level) => level switch
    {
        0 => "Trung học",
        1 => "Cao đẳng",
        2 => "Đại học",
        3 => "Thạc sĩ",
        4 => "Khác",
        _ => "Chưa cập nhật"
    };

    string VerificationText(int? code) => code switch
    {
        1 => "Tài khoản đang chờ duyệt xác minh.",
        2 => "Tài khoản đã được xác minh.",
        _ => "Tài khoản chưa được xác minh."
    };

    string ChildAgeGroupLabel(byte? ageGroup) => ageGroup switch
    {
        0 => "Em bé (0 - 1 tuổi)",
        1 => "Trẻ nhỏ (1 - 3 tuổi)",
        2 => "Mầm non (3 - 5 tuổi)",
        3 => "Tiểu học (6 - 12 tuổi)",
        _ => "Chưa cập nhật"
    };

    var days = new[] { (1, "Thứ 2"), (2, "Thứ 3"), (3, "Thứ 4"), (4, "Thứ 5"), (5, "Thứ 6"), (6, "Thứ 7"), (0, "Chủ nhật") };
    var slots = new[] { (0, "Sáng"), (1, "Chiều"), (2, "Tối"), (3, "Đêm") };
    bool IsAvailable(int day, int slot) => Model.Availabilities?.Any(a => a.DayOfWeek == day && a.TimeSlot == slot && a.IsAvailable) == true;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white">
    <div class="h-32 sm:h-40 bg-gradient-to-r from-orange-400 to-orange-600 relative overflow-hidden shadow-lg">
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 left-0 w-64 h-64 bg-white rounded-full blur-3xl -ml-20 -mt-20"></div>
            <div class="absolute bottom-0 right-0 w-64 h-64 bg-white rounded-full blur-3xl -mr-20 -mb-20"></div>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 -mt-16 sm:-mt-20 pb-20 relative z-10">
        <div class="flex flex-col md:flex-row items-center md:items-end gap-6 px-4 mb-8">
            <div class="h-32 w-32 sm:h-40 sm:w-40 rounded-3xl bg-white p-1 shadow-xl overflow-hidden shrink-0">
                @if (avatar != null)
                {
                    <img src="@avatar" alt="Avatar" class="h-full w-full object-cover rounded-2xl" />
                }
                else
                {
                    <div class="h-full w-full flex items-center justify-center bg-gray-50 text-gray-400 rounded-2xl">
                        <span class="material-icons-round" style="font-size: 64px;">person</span>
                    </div>
                }
            </div>

            <div class="flex-1 text-center md:text-left mb-2">
                <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900" style="font-family:'Quicksand',sans-serif">
                    @Model.FirstName @Model.LastName
                </h1>
                <div class="mt-2 flex flex-wrap items-center justify-center md:justify-start gap-3 text-sm text-gray-600">
                    <span class="px-3 py-1 bg-orange-100 text-orange-700 font-bold rounded-full uppercase tracking-wider">
                        @(isNanny ? "Bảo mẫu" : "Phụ huynh")
                    </span>
                    <span>@(!string.IsNullOrWhiteSpace(Model.City) ? Model.City : "Việt Nam")</span>
                    <span>@(Model.Age?.ToString() ?? "—") tuổi</span>
                    @if (isNanny)
                    {
                        <span class="font-semibold">Đánh giá: @rating.ToString("0.##") (@(Model.TotalReviews ?? 0))</span>
                    }
                </div>
            </div>

            <a href="@Url.Action("Edit", "Profile")"
               class="inline-flex items-center gap-2 px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-bold rounded-2xl transition-all">
                Chỉnh sửa hồ sơ
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-8">
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-soft border border-gray-100">
                    <h2 class="text-xl font-bold mb-4" style="font-family:'Quicksand',sans-serif">
                        @(isNanny ? "Giới thiệu bản thân" : "Mô tả gia đình")
                    </h2>
                    <p class="text-gray-700 leading-relaxed">
                        @((isNanny ? Model.Bio : Model.FamilyDescription) ?? "Chưa có thông tin cập nhật.")
                    </p>
                </div>

                @if (isNanny)
                {
                    <div class="bg-white rounded-3xl p-6 shadow-soft border border-gray-100 overflow-x-auto">
                        <h2 class="text-xl font-bold mb-4" style="font-family:'Quicksand',sans-serif">Thông tin NannyProfile</h2>
                        <table class="w-full text-sm border border-gray-200 rounded-xl overflow-hidden">
                            <tbody>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50 w-56">Bio</td>
                                    <td class="px-4 py-3">@(!string.IsNullOrWhiteSpace(Model.Bio) ? Model.Bio : "Chưa cập nhật")</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">YearsOfExperience</td>
                                    <td class="px-4 py-3">@((Model.YearsOfExperience?.ToString()) ?? "0")</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">EducationLevel</td>
                                    <td class="px-4 py-3">@EducationLabel(Model.EducationLevel)</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">ExpectedSalaryMin</td>
                                    <td class="px-4 py-3">@((Model.ExpectedSalaryMin?.ToString("0")) ?? "0") VND</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">ExpectedSalaryMax</td>
                                    <td class="px-4 py-3">@((Model.ExpectedSalaryMax?.ToString("0")) ?? "0") VND</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">MaxTravelDistance</td>
                                    <td class="px-4 py-3">@((Model.MaxTravelDistance?.ToString()) ?? "0") km</td>
                                </tr>
                                <tr class="border-b border-gray-200">
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">AverageRating</td>
                                    <td class="px-4 py-3">@rating.ToString("0.##")</td>
                                </tr>
                                <tr>
                                    <td class="font-semibold text-gray-700 px-4 py-3 bg-gray-50">VerificationStatus</td>
                                    <td class="px-4 py-3">
                                        @VerificationText(Model.VerificationStatusCode)
                                        @if ((Model.VerificationStatusCode ?? 0) == 0)
                                        {
                                            <div class="mt-2">
                                                <a href="@Url.Action("Verify", "Profile")" class="inline-block px-4 py-2 rounded-lg bg-orange-500 hover:bg-orange-600 text-white font-semibold text-xs">
                                                    Đi đến trang Verify
                                                </a>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="bg-white rounded-3xl p-6 shadow-soft border border-gray-100">
                        <h2 class="text-xl font-bold mb-4" style="font-family:'Quicksand',sans-serif">NannySkill</h2>
                        @if (Model.Skills != null && Model.Skills.Any())
                        {
                            <div class="flex flex-wrap gap-2">
                                @foreach (var s in Model.Skills)
                                {
                                    <span class="px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-sm font-semibold">
                                        @(string.IsNullOrWhiteSpace(s.SkillName) ? s.SkillId.ToString() : s.SkillName)
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-gray-500">Chưa có kỹ năng nào.</p>
                        }
                    </div>

                    <div class="bg-white rounded-3xl p-6 shadow-soft border border-gray-100">
                        <h2 class="text-xl font-bold mb-4" style="font-family:'Quicksand',sans-serif">NannyAvailability (Thứ 2 - Chủ nhật)</h2>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm border border-gray-200 rounded-xl overflow-hidden">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="text-left px-3 py-2 font-semibold text-gray-700">Ca</th>
                                        @foreach (var d in days)
                                        {
                                            <th class="text-center px-3 py-2 font-semibold text-gray-700">@d.Item2</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slot in slots)
                                    {
                                        <tr class="border-t border-gray-200">
                                            <td class="px-3 py-2 font-semibold text-gray-700">@slot.Item2</td>
                                            @foreach (var d in days)
                                            {
                                                var ok = IsAvailable(d.Item1, slot.Item1);
                                                <td class="px-3 py-2 text-center">
                                                    <span class="inline-block w-3 h-3 rounded-full @(ok ? "bg-green-500" : "bg-gray-300")"></span>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="bg-white rounded-3xl p-6 shadow-soft border border-gray-100">
                        <h2 class="text-xl font-bold mb-4" style="font-family:'Quicksand',sans-serif">NannyCertificate</h2>
                        @if (Model.Certificates != null && Model.Certificates.Any())
                        {
                            <div class="space-y-3">
                                @foreach (var cert in Model.Certificates)
                                {
                                    <div class="p-4 rounded-xl border border-gray-200 bg-gray-50">
                                        <p class="font-semibold text-gray-800">@cert.Name</p>
                                        @if (!string.IsNullOrWhiteSpace(cert.IssuingOrganization))
                                        {
                                            <p class="text-sm text-gray-600">Đơn vị cấp: @cert.IssuingOrganization</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(cert.CertificateUrl))
                                        {
                                            <a href="@cert.CertificateUrl" target="_blank" class="text-sm text-orange-600 hover:underline">Xem chứng chỉ</a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-gray-500 mb-3">Bạn chưa có chứng chỉ.</p>
                            <a href="@Url.Action("Verify", "Profile")" class="inline-block px-4 py-2 rounded-lg bg-orange-500 hover:bg-orange-600 text-white font-semibold text-xs">
                                Thêm Certificate
                            </a>
                        }
                    </div>
                }

                <div class="bg-white rounded-3xl p-6 shadow-soft border border-gray-100 overflow-hidden">
                    <h2 class="text-xl font-bold mb-4" style="font-family:'Quicksand',sans-serif">Khu vực hoạt động</h2>
                    <div id="map" class="rounded-2xl h-80 w-full shadow-inner bg-gray-100 border border-gray-200"></div>
                </div>
            </div>

            <div class="space-y-8">
                <div class="bg-white rounded-3xl p-6 shadow-soft border border-gray-100">
                    <h3 class="text-lg font-bold mb-4" style="font-family:'Quicksand',sans-serif">Thông tin liên hệ</h3>
                    <div class="space-y-3 text-sm">
                        <div class="p-3 bg-gray-50 rounded-xl border border-gray-100">
                            <p class="text-xs font-bold text-gray-400 uppercase">Email</p>
                            <p class="font-semibold">@Model.Email</p>
                        </div>
                        <div class="p-3 bg-gray-50 rounded-xl border border-gray-100">
                            <p class="text-xs font-bold text-gray-400 uppercase">Điện thoại</p>
                            <p class="font-semibold">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</p>
                        </div>
                    </div>
                </div>

                @if (isParent)
                {
                    <div class="bg-white rounded-3xl p-8 shadow-soft border border-gray-100">
                        <h2 class="text-xl font-bold mb-6" style="font-family:'Quicksand',sans-serif">Thông tin ChildProfile</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                                <div class="text-xs font-bold text-gray-400 uppercase mb-2">Số lượng trẻ</div>
                                <div class="text-2xl font-bold">@(Model.NumberOfChildren?.ToString() ?? "—")</div>
                            </div>
                            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                                <div class="text-xs font-bold text-gray-400 uppercase mb-2">Nhóm tuổi của bé</div>
                                <div class="text-base font-semibold">@ChildAgeGroupLabel(Model.ChildAgeGroup)</div>
                            </div>
                            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 md:col-span-2">
                                <div class="text-xs font-bold text-gray-400 uppercase mb-2">Nhu cầu đặc biệt</div>
                                <div class="text-base font-semibold text-gray-800">@(string.IsNullOrWhiteSpace(Model.SpecialNeeds) ? "Không có" : Model.SpecialNeeds)</div>
                            </div>
                            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 md:col-span-2">
                                <div class="text-xs font-bold text-gray-400 uppercase mb-2">Ghi chú</div>
                                <div class="text-base font-semibold text-gray-800">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có" : Model.Notes)</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .shadow-soft { box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05); }
    #map { z-index: 1; }
</style>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var lat = @(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "21.0285");
        var lng = @(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "105.8542");
        var mapElement = document.getElementById('map');
        if (!mapElement) return;

        var map = L.map('map', {
            center: [lat, lng],
            zoom: 15,
            scrollWheelZoom: false
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        L.circle([lat, lng], {
            color: '#3b82f6',
            fillColor: '#3b82f6',
            fillOpacity: 0.15,
            radius: 400
        }).addTo(map);
    });
</script>
