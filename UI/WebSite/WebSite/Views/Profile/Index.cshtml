@model WebSite.Models.Profile.PersonalProfileViewModel
@{
    ViewData["Title"] = "Ho so ca nhan";
    var avatar = string.IsNullOrWhiteSpace(Model.AvatarUrl) ? null : Model.AvatarUrl.Trim();
    var isNanny = Model.IsNanny;
    var isParent = Model.IsParent;
    var rating = Model.AverageRating ?? 0m;
    var isReadOnly = Model.IsReadOnlyView;
    var canEditProfile = !isReadOnly;
    var canShowFavoriteHeart = User.IsInRole("Parent") && isNanny;
    var canContactNanny = isReadOnly && User.IsInRole("Parent") && isNanny;
    var currentUserId = Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var parsedUserId)
        ? parsedUserId
        : Guid.Empty;
    var canReportProfile = isReadOnly && Model.UserId != Guid.Empty && Model.UserId != currentUserId;
    var currentProfileUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var suppressEngagementActions = (bool?)ViewBag.SuppressEngagementActions == true;
    var canShowFavoriteHeart = User.IsInRole("Parent") && isNanny && !suppressEngagementActions;
    var canContactNanny = isReadOnly && User.IsInRole("Parent") && isNanny && Model.UserId != Guid.Empty;
    var isContactAccepted = (bool?)ViewBag.IsContactAccepted == true;
    var hasHiringContext = (bool?)ViewBag.HasHiringContext == true;
    var hiringJobPostingId = (ViewBag.HiringJobPostingId as string) ?? "";
    var hiringJobApplicationId = (ViewBag.HiringJobApplicationId as string) ?? "";
    var contactRequestId = (ViewBag.ContactRequestId as string) ?? "";
    var canHireInHiringFlow = canContactNanny && hasHiringContext && !string.IsNullOrWhiteSpace(hiringJobPostingId) && !string.IsNullOrWhiteSpace(hiringJobApplicationId);
    var canSendContactRequest = !suppressEngagementActions && canContactNanny && !hasHiringContext && Model.ContactNannyProfileId.HasValue && Model.ContactNannyProfileId.Value != Guid.Empty && !isContactAccepted;
    var canMessageInContactFlow = canContactNanny && !hasHiringContext && isContactAccepted;
    var canHireInContactFlow = canMessageInContactFlow;
    var canMessageInHiringFlow = canContactNanny && hasHiringContext;
    var canShowAnyAction = canContactNanny || canShowFavoriteHeart;

    string EducationLabel(int? level) => level switch
    {
        0 => "Trung hoc",
        1 => "Cao dang",
        2 => "Dai hoc",
        3 => "Thac si",
        4 => "Khac",
        _ => "Chua cap nhat"
    };

    string VerificationText(int? code) => code switch
    {
        1 => "Dang cho duyet xac minh",
        2 => "Da duoc xac minh",
        _ => "Chua xac minh"
    };

    string ChildAgeGroupLabel(byte? ageGroup) => ageGroup switch
    {
        0 => "0 - 1 tuoi",
        1 => "1 - 3 tuoi",
        2 => "3 - 5 tuoi",
        3 => "6 - 12 tuoi",
        _ => "Chua cap nhat"
    };

    var dayColumns = new[] { (1, "T2"), (2, "T3"), (3, "T4"), (4, "T5"), (5, "T6"), (6, "T7"), (0, "CN") };
    var slotRows = new[] { (0, "Sang"), (1, "Chieu"), (2, "Toi"), (3, "Dem") };
    bool IsAvailable(int day, int slot) => Model.Availabilities?.Any(a => a.DayOfWeek == day && a.TimeSlot == slot && a.IsAvailable) == true;
}

@section Head {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<section class="profile-page">
    <div class="profile-shell">
        <div class="profile-header">
            <div class="profile-avatar">
                @if (avatar != null)
                {
                    <img src="@avatar" alt="Avatar" />
                }
                else
                {
                    <div class="profile-avatar-placeholder">
                        <span class="material-icons-round" style="font-size:52px;">person</span>
                    </div>
                }
            </div>

            <div class="flex-1 min-w-[220px]">
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-3xl font-bold text-slate-900" style="font-family:'Quicksand',sans-serif">
                        @Model.FirstName @Model.LastName
                    </h1>
                </div>
                <div class="mt-2 flex items-center gap-2 flex-wrap text-sm text-slate-500 font-semibold">
                    <span class="profile-role-chip">@(isNanny ? "Nanny" : "Parent")</span>
                    <span>@(!string.IsNullOrWhiteSpace(Model.City) ? Model.City : "Viet Nam")</span>
                    <span>@(Model.Age?.ToString() ?? "--") tuoi</span>
                    @if (isNanny)
                    {
                        <span class="text-orange-600">Rating @rating.ToString("0.##") (@(Model.TotalReviews ?? 0))</span>
                    }
                </div>
            </div>

            @if (canEditProfile)
            {
                <a href="@Url.Action("Edit", "Profile")" class="profile-primary-btn">
                    Chinh sua ho so
                </a>
            }
            else if (canContactNanny || canShowFavoriteHeart || canReportProfile)
            else if (canShowAnyAction)
            {
                <div class="profile-header-actions flex items-center gap-2">
                    @if (canShowFavoriteHeart)
                    {
                        <button type="button"
                                id="favoriteNannyBtn"
                                data-favorite="false"
                                aria-pressed="false"
                                title="Luu nanny yeu thich"
                                class="profile-favorite-btn inline-flex items-center justify-center h-10 w-10 rounded-full border border-orange-200 bg-white text-orange-500 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-orange-300 hover:bg-orange-50 hover:shadow-md">
                            <span class="material-icons-round text-[20px]">favorite_border</span>
                        </button>
                    }

                    @if (canSendContactRequest)
                    {
                        <button type="button"
                                id="contactRequestBtn"
                                data-nanny-profile-id="@(Model.ContactNannyProfileId?.ToString() ?? string.Empty)"
                                class="profile-primary-btn">
                            Gui request contact
                        </button>
                    }
                    @if (canReportProfile)
                    {
                        <button type="button"
                                id="reportProfileBtn"
                                class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-rose-200 bg-white text-rose-500 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-rose-300 hover:bg-rose-50 hover:shadow-md"
                                title="Phan nan ho so"
                                aria-label="Phan nan ho so">
                            <span class="material-icons-round text-[20px]">flag</span>

                    @if (canMessageInContactFlow || canMessageInHiringFlow)
                    {
                        <button type="button"
                                id="messageNannyBtn"
                                data-user-id="@Model.UserId"
                                class="profile-primary-btn">
                            Nhan tin
                        </button>
                    }

                    @if (canHireInHiringFlow || canHireInContactFlow)
                    {
                        <button type="button" id="hireNannyBtn" class="profile-primary-btn">
                            Thue
                        </button>
                    }
                </div>
            }
        </div>

        <div class="profile-grid">
            <div class="space-y-4">
                <div class="profile-card">
                    <h3>@(isNanny ? "Gioi thieu ban than" : "Mo ta gia dinh")</h3>
                    <p class="text-sm text-slate-600 leading-7">
                        @((isNanny ? Model.Bio : Model.FamilyDescription) ?? "Chua co thong tin cap nhat.")
                    </p>
                </div>

                @if (isNanny)
                {
                    <div class="profile-card profile-card-soft">
                        <h3>Thong tin nanny</h3>
                        <div class="profile-detail-grid">
                            <div class="profile-detail-item">
                                <div class="label">Kinh nghiem</div>
                                <div class="value">@((Model.YearsOfExperience?.ToString()) ?? "0") nam</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Hoc van</div>
                                <div class="value">@EducationLabel(Model.EducationLevel)</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Luong mong muon</div>
                                <div class="value">@((Model.ExpectedSalaryMin?.ToString("0")) ?? "0") - @((Model.ExpectedSalaryMax?.ToString("0")) ?? "0") VND</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Ban kinh di chuyen</div>
                                <div class="value">@((Model.MaxTravelDistance?.ToString()) ?? "0") km</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Xac minh</div>
                                <div class="value">@VerificationText(Model.VerificationStatusCode)</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Rating trung binh</div>
                                <div class="value">@rating.ToString("0.##")</div>
                            </div>
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Ky nang</h3>
                        @if (Model.Skills != null && Model.Skills.Any())
                        {
                            <div class="skill-chip-wrap">
                                @foreach (var s in Model.Skills)
                                {
                                    <span class="skill-chip">@(string.IsNullOrWhiteSpace(s.SkillName) ? s.SkillId.ToString() : s.SkillName)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500">Chua co ky nang nao.</p>
                        }
                    </div>

                    <div class="profile-card">
                        <h3>Lich lam viec</h3>
                        <div class="schedule-grid schedule-grid--readonly">
                            <div></div>
                            @foreach (var day in dayColumns)
                            {
                                <div class="schedule-col-label">@day.Item2</div>
                            }
                            @foreach (var slot in slotRows)
                            {
                                <div class="schedule-row-label">@slot.Item2</div>
                                @foreach (var day in dayColumns)
                                {
                                    var active = IsAvailable(day.Item1, slot.Item1);
                                    <div class="schedule-cell @(active ? "active" : "")" aria-hidden="true">
                                        <span class="schedule-check">@(active ? "✓" : "")</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="profile-card">
                        <h3>Feedback va review</h3>
                        <p class="text-sm text-slate-500 mb-3">Mau UI review. Chua ket noi du lieu backend.</p>
                        <div class="feedback-list">
                            <div class="feedback-item">
                                <div class="feedback-meta">
                                    <span class="feedback-name">Parent - Nguyen Minh</span>
                                    <span class="feedback-star">★★★★★</span>
                                </div>
                                <p class="text-sm text-slate-600">Nanny dung gio, giao tiep nhe nhang va cham be rat can than.</p>
                            </div>
                            <div class="feedback-item">
                                <div class="feedback-meta">
                                    <span class="feedback-name">Parent - Tran Hien</span>
                                    <span class="feedback-star">★★★★☆</span>
                                </div>
                                <p class="text-sm text-slate-600">Thai do tot va linh hoat lich lam viec. Gia dinh hai long.</p>
                            </div>
                        </div>
                    </div>

                }

                <div class="profile-card">
                    <h3>Khu vuc hoat dong</h3>
                    <div id="map" class="profile-map"></div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="profile-card">
                    <h3>Thong tin lien he</h3>
                    <div class="grid grid-cols-1 gap-3">
                        <div class="profile-detail-item">
                            <div class="label">Email</div>
                            <div class="value break-all">@Model.Email</div>
                        </div>
                        <div class="profile-detail-item">
                            <div class="label">Dien thoai</div>
                            <div class="value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chua cap nhat" : Model.PhoneNumber)</div>
                        </div>
                        <div class="profile-detail-item">
                            <div class="label">Dia chi</div>
                            <div class="value">@(!string.IsNullOrWhiteSpace(Model.Address) ? Model.Address : "Chua cap nhat")</div>
                        </div>
                        <div class="profile-detail-item">
                            <div class="label">Khu vuc</div>
                            <div class="value">@string.Join(", ", new[] { Model.Ward, Model.District, Model.City }.Where(v => !string.IsNullOrWhiteSpace(v)))</div>
                        </div>
                    </div>
                </div>

                @if (isNanny)
                {
                    <div class="profile-card">
                        <h3>Chung chi</h3>
                        @if (Model.Certificates != null && Model.Certificates.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var cert in Model.Certificates)
                                {
                                    <div class="profile-detail-item">
                                        <div class="value">@cert.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(cert.IssuingOrganization))
                                        {
                                            <p class="text-xs text-slate-500 mt-1">Don vi cap: @cert.IssuingOrganization</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(cert.CertificateUrl))
                                        {
                                            <a href="@cert.CertificateUrl" target="_blank" class="text-xs font-semibold text-orange-600 hover:underline mt-2 inline-block">Xem chung chi</a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500 mb-2">Chua co chung chi.</p>
                            @if (canEditProfile)
                            {
                                <a href="@Url.Action("Verify", "Profile")" class="text-sm font-semibold text-orange-600 hover:underline">Them chung chi</a>
                            }
                            }
                    </div>
                }

                @if (isParent)
                {
                    <div class="profile-card profile-card-soft">
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <h3 class="!mb-0">Thong tin tre</h3>
                            @if (!isReadOnly)
                            {
                                <a href="@Url.Action("Children", "Profile")"
                                   class="inline-flex items-center justify-center px-4 py-2 rounded-full border border-orange-200 bg-white text-orange-700 text-xs font-bold hover:bg-orange-50">
                                    Edit Child Profile
                                </a>
                            }
                        </div>
                        <div class="profile-detail-grid">
                            <div class="profile-detail-item">
                                <div class="label">So luong tre</div>
                                <div class="value">@(Model.NumberOfChildren?.ToString() ?? "--")</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Nhom tuoi</div>
                                <div class="value">@ChildAgeGroupLabel(Model.ChildAgeGroup)</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Nhu cau dac biet</div>
                                <div class="value">@(string.IsNullOrWhiteSpace(Model.SpecialNeeds) ? "Khong co" : Model.SpecialNeeds)</div>
                            </div>
                            <div class="profile-detail-item">
                                <div class="label">Ghi chu</div>
                                <div class="value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Khong co" : Model.Notes)</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@if (canReportProfile)
{
    <div id="profileReportModal" class="nmodal fixed inset-0 z-50 bg-black/50 backdrop-blur-sm items-center justify-center px-4" onclick="if(event.target===this)closeProfileReportModal()">
        <div class="nmodal-box bg-white rounded-2xl w-full max-w-xl shadow-2xl relative">
            <div class="flex items-center justify-between px-6 pt-6 pb-4 border-b border-gray-100">
                <div>
                    <h2 class="text-lg font-bold text-gray-900">Gui phan nan ho so</h2>
                    <p class="text-xs text-gray-400 font-semibold mt-0.5">Ho so: @Model.FirstName @Model.LastName</p>
                </div>
                <button type="button" onclick="closeProfileReportModal()" class="text-gray-300 hover:text-gray-700 material-icons-round text-2xl transition-colors">close</button>
            </div>
            <form id="profileReportForm" method="post" asp-controller="Report" asp-action="ReportProfile" class="px-6 py-5 space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="profileReportedUserId" name="ReportedUserId" value="@Model.UserId" />
                <input type="hidden" name="ReturnUrl" value="@currentProfileUrl" />
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Ly do phan nan <span class="text-red-500">*</span></label>
                    <textarea id="profileReportReason" name="Reason" rows="4" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400" placeholder="Nhap ly do phan nan..."></textarea>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Bang chung (khong bat buoc)</label>
                    <textarea id="profileReportEvidence" name="Evidence" rows="3" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400" placeholder="Mo ta, hinh anh, video lien quan..."></textarea>
                </div>
                <div class="flex gap-2">
                    <button type="button" onclick="closeProfileReportModal()" class="modal-btn modal-btn-secondary w-full">Huy</button>
                    <button id="profileReportSubmitBtn" type="submit" class="modal-btn modal-btn-primary w-full">Gui phan nan</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    @if (canReportProfile)
    {
        <script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var favoriteBtn = document.getElementById('favoriteNannyBtn');
            if (favoriteBtn) {
                function renderFavoriteState(isFavorite) {
                    favoriteBtn.dataset.favorite = isFavorite ? 'true' : 'false';
                    favoriteBtn.setAttribute('aria-pressed', isFavorite ? 'true' : 'false');
                    favoriteBtn.title = isFavorite ? 'Da luu nanny yeu thich' : 'Luu nanny yeu thich';
                    favoriteBtn.classList.toggle('bg-orange-500', isFavorite);
                    favoriteBtn.classList.toggle('text-white', isFavorite);
                    favoriteBtn.classList.toggle('border-orange-500', isFavorite);
                    favoriteBtn.classList.toggle('shadow-lg', isFavorite);
                    favoriteBtn.classList.toggle('shadow-orange-200', isFavorite);
                    favoriteBtn.classList.toggle('bg-white', !isFavorite);
                    favoriteBtn.classList.toggle('text-orange-500', !isFavorite);
                    favoriteBtn.classList.toggle('border-orange-200', !isFavorite);

                    var icon = favoriteBtn.querySelector('.material-icons-round');
                    if (icon) icon.textContent = isFavorite ? 'favorite' : 'favorite_border';
                }

                favoriteBtn.addEventListener('click', function () {
                    var nextState = favoriteBtn.dataset.favorite !== 'true';
                    renderFavoriteState(nextState);

                    if (typeof window.onFavoriteNannyClick === 'function') {
                        window.onFavoriteNannyClick({
                            isFavorite: nextState,
                            button: favoriteBtn
                        });
                    }
                });

                renderFavoriteState(false);
            }

            var requestBtn = document.getElementById('contactRequestBtn');
            if (requestBtn) {
                requestBtn.addEventListener('click', async function () {
                    var nannyProfileId = requestBtn.getAttribute('data-nanny-profile-id');
                    if (!nannyProfileId) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Khong tim thay nanny profile de gui request contact.', { type: 'warning' });
                        }
                        return;
                    }

                    requestBtn.disabled = true;
                    var oldText = requestBtn.textContent;
                    requestBtn.textContent = 'Dang gui request...';

                    try {
                        var response = await fetch('/Nanny/SendContactRequest', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'same-origin',
                            body: JSON.stringify({
                                nannyProfileId: nannyProfileId,
                                message: 'Parent gui request contact tu trang ho so.'
                            })
                        });

                        var json = await response.json();
                        if (!response.ok || !json?.success) {
                            if (typeof window.showToast === 'function') {
                                window.showToast(json?.message || 'Khong the gui request contact.', { type: 'error' });
                            }
                            return;
                        }

                        if (typeof window.showToast === 'function') {
                            window.showToast(json?.message || 'Da gui request contact thanh cong.', { type: 'success' });
                        }
                        window.dispatchEvent(new CustomEvent('nm:notifications-refresh'));
                        setTimeout(function () { window.location.reload(); }, 700);
                    } catch {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Khong the gui request contact.', { type: 'error' });
                        }
                    } finally {
                        requestBtn.disabled = false;
                        requestBtn.textContent = oldText;
                    }
                });
            }

            var messageBtn = document.getElementById('messageNannyBtn');
            if (messageBtn) {
                messageBtn.addEventListener('click', async function () {
                    var userId = messageBtn.getAttribute('data-user-id');
                    if (!userId) return;

                    messageBtn.disabled = true;
                    var oldText = messageBtn.textContent;
                    messageBtn.textContent = 'Dang mo chat...';

                    try {
                        var response = await fetch('/Communication/GetOrCreate', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'same-origin',
                            body: JSON.stringify({ otherUserId: userId })
                        });

                        var json = await response.json();
                        var conversationId = json?.data?.id;
                        if (conversationId) {
                            window.location.href = `/Communication?conversationId=${conversationId}`;
                            return;
                        }
                        window.location.href = '/Communication';
                    } catch {
                        window.location.href = '/Communication';
                    } finally {
                        messageBtn.disabled = false;
                        messageBtn.textContent = oldText;
                    }
                });
            }

            const hasHiringContext = @((hasHiringContext) ? "true" : "false");
            const hiringJobPostingId = '@Html.Raw(hiringJobPostingId)';
            const hiringJobApplicationId = '@Html.Raw(hiringJobApplicationId)';
            const contactRequestId = '@Html.Raw(contactRequestId)';
            const isContactAccepted = @((isContactAccepted) ? "true" : "false");
            const hireBtn = document.getElementById('hireNannyBtn');
            if (hireBtn) {
                hireBtn.addEventListener('click', function () {
                    if (hasHiringContext) {
                        const nannyName = (`@Model.FirstName @Model.LastName`).trim();
                        window.__openHireModal?.(hiringJobPostingId, hiringJobApplicationId, nannyName);
                        return;
                    }
                    if (contactRequestId && isContactAccepted) {
                        const nannyName = (`@Model.FirstName @Model.LastName`).trim();
                        window.__openHireModal?.(null, null, nannyName, contactRequestId);
                        return;
                    }
                    if (!hasHiringContext) {
                        if (typeof window.showToast === 'function') {
                            window.showToast('Can co ngu canh hop le de tao hiring record.', { type: 'info' });
                        }
                        window.location.href = '/Search/History';
                    }
                });
            }

            var reportBtn = document.getElementById('reportProfileBtn');
            var reportModal = document.getElementById('profileReportModal');
            var reportForm = document.getElementById('profileReportForm');
            var reportSubmitBtn = document.getElementById('profileReportSubmitBtn');
            var reportReasonEl = document.getElementById('profileReportReason');
            var reportEvidenceEl = document.getElementById('profileReportEvidence');
            var reportEditorsReady = false;
            var isSubmittingProfileReport = false;

            function notifyProfileToast(message, type) {
                if (typeof window.showToast === 'function') {
                    window.showToast(message, { type: type || 'info' });
                }
            }

            function extractProfileReportPlainText(html) {
                var div = document.createElement('div');
                div.innerHTML = String(html || '');
                return (div.textContent || div.innerText || '').replace(/\s+/g, ' ').trim();
            }

            function getProfileReportEditorContent(editorId) {
                if (typeof tinymce !== 'undefined') {
                    var editor = tinymce.get(editorId);
                    if (editor) return editor.getContent();
                }
                var input = document.getElementById(editorId);
                return input ? (input.value || '') : '';
            }

            function setProfileReportEditorContent(editorId, value) {
                if (typeof tinymce !== 'undefined') {
                    var editor = tinymce.get(editorId);
                    if (editor) {
                        editor.setContent(value || '');
                        return;
                    }
                }
                var input = document.getElementById(editorId);
                if (input) input.value = value || '';
            }

            async function uploadProfileReportMediaFiles(files, endpoint, emptyMessage) {
                if (!files || !files.length) throw new Error(emptyMessage);

                var formData = new FormData();
                Array.from(files).forEach(function (file) { formData.append('files', file); });

                var response = await fetch(endpoint, {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: formData
                });

                var raw = await response.text();
                var result = null;
                if (raw) {
                    try {
                        result = JSON.parse(raw);
                    } catch {
                        if (response.redirected && response.url && response.url.includes('/Auth/Login')) {
                            throw new Error('Phien dang nhap da het han. Vui long dang nhap lai.');
                        }
                        throw new Error('Server tra ve du lieu khong hop le khi upload media.');
                    }
                }

                if (!response.ok) {
                    throw new Error((result && result.message) || ('Upload media that bai (HTTP ' + response.status + ').'));
                }

                if (!result || !result.success || !result.data || !Array.isArray(result.data.urls) || result.data.urls.length === 0) {
                    throw new Error((result && result.message) || 'Upload media that bai.');
                }

                return result.data.urls;
            }

            function pickProfileReportFile(accept, multiple) {
                return new Promise(function (resolve) {
                    var input = document.createElement('input');
                    input.type = 'file';
                    input.accept = accept;
                    input.multiple = !!multiple;
                    input.onchange = function () {
                        var files = input.files ? Array.from(input.files) : [];
                        resolve(multiple ? files : (files[0] || null));
                    };
                    input.click();
                });
            }

            function uploadSingleProfileReportImageForTiny(blobInfo) {
                return new Promise(async function (resolve, reject) {
                    try {
                        var urls = await uploadProfileReportMediaFiles(
                            [blobInfo.blob()],
                            '/Report/UploadReportMedia?mediaType=image',
                            'Vui long chon it nhat mot anh.');
                        resolve(urls[0]);
                    } catch (error) {
                        reject({ message: (error && error.message) || 'Khong the upload anh.' });
                    }
                });
            }

            function handleProfileReportTinyFilePicker(callback, meta) {
                var isImage = meta.filetype === 'image';
                var accept = isImage
                    ? 'image/*'
                    : 'video/mp4,video/webm,video/ogg,video/quicktime,.mp4,.webm,.ogg,.mov';
                var endpoint = isImage
                    ? '/Report/UploadReportMedia?mediaType=image'
                    : '/Report/UploadReportMedia?mediaType=video';

                pickProfileReportFile(accept, false).then(async function (file) {
                    if (!file) return;
                    try {
                        var urls = await uploadProfileReportMediaFiles([file], endpoint, 'Vui long chon file de upload.');
                        var url = urls[0];
                        if (isImage) callback(url, { alt: file.name || 'image' });
                        else callback(url, { source2: '', poster: '' });
                    } catch (error) {
                        notifyProfileToast((error && error.message) || 'Khong the upload media.', 'error');
                    }
                });
            }

            function ensureProfileReportEditorsInitialized() {
                if (reportEditorsReady) return;
                if (typeof tinymce === 'undefined') return;
                if (!reportReasonEl || !reportEvidenceEl) return;

                tinymce.init({
                    selector: '#profileReportReason',
                    license_key: 'gpl',
                    menubar: false,
                    branding: false,
                    plugins: 'lists code',
                    toolbar: 'undo redo | bold italic underline | bullist numlist | removeformat | code',
                    height: 160,
                    statusbar: false,
                    content_style: 'body{font-family:Segoe UI,Arial,sans-serif;font-size:14px;line-height:1.6;}'
                });

                tinymce.init({
                    selector: '#profileReportEvidence',
                    license_key: 'gpl',
                    menubar: false,
                    branding: false,
                    plugins: 'link lists code image media',
                    toolbar: 'undo redo | bold italic underline | bullist numlist | link image media | removeformat | code',
                    height: 220,
                    automatic_uploads: true,
                    images_upload_handler: function (blobInfo) {
                        return uploadSingleProfileReportImageForTiny(blobInfo);
                    },
                    file_picker_types: 'image media',
                    file_picker_callback: function (callback, _value, meta) {
                        handleProfileReportTinyFilePicker(callback, meta);
                    },
                    statusbar: false,
                    content_style: 'body{font-family:Segoe UI,Arial,sans-serif;font-size:14px;line-height:1.6;} img,video{max-width:100%;height:auto;border-radius:8px;}'
                });

                reportEditorsReady = true;
            }

            function openProfileReportModal() {
                if (!reportModal) return;
                ensureProfileReportEditorsInitialized();
                setProfileReportEditorContent('profileReportReason', '');
                setProfileReportEditorContent('profileReportEvidence', '');
                isSubmittingProfileReport = false;
                if (reportSubmitBtn) {
                    reportSubmitBtn.disabled = false;
                    reportSubmitBtn.textContent = 'Gui phan nan';
                }
                reportModal.classList.add('show');
            }

            window.closeProfileReportModal = function () {
                if (reportModal) reportModal.classList.remove('show');
                isSubmittingProfileReport = false;
                if (reportSubmitBtn) {
                    reportSubmitBtn.disabled = false;
                    reportSubmitBtn.textContent = 'Gui phan nan';
                }
            };

            if (reportBtn && reportModal && reportForm) {
                reportBtn.addEventListener('click', function () {
                    openProfileReportModal();
                });

                reportForm.addEventListener('submit', function (event) {
                    var reportedUserIdInput = document.getElementById('profileReportedUserId');
                    var reportedUserId = reportedUserIdInput ? String(reportedUserIdInput.value || '').trim() : '';
                    if (!reportedUserId) {
                        event.preventDefault();
                        notifyProfileToast('Khong tim thay ho so can phan nan.', 'error');
                        return;
                    }

                    if (typeof tinymce !== 'undefined') tinymce.triggerSave();

                    var reasonHtml = getProfileReportEditorContent('profileReportReason');
                    var evidenceHtml = getProfileReportEditorContent('profileReportEvidence');
                    var reason = extractProfileReportPlainText(reasonHtml);
                    var evidence = String(evidenceHtml || '').trim();

                    if (reason.length < 5 || reason.length > 500) {
                        event.preventDefault();
                        notifyProfileToast('Ly do phan nan phai tu 5 den 500 ky tu.', 'warning');
                        if (typeof tinymce !== 'undefined' && tinymce.get('profileReportReason')) {
                            tinymce.get('profileReportReason').focus();
                        } else if (reportReasonEl) {
                            reportReasonEl.focus();
                        }
                        return;
                    }

                    if (evidence.length > 2000) {
                        event.preventDefault();
                        notifyProfileToast('Bang chung khong duoc vuot qua 2000 ky tu.', 'warning');
                        if (typeof tinymce !== 'undefined' && tinymce.get('profileReportEvidence')) {
                            tinymce.get('profileReportEvidence').focus();
                        }
                        return;
                    }

                    if (isSubmittingProfileReport) {
                        event.preventDefault();
                        return;
                    }

                    isSubmittingProfileReport = true;
                    if (reportSubmitBtn) {
                        reportSubmitBtn.disabled = true;
                        reportSubmitBtn.textContent = 'Dang gui...';
                    }
                });
            }

            var lat = @(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "21.0285");
            var lng = @(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "105.8542");
            var mapElement = document.getElementById('map');
            if (!mapElement || typeof L === 'undefined') return;

            var map = L.map('map', { zoomControl: true, scrollWheelZoom: false }).setView([lat, lng], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; CartoDB',
                maxZoom: 19
            }).addTo(map);

            var icon = L.divIcon({
                className: '',
                html: '<div class="job-map-marker active"><span class="job-map-marker__halo"></span><span class="job-map-marker__pin"><span class="job-map-marker__core"></span></span></div>',
                iconSize: [26, 34],
                iconAnchor: [13, 28]
            });
            L.marker([lat, lng], { icon: icon }).addTo(map);

            L.circle([lat, lng], {
                radius: 1500,
                color: '#fdba74',
                fillColor: '#fdba74',
                fillOpacity: 0.1,
                weight: 1
            }).addTo(map);
        });
    </script>
}

