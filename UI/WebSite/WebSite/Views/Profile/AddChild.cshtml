@using WebSite.Controllers
@using WebSite.Models.Profile
@model CreateChildProfileViewModel

@{
    ViewData["Title"] = "Thêm con em";
}

<div class="min-h-screen bg-gradient-to-br from-green-50 via-emerald-50/30 to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <span class="section-label">👶 Gia đình mở rộng</span>
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mt-3" style="font-family:'Quicksand',sans-serif">
                Thêm <span class="gradient-text">con em</span>
            </h1>
            <div class="section-divider left mt-4"></div>
        </div>

        <!-- Form Card -->
        <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-8 lg:p-10 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm">
            <form method="post">
                @Html.AntiForgeryToken()

                <!-- Basic Information -->
                <div class="space-y-6 mb-8">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                        <span class="material-icons-round text-green-500">person</span>
                        Thông tin cơ bản
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">


                        <!-- Child Age Group -->
                        <div>
                            <label for="ChildAgeGroup" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                                🎂 Nhóm tuổi
                            </label>
                            <select class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                                    id="ChildAgeGroup" name="ChildAgeGroup">
                                <option value="">-- Chọn nhóm tuổi --</option>
                                <option value="1">Em bé (0-1 tuổi)</option>
                                <option value="2">Toddler (1-3 tuổi)</option>
                                <option value="3">Mầm non (3-5 tuổi)</option>
                                <option value="4">Học sinh tiểu học (6-12 tuổi)</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.ChildAgeGroup, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>
                    </div>
                </div>

                <!-- Health & Special Information -->
                <div class="border-t border-gray-100 dark:border-gray-700/50 pt-8 space-y-6">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                        <span class="material-icons-round text-green-500">health_and_safety</span>
                        Thông tin sức khỏe
                    </h3>



                    <!-- Special Needs -->
                    <div>
                        <label for="SpecialNeeds" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            🎯 Nhu cầu đặc biệt (nếu có)
                        </label>
                        <textarea class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all resize-none"
                                  id="SpecialNeeds" name="SpecialNeeds" rows="3" placeholder="Mô tả các nhu cầu đặc biệt nếu có...">@Model.SpecialNeeds</textarea>
                        @Html.ValidationMessageFor(m => m.SpecialNeeds, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Notes -->
                    <div>
                        <label for="Notes" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            📝 Ghi chú thêm
                        </label>
                        <textarea class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all resize-none"
                                  id="Notes" name="Notes" rows="4" placeholder="Các thông tin thêm về con em...">@Model.Notes</textarea>
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Characteristic -->
                    <div>
                        <label for="Characteristic" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            ✨ Đặc điểm tính cách
                        </label>
                        <textarea class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all resize-none"
                                  id="Characteristic" name="Characteristic" rows="3" placeholder="Mô tả đặc điểm tính cách của con...">@Model.Characteristic</textarea>
                        @Html.ValidationMessageFor(m => m.Characteristic, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 mt-10 pt-8 border-t border-gray-100 dark:border-gray-700/50">
                    <a href="@Url.Action("Children", "Profile")" 
                       class="flex items-center justify-center gap-2 px-6 py-3 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-800 dark:text-white font-bold rounded-xl transition-all duration-300">
                        <span class="material-icons-round">close</span>
                        Hủy
                    </a>
                    <button type="submit" 
                            class="flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl flex-1 sm:flex-none">
                        <span class="material-icons-round">add_circle</span>
                        Thêm con em
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
    .form-select {
        border-radius: 5px;
        border: 1px solid #ddd;
        padding: 0.5rem 0.75rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
    }

    .btn {
        border-radius: 5px;
        padding: 0.5rem 1rem;
    }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
</style>
