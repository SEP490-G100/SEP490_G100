@using WebSite.Models.Profile
@model CreateChildProfileViewModel

@{
    ViewData["Title"] = "Them con em";
}

<div class="child-page">
    <div class="child-shell">
        <h1 class="child-title">Them ho so con em</h1>

        <form method="post" class="child-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="child-summary"></div>

            <div class="child-field">
                <label asp-for="ChildAgeGroup" class="child-label">Nhom tuoi</label>
                <select asp-for="ChildAgeGroup"
                        asp-items="Html.GetEnumSelectList<WebSite.Enums.ChildAgeGroup>()"
                        class="child-input">
                    <option value="">-- Chon nhom tuoi --</option>
                </select>
                @Html.ValidationMessageFor(m => m.ChildAgeGroup, "", new { @class = "child-error" })
            </div>

            <div class="child-field">
                <label asp-for="Characteristic" class="child-label">Dac diem tinh cach</label>
                <textarea asp-for="Characteristic" rows="3" class="child-input child-textarea" placeholder="Mo ta tinh cach cua tre..."></textarea>
                @Html.ValidationMessageFor(m => m.Characteristic, "", new { @class = "child-error" })
            </div>

            <div class="child-field">
                <label asp-for="SpecialNeeds" class="child-label">Nhu cau dac biet</label>
                <textarea asp-for="SpecialNeeds" rows="3" class="child-input child-textarea" placeholder="Mo ta nhu cau dac biet neu co..."></textarea>
                @Html.ValidationMessageFor(m => m.SpecialNeeds, "", new { @class = "child-error" })
            </div>

            <div class="child-field">
                <label asp-for="Notes" class="child-label">Ghi chu</label>
                <textarea asp-for="Notes" rows="3" class="child-input child-textarea" placeholder="Thong tin bo sung..."></textarea>
                @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "child-error" })
            </div>

            <div class="child-actions">
                <button type="submit" class="btn-primary">Luu ho so con em</button>
                <a href="@Url.Action("Children", "Profile")" class="btn-secondary">Huy</a>
            </div>
        </form>
    </div>
</div>

<style>
    .child-page { min-height: calc(100vh - 72px); padding: 28px 16px; background: #faf9f7; }
    .child-shell { max-width: 760px; margin: 0 auto; }
    .child-title { margin: 0 0 16px; font-size: 28px; font-weight: 800; color: #0f172a; }
    .child-form { background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 20px; }
    .child-summary { margin-bottom: 12px; color: #b91c1c; font-weight: 600; }
    .child-field { margin-bottom: 14px; }
    .child-label { display: block; margin-bottom: 6px; font-size: 12px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #334155; }
    .child-input { width: 100%; min-height: 46px; border: 1px solid #cbd5e1; border-radius: 12px; padding: 0 12px; font-size: 14px; }
    .child-textarea { min-height: 104px; padding: 10px 12px; resize: vertical; }
    .child-input:focus { outline: none; border-color: #f97316; box-shadow: 0 0 0 3px rgba(249,115,22,.12); }
    .child-error { display: block; margin-top: 4px; color: #dc2626; font-size: 12px; }
    .child-actions { display: flex; gap: 10px; margin-top: 16px; }
    .btn-primary, .btn-secondary { min-height: 42px; border-radius: 12px; padding: 0 16px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; border: 1px solid transparent; cursor: pointer; }
    .btn-primary { background: #f97316; color: #fff; }
    .btn-primary:hover { background: #ea580c; }
    .btn-secondary { background: #fff; border-color: #cbd5e1; color: #334155; }
    .btn-secondary:hover { background: #f8fafc; }
</style>
