@model WebSite.Models.Profile.ParentOnboardingWizardViewModel
@using WebSite.Enums
@{
    ViewData["Title"] = "Phụ huynh - Gia đình và trẻ";

    var childCount = Model.NumberOfChildren ?? Model.Children?.Count ?? 1;
    if (childCount < 1) childCount = 1;
    if (childCount > 20) childCount = 20;

    var children = (Model.Children ?? new List<WebSite.Models.Profile.ParentOnboardingChildInputViewModel>()).ToList();
    while (children.Count < childCount)
    {
        children.Add(new WebSite.Models.Profile.ParentOnboardingChildInputViewModel());
    }
}

<div class="nm-flow-shell">
    <div class="nm-flow-container">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Đăng ký phụ huynh</span>
                        <h1 class="nm-flow-title">Thông tin gia đình và trẻ</h1>
                        <p class="nm-flow-subtitle">
                            Chọn số lượng trẻ cần chăm, sau đó điền thông tin tương ứng cho từng bé ngay tại màn hình này.
                        </p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="nm-alert"></div>

                <form asp-action="Step2Family" method="post" class="nm-family-form">
                    @Html.AntiForgeryToken()

                    <div class="nm-form-grid">
                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Tổng quan gia đình</div>
                                <div class="nm-form-grid">
                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="FamilyDescription" class="nm-label">Mô tả gia đình <span class="required">*</span></label>
                                            <textarea asp-for="FamilyDescription" rows="4" class="nm-textarea" placeholder="Mô tả nhu cầu chăm bé, thói quen sinh hoạt, điều cần lưu ý..."></textarea>
                                            <span asp-validation-for="FamilyDescription" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="NumberOfChildren" class="nm-label">Số lượng trẻ cần chăm <span class="required">*</span></label>
                                            <input asp-for="NumberOfChildren" id="NumberOfChildren" type="number" min="1" max="20" class="nm-input" />
                                            <div class="nm-field-hint">Chọn từ 1 đến 20 trẻ. Form bên dưới sẽ tự tăng/giảm theo số bạn chọn.</div>
                                            <span asp-validation-for="NumberOfChildren" class="nm-error"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Thông tin từng trẻ</div>
                                <div class="nm-section-note">Bạn đã chọn <strong id="childCountBadge">@childCount</strong> trẻ.</div>

                                <div id="childrenContainer" class="space-y-4 mt-4">
                                    @for (var i = 0; i < childCount; i++)
                                    {
                                        var child = children[i];
                                        <div class="child-card border border-orange-100 rounded-2xl p-4 bg-orange-50/30" data-child-index="@i">
                                            <div class="text-sm font-bold text-slate-800 mb-3">Trẻ thứ @(i + 1)</div>

                                            <div class="nm-form-grid">
                                                <div class="nm-col-6">
                                                    <div class="nm-field">
                                                        <label class="nm-label">Nhóm tuổi <span class="required">*</span></label>
                                                        <select name="Children[@i].ChildAgeGroup" id="@($"Children_{i}__ChildAgeGroup")" class="nm-select">
                                                            <option value="">Chọn nhóm tuổi</option>
                                                            <option value="0" selected="@(child.ChildAgeGroup == ChildAgeGroup.Baby)">Sơ sinh (0 - 1 tuổi)</option>
                                                            <option value="1" selected="@(child.ChildAgeGroup == ChildAgeGroup.Toddler)">Chập chững (1 - 3 tuổi)</option>
                                                            <option value="2" selected="@(child.ChildAgeGroup == ChildAgeGroup.Preschooler)">Mầm non (3 - 5 tuổi)</option>
                                                            <option value="3" selected="@(child.ChildAgeGroup == ChildAgeGroup.Gradeschooler)">Tiểu học (6 - 12 tuổi)</option>
                                                        </select>
                                                        @Html.ValidationMessage($"Children[{i}].ChildAgeGroup", new { @class = "nm-error" })
                                                    </div>
                                                </div>

                                                <div class="nm-col-6">
                                                    <div class="nm-field">
                                                        <label class="nm-label">Đặc điểm</label>
                                                        <input name="Children[@i].ChildCharacteristic" id="@($"Children_{i}__ChildCharacteristic")" value="@child.ChildCharacteristic" class="nm-input" placeholder="Ví dụ: hiếu động, dễ ngủ..." />
                                                        @Html.ValidationMessage($"Children[{i}].ChildCharacteristic", new { @class = "nm-error" })
                                                    </div>
                                                </div>

                                                <div class="nm-col-12">
                                                    <div class="nm-field">
                                                        <label class="nm-label">Nhu cầu đặc biệt</label>
                                                        <input name="Children[@i].ChildSpecialNeeds" id="@($"Children_{i}__ChildSpecialNeeds")" value="@child.ChildSpecialNeeds" class="nm-input" placeholder="Ví dụ: dị ứng sữa, hen suyễn..." />
                                                        @Html.ValidationMessage($"Children[{i}].ChildSpecialNeeds", new { @class = "nm-error" })
                                                    </div>
                                                </div>

                                                <div class="nm-col-12">
                                                    <div class="nm-field">
                                                        <label class="nm-label">Ghi chú</label>
                                                        <textarea name="Children[@i].ChildNotes" id="@($"Children_{i}__ChildNotes")" rows="2" class="nm-textarea" placeholder="Thông tin bổ sung...">@child.ChildNotes</textarea>
                                                        @Html.ValidationMessage($"Children[{i}].ChildNotes", new { @class = "nm-error" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="nm-flow-actions">
                        <button type="submit" name="direction" value="back" class="nm-btn nm-btn--ghost">Quay lại</button>
                        <button type="submit" name="direction" value="next" class="nm-btn nm-btn--primary">Hoàn thành</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    try {
        window.localStorage.removeItem('nm_parent_onboarding_step1_draft_v1');
    } catch (e) { }

    var numberInput = document.getElementById('NumberOfChildren');
    var container = document.getElementById('childrenContainer');
    var badge = document.getElementById('childCountBadge');
    if (!numberInput || !container) return;

    function clampCount(value) {
        var parsed = parseInt(value, 10);
        if (isNaN(parsed)) parsed = 1;
        if (parsed < 1) parsed = 1;
        if (parsed > 20) parsed = 20;
        return parsed;
    }

    function ageOptionsHtml() {
        return [
            '<option value="">Chọn nhóm tuổi</option>',
            '<option value="0">Sơ sinh (0 - 1 tuổi)</option>',
            '<option value="1">Chập chững (1 - 3 tuổi)</option>',
            '<option value="2">Mầm non (3 - 5 tuổi)</option>',
            '<option value="3">Tiểu học (6 - 12 tuổi)</option>'
        ].join('');
    }

    function cardHtml(index) {
        return '' +
            '<div class="child-card border border-orange-100 rounded-2xl p-4 bg-orange-50/30" data-child-index="' + index + '">' +
            '  <div class="text-sm font-bold text-slate-800 mb-3">Trẻ thứ ' + (index + 1) + '</div>' +
            '  <div class="nm-form-grid">' +
            '    <div class="nm-col-6">' +
            '      <div class="nm-field">' +
            '        <label class="nm-label">Nhóm tuổi <span class="required">*</span></label>' +
            '        <select name="Children[' + index + '].ChildAgeGroup" id="Children_' + index + '__ChildAgeGroup" class="nm-select">' + ageOptionsHtml() + '</select>' +
            '      </div>' +
            '    </div>' +
            '    <div class="nm-col-6">' +
            '      <div class="nm-field">' +
            '        <label class="nm-label">Đặc điểm</label>' +
            '        <input name="Children[' + index + '].ChildCharacteristic" id="Children_' + index + '__ChildCharacteristic" class="nm-input" placeholder="Ví dụ: hiếu động, dễ ngủ..." />' +
            '      </div>' +
            '    </div>' +
            '    <div class="nm-col-12">' +
            '      <div class="nm-field">' +
            '        <label class="nm-label">Nhu cầu đặc biệt</label>' +
            '        <input name="Children[' + index + '].ChildSpecialNeeds" id="Children_' + index + '__ChildSpecialNeeds" class="nm-input" placeholder="Ví dụ: dị ứng sữa, hen suyễn..." />' +
            '      </div>' +
            '    </div>' +
            '    <div class="nm-col-12">' +
            '      <div class="nm-field">' +
            '        <label class="nm-label">Ghi chú</label>' +
            '        <textarea name="Children[' + index + '].ChildNotes" id="Children_' + index + '__ChildNotes" rows="2" class="nm-textarea" placeholder="Thông tin bổ sung..."></textarea>' +
            '      </div>' +
            '    </div>' +
            '  </div>' +
            '</div>';
    }

    function syncChildCards() {
        var count = clampCount(numberInput.value);
        numberInput.value = count;

        while (container.children.length < count) {
            var index = container.children.length;
            container.insertAdjacentHTML('beforeend', cardHtml(index));
        }

        while (container.children.length > count) {
            container.removeChild(container.lastElementChild);
        }

        for (var i = 0; i < container.children.length; i++) {
            var title = container.children[i].querySelector('.text-sm.font-bold');
            if (title) title.textContent = 'Trẻ thứ ' + (i + 1);
        }

        if (badge) badge.textContent = String(count);
    }

    numberInput.addEventListener('input', syncChildCards);
    numberInput.addEventListener('change', syncChildCards);
    syncChildCards();
});
</script>
