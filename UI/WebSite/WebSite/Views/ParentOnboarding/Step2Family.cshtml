@model WebSite.Models.Profile.ParentOnboardingWizardViewModel
@{
    ViewData["Title"] = "Parent - Gia dinh va con cai";
}

<div class="nm-flow-shell">
    <div class="nm-flow-container">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Parent onboarding</span>
                        <h1 class="nm-flow-title">Them thong tin gia dinh va tre</h1>
                        <p class="nm-flow-subtitle">
                            Man hinh nay giup job posting va goi y nanny khop hon. Ban chi can khai thong tin cua mot be, cac be khac co the them sau trong profile.
                        </p>
                    </div>
                    <div class="nm-flow-progress" aria-hidden="true">
                        <span class="nm-progress-step">1</span>
                        <span class="nm-progress-line"></span>
                        <span class="nm-progress-step is-active">2</span>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="nm-alert"></div>

                <form asp-action="Step2Family" method="post" data-nm-unified-skip="true">
                    @Html.AntiForgeryToken()

                    <div class="nm-form-grid">
                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Tong quan gia dinh</div>
                                <div class="nm-section-note">Thong tin nay duoc dung de moderator va nanny hieu nhanh boi canh gia dinh truoc khi ket noi.</div>

                                <div class="nm-form-grid">
                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="FamilyDescription" class="nm-label">Mo ta gia dinh <span class="required">*</span></label>
                                            <textarea asp-for="FamilyDescription" rows="4" class="nm-textarea" placeholder="Mo ta nhip sinh hoat, nhu cau cham be, dieu can luu y..."></textarea>
                                            <span asp-validation-for="FamilyDescription" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-4">
                                        <div class="nm-field">
                                            <label asp-for="NumberOfChildren" class="nm-label">So luong con <span class="required">*</span></label>
                                            <select asp-for="NumberOfChildren" class="nm-select">
                                                <option value="">Chon so luong</option>
                                                <option value="1">1 con</option>
                                                <option value="2">2 con</option>
                                                <option value="3">3 con</option>
                                                <option value="4">4 con</option>
                                            </select>
                                            <span asp-validation-for="NumberOfChildren" class="nm-error"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Thong tin cua mot be</div>
                                <div class="nm-section-note">Sau khi vao he thong, ban co the them ho so cho cac be khac trong trang profile.</div>

                                <div class="nm-form-grid">
                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="ChildAgeGroup" class="nm-label">Nhom tuoi <span class="required">*</span></label>
                                            <select asp-for="ChildAgeGroup" asp-items="Html.GetEnumSelectList<WebSite.Enums.ChildAgeGroup>()" class="nm-select">
                                                <option value="">Chon nhom tuoi</option>
                                            </select>
                                            <span asp-validation-for="ChildAgeGroup" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="ChildCharacteristic" class="nm-label">Tinh cach</label>
                                            <input asp-for="ChildCharacteristic" class="nm-input" placeholder="Nang dong, de ngu, thich ve..." />
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label class="nm-label">Nhu cau dac biet</label>
                                            <div class="nm-field-hint">Chon tat ca nhung muc phu hop de nanny chuan bi dung kinh nghiem va ky nang.</div>
                                            <div class="nm-tags-grid mt-2">
                                                @{
                                                    var options = new[] { "Di ung thuc pham", "Hen suyen", "Tu ky", "ADHD", "Che do an dac biet", "Khac" };
                                                }
                                                @foreach (var option in options)
                                                {
                                                    <label class="nm-check-card">
                                                        <input type="checkbox" value="@option" class="special-need-checkbox" />
                                                        <span>@option</span>
                                                    </label>
                                                }
                                            </div>
                                            <input type="hidden" asp-for="ChildSpecialNeeds" id="hiddenSpecialNeeds" />
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="ChildNotes" class="nm-label">Ghi chu them</label>
                                            <textarea asp-for="ChildNotes" rows="3" class="nm-textarea" placeholder="Thong tin bo sung de nanny de hinh dung hon ve be..."></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="nm-flow-actions">
                        <button type="submit" name="direction" value="back" class="nm-btn nm-btn--ghost">Quay lai</button>
                        <button type="submit" name="direction" value="next" class="nm-btn nm-btn--primary">Hoan thanh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const checkboxes = document.querySelectorAll('.special-need-checkbox');
    const hiddenInput = document.getElementById('hiddenSpecialNeeds');

    function updateHiddenInput() {
        const selected = Array.from(checkboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);
        hiddenInput.value = selected.join(', ');
    }

    checkboxes.forEach(cb => cb.addEventListener('change', updateHiddenInput));
});
</script>
