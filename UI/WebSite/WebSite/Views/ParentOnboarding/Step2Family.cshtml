@model WebSite.Models.Profile.ParentOnboardingWizardViewModel
@{
    ViewData["Title"] = "Parent - Gia đình & Con cái";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        <div class="mb-8">
            <span class="section-label">👨‍👩‍👧 Parent Onboarding</span>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-3">
                Bước 2: Thông tin gia đình & Trẻ
            </h1>
            <div class="section-divider left mt-4"></div>
        </div>

        <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-8 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

            <form asp-action="Step2Family" method="post">
                @Html.AntiForgeryToken()

                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">🏠 Thông tin gia đình</h3>
                <div class="space-y-6 mb-8">
                    <div>
                        <label asp-for="FamilyDescription" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            Mô tả gia đình <span class="text-red-500">*</span>
                        </label>
                        <textarea asp-for="FamilyDescription" rows="3"
                                  class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                                  placeholder="Chia sẻ đôi chút về gia đình, thói quen..."></textarea>
                        <span asp-validation-for="FamilyDescription" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="NumberOfChildren" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            Số lượng con <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="NumberOfChildren" type="number" min="1"
                               class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all" />
                        <span asp-validation-for="NumberOfChildren" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>

                <div class="border-t border-gray-200 dark:border-gray-700 pt-8 mb-4">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">👶 Thông tin một bé (Bạn có thể thêm bé khác sau)</h3>
                    
                    <div class="space-y-6">
                        <div>
                            <label asp-for="ChildAgeGroup" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                                Nhóm tuổi <span class="text-red-500">*</span>
                            </label>
                            <select asp-for="ChildAgeGroup" asp-items="Html.GetEnumSelectList<WebSite.Enums.ChildAgeGroup>()"
                                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all">
                                <option value="">-- Chọn nhóm tuổi --</option>
                            </select>
                            <span asp-validation-for="ChildAgeGroup" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="ChildCharacteristic" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                                Tính cách
                            </label>
                            <input asp-for="ChildCharacteristic"
                                   class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                                   placeholder="VD: Năng động, thích vẽ..." />
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-3">
                                Nhu cầu đặc biệt (Chọn tất cả các mục phù hợp)
                            </label>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-gray-50/50 dark:bg-gray-900/50 p-4 rounded-2xl border border-gray-100 dark:border-gray-700">
                                @{
                                    var options = new[] { "Dị ứng thực phẩm", "Hen suyễn", "Tự kỷ", "ADHD", "Chế độ ăn đặc biệt", "Khác" };
                                }
                                @foreach (var option in options)
                                {
                                    <label class="flex items-center gap-3 p-2 hover:bg-white dark:hover:bg-gray-800 rounded-xl transition-colors cursor-pointer group">
                                        <input type="checkbox" value="@option" class="special-need-checkbox w-5 h-5 rounded border-gray-300 text-orange-600 focus:ring-orange-500/20 transition-all cursor-pointer" />
                                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-orange-600 transition-colors">@option</span>
                                    </label>
                                }
                            </div>
                            <input type="hidden" asp-for="ChildSpecialNeeds" id="hiddenSpecialNeeds" />
                        </div>

                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                const checkboxes = document.querySelectorAll('.special-need-checkbox');
                                const hiddenInput = document.getElementById('hiddenSpecialNeeds');

                                function updateHiddenInput() {
                                    const selected = Array.from(checkboxes)
                                        .filter(cb => cb.checked)
                                        .map(cb => cb.value);
                                    hiddenInput.value = selected.join(', ');
                                }

                                checkboxes.forEach(cb => {
                                    cb.addEventListener('change', updateHiddenInput);
                                });
                            });
                        </script>

                        <div>
                            <label asp-for="ChildNotes" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                                Ghi chú thêm
                            </label>
                            <textarea asp-for="ChildNotes" rows="2"
                                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                                      placeholder="Lưu ý khác cho nanny..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between mt-8">
                    <button type="submit" name="direction" value="back"
                            class="px-6 py-2 rounded-xl border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 text-sm font-semibold">
                        Quay lại
                    </button>
                    <button type="submit" name="direction" value="next"
                            class="px-6 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-semibold text-sm shadow-md">
                        Hoàn thành
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
