@model WebSite.Models.Profile.ParentOnboardingWizardViewModel
@{
    ViewData["Title"] = "Parent - Thong tin co ban";
}

<div class="nm-flow-shell">
    <div class="nm-flow-container">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Parent onboarding</span>
                        <h1 class="nm-flow-title">Hoan thien thong tin co ban</h1>
                        <p class="nm-flow-subtitle">
                            Day la thong tin nen de he thong goi y nanny phu hop va hien thi khu vuc cua ban chinh xac hon trong cac luong tim kiem.
                        </p>
                    </div>
                    <div class="nm-flow-progress" aria-hidden="true">
                        <span class="nm-progress-step is-active">1</span>
                        <span class="nm-progress-line"></span>
                        <span class="nm-progress-step">2</span>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="nm-alert"></div>

                <form asp-action="Step1BasicInfo" method="post" enctype="multipart/form-data" data-nm-unified-skip="true">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Latitude" id="Latitude" />
                    <input type="hidden" asp-for="Longitude" id="Longitude" />
                    <input type="hidden" asp-for="AvatarUrl" />

                    <div class="nm-form-grid">
                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Thong tin ca nhan</div>
                                <div class="nm-section-note">Anh dai dien, ho ten va dia chi co ban se duoc dung cho ho so parent sau khi onboarding hoan tat.</div>

                                <div class="nm-form-grid">
                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="FullName" class="nm-label">Ho va ten <span class="required">*</span></label>
                                            <input asp-for="FullName" class="nm-input" placeholder="Tran Van B" />
                                            <span asp-validation-for="FullName" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="AvatarFile" class="nm-label">Anh dai dien</label>
                                            <input type="file" asp-for="AvatarFile" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="nm-file" />
                                            <div class="nm-field-hint">Chap nhan dinh dang .jpg, .jpeg, .png. Ban co the bo qua va cap nhat sau.</div>
                                            <div id="avatarUploadError" class="nm-error hidden"></div>
                                            <div class="mt-3">
                                                <img id="avatarPreview" class="nm-avatar-preview hidden" alt="Avatar preview" />
                                            </div>
                                            <span asp-validation-for="AvatarFile" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="Address" class="nm-label">Dia chi chi tiet <span class="required">*</span></label>
                                            <input asp-for="Address" id="Address" class="nm-input" placeholder="So nha, ten duong..." />
                                            <span asp-validation-for="Address" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="City" class="nm-label">Tinh / Thanh pho <span class="required">*</span></label>
                                            <select asp-for="City" id="City" class="nm-select">
                                                <option value="">Chon tinh / thanh</option>
                                            </select>
                                            <span asp-validation-for="City" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="District" class="nm-label">Quan / Huyen / Phuong <span class="required">*</span></label>
                                            <select asp-for="District" id="District" class="nm-select">
                                                <option value="">Chon khu vuc</option>
                                            </select>
                                            <span asp-validation-for="District" class="nm-error"></span>
                                        </div>
                                    </div>
                                </div>

                                <div id="addressLoadError" class="nm-error hidden mt-3"></div>
                            </div>
                        </div>
                    </div>

                    <div class="nm-flow-actions">
                        <a href="@Url.Action("Index", "Home")" class="nm-btn nm-btn--ghost">Bo qua</a>
                        <button type="submit" name="direction" value="next" class="nm-btn nm-btn--primary">Tiep tuc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var avatarInput = document.getElementById('AvatarFile');
    var avatarErr = document.getElementById('avatarUploadError');
    var avatarPreview = document.getElementById('avatarPreview');
    var currentAvatarUrl = '@(Model.AvatarUrl ?? "")';
    var objectUrl = null;

    function showAvatarError(msg) {
        if (!avatarErr) return;
        avatarErr.textContent = msg || '';
        avatarErr.classList.toggle('hidden', !msg);
    }

    function clearPreview() {
        if (objectUrl) { try { URL.revokeObjectURL(objectUrl); } catch (e) { } objectUrl = null; }
        if (avatarPreview) {
            avatarPreview.src = '';
            avatarPreview.classList.add('hidden');
        }
    }

    function setPreview(src) {
        if (!avatarPreview) return;
        avatarPreview.src = src;
        avatarPreview.classList.remove('hidden');
    }

    function isAllowedImage(file) {
        if (!file) return false;
        var name = (file.name || '').toLowerCase();
        var extOk = name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg');
        var typeOk = (file.type === 'image/png' || file.type === 'image/jpeg' || file.type === 'image/jpg');
        return extOk && (typeOk || !file.type);
    }

    if (currentAvatarUrl) {
        setPreview(currentAvatarUrl);
    }

    if (avatarInput) {
        avatarInput.addEventListener('change', function () {
            showAvatarError('');
            clearPreview();

            var file = avatarInput.files && avatarInput.files[0] ? avatarInput.files[0] : null;
            if (!file) {
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            if (!isAllowedImage(file)) {
                avatarInput.value = '';
                showAvatarError('Chi cho phep upload anh .png, .jpg, .jpeg.');
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            objectUrl = URL.createObjectURL(file);
            setPreview(objectUrl);
        });
    }

    var citySelect = document.getElementById('City');
    var districtSelect = document.getElementById('District');
    var addressInput = document.getElementById('Address');
    var latEl = document.getElementById('Latitude');
    var lngEl = document.getElementById('Longitude');
    var addressLoadError = document.getElementById('addressLoadError');
    var provinces = [];

    setAddressSelectState(true);

    fetch('/Address/LocationTree')
        .then(function (r) {
            if (!r.ok) throw new Error('address-load-failed');
            return r.json();
        })
        .then(function (data) {
            provinces = data || [];
            provinces.forEach(function (p) {
                var opt = document.createElement('option');
                opt.value = p.name;
                opt.textContent = p.name;
                opt.dataset.code = p.code;
                citySelect.appendChild(opt);
            });

            preselectFromModel();
            showAddressLoadError('');
            setAddressSelectState(false);
        })
        .catch(function () {
            provinces = [];
            setAddressSelectState(true);
            showAddressLoadError('Khong tai duoc danh sach tinh thanh. Vui long thu lai sau.');
        });

    function setAddressSelectState(disabled) {
        citySelect.disabled = disabled;
        districtSelect.disabled = disabled;
    }

    function showAddressLoadError(message) {
        if (!addressLoadError) return;
        addressLoadError.textContent = message || '';
        addressLoadError.classList.toggle('hidden', !message);
    }

    function normalizeText(value) {
        return (value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/đ/g, 'd')
            .trim();
    }

    function setSelectByNormalized(selectEl, value) {
        var target = normalizeText(value);
        if (!target) return;
        for (var i = 0; i < selectEl.options.length; i++) {
            if (normalizeText(selectEl.options[i].value) === target) {
                selectEl.value = selectEl.options[i].value;
                return;
            }
        }
    }

    function preselectFromModel() {
        var currentCity = '@(Model.City ?? "")';
        var currentDistrict = '@(Model.District ?? "")';
        if (currentCity) {
            setSelectByNormalized(citySelect, currentCity);
            onCityChange(function () {
                if (currentDistrict) {
                    setSelectByNormalized(districtSelect, currentDistrict);
                    onDistrictChange();
                }
            });
        }
    }

    function onCityChange(callback) {
        districtSelect.innerHTML = '<option value="">Chon khu vuc</option>';

        var selectedCity = normalizeText(citySelect.value);
        var selected = provinces.find(function (p) { return normalizeText(p.name) === selectedCity; });
        if (!selected) { if (callback) callback(); return; }

        selected.districts.forEach(function (d) {
            var opt = document.createElement('option');
            opt.value = d.name;
            opt.textContent = d.name;
            opt.dataset.code = d.code;
            districtSelect.appendChild(opt);
        });

        if (callback) callback();
        autoGeocode();
    }

    function onDistrictChange(callback) {
        var selectedCity = normalizeText(citySelect.value);
        var selectedProv = provinces.find(function (p) { return normalizeText(p.name) === selectedCity; });
        if (!selectedProv) { if (callback) callback(); return; }

        var selectedDistrict = normalizeText(districtSelect.value);
        var selectedDist = selectedProv.districts.find(function (d) { return normalizeText(d.name) === selectedDistrict; });
        if (!selectedDist) { if (callback) callback(); return; }

        if (callback) callback();
        autoGeocode();
    }

    citySelect.addEventListener('change', function () { onCityChange(); });
    districtSelect.addEventListener('change', function () { onDistrictChange(); });

    var debounceTimer;
    addressInput.addEventListener('blur', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(autoGeocode, 300);
    });

    function autoGeocode() {
        var city = (citySelect.value || '').trim();
        var dist = (districtSelect.value || '').trim();
        if (!city) return;

        var parts = [];
        if (dist) parts.push(dist);
        parts.push(city);
        var query = parts.join(', ');

        fetch('/Address/Suggest?q=' + encodeURIComponent(query) + '&limit=1')
            .then(function (r) { return r.json(); })
            .then(function (items) {
                if (!items || !items.length) return;
                var item = items[0];
                var lat = item.latitude != null ? item.latitude : item.Latitude;
                var lng = item.longitude != null ? item.longitude : item.Longitude;
                if (latEl && lat != null) latEl.value = lat;
                if (lngEl && lng != null) lngEl.value = lng;
            })
            .catch(function () { });
    }
})();
</script>
