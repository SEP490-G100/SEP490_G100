@model WebSite.Models.Profile.ParentOnboardingWizardViewModel
@{
    ViewData["Title"] = "Parent - Thông tin cơ bản";
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd");
    var currentAvatarUrlJson = System.Text.Json.JsonSerializer.Serialize(Model.AvatarUrl ?? "");
}

<div class="nm-flow-shell">
    <div class="nm-flow-container">
        <div class="nm-flow-card">
            <div class="nm-flow-card__inner">
                <div class="nm-flow-header">
                    <div class="nm-flow-header__content">
                        <span class="nm-flow-badge">Parent onboarding</span>
                        <h1 class="nm-flow-title">Thông tin cơ bản</h1>
                        <p class="nm-flow-subtitle">
                            Đây là thông tin nền để hệ thống gợi ý nanny phù hợp và hiển thị khu vực của bạn chính xác hơn trong các luồng tìm kiếm.
                        </p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="nm-alert"></div>

                <form asp-action="Step1BasicInfo" method="post" enctype="multipart/form-data" data-nm-unified-skip="true" class="nm-basic-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Latitude" id="Latitude" />
                    <input type="hidden" asp-for="Longitude" id="Longitude" />
                    <input type="hidden" asp-for="AvatarUrl" />

                    <div class="nm-form-grid">
                        <div class="nm-col-12">
                            <div class="nm-section-card">
                                <div class="nm-section-title">Thông tin cá nhân</div>
                                <div class="nm-section-note">Ảnh đại diện, họ tên và địa chỉ cơ bản sẽ được dùng cho hồ sơ parent sau khi onboarding hoàn tất.</div>

                                <div class="nm-form-grid">
                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="FullName" class="nm-label">Họ và tên <span class="required">*</span></label>
                                            <input asp-for="FullName" class="nm-input" placeholder="Trần Văn B" />
                                            <span asp-validation-for="FullName" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="PhoneNumber" class="nm-label">Số điện thoại</label>
                                            <input asp-for="PhoneNumber" class="nm-input" placeholder="+84901234567" />
                                            <div class="nm-field-hint">Nhập 9-15 chữ số, có thể bắt đầu bằng dấu +.</div>
                                            <span asp-validation-for="PhoneNumber" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="DateOfBirth" class="nm-label">Ngày sinh <span class="required">*</span></label>
                                            <input asp-for="DateOfBirth" asp-format="{0:yyyy-MM-dd}" id="DateOfBirth" type="date" class="nm-input" max="@todayIso" />
                                            <div id="dateOfBirthError" class="nm-error hidden"></div>
                                            <span asp-validation-for="DateOfBirth" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="AvatarFile" class="nm-label">Ảnh đại diện</label>
                                            <div class="nm-avatar-upload">
                                                <div class="nm-avatar-preview-frame">
                                                    <img id="avatarPreview" class="nm-avatar-preview hidden" alt="Avatar preview" />
                                                    <div id="avatarPreviewPlaceholder" class="nm-avatar-placeholder">
                                                        <span class="material-icons-round">person</span>
                                                    </div>
                                                </div>
                                                <div class="nm-avatar-upload-main">
                                                    <input type="file" asp-for="AvatarFile" id="AvatarFile" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="nm-avatar-file-input" />
                                                    <button id="avatarPickBtn" type="button" class="nm-avatar-pick-btn">Chọn ảnh</button>
                                                    <span id="avatarFileName" class="nm-avatar-file-name">Chưa chọn tệp</span>
                                                    <div class="nm-field-hint">Chấp nhận .jpg, .jpeg, .png và tối đa 5MB.</div>
                                                    <div id="avatarUploadError" class="nm-error hidden"></div>
                                                    <span asp-validation-for="AvatarFile" class="nm-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="nm-col-12">
                                        <div class="nm-field">
                                            <label asp-for="Address" class="nm-label">Địa chỉ chi tiết <span class="required">*</span></label>
                                            <input asp-for="Address" id="Address" class="nm-input" placeholder="Số nhà, tên đường..." />
                                            <span asp-validation-for="Address" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="City" class="nm-label">Tỉnh / Thành phố <span class="required">*</span></label>
                                            <input type="hidden" asp-for="City" id="City" />
                                            <div class="nm-cf-dropdown" id="dd_city">
                                                <button type="button" class="nm-cf-dropdown-trigger" aria-label="Chọn tỉnh thành">
                                                    <span id="CityDisplay" class="nm-cf-dropdown-text nm-cf-dropdown-placeholder">Chọn tỉnh / thành</span>
                                                    <span class="material-icons-round nm-cf-dropdown-arrow">expand_more</span>
                                                </button>
                                                <div class="nm-cf-dropdown-menu" id="CityMenu"></div>
                                            </div>
                                            <span asp-validation-for="City" class="nm-error"></span>
                                        </div>
                                    </div>

                                    <div class="nm-col-6">
                                        <div class="nm-field">
                                            <label asp-for="District" class="nm-label">Quận / Huyện / Phường <span class="required">*</span></label>
                                            <input type="hidden" asp-for="District" id="District" />
                                            <div class="nm-cf-dropdown is-disabled" id="dd_district">
                                                <button type="button" class="nm-cf-dropdown-trigger" aria-label="Chọn khu vực">
                                                    <span id="DistrictDisplay" class="nm-cf-dropdown-text nm-cf-dropdown-placeholder">Chọn khu vực</span>
                                                    <span class="material-icons-round nm-cf-dropdown-arrow">expand_more</span>
                                                </button>
                                                <div class="nm-cf-dropdown-menu" id="DistrictMenu"></div>
                                            </div>
                                            <span asp-validation-for="District" class="nm-error"></span>
                                        </div>
                                    </div>
                                </div>

                                <div id="addressLoadError" class="nm-error hidden mt-3"></div>
                            </div>
                        </div>
                    </div>

                    <div class="nm-flow-actions">
                        <a href="@Url.Action("Index", "Home")" class="nm-btn nm-btn--ghost">Bỏ qua</a>
                        <button type="submit" name="direction" value="next" class="nm-btn nm-btn--primary">Tiếp tục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .nm-avatar-upload {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 12px;
        border: 1px dashed #fdba74;
        border-radius: 16px;
        background: #fff7ed;
    }

    .nm-avatar-preview-frame {
        width: 108px;
        height: 108px;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #fff;
        position: relative;
        flex-shrink: 0;
    }

    .nm-avatar-preview {
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
        border: 0;
        box-shadow: none;
    }

    .nm-avatar-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        color: #94a3b8;
        background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .nm-avatar-placeholder .material-icons-round {
        font-size: 36px;
    }

    .nm-avatar-upload-main {
        display: grid;
        gap: 8px;
        min-width: 280px;
        flex: 1;
    }

    .nm-avatar-file-input {
        display: none;
    }

    .nm-avatar-pick-btn {
        width: fit-content;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        border: 1px solid #f97316;
        background: #fff;
        color: #ea580c;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: .15s ease;
    }

    .nm-avatar-pick-btn:hover {
        background: #fff7ed;
        transform: translateY(-1px);
    }

    .nm-avatar-file-name {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
    }

    .nm-cf-dropdown {
        position: relative;
        z-index: 2;
    }

    .nm-cf-dropdown.open {
        z-index: 2200;
    }

    .nm-field.nm-dropdown-active {
        z-index: 2200;
    }

    .nm-section-card.nm-dropdown-active {
        z-index: 2300;
    }

    .nm-cf-dropdown-trigger {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 54px;
        padding: 0 16px;
        border: 1.5px solid #dbe3ec;
        border-radius: 18px;
        background: #fff;
        cursor: pointer;
        transition: border-color .15s, box-shadow .15s;
    }

    .nm-cf-dropdown:not(.is-disabled) .nm-cf-dropdown-trigger:hover {
        border-color: #fdba74;
    }

    .nm-cf-dropdown.open .nm-cf-dropdown-trigger {
        border-color: #f97316;
        box-shadow: 0 0 0 3px rgba(249, 115, 22, .12);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }

    .nm-cf-dropdown.is-disabled .nm-cf-dropdown-trigger {
        background: #f8fafc;
        color: #9ca3af;
        cursor: not-allowed;
    }

    .nm-cf-dropdown-text {
        font-size: 16px;
        font-weight: 600;
        color: #0f172a;
    }

    .nm-cf-dropdown-placeholder {
        color: #94a3b8;
        font-weight: 500;
    }

    .nm-cf-dropdown-arrow {
        font-size: 20px !important;
        color: #f97316;
        transition: transform .2s;
        flex-shrink: 0;
    }

    .nm-cf-dropdown.open .nm-cf-dropdown-arrow {
        transform: rotate(180deg);
    }

    .nm-cf-dropdown-menu {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
        border: 1.5px solid #f97316;
        border-top: none;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .12);
        z-index: 2250;
    }

    .nm-cf-dropdown.open .nm-cf-dropdown-menu {
        display: block;
    }

    .nm-cf-dropdown-option {
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 500;
        color: #334155;
        cursor: pointer;
        border-bottom: 1px solid #ffedd5;
        transition: background .1s, color .1s;
    }

    .nm-cf-dropdown-option:last-child {
        border-bottom: none;
    }

    .nm-cf-dropdown-option:hover {
        background: #fff7ed;
        color: #c2410c;
    }

    .nm-cf-dropdown-option.is-selected {
        background: #fff7ed;
        color: #c2410c;
        font-weight: 700;
    }

    .nm-cf-dropdown-option.is-disabled {
        color: #94a3b8;
        cursor: default;
        background: #fff;
    }

    @@media (max-width: 640px) {
        .nm-avatar-upload {
            align-items: flex-start;
        }

        .nm-avatar-upload-main {
            min-width: 100%;
        }
    }
</style>

<script>
(function () {
    var form = document.querySelector('.nm-basic-form');
    var todayIso = '@todayIso';
    var minAdultIso = '@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")';

    var avatarInput = document.getElementById('AvatarFile');
    var avatarPickBtn = document.getElementById('avatarPickBtn');
    var avatarFileName = document.getElementById('avatarFileName');
    var avatarErr = document.getElementById('avatarUploadError');
    var avatarPreview = document.getElementById('avatarPreview');
    var avatarPreviewPlaceholder = document.getElementById('avatarPreviewPlaceholder');
    var currentAvatarUrl = @Html.Raw(currentAvatarUrlJson);
    var objectUrl = null;

    var dobInput = document.getElementById('DateOfBirth');
    var dobErr = document.getElementById('dateOfBirthError');

    function showAvatarError(msg) {
        if (!avatarErr) return;
        avatarErr.textContent = msg || '';
        avatarErr.classList.toggle('hidden', !msg);
    }

    function showDobError(msg) {
        if (!dobErr) return;
        dobErr.textContent = msg || '';
        dobErr.classList.toggle('hidden', !msg);
    }

    function clearPreview() {
        if (objectUrl) {
            try { URL.revokeObjectURL(objectUrl); } catch (e) { }
            objectUrl = null;
        }
        if (avatarPreview) {
            avatarPreview.src = '';
            avatarPreview.classList.add('hidden');
        }
        if (avatarPreviewPlaceholder) {
            avatarPreviewPlaceholder.classList.remove('hidden');
        }
    }

    function setPreview(src) {
        if (!avatarPreview) return;
        avatarPreview.src = src;
        avatarPreview.classList.remove('hidden');
        if (avatarPreviewPlaceholder) {
            avatarPreviewPlaceholder.classList.add('hidden');
        }
    }

    function isAllowedImage(file) {
        if (!file) return false;
        var name = (file.name || '').toLowerCase();
        var extOk = name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg');
        var typeOk = file.type === 'image/png' || file.type === 'image/jpeg' || file.type === 'image/jpg';
        return extOk && (typeOk || !file.type);
    }

    function validateDateOfBirth() {
        if (!dobInput) return true;
        if (!dobInput.value) {
            showDobError('');
            dobInput.setCustomValidity('');
            return true;
        }

        if (dobInput.value > todayIso) {
            var msg = 'Ngày sinh không được lớn hơn ngày hiện tại.';
            showDobError(msg);
            dobInput.setCustomValidity(msg);
            return false;
        }

        if (dobInput.value > minAdultIso) {
            var ageMsg = 'Phụ huynh phải đủ 18 tuổi trở lên.';
            showDobError(ageMsg);
            dobInput.setCustomValidity(ageMsg);
            return false;
        }

        showDobError('');
        dobInput.setCustomValidity('');
        return true;
    }

    if (dobInput) {
        dobInput.max = todayIso;
        dobInput.addEventListener('input', validateDateOfBirth);
        dobInput.addEventListener('change', validateDateOfBirth);
    }

    if (currentAvatarUrl) {
        setPreview(currentAvatarUrl);
        if (avatarFileName) {
            avatarFileName.textContent = 'Đang dùng ảnh hiện tại';
        }
    }

    if (avatarPickBtn && avatarInput) {
        avatarPickBtn.addEventListener('click', function () {
            avatarInput.click();
        });
    }

    if (avatarInput) {
        avatarInput.addEventListener('change', function () {
            showAvatarError('');
            clearPreview();

            var file = avatarInput.files && avatarInput.files[0] ? avatarInput.files[0] : null;
            if (!file) {
                if (avatarFileName) avatarFileName.textContent = currentAvatarUrl ? 'Đang dùng ảnh hiện tại' : 'Chưa chọn tệp';
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            if (!isAllowedImage(file)) {
                avatarInput.value = '';
                showAvatarError('Chỉ cho phép upload ảnh .png, .jpg, .jpeg.');
                if (avatarFileName) avatarFileName.textContent = currentAvatarUrl ? 'Đang dùng ảnh hiện tại' : 'Chưa chọn tệp';
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            var maxSize = 5 * 1024 * 1024;
            if (file.size > maxSize) {
                avatarInput.value = '';
                showAvatarError('Dung lượng ảnh không được vượt quá 5MB.');
                if (avatarFileName) avatarFileName.textContent = currentAvatarUrl ? 'Đang dùng ảnh hiện tại' : 'Chưa chọn tệp';
                if (currentAvatarUrl) setPreview(currentAvatarUrl);
                return;
            }

            if (avatarFileName) avatarFileName.textContent = file.name;
            objectUrl = URL.createObjectURL(file);
            setPreview(objectUrl);
        });
    }

    var cityInput = document.getElementById('City');
    var districtInput = document.getElementById('District');
    var cityDisplay = document.getElementById('CityDisplay');
    var districtDisplay = document.getElementById('DistrictDisplay');
    var cityMenu = document.getElementById('CityMenu');
    var districtMenu = document.getElementById('DistrictMenu');
    var cityDropdown = document.getElementById('dd_city');
    var districtDropdown = document.getElementById('dd_district');

    var addressInput = document.getElementById('Address');
    var latEl = document.getElementById('Latitude');
    var lngEl = document.getElementById('Longitude');
    var addressLoadError = document.getElementById('addressLoadError');
    var provinces = [];
    var selectedProvince = null;

    function showAddressLoadError(message) {
        if (!addressLoadError) return;
        addressLoadError.textContent = message || '';
        addressLoadError.classList.toggle('hidden', !message);
    }

    function normalizeText(value) {
        return (value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/Ä‘/g, 'd')
            .trim();
    }

    function setDropdownOpenState(dropdown, isOpen) {
        if (!dropdown) return;
        dropdown.classList.toggle('open', !!isOpen);

        var parentField = dropdown.closest('.nm-field');
        var parentCard = dropdown.closest('.nm-section-card');
        if (parentField) parentField.classList.toggle('nm-dropdown-active', !!isOpen);
        if (parentCard) parentCard.classList.toggle('nm-dropdown-active', !!isOpen);
    }

    function closeAllDropdowns() {
        document.querySelectorAll('.nm-cf-dropdown.open').forEach(function (dd) {
            setDropdownOpenState(dd, false);
        });
    }

    function setDropdownDisabled(dropdown, disabled) {
        if (!dropdown) return;
        dropdown.classList.toggle('is-disabled', !!disabled);
        if (disabled) {
            setDropdownOpenState(dropdown, false);
        }
    }

    function setDisplayText(el, value, placeholder) {
        if (!el) return;
        el.textContent = value || placeholder;
        el.classList.toggle('nm-cf-dropdown-placeholder', !value);
    }

    function createOption(text, onClick, selected, disabled) {
        var opt = document.createElement('div');
        opt.className = 'nm-cf-dropdown-option';
        if (selected) opt.classList.add('is-selected');
        if (disabled) opt.classList.add('is-disabled');
        opt.textContent = text;
        if (!disabled && typeof onClick === 'function') {
            opt.addEventListener('click', onClick);
        }
        return opt;
    }

    function findProvinceByName(name) {
        var target = normalizeText(name);
        return provinces.find(function (p) {
            return normalizeText(p.name) === target;
        });
    }

    function findDistrictByName(province, name) {
        if (!province || !Array.isArray(province.districts)) return null;
        var target = normalizeText(name);
        return province.districts.find(function (d) {
            return normalizeText(d.name) === target;
        });
    }

    function renderCityOptions() {
        if (!cityMenu) return;
        cityMenu.innerHTML = '';
        if (!provinces.length) {
            cityMenu.appendChild(createOption('Không có dữ liệu tỉnh/thành', null, false, true));
            return;
        }
        provinces.forEach(function (p) {
            var selected = normalizeText(cityInput.value) === normalizeText(p.name);
            cityMenu.appendChild(createOption(p.name, function () {
                selectCity(p.name, false);
                closeAllDropdowns();
            }, selected, false));
        });
    }

    function renderDistrictOptions() {
        if (!districtMenu) return;
        districtMenu.innerHTML = '';

        if (!selectedProvince) {
            districtMenu.appendChild(createOption('Vui lòng chọn tỉnh/thành trước', null, false, true));
            return;
        }

        var districts = selectedProvince.districts || [];
        if (!districts.length) {
            districtMenu.appendChild(createOption('Không có dữ liệu khu vực', null, false, true));
            return;
        }

        districts.forEach(function (d) {
            var selected = normalizeText(districtInput.value) === normalizeText(d.name);
            districtMenu.appendChild(createOption(d.name, function () {
                selectDistrict(d.name);
                closeAllDropdowns();
            }, selected, false));
        });
    }

    function selectCity(cityName, keepDistrict) {
        var province = findProvinceByName(cityName);
        selectedProvince = province || null;

        if (!province) {
            // Keep user's posted values on validation roundtrip even if
            // API location naming changed and cannot map back exactly.
            setDisplayText(cityDisplay, cityInput.value || cityName || '', 'Chọn tỉnh / thành');
            setDisplayText(districtDisplay, districtInput.value || '', 'Chọn khu vực');
            setDropdownDisabled(districtDropdown, !districtInput.value);
            districtMenu.innerHTML = '';
            if (districtInput.value) {
                districtMenu.appendChild(createOption(districtInput.value, null, true, true));
            } else {
                districtMenu.appendChild(createOption('Vui lòng chọn tỉnh/thành trước', null, false, true));
            }
            return;
        }

        cityInput.value = province.name;
        setDisplayText(cityDisplay, province.name, 'Chọn tỉnh / thành');
        setDropdownDisabled(districtDropdown, false);

        if (!keepDistrict) {
            districtInput.value = '';
            setDisplayText(districtDisplay, '', 'Chọn khu vực');
        }

        renderCityOptions();
        renderDistrictOptions();

        if (keepDistrict && districtInput.value) {
            selectDistrict(districtInput.value);
        }

        autoGeocode();
    }

    function selectDistrict(districtName) {
        if (!selectedProvince) {
            districtInput.value = '';
            setDisplayText(districtDisplay, '', 'Chọn khu vực');
            renderDistrictOptions();
            return;
        }

        var district = findDistrictByName(selectedProvince, districtName);
        if (!district) {
            districtInput.value = '';
            setDisplayText(districtDisplay, '', 'Chọn khu vực');
            renderDistrictOptions();
            return;
        }

        districtInput.value = district.name;
        setDisplayText(districtDisplay, district.name, 'Chọn khu vực');
        renderDistrictOptions();
        autoGeocode();
    }

        districtInput.value = district.name;
        setDisplayText(districtDisplay, district.name, 'Chon khu vuc');
        renderDistrictOptions();
        autoGeocode();
    }

    function autoGeocode() {
        var city = (cityInput && cityInput.value ? cityInput.value : '').trim();
        var dist = (districtInput && districtInput.value ? districtInput.value : '').trim();
        if (!city) return;

        var parts = [];
        if (dist) parts.push(dist);
        parts.push(city);
        var query = parts.join(', ');

        fetch('/Address/Suggest?q=' + encodeURIComponent(query) + '&limit=1')
            .then(function (r) { return r.json(); })
            .then(function (items) {
                if (!items || !items.length) return;
                var item = items[0];
                var lat = item.latitude != null ? item.latitude : item.Latitude;
                var lng = item.longitude != null ? item.longitude : item.Longitude;
                if (latEl && lat != null) latEl.value = lat;
                if (lngEl && lng != null) lngEl.value = lng;
            })
            .catch(function () { });
    }

    document.querySelectorAll('.nm-cf-dropdown-trigger').forEach(function (trigger) {
        trigger.addEventListener('click', function () {
            var dropdown = trigger.closest('.nm-cf-dropdown');
            if (!dropdown || dropdown.classList.contains('is-disabled')) return;
            if (dropdown.classList.contains('open')) {
                setDropdownOpenState(dropdown, false);
            } else {
                closeAllDropdowns();
                setDropdownOpenState(dropdown, true);
            }
        });
    });

    document.addEventListener('click', function (event) {
        if (!event.target.closest('.nm-cf-dropdown')) {
            closeAllDropdowns();
        }
    });

    var debounceTimer;
    if (addressInput) {
        addressInput.addEventListener('blur', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(autoGeocode, 300);
        });
    }

    setDropdownDisabled(cityDropdown, true);
    setDropdownDisabled(districtDropdown, true);
    setDisplayText(cityDisplay, cityInput ? cityInput.value : '', 'Chọn tỉnh / thành');
    setDisplayText(districtDisplay, districtInput ? districtInput.value : '', 'Chọn khu vực');
    renderDistrictOptions();

    fetch('/Address/LocationTree')
        .then(function (r) {
            if (!r.ok) throw new Error('address-load-failed');
            return r.json();
        })
        .then(function (data) {
            provinces = data || [];
            renderCityOptions();
            setDropdownDisabled(cityDropdown, false);
            showAddressLoadError('');

            if (cityInput && cityInput.value) {
                selectCity(cityInput.value, true);
            } else {
                setDropdownDisabled(districtDropdown, true);
                renderDistrictOptions();
            }
        })
        .catch(function () {
            provinces = [];
            renderCityOptions();
            setDropdownDisabled(cityDropdown, true);
            setDropdownDisabled(districtDropdown, true);
            showAddressLoadError('Không tải được danh sách tỉnh thành. Vui lòng thử lại sau.');
        });

    if (form) {
        function setValidationMessage(fieldName, message) {
            var msgEl = document.querySelector('[data-valmsg-for="' + fieldName + '"]');
            if (!msgEl) return;
            msgEl.textContent = message || '';
            msgEl.classList.toggle('field-validation-valid', !message);
            msgEl.classList.toggle('field-validation-error', !!message);
        }

        function validateRequiredFields() {
            var isValid = true;
            var fullNameInput = document.getElementById('FullName');

            if (fullNameInput) {
                var fullNameOk = !!fullNameInput.value.trim();
                setValidationMessage('FullName', fullNameOk ? '' : 'Vui lòng nhập họ tên.');
                isValid = isValid && fullNameOk;
            }

            var addressOk = !!(addressInput && addressInput.value.trim());
            setValidationMessage('Address', addressOk ? '' : 'Vui lòng nhập địa chỉ chi tiết.');
            isValid = isValid && addressOk;

            var cityOk = !!(cityInput && cityInput.value.trim());
            setValidationMessage('City', cityOk ? '' : 'Vui lòng chọn Tỉnh/Thành.');
            isValid = isValid && cityOk;

            var districtOk = !!(districtInput && districtInput.value.trim());
            setValidationMessage('District', districtOk ? '' : 'Vui lòng chọn Quận/Huyện/Phường.');
            isValid = isValid && districtOk;

            return isValid;
        }

        form.addEventListener('submit', function (event) {
            var dateOk = validateDateOfBirth();
            var requiredOk = validateRequiredFields();
            if (!dateOk || !requiredOk) {
                event.preventDefault();
            }
        });
    }
})();
</script>

