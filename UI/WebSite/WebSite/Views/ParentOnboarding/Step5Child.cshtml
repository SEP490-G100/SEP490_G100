@model WebSite.Models.Profile.ParentOnboardingWizardViewModel
@{
    ViewData["Title"] = "Parent - Thông tin con";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50 via-amber-50/30 to-white dark:from-gray-900 dark:via-gray-800 dark:to-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl mx-auto">
        <div class="mb-8">
            <span class="section-label">👨‍👩‍👧 Parent Onboarding</span>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mt-3">
                Bước 5: Thông tin con
            </h1>
            <div class="section-divider left mt-4"></div>
        </div>

        <div class="bg-white dark:bg-gray-800/80 rounded-3xl p-8 shadow-soft border border-gray-100/80 dark:border-gray-700/50 backdrop-blur-sm">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

            <form asp-action="Step5Child" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="Address" />
                <input type="hidden" asp-for="City" />
                <input type="hidden" asp-for="District" />
                <input type="hidden" asp-for="Ward" />
                <input type="hidden" asp-for="AvatarUrl" />
                <input type="hidden" asp-for="FamilyDescription" />
                <input type="hidden" asp-for="NumberOfChildren" />

                <div class="space-y-4">
                    <div>
                        <label asp-for="ChildDateOfBirth" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            Ngày sinh của con <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="ChildDateOfBirth" type="date"
                               class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all" />
                        <span asp-validation-for="ChildDateOfBirth" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="ChildSpecialNeeds" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                            Nhu cầu đặc biệt (tùy chọn)
                        </label>
                        <textarea asp-for="ChildSpecialNeeds" rows="2"
                                  class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                                  placeholder="VD: Dị ứng, cần theo dõi sức khỏe..."></textarea>
                        <span asp-validation-for="ChildSpecialNeeds" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="ChildAllergies" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                                Dị ứng (tùy chọn)
                            </label>
                            <input asp-for="ChildAllergies"
                                   class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all" />
                            <span asp-validation-for="ChildAllergies" class="text-red-500 text-sm mt-1"></span>
                        </div>
                        <div>
                            <label asp-for="ChildNotes" class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">
                                Ghi chú thêm (tùy chọn)
                            </label>
                            <input asp-for="ChildNotes"
                                   class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all" />
                            <span asp-validation-for="ChildNotes" class="text-red-500 text-sm mt-1"></span>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between mt-8">
                    <button type="submit" name="direction" value="back"
                            class="px-6 py-2 rounded-xl border border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 text-sm font-semibold">
                        Back
                    </button>
                    <button type="submit" name="direction" value="next"
                            class="px-6 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-semibold text-sm shadow-md">
                        Hoàn tất
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

