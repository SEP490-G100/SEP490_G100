@{
    var isParent = User.IsInRole("Parent");
    ViewData["Title"] = isParent ? "Lich su thue bao mau" : "Lich su duoc thue";
    var sampleContractUrl = "https://docs.google.com/document/d/1ix5IfIKIZFrmjspvv9Z-MBKNrk0Yh7Un/edit?usp=sharing&ouid=109977210644916932805&rtpof=true&sd=true";
}

<section class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="border-b border-orange-100 px-5 py-5 md:px-7">
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Hiring History</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">@(isParent ? "Lich su thue bao mau" : "Lich su duoc thue")</h1>
            <p class="mt-2 text-sm text-slate-600">
                Day la hop dong mau chung toi tham khao tu nguon thu vien tham khao. Chung toi khong chiu trach nhiem ve cac dieu khoan.
                Mong ben Bo me va bao mau se tham khao va di toi thoa thuan phu hop cho ca hai ben.
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <a href="@sampleContractUrl" target="_blank" rel="noopener"
                   class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 px-4 py-2 text-sm font-bold text-white shadow-sm hover:from-orange-600 hover:to-orange-500">
                    Su dung hop dong mau
                </a>
                <p class="text-sm text-slate-600">
                    Neu ban muon luu tru hop dong cua ban, hay tai len hop dong
                    <a href="/Contract" target="_blank" rel="noopener noreferrer" class="font-bold text-orange-600 hover:text-orange-700 hover:underline">tai day</a>.
                </p>
            </div>
        </div>

        <div class="px-5 pb-6 pt-5 md:px-7">
            <div id="hiringHistoryState" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                Dang tai lich su...
            </div>
            <div id="hiringHistoryList" class="hidden grid gap-3"></div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const isParent = @(isParent ? "true" : "false");
            const isNanny = !isParent;
            const stateEl = document.getElementById('hiringHistoryState');
            const listEl = document.getElementById('hiringHistoryList');
            const focusHiringRecordId = new URLSearchParams(window.location.search).get('hiringRecordId');

            const esc = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('vi-VN') : 'Chua xac dinh';
            const fmtDateTime = (value) => value ? new Date(value).toLocaleString('vi-VN') : 'Chua xac dinh';

            const statusLabel = (status) => {
                const s = Number(status);
                if (s === 0) return { text: 'Dang cho bao mau phan hoi', css: 'bg-amber-50 text-amber-700 border-amber-200' };
                if (s === 1) return { text: 'Dang hoat dong', css: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
                if (s === 2) return { text: 'Da tu choi', css: 'bg-rose-50 text-rose-700 border-rose-200' };
                if (s === 3) return { text: 'Da huy', css: 'bg-slate-100 text-slate-700 border-slate-200' };
                if (s === 4) return { text: 'Da hoan thanh', css: 'bg-indigo-50 text-indigo-700 border-indigo-200' };
                return { text: 'Khong xac dinh', css: 'bg-slate-100 text-slate-700 border-slate-200' };
            };

            const showToast = (message, type = 'info') => {
                if (typeof window.showToast === 'function') {
                    window.showToast(message, { type });
                    return;
                }
                alert(message);
            };

            const getErrorMessage = async (response) => {
                try {
                    const json = await response.json();
                    return json?.message || 'Thao tac that bai.';
                } catch {
                    return 'Thao tac that bai.';
                }
            };

            const postJson = async (url, body) => {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify(body || {})
                });

                if (!response.ok) {
                    throw new Error(await getErrorMessage(response));
                }

                const json = await response.json();
                if (json?.success === false) {
                    throw new Error(json?.message || 'Thao tac that bai.');
                }
            };

            const postEmpty = async (url) => {
                const response = await fetch(url, {
                    method: 'POST',
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error(await getErrorMessage(response));
                }

                const json = await response.json();
                if (json?.success === false) {
                    throw new Error(json?.message || 'Thao tac that bai.');
                }
            };

            const handleAccept = async (hiringRecordId) => {
                try {
                    await postJson(`/Hiring/Records/${encodeURIComponent(hiringRecordId)}/Respond`, { action: 'accept' });
                    showToast('Ban da chap nhan de nghi viec lam.', 'success');
                    await loadHistory();
                } catch (error) {
                    showToast(error.message || 'Khong the chap nhan de nghi.', 'error');
                }
            };

            const handleDecline = async (hiringRecordId) => {
                const reason = window.prompt('Nhap ly do tu choi (co the de trong):', '') ?? null;
                if (reason === null) return;

                try {
                    await postJson(`/Hiring/Records/${encodeURIComponent(hiringRecordId)}/Respond`, {
                        action: 'decline',
                        declineReason: String(reason || '').trim() || null
                    });
                    showToast('Ban da tu choi de nghi viec lam.', 'warning');
                    await loadHistory();
                } catch (error) {
                    showToast(error.message || 'Khong the tu choi de nghi.', 'error');
                }
            };

            const handleCancel = async (hiringRecordId) => {
                if (!window.confirm('Ban co chac muon huy de nghi viec lam nay khong?')) return;

                try {
                    await postEmpty(`/Hiring/Records/${encodeURIComponent(hiringRecordId)}/Cancel`);
                    showToast('Ban da huy de nghi viec lam.', 'warning');
                    await loadHistory();
                } catch (error) {
                    showToast(error.message || 'Khong the huy de nghi viec lam.', 'error');
                }
            };

            const handleComplete = async (hiringRecordId) => {
                if (!window.confirm('Ban co chac muon xac nhan hoan thanh cong viec nay khong?')) return;

                try {
                    await postEmpty(`/Hiring/Records/${encodeURIComponent(hiringRecordId)}/Complete`);
                    showToast('Ban da xac nhan hoan thanh cong viec.', 'success');
                    await loadHistory();
                } catch (error) {
                    showToast(error.message || 'Khong the xac nhan hoan thanh.', 'error');
                }
            };

            window.__hiringHistoryAccept = handleAccept;
            window.__hiringHistoryDecline = handleDecline;
            window.__hiringHistoryCancel = handleCancel;
            window.__hiringHistoryComplete = handleComplete;

            const renderActionButtons = (item) => {
                const status = Number(item.hiringStatus);
                const id = esc(item.hiringRecordId);
                const buttons = [];

                if (isNanny && status === 0) {
                    buttons.push(`
                        <button type="button"
                                onclick="window.__hiringHistoryAccept('${id}')"
                                class="inline-flex items-center justify-center rounded-xl px-3 py-2 text-xs font-extrabold shadow-sm hover:opacity-90"
                                style="background-color:#10b981;color:#ffffff;border:1px solid #059669;opacity:1;">
                            Chap nhan
                        </button>`);
                    buttons.push(`
                        <button type="button"
                                onclick="window.__hiringHistoryDecline('${id}')"
                                class="inline-flex items-center justify-center rounded-xl px-3 py-2 text-xs font-extrabold shadow-sm hover:opacity-90"
                                style="background-color:#f43f5e;color:#ffffff;border:1px solid #e11d48;opacity:1;">
                            Tu choi yeu cau
                        </button>`);
                }

                if (isParent && status === 0) {
                    buttons.push(`
                        <button type="button"
                                onclick="window.__hiringHistoryCancel('${id}')"
                                class="inline-flex items-center justify-center rounded-xl px-3 py-2 text-xs font-extrabold shadow-sm hover:opacity-90"
                                style="background-color:#475569;color:#ffffff;border:1px solid #334155;opacity:1;">
                            Huy thue
                        </button>`);
                }

                if (isParent && status === 1) {
                    buttons.push(`
                        <button type="button"
                                onclick="window.__hiringHistoryComplete('${id}')"
                                class="inline-flex items-center justify-center rounded-xl px-3 py-2 text-xs font-extrabold shadow-sm hover:opacity-90"
                                style="background-color:#4f46e5;color:#ffffff;border:1px solid #4338ca;opacity:1;">
                            Hoan thanh thue
                        </button>`);
                }

                if (!buttons.length) return '';
                return `<div class="mt-3 flex flex-wrap justify-end gap-2">${buttons.join('')}</div>`;
            };

            const renderItem = (item) => {
                const badge = statusLabel(item.hiringStatus);
                const focusClass = focusHiringRecordId && item.hiringRecordId === focusHiringRecordId
                    ? 'ring-2 ring-orange-300 border-orange-300'
                    : 'border-orange-100';
                const hasContractPdf = !!String(item.pdfUrl || '').trim();

                return `
                    <article id="hiring-${esc(item.hiringRecordId)}" class="rounded-2xl border ${focusClass} bg-gradient-to-b from-white to-orange-50/40 p-4 shadow-sm">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-base font-bold text-slate-900">${esc(item.jobTitle || 'Cong viec')}</p>
                                <p class="mt-1 text-xs font-semibold text-slate-500">Tao luc: ${fmtDateTime(item.createdAt)}</p>
                            </div>
                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-extrabold ${badge.css}">${badge.text}</span>
                        </div>
                        <div class="mt-3 grid gap-1 text-sm text-slate-700">
                            <p><span class="font-bold text-slate-800">Parent:</span> ${esc(item.parentName || '...')}</p>
                            <p><span class="font-bold text-slate-800">Nanny:</span> ${esc(item.nannyName || '...')}</p>
                            <p><span class="font-bold text-slate-800">Thoi gian:</span> ${fmtDate(item.startDate)} - ${fmtDate(item.endDate)}</p>
                            <p><span class="font-bold text-slate-800">File PDF hop dong:</span> ${hasContractPdf ? 'Da tai len' : 'Chua tai len'}</p>
                        </div>
                        ${hasContractPdf ? `
                            <div class="mt-3 flex justify-end">
                                <a href="${esc(item.pdfUrl)}" target="_blank" rel="noopener"
                                   class="inline-flex items-center justify-center rounded-xl border border-orange-200 bg-white px-4 py-2 text-xs font-extrabold text-orange-600 hover:bg-orange-50">
                                    Xem file PDF hop dong
                                </a>
                            </div>` : ''}
                        ${renderActionButtons(item)}
                    </article>`;
            };

            const loadHistory = async () => {
                try {
                    const res = await fetch('/Hiring/Api/History', { credentials: 'include' });
                    const json = await res.json();
                    if (!res.ok || !json?.success) {
                        throw new Error(json?.message || 'Khong the tai lich su.');
                    }

                    const items = Array.isArray(json.data) ? json.data : [];
                    if (!items.length) {
                        stateEl.classList.remove('hidden');
                        stateEl.textContent = 'Chua co ban ghi thue nao.';
                        listEl.classList.add('hidden');
                        listEl.innerHTML = '';
                        return;
                    }

                    listEl.innerHTML = items.map(renderItem).join('');
                    stateEl.classList.add('hidden');
                    listEl.classList.remove('hidden');

                    if (focusHiringRecordId) {
                        const target = document.getElementById(`hiring-${focusHiringRecordId}`);
                        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                } catch (err) {
                    stateEl.classList.remove('hidden');
                    stateEl.textContent = `Khong tai duoc lich su: ${String(err?.message || 'Unknown error')}`;
                    listEl.classList.add('hidden');
                }
            };

            loadHistory();
        })();
    </script>
}
