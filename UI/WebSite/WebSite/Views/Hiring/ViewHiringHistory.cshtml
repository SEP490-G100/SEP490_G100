@{
    var isParent = User.IsInRole("Parent");
    ViewData["Title"] = isParent ? "Lịch sử thuê bảo mẫu" : "Lịch sử được thuê";
}

<section class="mx-auto max-w-6xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="border-b border-orange-100 px-5 py-5 md:px-7">
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">@(isParent ? "Khu vực phụ huynh" : "Khu vực bảo mẫu")</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">@(isParent ? "Lịch sử thuê bảo mẫu" : "Lịch sử được thuê")</h1>
        </div>

        <div class="px-5 pb-6 pt-5 md:px-7">
            <div id="hiringHistoryState" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-6 text-center text-sm font-semibold text-slate-500">
                Đang tải lịch sử...
            </div>
            <div id="hiringHistoryList" class="hidden grid gap-3"></div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const stateEl = document.getElementById('hiringHistoryState');
            const listEl = document.getElementById('hiringHistoryList');
            const focusHiringRecordId = new URLSearchParams(window.location.search).get('hiringRecordId');

            const esc = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const fmtDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString('vi-VN') : 'Chưa xác định';
            const fmtDateTime = (value) => value ? new Date(value).toLocaleString('vi-VN') : 'Chưa xác định';

            const statusLabel = (status) => {
                const s = Number(status);
                if (s === 0) return { text: 'Đang chờ', css: 'bg-amber-50 text-amber-700 border-amber-200' };
                if (s === 1) return { text: 'Đang hoạt động', css: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
                if (s === 4) return { text: 'Đã hoàn thành', css: 'bg-indigo-50 text-indigo-700 border-indigo-200' };
                if (s === 2) return { text: 'Đã từ chối', css: 'bg-rose-50 text-rose-700 border-rose-200' };
                if (s === 3) return { text: 'Đã hủy', css: 'bg-slate-100 text-slate-700 border-slate-200' };
                return { text: 'Không xác định', css: 'bg-slate-100 text-slate-700 border-slate-200' };
            };

            const renderItem = (item) => {
                const badge = statusLabel(item.hiringStatus);
                const focusClass = focusHiringRecordId && item.hiringRecordId === focusHiringRecordId
                    ? 'ring-2 ring-orange-300 border-orange-300'
                    : 'border-orange-100';
                const contractId = item.contractId ? esc(item.contractId) : '';
                const hasContract = !!contractId;

                return `
                    <article id="hiring-${esc(item.hiringRecordId)}" class="rounded-2xl border ${focusClass} bg-gradient-to-b from-white to-orange-50/40 p-4 shadow-sm">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-base font-bold text-slate-900">${esc(item.jobTitle || 'Công việc')}</p>
                                <p class="mt-1 text-xs font-semibold text-slate-500">Tạo lúc: ${fmtDateTime(item.createdAt)}</p>
                            </div>
                            <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-extrabold ${badge.css}">${badge.text}</span>
                        </div>

                        <div class="mt-3 grid gap-1 text-sm text-slate-700">
                            <p><span class="font-bold text-slate-800">Bố mẹ:</span> ${esc(item.parentName || '...')}</p>
                            <p><span class="font-bold text-slate-800">Bảo mẫu:</span> ${esc(item.nannyName || '...')}</p>
                            <p><span class="font-bold text-slate-800">Thời gian:</span> ${fmtDate(item.startDate)} - ${fmtDate(item.endDate)}</p>
                        </div>

                        <div class="mt-3 flex flex-wrap justify-end gap-2">
                            ${hasContract ? `
                            <a href="/Contract/ViewContractDetail?contractId=${contractId}"
                               class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-extrabold text-slate-700 hover:bg-slate-50">
                                Xem chi tiết hợp đồng
                            </a>` : ''}
                            ${hasContract ? `
                            <a href="/Contract/Api/${contractId}/Download"
                               class="inline-flex items-center justify-center rounded-xl border border-orange-200 bg-white px-4 py-2 text-xs font-extrabold text-orange-600 hover:bg-orange-50">
                                Tải xuống hợp đồng
                            </a>` : ''}
                        </div>
                    </article>`;
            };

            const loadHistory = async () => {
                try {
                    const res = await fetch('/Hiring/Api/History', { credentials: 'include' });
                    const json = await res.json();
                    if (!res.ok || !json?.success) {
                        throw new Error(json?.message || 'Không thể tải lịch sử.');
                    }

                    const items = Array.isArray(json.data) ? json.data : [];
                    if (!items.length) {
                        stateEl.classList.remove('hidden');
                        stateEl.textContent = 'Chưa có bản ghi thuê nào.';
                        listEl.classList.add('hidden');
                        listEl.innerHTML = '';
                        return;
                    }

                    listEl.innerHTML = items.map(renderItem).join('');
                    stateEl.classList.add('hidden');
                    listEl.classList.remove('hidden');

                    if (focusHiringRecordId) {
                        const target = document.getElementById(`hiring-${focusHiringRecordId}`);
                        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                } catch (err) {
                    stateEl.classList.remove('hidden');
                    stateEl.textContent = `Không thể tải lịch sử: ${String(err?.message || 'Unknown error')}`;
                    listEl.classList.add('hidden');
                }
            };

            loadHistory();
        })();
    </script>
}
