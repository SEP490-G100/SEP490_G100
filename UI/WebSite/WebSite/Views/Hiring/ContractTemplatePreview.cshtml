@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Preview mau hop dong";
    var title = (ViewBag.TemplateTitle as string) ?? "Mau hop dong";
    var version = (ViewBag.TemplateVersion as string) ?? "";
    var content = (ViewBag.TemplateContent as string) ?? "";
}

<section class="mx-auto max-w-5xl px-4 py-8 md:py-10">
    <div class="rounded-3xl border border-orange-100 bg-white shadow-sm">
        <div class="border-b border-orange-100 px-5 py-5 md:px-7">
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Preview</p>
            <h1 class="mt-1 text-2xl font-bold text-slate-900">@title</h1>
            @if (!string.IsNullOrWhiteSpace(version))
            {
                <p class="mt-1 text-sm font-semibold text-slate-500">Version: @version</p>
            }
        </div>
        <div class="px-5 pb-6 pt-5 md:px-7">
            <pre class="max-h-[75vh] overflow-auto whitespace-pre-wrap rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">@content</pre>
        </div>
    </div>
</section>
