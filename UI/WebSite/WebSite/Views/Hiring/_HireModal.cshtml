<div id="hireNannyModal"
     class="fixed inset-0 z-[12000] hidden items-center justify-center bg-black/50 backdrop-blur-sm px-4"
     onclick="if(event.target===this)window.__closeHireModal?.()">
    <div class="relative w-full max-w-lg overflow-hidden rounded-[28px] bg-white shadow-2xl">
        <div class="border-b border-orange-100 bg-gradient-to-b from-white to-orange-50/60 px-6 py-5">
            <button type="button"
                    onclick="window.__closeHireModal?.()"
                    class="absolute right-4 top-4 inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-400 transition-colors hover:text-slate-600">
                <span class="material-icons-round text-base">close</span>
            </button>
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Tuyển dụng</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">Thuê bảo mẫu</h2>
            <p id="hireModalNannyName" class="mt-1 text-sm text-slate-500"></p>
        </div>

        <div class="space-y-4 px-6 py-5">
            <div>
                <label for="hireStartDate" class="mb-1 block text-sm font-bold text-slate-700">
                    Ngày bắt đầu <span class="text-rose-500">*</span>
                </label>
                <input type="date"
                       id="hireStartDate"
                       required
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 transition focus:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-100" />
            </div>

            <div>
                <label for="hireEndDate" class="mb-1 block text-sm font-bold text-slate-700">
                    Ngày kết thúc <span class="text-rose-500">*</span>
                </label>
                <input type="date"
                       id="hireEndDate"
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 transition focus:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-100" />
                <p id="hireEndDateInlineError" class="hidden mt-1 text-xs font-semibold text-rose-600"></p>
            </div>

            <div>
                <label for="hireTemplateId" class="mb-1 block text-sm font-bold text-slate-700">
                    Mẫu hợp đồng <span class="text-rose-500">*</span>
                </label>
                <select id="hireTemplateId"
                        required
                        class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 transition focus:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-100">
                    <option value="">Đang tải mẫu hợp đồng...</option>
                </select>
            </div>

            <p id="hireModalError" class="hidden text-sm font-semibold text-rose-600"></p>
        </div>

        <div class="flex items-center justify-end gap-3 px-6 pb-6">
            <button type="button"
                    onclick="window.__closeHireModal?.()"
                    class="inline-flex min-h-[42px] items-center justify-center rounded-xl border border-slate-200 bg-white px-5 font-bold text-slate-600 transition-all hover:bg-slate-50">
                Hủy
            </button>
            <button type="button"
                    id="hireConfirmBtn"
                    onclick="window.__submitHiring?.()"
                    disabled
                    class="inline-flex min-h-[42px] items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 px-6 font-bold text-white shadow-lg shadow-orange-200 transition-all hover:from-orange-600 hover:to-orange-500 disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:from-orange-500 disabled:hover:to-orange-400">
                <span class="material-icons-round text-base">handshake</span>
                Xác nhận thuê
            </button>
        </div>
    </div>
</div>

<script>
(() => {
    let context = { jobPostingId: null, jobAppId: null, contactRequestId: null };

    const modal = document.getElementById('hireNannyModal');
    const errorEl = document.getElementById('hireModalError');
    const endDateInlineErrorEl = document.getElementById('hireEndDateInlineError');
    const confirmBtn = document.getElementById('hireConfirmBtn');
    const startInput = document.getElementById('hireStartDate');
    const endInput = document.getElementById('hireEndDate');
    const templateSelect = document.getElementById('hireTemplateId');

    const show = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    const hide = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    const setError = (message) => {
        errorEl.textContent = message || '';
        errorEl.classList.toggle('hidden', !message);
    };

    const setEndDateInlineError = (message) => {
        endDateInlineErrorEl.textContent = message || '';
        endDateInlineErrorEl.classList.toggle('hidden', !message);
    };

    const addDays = (dateText, days) => {
        const date = new Date(dateText);
        date.setDate(date.getDate() + days);
        return date.toISOString().slice(0, 10);
    };

    const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

    const getValidationError = () => {
        const startDate = startInput.value;
        const endDate = endInput.value;
        const contractTemplateId = templateSelect.value;
        const today = new Date().toISOString().slice(0, 10);

        if (!startDate) return 'Vui lòng chọn ngày bắt đầu.';
        if (!endDate) return 'Vui lòng chọn ngày kết thúc.';
        if (!contractTemplateId) return 'Vui lòng chọn mẫu hợp đồng.';
        if (startDate < today) return 'Ngày bắt đầu không được trước ngày tạo hợp đồng.';
        if (endDate <= startDate) return 'Ngày kết thúc phải lớn hơn ngày bắt đầu.';
        return '';
    };

    const updateConfirmState = () => {
        const hasEndDateOrderError =
            !!startInput.value &&
            !!endInput.value &&
            endInput.value <= startInput.value;

        setEndDateInlineError(hasEndDateOrderError ? 'Ngày kết thúc phải lớn hơn ngày bắt đầu.' : '');
        confirmBtn.disabled = !!getValidationError();
    };

    const loadTemplates = async () => {
        templateSelect.innerHTML = '<option value="">Đang tải mẫu hợp đồng...</option>';
        updateConfirmState();

        try {
            const response = await fetch('/Hiring/Templates');
            const data = await response.json();

            if (data.success && Array.isArray(data.data) && data.data.length) {
                templateSelect.innerHTML = '<option value="">-- Chọn mẫu hợp đồng --</option>' +
                    data.data.map((template) => {
                        const inactiveTag = template.isActive ? '' : ' - Inactive';
                        const disabledAttr = template.isActive ? '' : ' disabled';
                        return `<option value="${template.id}"${disabledAttr}>${escapeHtml(template.name)} (v${escapeHtml(template.version)})${inactiveTag}</option>`;
                    }).join('');
            } else {
                templateSelect.innerHTML = '<option value="">Không có mẫu hợp đồng</option>';
            }
        } catch {
            templateSelect.innerHTML = '<option value="">Lỗi tải mẫu</option>';
        } finally {
            updateConfirmState();
        }
    };

    window.__openHireModal = async (jobPostingId, jobAppId, nannyName, contactRequestId = null) => {
        context = { jobPostingId, jobAppId, contactRequestId };
        document.getElementById('hireModalNannyName').textContent = nannyName ? `Nanny: ${nannyName}` : '';

        const today = new Date().toISOString().slice(0, 10);
        startInput.value = today;
        startInput.setAttribute('min', today);
        endInput.value = '';
        endInput.setAttribute('min', addDays(today, 1));
        templateSelect.value = '';

        setError('');
        setEndDateInlineError('');
        updateConfirmState();
        show();
        await loadTemplates();
    };

    window.__closeHireModal = () => {
        setError('');
        setEndDateInlineError('');
        hide();
    };

    window.__submitHiring = async () => {
        const startDate = startInput.value;
        const endDate = endInput.value;
        const contractTemplateId = templateSelect.value;

        const validationError = getValidationError();
        if (validationError) {
            setError(validationError);
            updateConfirmState();
            return;
        }

        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span class="material-icons-round text-base animate-spin">sync</span> Đang xử lý...';
        setError('');

        try {
            const endpoint = (context.jobPostingId && context.jobAppId)
                ? `/Hiring/${context.jobPostingId}/Applicants/${context.jobAppId}/Hire`
                : `/Hiring/ContactRequests/${context.contactRequestId}/Hire`;

            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    startDate,
                    endDate: endDate || null,
                    contractDuration: null,
                    contractTemplateId
                })
            });

            const responseText = await response.text();
            let json = {};
            if (responseText) {
                try {
                    json = JSON.parse(responseText);
                } catch {
                    json = {};
                }
            }

            if (!response.ok) {
                setError(json?.message || 'Có lỗi xảy ra.');
                return;
            }

            if (json?.success === false) {
                setError(json?.message || 'Có lỗi xảy ra.');
                return;
            }

            hide();
            if (json?.data?.conversationId) {
                window.location.href = `/Communication?conversationId=${json.data.conversationId}`;
            }
        } catch {
            setError('Lỗi kết nối. Vui lòng thử lại.');
        } finally {
            updateConfirmState();
            confirmBtn.innerHTML = '<span class="material-icons-round text-base">handshake</span> Xác nhận thuê';
        }
    };

    startInput.addEventListener('change', () => {
        if (!startInput.value) {
            endInput.setAttribute('min', '');
            updateConfirmState();
            return;
        }

        endInput.setAttribute('min', addDays(startInput.value, 1));
        if (endInput.value && endInput.value <= startInput.value) {
            endInput.value = '';
        }
        updateConfirmState();
    });

    endInput.addEventListener('change', updateConfirmState);
    templateSelect.addEventListener('change', updateConfirmState);
})();
</script>
