<div id="hireNannyModal"
     class="fixed inset-0 z-[12000] hidden items-center justify-center bg-black/50 backdrop-blur-sm px-4"
     onclick="if(event.target===this)window.__closeHireModal?.()">
    <div class="bg-white rounded-[28px] w-full max-w-lg shadow-2xl relative overflow-hidden">
        <div class="px-6 py-5 border-b border-orange-100 bg-gradient-to-b from-white to-orange-50/60">
            <button type="button" onclick="window.__closeHireModal?.()"
                    class="absolute top-4 right-4 inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-400 hover:text-slate-600 transition-colors">
                <span class="material-icons-round text-base">close</span>
            </button>
            <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-orange-500">Tuyển dụng</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">Thuê Bảo Mẫu</h2>
            <p id="hireModalNannyName" class="mt-1 text-sm text-slate-500"></p>
        </div>

        <div class="px-6 py-5 space-y-4">
            <div>
                <label for="hireStartDate" class="block text-sm font-bold text-slate-700 mb-1">
                    Ngày bắt đầu <span class="text-rose-500">*</span>
                </label>
                <input type="date" id="hireStartDate" required
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition" />
            </div>

            <div>
                <label for="hireEndDate" class="block text-sm font-bold text-slate-700 mb-1">
                    Ngay ket thuc <span class="text-rose-500">*</span>
                </label>
                <input type="date" id="hireEndDate"
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition" />
                <p class="mt-1 text-xs text-slate-400">Ngay ket thuc phai lon hon ngay bat dau.</p>
            </div>

            <div>
                <label for="hireTemplateId" class="block text-sm font-bold text-slate-700 mb-1">
                    Mẫu hợp đồng <span class="text-rose-500">*</span>
                </label>
                <select id="hireTemplateId" required
                        class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-100 transition bg-white">
                    <option value="">Đang tải mẫu hợp đồng...</option>
                </select>
            </div>

            <p id="hireModalError" class="hidden text-sm text-rose-600 font-semibold"></p>
        </div>

        <div class="px-6 pb-6 flex items-center justify-end gap-3">
            <button type="button" onclick="window.__closeHireModal?.()"
                    class="inline-flex items-center justify-center min-h-[42px] px-5 rounded-xl border border-slate-200 bg-white text-slate-600 font-bold hover:bg-slate-50 transition-all">
                Hủy
            </button>
            <button type="button" id="hireConfirmBtn" onclick="window.__submitHiring?.()" disabled
                    class="inline-flex items-center justify-center gap-2 min-h-[42px] px-6 rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 text-white font-bold shadow-lg shadow-orange-200 hover:from-orange-600 hover:to-orange-500 transition-all disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:from-orange-500 disabled:hover:to-orange-400">
                <span class="material-icons-round text-base">handshake</span>
                Xác nhận thuê
            </button>
        </div>
    </div>
</div>

<script>
(() => {
    let context = { jobPostingId: null, jobAppId: null, contactRequestId: null };

    const modal = document.getElementById('hireNannyModal');
    const errorEl = document.getElementById('hireModalError');
    const confirmBtn = document.getElementById('hireConfirmBtn');
    const startInput = document.getElementById('hireStartDate');
    const endInput = document.getElementById('hireEndDate');
    const templateSelect = document.getElementById('hireTemplateId');

    const show = () => { modal.classList.remove('hidden'); modal.classList.add('flex'); };
    const hiđ = () => { modal.classList.add('hidden'); modal.classList.remove('flex'); };
    const setError = (msg) => {
        errorEl.textContent = msg || '';
        errorEl.classList.toggle('hidden', !msg);
    };
    const addDays = (dateText, days) => {
        const date = new Date(dateText);
        date.setDate(date.getDate() + days);
        return date.toISOString().slice(0, 10);
    };
    const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

    const getValidationError = () => {
        const startDate = startInput.value;
        const endDate = endInput.value;
        const contractTemplateId = templateSelect.value;
        const today = new Date().toISOString().slice(0, 10);

        if (!startDate) return 'Vui long chon ngay bat dau.';
        if (!endDate) return 'Vui long chon ngay ket thuc.';
        if (!contractTemplateId) return 'Vui long chon mau hop dong.';
        if (startDate < today) return 'Ngay bat dau khong duoc truoc ngay tao hop dong.';
        if (endDate <= startDate) return 'Ngay ket thuc phai lon hon ngay bat dau.';
        return '';
    };

    const updateConfirmState = () => {
        const error = getValidationError();
        confirmBtn.disabled = !!error;
        return !error;
    };

    const loadTemplates = async () => {
        templateSelect.innerHTML = '<option value="">Dang tai mau hop dong...</option>';
        updateConfirmState();

        try {
            const res = await fetch('/Hiring/Templates');
            const json = await res.json();
            if (json.success && Array.isArray(json.data) && json.data.length) {
                templateSelect.innerHTML = '<option value="">-- Chon mau hop dong --</option>' +
                    json.data.map(t => {
                        const inactiveTag = t.isActive ? '' : ' - Inactive';
                        const disabledAttr = t.isActive ? '' : ' disabled';
                        return `<option value="${t.id}"${disabledAttr}>${escapeHtml(t.name)} (v${escapeHtml(t.version)})${inactiveTag}</option>`;
                    }).join('');
            } else {
                templateSelect.innerHTML = '<option value="">Khong co mau hop dong</option>';
            }
        } catch {
            templateSelect.innerHTML = '<option value="">Loi tai mau</option>';
        } finally {
            updateConfirmState();
        }
    };

    window.__openHireModal = async (jobPostingId, jobAppId, nannyName, contactRequestId = null) => {
        context = { jobPostingId, jobAppId, contactRequestId };
        document.getElementById('hireModalNannyName').textContent = nannyName ? `Nanny: ${nannyName}` : '';
        const today = new Date().toISOString().slice(0, 10);
        startInput.value = today;
        startInput.setAttribute('min', today);
        endInput.value = '';
        endInput.setAttribute('min', addDays(today, 1));
        templateSelect.value = '';
        setError('');
        updateConfirmState();
        show();
        await loadTemplates();
    };

    window.__closeHireModal = () => hide();

    window.__submitHiring = async () => {
        const startDate = startInput.value;
        const endDate = endInput.value;
        const contractTemplateId = templateSelect.value;

        const validationError = getValidationError();
        if (validationError) {
            setError(validationError);
            updateConfirmState();
            return;
        }

        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Đang xử lý...';
        setError('');

        try {
            const endpoint = (context.jobPostingId && context.jobAppId)
                ? `/Hiring/${context.jobPostingId}/Applicants/${context.jobAppId}/Hire`
                : `/Hiring/ContactRequests/${context.contactRequestId}/Hire`;
            const res = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    startDate,
                    endDate: endDate || null,
                    contractDuration: null,
                    contractTemplateId
                })
            });
            const json = await res.json();
            if (!json.success) {
                setError(json.message || 'Có lỗi xảy ra.');
                return;
            }

            hide();
            if (json.data?.conversationId) {
                window.location.href = `/Communication?conversationId=${json.data.conversationId}`;
            }
        } catch {
            setError('Lỗi kết nối. Vui lòng thử lại.');
        } finally {
            updateConfirmState();
            confirmBtn.innerHTML = '<span class="material-icons-round text-base">handshake</span> Xac nhan thue';
        }
    };

    startInput.addEventListener('change', () => {
        if (!startInput.value) {
            endInput.setAttribute('min', '');
            updateConfirmState();
            return;
        }

        endInput.setAttribute('min', addDays(startInput.value, 1));
        if (endInput.value && endInput.value <= startInput.value) {
            endInput.value = '';
        }
        updateConfirmState();
    });

    endInput.addEventListener('change', updateConfirmState);
    templateSelect.addEventListener('change', updateConfirmState);
})();
</script>
